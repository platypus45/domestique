# Logs (persistent, rotated)
logs/

# Build artifacts
build/
dist/
*.pyc
__pycache__/
*.spec.bak

# Release binaries — ship via GitHub Releases only, never in the repo.
# A 54MB DMG / 70MB EXE committed once is permanent in .git history forever
# (can't be removed without rewriting history) and bloats every clone for
# every contributor. Always upload via `gh release upload`.
*.dmg
*.exe
*.msi
*.zip
*.tar.gz
*.7z

# User data (created at runtime)
.setup_complete
user_paths.json
user_prefs.json
trainer_config.json
known_devices.json
active_profile.json

# Icon build intermediates
assets/icon.iconset/

# IDE
.vscode/
.idea/

# OS
.DS_Store

# Secrets
.env
.notarize.env
*.p12

# Database (user-specific)
*.db
*.db-shm
*.db-wal
sports_nutrition_db.json.bak
routes.json.bak
routes.json.surface_bak

# Claude Code agent runtime artefacts
.claude/scheduled_tasks.lock
.claude/worktrees/

# dev-only classifier audit transition logs (not runtime)
workouts/.classification_audit_*.json
FEEDBACK_TRIAGE.md
NEW_FEATURES.md
IP_*.md

# OAuth client secret — NEVER commit (public repo)
.oauth.env
.venv-build/
