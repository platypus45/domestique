<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 20s/30s 10x (48min)</name>
    <description>Warmup: 10min from 40% to 75% FTP | Microintervals: 10 x (20s @ 125% / 30s @ 60%) | Cooldown: 9min from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="10" OnDuration="20" OffDuration="30" OnPower="1.25" OffPower="0.6" pace="0" />
        <SteadyState Duration="300" Power="0.85" pace="0" Cadence="85" />
        <IntervalsT Repeat="10" OnDuration="20" OffDuration="40" OnPower="1.2" OffPower="0.6" pace="0" />
        <SteadyState Duration="180" Power="0.8" pace="0" Cadence="85" />
        <SteadyState Duration="120" Power="0.95" pace="0" Cadence="90" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <Cooldown Duration="540" PowerLow="0.60" PowerHigh="0.40" pace="0" />
    </workout>
</workout_file>