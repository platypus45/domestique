<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 30s/30s 10x (51min)</name>
    <description>Warmup: 20min from 55% to 75% FTP | Microintervals: 10 x (30s @ 125% / 30s @ 55%)</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="1200" PowerLow="0.55" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="120" OnPower="0.95" OffPower="0.7" pace="0" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="30" OnPower="1.25" OffPower="0.55" pace="0" />
        <Ramp Duration="600" PowerLow="0.75" PowerHigh="0.55" pace="0" />
        <FreeRide Duration="300" FlatRoad="0" />
    </workout>
</workout_file>