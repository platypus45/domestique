<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 20s/3min 10x (51min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 10 x (20s @ 130% / 3min @ 82%) | Cooldown: 7min @ 40% FTP</description>
