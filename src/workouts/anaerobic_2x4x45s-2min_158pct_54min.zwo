<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 45s/2min 8x (54min)</name>
    <description>Warmup: 10min from 50% to 75% FTP | Microintervals: 8 x (45s @ 158% / 2min @ 56%) | Cooldown: 10min from 56% to 45% FTP</description>
