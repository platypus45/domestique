<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 2x30s (59min)</name>
    <description>Warmup: 10min from 40% to 70% FTP | Intervals: 2 x (30s @ 95% / 2min @ 55%) | Cooldown: 5min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.7" pace="0" Cadence="90" />
        <SteadyState Duration="120" Power="0.55" pace="0" Cadence="90" />
        <Ramp Duration="180" PowerLow="0.8" PowerHigh="1.0" pace="0" Cadence="95" />
        <SteadyState Duration="180" Power="0.55" pace="0" Cadence="90" />
        <IntervalsT Repeat="2" OnDuration="30" OffDuration="120" OnPower="0.95" OffPower="0.55" pace="0" Cadence="115" CadenceResting="90" />
        <FreeRide Duration="30" FlatRoad="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" Cadence="90" />
        <FreeRide Duration="30" FlatRoad="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" Cadence="90" />
        <FreeRide Duration="30" FlatRoad="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" Cadence="90" />
        <FreeRide Duration="30" FlatRoad="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" Cadence="90" />
        <SteadyState Duration="20" Power="1.2" pace="0" />
        <SteadyState Duration="20" Power="1.4" pace="0" />
        <SteadyState Duration="20" Power="1.6" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" Cadence="90" />
        <SteadyState Duration="20" Power="1.2" pace="0" />
        <SteadyState Duration="20" Power="1.4" pace="0" />
        <SteadyState Duration="20" Power="1.6" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" Cadence="90" />
        <SteadyState Duration="20" Power="1.2" pace="0" />
        <SteadyState Duration="20" Power="1.4" pace="0" />
        <SteadyState Duration="20" Power="1.6" pace="0" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45" pace="0" Cadence="90" />
    </workout>
</workout_file>