<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 4x30s (55min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 4 x (30s @ 117% / 0s @ 55%) | Cooldown: 5min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="30" Power="1.05" pace="0" />
        <Ramp Duration="300" PowerLow="0.6" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.05" pace="0" />
        <Ramp Duration="300" PowerLow="0.6" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.17" pace="0" />
        <Ramp Duration="120" PowerLow="1.11" PowerHigh="1.28" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.17" pace="0" />
        <Ramp Duration="120" PowerLow="1.11" PowerHigh="1.28" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.17" pace="0" />
        <Ramp Duration="120" PowerLow="1.11" PowerHigh="1.28" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.17" pace="0" />
        <Ramp Duration="120" PowerLow="1.11" PowerHigh="1.28" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="480" Power="0.8" pace="0" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>