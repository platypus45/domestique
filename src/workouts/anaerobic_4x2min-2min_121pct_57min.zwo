<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 4x2min (57min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 4 x (2min @ 121% / 2min @ 60%) | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="60" Power="1.09" pace="0" Cadence="95" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="240" Power="0.9" pace="0" Cadence="95" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="120" OffDuration="120" OnPower="1.21" OffPower="0.6" pace="0" Cadence="95" CadenceResting="80" />
        <SteadyState Duration="600" Power="0.5" pace="0" />
        <FreeRide Duration="360" FlatRoad="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
    </workout>
</workout_file>