<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 45s/2min 8x (45min)</name>
    <description>Warmup: 12min from 50% to 75% FTP | Microintervals: 8 x (45s @ 135% / 2min 15s @ 50%) | Cooldown: 8min 30s from 50% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="750" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="8" OnDuration="45" OffDuration="135" OnPower="1.35" OffPower="0.5" pace="0" />
        <Cooldown Duration="510" PowerLow="0.50" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>