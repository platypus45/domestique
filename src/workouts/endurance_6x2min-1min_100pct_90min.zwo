<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance 6x2min (90min)</name>
    <description>Warmup: 5min from 25% to 55% FTP | Intervals: 6 x (2min @ 100% / 1min @ 55%) | Cooldown: 2min from 50% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.25" PowerHigh="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" Cadence="95" />
        <SteadyState Duration="300" Power="0.65" pace="0" Cadence="100" />
        <SteadyState Duration="30" Power="0.9" pace="0" Cadence="100" />
        <SteadyState Duration="60" Power="0.55" pace="0" Cadence="85" />
        <SteadyState Duration="30" Power="1.0" pace="0" Cadence="105" />
        <SteadyState Duration="60" Power="0.55" pace="0" Cadence="85" />
        <SteadyState Duration="30" Power="1.1" pace="0" Cadence="110" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <SteadyState Duration="150" Power="0.55" pace="0" Cadence="85" />
        <SteadyState Duration="600" Power="0.85" pace="0" Cadence="75" />
        <SteadyState Duration="600" Power="0.65" pace="0" Cadence="90" />
        <IntervalsT Repeat="6" OnDuration="120" OffDuration="60" OnPower="1.0" OffPower="0.55" pace="0" Cadence="100" CadenceResting="85" />
        <SteadyState Duration="600" Power="0.65" pace="0" Cadence="90" />
        <IntervalsT Repeat="8" OnDuration="20" OffDuration="40" OnPower="1.3" OffPower="0.55" pace="0" Cadence="110" CadenceResting="85" />
        <SteadyState Duration="600" Power="0.65" pace="0" Cadence="90" />
        <Cooldown Duration="120" PowerLow="0.5" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>