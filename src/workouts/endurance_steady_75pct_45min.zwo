<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (45min)</name>
    <description>Warmup: 10min from 40% to 75% FTP | Steady: 2min @ 75% FTP | Steady: 28min @ 70% FTP | Cooldown: 5min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.75" />
        <SteadyState Duration="120" Power="0.75" />
        <Ramp Duration="1680" PowerLow="0.75" PowerHigh="0.65" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45" />
    </workout>
</workout_file>