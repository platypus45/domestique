<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 12x2min (71min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 12 x (2min @ 88% / 20s @ 140%) | Cooldown: 5min from 60% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="640" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="10" Power="2" pace="0" Cadence="105" />
        <SteadyState Duration="60" Power="0.55" pace="0" Cadence="85" />
        <SteadyState Duration="10" Power="2" pace="0" Cadence="105" />
        <SteadyState Duration="60" Power="0.55" pace="0" Cadence="85" />
        <IntervalsT Repeat="4" OnDuration="180" OffDuration="120" OnPower="0.85" OffPower="0.85" pace="0" Cadence="95" CadenceResting="65" />
        <SteadyState Duration="300" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="6" OnDuration="120" OffDuration="20" OnPower="0.88" OffPower="1.4" pace="0" Cadence="95" CadenceResting="105" />
        <IntervalsT Repeat="6" OnDuration="120" OffDuration="20" OnPower="0.88" OffPower="1.4" pace="0" Cadence="95" CadenceResting="105" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>