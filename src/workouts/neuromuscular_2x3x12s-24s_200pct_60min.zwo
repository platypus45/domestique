<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 60min — 6×12s/24s @ 200%</name>
    <description>Warmup: 10min from 25% to 75% FTP | Microintervals: 6 x (12s @ 200% / 24s @ 50%) | Cooldown: 11min from 60% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="12" OffDuration="24" OnPower="2.0" OffPower="0.5" pace="0" />
        <SteadyState Duration="900" Power="0.88" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <IntervalsT Repeat="3" OnDuration="12" OffDuration="24" OnPower="2.0" OffPower="0.5" pace="0" />
        <SteadyState Duration="900" Power="0.81" pace="0" />
        <Cooldown Duration="684" PowerLow="0.60" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>