<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 10s/7min 8x (130min)</name>
    <description>Warmup: 10min ramp from 50% to 60% FTP | Microintervals: 8 x (10s @ 170% / 7min 2s @ 62%) | Cooldown: 5min from 55% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.6" /><IntervalsT Repeat="8" OnDuration="440" OffDuration="10" OnPower="0.6" OffPower="1.7" pace="0" />
        <SteadyState Duration="300" Power="0.75" pace="0" />
        <IntervalsT Repeat="4" OnDuration="280" OffDuration="20" OnPower="0.83" OffPower="1.25" pace="0" />
        <SteadyState Duration="600" Power="0.55" pace="0" />
        <IntervalsT Repeat="4" OnDuration="280" OffDuration="20" OnPower="0.83" OffPower="1.25" pace="0" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>