<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 15s/15s 60x (61min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Microintervals: 60 x (15s @ 110% / 15s @ 50%) | Cooldown: 5min ramp from 50% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="0.75" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="20" OnDuration="15" OffDuration="15" OnPower="1.1" OffPower="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="20" OnDuration="15" OffDuration="15" OnPower="1.1" OffPower="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="20" OnDuration="15" OffDuration="15" OnPower="1.1" OffPower="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.50" PowerHigh="0.40" /></workout>
</workout_file>