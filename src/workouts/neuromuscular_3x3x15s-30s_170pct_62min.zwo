<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 15s/30s 9x (62min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 9 x (15s @ 170% / 30s @ 65%) | Cooldown: 5min ramp from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="60" Power="0.95" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Ramp Duration="180" PowerLow="0.5" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="15" OffDuration="30" OnPower="1.7" OffPower="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.81" pace="0" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="15" OffDuration="30" OnPower="1.7" OffPower="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.86" pace="0" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="15" OffDuration="30" OnPower="1.7" OffPower="0.65" pace="0" />
        <Ramp Duration="600" PowerLow="0.76" PowerHigh="0.89" pace="0" />
        <Cooldown Duration="315" PowerLow="0.60" PowerHigh="0.40" /></workout>
</workout_file>