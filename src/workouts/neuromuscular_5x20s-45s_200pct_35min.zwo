<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 20s/45s 5x (34min)</name>
    <description>Warmup: 20min @ 50% FTP | Microintervals: 5 x (20s @ 200% / 45s @ 50%) | Cooldown: 10min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="1200" Power="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="20" OffDuration="45" OnPower="2.0" OffPower="0.5" pace="0" />
        <SteadyState Duration="600" Power="0.5" pace="0" />
    </workout>
</workout_file>