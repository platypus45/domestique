<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 30s cadence 3x2 (42min)</name>
    <description>Warmup: 7min ramp from 45% to 75% FTP, 3 x 30s cadence drill @ 82% alternating 60rpm and 110rpm, primer 1min @ 88% + 1min @ 102% | Cadence contrast at matched watts: 3 x (30s @ 160% at 65rpm, 2min 30s @ 50%, 30s @ 160% at 110rpm), 5min @ 45% between pairs — same power, torque then leg speed | Cooldown: 5min 30s from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="420" PowerLow="0.45" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="30" Power="0.82" pace="0" Cadence="60" />
        <SteadyState Duration="30" Power="0.45" pace="0" Cadence="85" />
        <SteadyState Duration="30" Power="0.82" pace="0" Cadence="110" />
        <SteadyState Duration="30" Power="0.45" pace="0" Cadence="85" />
        <SteadyState Duration="30" Power="0.82" pace="0" Cadence="60" />
        <SteadyState Duration="30" Power="0.45" pace="0" Cadence="85" />
        <SteadyState Duration="60" Power="0.88" pace="0" />
        <SteadyState Duration="60" Power="0.48" pace="0" />
        <SteadyState Duration="60" Power="1.02" pace="0" />
        <SteadyState Duration="60" Power="0.48" pace="0" />
        <SteadyState Duration="105" Power="0.45" pace="0" />
        <SteadyState Duration="30" Power="1.6" pace="0" Cadence="65" />
        <SteadyState Duration="150" Power="0.5" pace="0" Cadence="90" />
        <SteadyState Duration="30" Power="1.6" pace="0" Cadence="110" />
        <SteadyState Duration="300" Power="0.45" pace="0" Cadence="85" />
        <SteadyState Duration="30" Power="1.6" pace="0" Cadence="65" />
        <SteadyState Duration="150" Power="0.5" pace="0" Cadence="90" />
        <SteadyState Duration="30" Power="1.6" pace="0" Cadence="110" />
