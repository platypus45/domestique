<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 15s/40s 7x (60min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Microintervals: 7 x (15s @ 150% / 40s @ 50%) | Cooldown: 5min from 50% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="30" Power="0.95" pace="0" Cadence="95" />
        <SteadyState Duration="30" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="30" Power="1.05" pace="0" Cadence="105" />
        <SteadyState Duration="75" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="30" Power="1.15" pace="0" Cadence="115" />
        <SteadyState Duration="75" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="300" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="1" OnDuration="15" OffDuration="40" OnPower="2.0" OffPower="0.5" pace="0" Cadence="100" CadenceResting="90" />
        <IntervalsT Repeat="3" OnDuration="15" OffDuration="40" OnPower="1.5" OffPower="0.5" pace="0" Cadence="100" CadenceResting="90" />
        <IntervalsT Repeat="1" OnDuration="15" OffDuration="40" OnPower="2.0" OffPower="0.5" pace="0" Cadence="100" CadenceResting="90" />
        <SteadyState Duration="600" Power="0.5" pace="0" Cadence="90" />
        <IntervalsT Repeat="2" OnDuration="15" OffDuration="40" OnPower="1.8" OffPower="0.5" pace="0" Cadence="100" CadenceResting="90" />
        <IntervalsT Repeat="2" OnDuration="15" OffDuration="40" OnPower="1.6" OffPower="0.5" pace="0" Cadence="100" CadenceResting="90" />
        <IntervalsT Repeat="2" OnDuration="15" OffDuration="40" OnPower="1.4" OffPower="0.5" pace="0" Cadence="100" CadenceResting="90" />
        <IntervalsT Repeat="4" OnDuration="15" OffDuration="15" OnPower="1.2" OffPower="0.5" pace="0" Cadence="100" CadenceResting="90" />
        <SteadyState Duration="300" Power="0.5" pace="0" Cadence="90" />
        <IntervalsT Repeat="2" OnDuration="15" OffDuration="40" OnPower="2.0" OffPower="0.5" pace="0" Cadence="100" CadenceResting="90" />
        <IntervalsT Repeat="2" OnDuration="15" OffDuration="15" OnPower="1.2" OffPower="0.5" pace="0" Cadence="100" CadenceResting="90" />
        <IntervalsT Repeat="2" OnDuration="15" OffDuration="40" OnPower="1.5" OffPower="0.5" pace="0" Cadence="100" CadenceResting="90" />
        <IntervalsT Repeat="2" OnDuration="15" OffDuration="15" OnPower="1.2" OffPower="0.5" pace="0" Cadence="100" CadenceResting="90" />
        <IntervalsT Repeat="2" OnDuration="15" OffDuration="40" OnPower="2.0" OffPower="0.5" pace="0" Cadence="100" CadenceResting="90" />
        <IntervalsT Repeat="2" OnDuration="15" OffDuration="40" OnPower="1.5" OffPower="0.5" pace="0" Cadence="100" CadenceResting="90" />
        <Cooldown Duration="300" PowerLow="0.5" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>