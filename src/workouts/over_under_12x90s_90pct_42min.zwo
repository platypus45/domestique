<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 12x2min (42min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 12 x (1min 30s @ 90% / 45s @ 105%) | Cooldown: 5min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="12" OnDuration="90" OffDuration="45" OnPower="0.9" OffPower="1.05" pace="0" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>