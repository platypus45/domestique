<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 9x2min (44min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 9 x (2min @ 93% / 30s @ 108%) | Cooldown: 5min from 55% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="630" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="3" OnDuration="120" OffDuration="30" OnPower="0.93" OffPower="1.08" pace="0" Cadence="90" CadenceResting="75" />
        <SteadyState Duration="180" Power="0.55" pace="0" Cadence="85" />
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="30" OnPower="0.93" OffPower="1.08" pace="0" Cadence="90" CadenceResting="100" />
        <SteadyState Duration="180" Power="0.55" pace="0" Cadence="85" />
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="30" OnPower="0.93" OffPower="1.08" pace="0" Cadence="90" CadenceResting="75" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>