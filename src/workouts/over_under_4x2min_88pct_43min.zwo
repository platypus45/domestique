<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 4x2min (43min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Intervals: 4 x (2min @ 88% / 30s @ 115%) | Cooldown: 5min from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="3" OnDuration="30" OffDuration="30" OnPower="1.05" OffPower="0.65" pace="0" Cadence="105" CadenceResting="85" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="2" OnDuration="120" OffDuration="30" OnPower="0.95" OffPower="1.15" pace="0" Cadence="90" CadenceResting="75" />
        <IntervalsT Repeat="2" OnDuration="120" OffDuration="30" OnPower="0.92" OffPower="1.15" pace="0" Cadence="90" CadenceResting="75" />
        <IntervalsT Repeat="2" OnDuration="120" OffDuration="30" OnPower="0.9" OffPower="1.15" pace="0" Cadence="90" CadenceResting="75" />
        <IntervalsT Repeat="4" OnDuration="120" OffDuration="30" OnPower="0.88" OffPower="1.15" pace="0" Cadence="90" CadenceResting="75" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.40" pace="0" Cadence="0" />
    </workout>
</workout_file>