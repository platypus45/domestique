        <Ramp Duration="180" PowerLow="0.8" PowerHigh="1.08" pace="0" />
        <Ramp Duration="180" PowerLow="1.08" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="120" Power="0.6" pace="0" />
