<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 5x3min (54min)</name>
    <description>Warmup: 6min from 40% to 75% FTP | Intervals: 5 x (3min @ 94% / 2min @ 60%) | Cooldown: 4min from 60% to 45% FTP</description>
