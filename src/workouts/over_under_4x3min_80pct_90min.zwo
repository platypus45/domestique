<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 4x1min (90min)</name>
    <description>Warmup: 10min from 40% to 70% FTP | Intervals: 4 x (1min @ 105% / 1min 15s @ 65%)</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.7" pace="0" />
        <IntervalsT Repeat="1" OnDuration="180" OffDuration="60" OnPower="0.8" OffPower="1.05" pace="0" Cadence="95" CadenceResting="65" />
        <SteadyState Duration="60" Power="0.65" pace="0" Cadence="85" />
        <IntervalsT Repeat="1" OnDuration="180" OffDuration="60" OnPower="0.8" OffPower="1.05" pace="0" Cadence="100" CadenceResting="65" />
        <SteadyState Duration="60" Power="0.65" pace="0" Cadence="85" />
        <IntervalsT Repeat="1" OnDuration="180" OffDuration="60" OnPower="0.8" OffPower="1.05" pace="0" Cadence="70" CadenceResting="100" />
        <SteadyState Duration="60" Power="0.65" pace="0" Cadence="85" />
        <IntervalsT Repeat="1" OnDuration="180" OffDuration="60" OnPower="0.8" OffPower="1.05" pace="0" Cadence="95" CadenceResting="65" />
        <SteadyState Duration="120" Power="0.65" pace="0" Cadence="85" />
        <SteadyState Duration="240" Power="0.9" pace="0" Cadence="95" />
        <SteadyState Duration="240" Power="0.8" pace="0" Cadence="85" />
        <SteadyState Duration="240" Power="0.7" pace="0" Cadence="75" />
        <SteadyState Duration="240" Power="0.9" pace="0" Cadence="75" />
        <SteadyState Duration="240" Power="0.8" pace="0" Cadence="85" />
        <SteadyState Duration="240" Power="0.7" pace="0" Cadence="95" />
        <Ramp Duration="720" PowerLow="0.9" PowerHigh="0.6" pace="0" />
        <SteadyState Duration="120" Power="0.75" pace="0" Cadence="65" />
        <SteadyState Duration="60" Power="0.75" pace="0" Cadence="65" />
        <SteadyState Duration="120" Power="0.75" pace="0" Cadence="95" />
        <SteadyState Duration="60" Power="0.75" pace="0" Cadence="65" />
        <SteadyState Duration="120" Power="0.75" pace="0" Cadence="65" />
        <IntervalsT Repeat="6" OnDuration="60" OffDuration="60" OnPower="0.75" OffPower="0.75" pace="0" Cadence="100" CadenceResting="60" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
    </workout>
</workout_file>