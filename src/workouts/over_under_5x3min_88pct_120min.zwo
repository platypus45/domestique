<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 5x2min (120min)</name>
    <description>Warmup: 5min from 25% to 65% FTP | Intervals: 5 x (2min @ 105% / 2min @ 88%) | Cooldown: 6min from 55% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.25" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" Cadence="95" />
        <SteadyState Duration="60" Power="0.8" pace="0" Cadence="100" />
        <SteadyState Duration="60" Power="0.75" pace="0" Cadence="100" />
        <SteadyState Duration="60" Power="0.55" pace="0" Cadence="85" />
        <SteadyState Duration="60" Power="0.9" pace="0" Cadence="105" />
        <SteadyState Duration="60" Power="0.85" pace="0" Cadence="105" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <SteadyState Duration="60" Power="1.0" pace="0" Cadence="110" />
        <SteadyState Duration="60" Power="0.95" pace="0" Cadence="110" />
        <SteadyState Duration="60" Power="0.55" pace="0" Cadence="85" />
        <SteadyState Duration="30" Power="1.08" pace="0" Cadence="110" />
        <SteadyState Duration="60" Power="0.55" pace="0" Cadence="85" />
        <SteadyState Duration="30" Power="1.15" pace="0" Cadence="115" />
        <SteadyState Duration="60" Power="0.55" pace="0" Cadence="85" />
        <SteadyState Duration="180" Power="0.55" pace="0" Cadence="85" />
        <IntervalsT Repeat="5" OnDuration="120" OffDuration="120" OnPower="1.05" OffPower="0.88" pace="0" Cadence="100" CadenceResting="85" />
        <SteadyState Duration="300" Power="0.55" pace="0" Cadence="85" />
        <IntervalsT Repeat="5" OnDuration="90" OffDuration="150" OnPower="1.05" OffPower="0.88" pace="0" Cadence="100" CadenceResting="85" />
        <SteadyState Duration="300" Power="0.55" pace="0" Cadence="85" />
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="180" OnPower="1.05" OffPower="0.88" pace="0" Cadence="70" CadenceResting="90" />
        <SteadyState Duration="300" Power="0.55" pace="0" Cadence="85" />
        <IntervalsT Repeat="7" OnDuration="60" OffDuration="60" OnPower="1.15" OffPower="0.55" pace="0" Cadence="100" CadenceResting="85" />
        <Cooldown Duration="360" PowerLow="0.55" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>