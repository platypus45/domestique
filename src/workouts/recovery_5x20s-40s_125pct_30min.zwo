<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery 5x20s (30min)</name>
    <description>Warmup: 10min from 30% to 50% FTP | Intervals: 5 x (20s @ 125% / 40s @ 50%) | Cooldown: 5min 40s from 50% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.3" PowerHigh="0.5" pace="0" />
        <SteadyState Duration="600" Power="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="20" OffDuration="40" OnPower="1.25" OffPower="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.4" pace="0" />
    </workout>
</workout_file>