<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery (33min)</name>
    <description>Warmup: 5min from 40% to 105% FTP | Steady: 2min @ 50% FTP | Steady: 5min @ 65% FTP | Steady: 5min @ 50% FTP | Steady: 3min @ 65% FTP | Steady: 5min @ 50% FTP | Steady: 1min @ 65% FTP | Steady: 2min @ 50% FTP | Cooldown: 5min from 50% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.4" PowerHigh="1.05" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <FreeRide Duration="300" FlatRoad="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <FreeRide Duration="180" FlatRoad="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <FreeRide Duration="60" FlatRoad="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.50" PowerHigh="0.40" pace="0" />
    </workout>
</workout_file>