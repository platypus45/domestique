<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (25min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Steady: 2min @ 50% FTP | Steady: 10min @ 90% FTP | Steady: 4min @ 55% FTP | Cooldown: 3min from 55% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="600" Power="0.9" pace="0" />
        <SteadyState Duration="240" Power="0.55" pace="0" />
        <Cooldown Duration="180" PowerLow="0.55" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>