<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 15s/15s 6x (59min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Microintervals: 6 x (15s @ 150% / 15s @ 65%) | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="180" Power="0.95" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="15" OffDuration="15" OnPower="1.5" OffPower="0.65" pace="0" />
        <Ramp Duration="900" PowerLow="0.8" PowerHigh="0.92" pace="0" Cadence="75" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="15" OffDuration="15" OnPower="1.5" OffPower="0.65" pace="0" />
        <Ramp Duration="900" PowerLow="0.92" PowerHigh="0.8" pace="0" Cadence="80" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
    </workout>
</workout_file>