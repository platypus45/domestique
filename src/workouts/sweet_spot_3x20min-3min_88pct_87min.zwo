<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 3x20min (87min)</name>
    <description>Warmup: 6min from 40% to 60% FTP | Intervals: 3 x (20min @ 88% / 3min @ 55%)</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="360" PowerLow="0.4" PowerHigh="0.6" pace="0" />
        <SteadyState Duration="240" Power="0.6" pace="0" />
        <SteadyState Duration="180" Power="0.8" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <IntervalsT Repeat="3" OnDuration="1200" OffDuration="180" OnPower="0.88" OffPower="0.55" pace="0" />
    <Cooldown Duration="180" PowerLow="0.55" PowerHigh="0.40" /></workout>
</workout_file>