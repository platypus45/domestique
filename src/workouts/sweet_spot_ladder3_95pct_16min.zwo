<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (16min)</name>
    <description>Warmup: 5min from 55% to 75% FTP | Steady: 1min @ 50% FTP | Steady: 2min @ 81% FTP | Steady: 1min @ 95% FTP | Steady: 4min @ 65% FTP | Steady: 1min @ 81% FTP | Cooldown: 2min ramp from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.55" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.81" pace="0" />
        <SteadyState Duration="60" Power="0.95" pace="0" />
        <SteadyState Duration="120" Power="0.65" pace="0" />
        <SteadyState Duration="120" Power="0.65" pace="0" />
        <SteadyState Duration="60" Power="0.81" pace="0" />
        <Cooldown Duration="120" PowerLow="0.60" PowerHigh="0.40" /></workout>
</workout_file>