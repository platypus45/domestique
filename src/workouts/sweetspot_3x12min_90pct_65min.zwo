<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 3x12min (65min)</name>
    <description>Warmup: 10min from 40% to 80% FTP | Intervals: 3 x (12min @ 90% / 3min @ 80%) | Cooldown: 7min from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.8" pace="0" />
        <IntervalsT Repeat="3" OnDuration="720" OffDuration="180" OnPower="0.9" OffPower="0.8" pace="0" Cadence="85" CadenceResting="85" />
        <SteadyState Duration="180" Power="0.9" pace="0" Cadence="92" />
        <Cooldown Duration="420" PowerLow="0.60" PowerHigh="0.40" pace="0" />
    </workout>
</workout_file>