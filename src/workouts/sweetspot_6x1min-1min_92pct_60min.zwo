<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 2x5min (60min)</name>
    <description>Warmup: 10min from 41% to 75% FTP | Intervals: 2 x (5min @ 99% / 5min @ 50%) | Cooldown: 9min from 50% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.41" PowerHigh="0.75" pace="0" Cadence="95" />
        <IntervalsT Repeat="6" OnDuration="60" OffDuration="60" OnPower="0.92" OffPower="0.5" pace="0" Cadence="105" CadenceResting="85" />
        <FreeRide Duration="300" FlatRoad="0" />
        <IntervalsT Repeat="2" OnDuration="300" OffDuration="300" OnPower="0.99" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="60" OnPower="0.85" OffPower="0.5" pace="0" Cadence="105" CadenceResting="85" />
        <Cooldown Duration="540" PowerLow="0.50" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>