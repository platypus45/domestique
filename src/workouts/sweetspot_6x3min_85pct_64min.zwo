<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 6x2min (64min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Intervals: 6 x (2min @ 95% / 3min @ 85%) | Cooldown: 9min from 60% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="20" Power="0.81" pace="0" />
        <SteadyState Duration="20" Power="0.95" pace="0" />
        <SteadyState Duration="20" Power="0.81" pace="0" />
        <Ramp Duration="240" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="6" OnDuration="120" OffDuration="180" OnPower="0.95" OffPower="0.85" pace="0" />
        <SteadyState Duration="120" Power="0.65" pace="0" />
        <SteadyState Duration="600" Power="0.9" pace="0" Cadence="85" />
        <Cooldown Duration="540" PowerLow="0.60" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>