<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 2x5min (78min)</name>
    <description>Warmup: 10min from 50% to 65% FTP | Intervals: 2 x (5min @ 95% / 2min @ 50%)</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.65" pace="0" />
        <Ramp Duration="300" PowerLow="0.5" PowerHigh="1.0" pace="0" />
        <SteadyState Duration="120" Power="0.65" pace="0" />
        <SteadyState Duration="120" Power="0.81" pace="0" />
        <SteadyState Duration="60" Power="0.95" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="2" OnDuration="720" OffDuration="60" OnPower="0.81" OffPower="0.5" pace="0" />
        <SteadyState Duration="600" Power="0.5" pace="0" />
        <IntervalsT Repeat="2" OnDuration="300" OffDuration="120" OnPower="0.95" OffPower="0.5" pace="0" />
    <Cooldown Duration="180" PowerLow="0.50" PowerHigh="0.40" /></workout>
</workout_file>