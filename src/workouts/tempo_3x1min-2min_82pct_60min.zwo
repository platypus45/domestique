<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance 3x1min (60min)</name>
    <description>Warmup: 8min from 45% to 75% FTP | Intervals: 3 x (1min @ 118% / 5min @ 67%) | Cooldown: 8min from 60% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.45" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="120" OnPower="0.82" OffPower="0.56" pace="0" Cadence="110" CadenceResting="90" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="300" OnPower="1.18" OffPower="0.67" pace="0" />
        <Ramp Duration="360" PowerLow="0.64" PowerHigh="1.02" pace="0" />
        <SteadyState Duration="30" Power="1.4" pace="0" />
        <FreeRide Duration="300" FlatRoad="0" />
        <SteadyState Duration="30" Power="1.4" pace="0" />
        <FreeRide Duration="300" FlatRoad="0" />
        <SteadyState Duration="30" Power="1.45" pace="0" />
        <Cooldown Duration="480" PowerLow="0.60" PowerHigh="0.30" pace="0" />
    </workout>
</workout_file>