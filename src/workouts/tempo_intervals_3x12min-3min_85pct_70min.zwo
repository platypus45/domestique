<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 3x12min (70min)</name>
    <description>Warmup: 15min from 50% to 75% FTP | Intervals: 3 x (12min @ 85% / 3min @ 55%) | Cooldown: 10min from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="720" OffDuration="180" OnPower="0.85" OffPower="0.55" pace="0" />
        <Cooldown Duration="600" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>