<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo (50min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Steady: 1min @ 60% FTP | Steady: 1min @ 65% FTP | Steady: 1min @ 81% FTP | Steady: 1min @ 109% FTP | Steady: 3min @ 50% FTP | Steady: 15min @ 82% FTP | Steady: 2min @ 50% FTP | Steady: 15min @ 82% FTP | Cooldown: 5min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="60" Power="0.81" pace="0" Cadence="100" />
        <SteadyState Duration="60" Power="1.09" pace="0" Cadence="105" />
        <SteadyState Duration="180" Power="0.5" pace="0" Cadence="85" />
        <Ramp Duration="300" PowerLow="0.76" PowerHigh="0.89" pace="0" Cadence="80" />
        <Ramp Duration="300" PowerLow="0.76" PowerHigh="0.89" pace="0" Cadence="60" />
        <Ramp Duration="300" PowerLow="0.76" PowerHigh="0.89" pace="0" Cadence="80" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <Ramp Duration="300" PowerLow="0.76" PowerHigh="0.89" pace="0" Cadence="80" />
        <Ramp Duration="300" PowerLow="0.76" PowerHigh="0.89" pace="0" Cadence="60" />
        <Ramp Duration="300" PowerLow="0.76" PowerHigh="0.89" pace="0" Cadence="80" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45" pace="0" Cadence="85" />
    </workout>
</workout_file>