<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 2x15min (86min)</name>
    <description>Warmup: 15min from 49% to 92% FTP | Intervals: 2 x (15min @ 95% / 10min @ 49%) | Cooldown: 16min @ 49% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.49" PowerHigh="0.92" pace="0" />
        <SteadyState Duration="180" Power="0.51" pace="0" />
        <IntervalsT Repeat="2" OnDuration="30" OffDuration="150" OnPower="1.23" OffPower="0.49" pace="0" Cadence="105" CadenceResting="100" />
        <SteadyState Duration="300" Power="0.53" pace="0" />
        <IntervalsT Repeat="2" OnDuration="900" OffDuration="600" OnPower="0.95" OffPower="0.49" pace="0" />
        <SteadyState Duration="390" Power="0.49" pace="0" />
    </workout>
</workout_file>