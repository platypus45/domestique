        <SteadyState Duration="300" Power="0.80" />
        <SteadyState Duration="300" Power="0.95" />
        <FreeRide Duration="180" FlatRoad="0" />
        <SteadyState Duration="60" Power="1.10" />
        <FreeRide Duration="60" FlatRoad="0" />
        <SteadyState Duration="1200" Power="1.0" />
        <FreeRide Duration="480" FlatRoad="0" />
        <SteadyState Duration="60" Power="1.10" />
        <FreeRide Duration="60" FlatRoad="0" />
        <SteadyState Duration="1200" Power="1.0" />
        <FreeRide Duration="600" FlatRoad="0" />
    </workout>
