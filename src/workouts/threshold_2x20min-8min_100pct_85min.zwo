<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (85min)</name>
    <description>Steady: 10min @ 65% FTP | Steady: 5min @ 80% FTP | Steady: 5min @ 95% FTP | Steady: 3min @ 65% FTP | Steady: 1min @ 110% FTP | Steady: 1min @ 65% FTP | Steady: 20min @ 100% FTP | Steady: 8min @ 65% FTP | Steady: 1min @ 110% FTP | Steady: 1min @ 65% FTP | Steady: 20min @ 100% FTP | Steady: 10min @ 65% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <FreeRide Duration="300" FlatRoad="0" />
