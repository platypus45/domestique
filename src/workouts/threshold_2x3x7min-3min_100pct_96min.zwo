<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 6x7min (96min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 6 x (7min @ 100% / 3min @ 45%) | Cooldown: 7min from 50% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="30" Power="1.09" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.09" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="420" OffDuration="180" OnPower="1.0" OffPower="0.4" pace="0" />
        <SteadyState Duration="600" Power="0.4" pace="0" />
        <IntervalsT Repeat="3" OnDuration="420" OffDuration="180" OnPower="1.0" OffPower="0.5" pace="0" />
        <Cooldown Duration="420" PowerLow="0.5" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>