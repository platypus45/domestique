<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 3x20min (86min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 3 x (20min @ 100% / 3min @ 55%) | Cooldown: 6min 30s from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="630" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="3" OnDuration="1200" OffDuration="180" OnPower="1" OffPower="0.55" pace="0" />
        <Cooldown Duration="390" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>