<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 3x20min (100min)</name>
    <description>Warmup: 15min from 25% to 75% FTP | Intervals: 3 x (20min @ 95% / 5min @ 65%) | Cooldown: 10min from 60% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="1200" OffDuration="300" OnPower="0.95" OffPower="0.65" pace="0" />
        <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>