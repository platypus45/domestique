<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 3x30s (42min)</name>
    <description>Warmup: 10min @ 50% FTP | Intervals: 3 x (30s @ 125% / 2min @ 50%) | Cooldown: 7min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="600" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.81" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="120" OnPower="1.25" OffPower="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
    </workout>
</workout_file>