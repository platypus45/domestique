<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 5x8min (80min)</name>
    <description>Warmup: 15min from 50% to 75% FTP | Intervals: 5 x (8min @ 95% / 3min @ 55%) | Cooldown: 10min from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="5" OnDuration="480" OffDuration="180" OnPower="0.95" OffPower="0.55" pace="0" />
        <Cooldown Duration="600" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>