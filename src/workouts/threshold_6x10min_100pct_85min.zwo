<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 6x10min (85min)</name>
    <description>Intervals: 6 x (10min @ 100% / 0s @ 55%)</description>
    <sportType>bike</sportType>
    <workout>
        <FreeRide Duration="300" FlatRoad="1" />
        <SteadyState Duration="300" Power="0.65" />
        <SteadyState Duration="180" Power="0.80" />
        <SteadyState Duration="120" Power="0.95" />
        <FreeRide Duration="300" FlatRoad="1" />
        <SteadyState Duration="600" Power="1.00" />
        <SteadyState Duration="600" Power="1.00" />
        <SteadyState Duration="600" Power="1.00" />
        <SteadyState Duration="600" Power="1.00" />
        <SteadyState Duration="600" Power="1.00" />
        <SteadyState Duration="600" Power="1.00" />
    <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.40" /></workout>
</workout_file>