<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 5x1min (120min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Intervals: 5 x (1min @ 120% / 2min @ 55%) | Cooldown: 5min from 60% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="0.95" OffPower="0.5" pace="0" Cadence="95" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.05" OffPower="0.5" pace="0" Cadence="105" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.15" OffPower="0.5" pace="0" Cadence="115" CadenceResting="85" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="600" Power="1.0" pace="0" Cadence="90" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="180" Power="0.65" pace="0" Cadence="90" />
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="0.65" OffPower="0.65" pace="0" Cadence="100" CadenceResting="70" />
        <SteadyState Duration="120" Power="0.65" pace="0" Cadence="90" />
        <IntervalsT Repeat="6" OnDuration="180" OffDuration="20" OnPower="0.77" OffPower="1.2" pace="0" Cadence="90" CadenceResting="110" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="180" Power="0.65" pace="0" Cadence="90" />
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="0.65" OffPower="0.65" pace="0" Cadence="100" CadenceResting="70" />
        <SteadyState Duration="120" Power="0.65" pace="0" Cadence="90" />
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="120" OnPower="1.2" OffPower="0.55" pace="0" Cadence="100" CadenceResting="85" />
        <SteadyState Duration="900" Power="0.65" pace="0" Cadence="90" />
        <SteadyState Duration="600" Power="1.0" pace="0" Cadence="90" />
        <Cooldown Duration="300" PowerLow="0.6" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>