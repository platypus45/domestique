<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 1min/1min 10x (65min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 10 x (1min @ 120% / 1min @ 50%) | Cooldown: 6min from 50% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="3" OnDuration="30" OffDuration="30" OnPower="0.9" OffPower="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.8" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="10" OnDuration="60" OffDuration="60" OnPower="1.2" OffPower="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.6" pace="0" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="30" OnPower="1.3" OffPower="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <Cooldown Duration="360" PowerLow="0.50" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>