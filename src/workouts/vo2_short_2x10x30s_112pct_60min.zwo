<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 30s/22s 20x (60min)</name>
    <description>Warmup: 10min from 35% to 55% FTP | Microintervals: 20 x (30s @ 112% / 22s @ 55%) | Cooldown: 5min from 55% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.35" PowerHigh="0.55" pace="0" />
        <IntervalsT Repeat="2" OnDuration="20" OffDuration="40" OnPower="1.0" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="2" OnDuration="15" OffDuration="45" OnPower="1.05" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="2" OnDuration="10" OffDuration="50" OnPower="1.1" OffPower="0.55" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <IntervalsT Repeat="10" OnDuration="40" OffDuration="20" OnPower="1.1" OffPower="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="15" OnPower="1.12" OffPower="0.55" pace="0" />
        <SteadyState Duration="330" Power="0.55" pace="0" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="30" OnPower="1.12" OffPower="0.55" pace="0" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>