<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 40s/20s 24x (60min)</name>
    <description>Warmup: 12min from 40% to 75% FTP | Microintervals: 24 x (40s @ 110% / 20s @ 50%) | Cooldown: 10min from 50% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="720" PowerLow="0.4" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="2" OnDuration="180" OffDuration="30" OnPower="1.15" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="12" OnDuration="40" OffDuration="20" OnPower="1.1" OffPower="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <IntervalsT Repeat="12" OnDuration="40" OffDuration="20" OnPower="1.1" OffPower="0.5" pace="0" />
        <Cooldown Duration="600" PowerLow="0.50" PowerHigh="0.40" pace="0" />
    </workout>
</workout_file>