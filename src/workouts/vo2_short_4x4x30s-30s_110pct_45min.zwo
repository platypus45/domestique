        <IntervalsT Repeat="4" OnDuration="30" OffDuration="30" OnPower="1.1" OffPower="0.5" pace="0" />
        <FreeRide Duration="180" FlatRoad="0" />
        <IntervalsT Repeat="4" OnDuration="30" OffDuration="30" OnPower="1.1" OffPower="0.5" pace="0" />
        <FreeRide Duration="180" FlatRoad="0" />
        <IntervalsT Repeat="4" OnDuration="30" OffDuration="30" OnPower="1.1" OffPower="0.5" pace="0" />
        <FreeRide Duration="180" FlatRoad="0" />
        <IntervalsT Repeat="4" OnDuration="30" OffDuration="30" OnPower="1.1" OffPower="0.5" pace="0" />
        <FreeRide Duration="600" FlatRoad="0" />
    </workout>
</workout_file>