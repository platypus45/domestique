<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 30s/30s 16x (45min)</name>
    <description>Warmup: 10min from 59% to 82% FTP | Microintervals: 16 x (30s @ 110% / 30s @ 50%)</description>
