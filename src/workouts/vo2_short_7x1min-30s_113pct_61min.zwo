<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 1min/30s 7x (61min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 7 x (1min @ 113% / 30s @ 50%) | Cooldown: 10min from 50% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="2" OnDuration="20" OffDuration="20" OnPower="1.0" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="7" OnDuration="60" OffDuration="30" OnPower="1.13" OffPower="0.5" pace="0" />
        <SteadyState Duration="210" Power="0.5" pace="0" />
        <IntervalsT Repeat="10" OnDuration="40" OffDuration="20" OnPower="1.18" OffPower="0.5" pace="0" />
        <SteadyState Duration="210" Power="0.5" pace="0" />
        <IntervalsT Repeat="13" OnDuration="30" OffDuration="15" OnPower="1.23" OffPower="0.5" pace="0" />
        <Cooldown Duration="625" PowerLow="0.5" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>