<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 40s/20s 8x (69min)</name>
    <description>Warmup: 10min from 40% to 70% FTP | Microintervals: 8 x (40s @ 120% / 20s @ 75%) | Cooldown: 5min from 55% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.7" pace="0" Cadence="90" />
        <SteadyState Duration="120" Power="0.55" pace="0" Cadence="90" />
        <Ramp Duration="180" PowerLow="0.8" PowerHigh="1.05" pace="0" Cadence="95" />
        <SteadyState Duration="180" Power="0.55" pace="0" Cadence="90" />
        <IntervalsT Repeat="8" OnDuration="20" OffDuration="40" OnPower="1.2" OffPower="0.75" pace="0" />
        <SteadyState Duration="360" Power="0.5" pace="0" Cadence="90" />
        <IntervalsT Repeat="8" OnDuration="30" OffDuration="30" OnPower="1.2" OffPower="0.75" pace="0" />
        <SteadyState Duration="360" Power="0.5" pace="0" Cadence="90" />
        <IntervalsT Repeat="8" OnDuration="40" OffDuration="20" OnPower="1.2" OffPower="0.75" pace="0" />
        <SteadyState Duration="360" Power="0.5" pace="0" Cadence="90" />
        <Ramp Duration="240" PowerLow="1.06" PowerHigh="1.2" pace="0" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.35" pace="0" Cadence="90" />
    </workout>
</workout_file>