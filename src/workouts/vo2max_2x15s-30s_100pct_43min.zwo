<workout_file>
    <author>Domestique Library</author>
    <name>VO2max (43min)</name>
    <description>Warmup: 10min from 50% to 75% FTP | Steady: 2min @ 100% FTP | Steady: 1min @ 50% FTP | Steady: 4min @ 100% FTP | Steady: 2min @ 50% FTP | Steady: 12min @ 100% FTP | Steady: 6min @ 50% FTP | Steady: 15s @ 100% FTP | Steady: 30s @ 50% FTP | Steady: 15s @ 100% FTP | Cooldown: 5min from 60% to 40% FTP</description>
