<workout_file>
    <author>Domestique Library</author>
    <name>VO2max (32min)</name>
    <description>Warmup: 10min from 50% to 70% FTP | Steady: 1min @ 115% FTP | Steady: 2min @ 50% FTP | Steady: 2min @ 115% FTP | Steady: 2min @ 50% FTP | Steady: 3min @ 115% FTP | Steady: 2min @ 50% FTP | Steady: 2min @ 115% FTP | Steady: 2min @ 50% FTP | Steady: 1min @ 115% FTP | Cooldown: 5min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="60" Power="1.15" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="1.15" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="1.15" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="1.15" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="1.15" pace="0" />
        <Cooldown Duration="300" PowerLow="0.6" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>