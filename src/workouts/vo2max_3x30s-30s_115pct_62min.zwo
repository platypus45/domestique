<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 2x4min (62min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Intervals: 2 x (4min @ 110% / 4min @ 50%) | Cooldown: 5min from 60% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" Cadence="75" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="30" OnPower="1.15" OffPower="0.5" pace="0" />
        <FreeRide Duration="120" FlatRoad="0" />
        <IntervalsT Repeat="2" OnDuration="240" OffDuration="240" OnPower="1.1" OffPower="0.5" pace="0" Cadence="100" CadenceResting="65" />
        <SteadyState Duration="600" Power="0.65" pace="0" Cadence="85" />
        <IntervalsT Repeat="2" OnDuration="240" OffDuration="240" OnPower="1.15" OffPower="0.6" pace="0" Cadence="100" CadenceResting="65" />
        <Cooldown Duration="300" PowerLow="0.6" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>