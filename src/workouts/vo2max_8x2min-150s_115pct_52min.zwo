<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 8x2min (52min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 8 x (2min @ 115% / 2min 30s @ 55%) | Cooldown: 5min 30s from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="630" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="8" OnDuration="120" OffDuration="150" OnPower="1.15" OffPower="0.55" pace="0" />
        <Cooldown Duration="330" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>