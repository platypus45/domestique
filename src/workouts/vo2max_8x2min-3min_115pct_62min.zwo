<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 8x2min (62min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 8 x (2min @ 115% / 3min @ 60%) | Cooldown: 8min from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="4" OnDuration="120" OffDuration="180" OnPower="1.15" OffPower="0.6" pace="0" />
        <SteadyState Duration="240" Power="0.8" pace="0" />
        <IntervalsT Repeat="4" OnDuration="120" OffDuration="180" OnPower="1.15" OffPower="0.6" pace="0" />
        <Cooldown Duration="480" PowerLow="0.60" PowerHigh="0.40" pace="0" />
    </workout>
</workout_file>