<workout_file>
    <author>Domestique Library</author>
    <name>Mixed (51min)</name>
    <description>Steady: 2min @ 50% FTP | Steady: 2min @ 60% FTP | Steady: 2min @ 70% FTP | Steady: 1min @ 90% FTP | Steady: 8min @ 65% FTP | Steady: 2min @ 95% FTP | Steady: 3min @ 103% FTP | Steady: 2min @ 111% FTP | Steady: 3min @ 65% FTP | Steady: 10min @ 105% FTP | Steady: 5min @ 65% FTP | Steady: 2min @ 140% FTP | Cooldown: 5min ramp from 60% to 40% FTP</description>
