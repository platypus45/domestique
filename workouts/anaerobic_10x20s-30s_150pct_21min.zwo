<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 20s/30s 10x (21min)</name>
    <description>Warmup: 8min from 50% to 75% FTP | Microintervals: 10 x (20s @ 150% / 30s @ 50%) | Cooldown: 5min from 60% to 40% FTP</description>
