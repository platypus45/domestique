<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 10x3min (91min)</name>
    <description>Warmup: 5min from 40% to 65% FTP | Intervals: 10 x (3min @ 88% / 1min @ 100%)</description>
    <sportType>bike</sportType>
    <workout>
