<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 12x2min (53min)</name>
    <description>Warmup: 10min ramp from 50% to 65% FTP | Intervals: 12 x (2min @ 91% / 30s @ 120%) | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.65" /><IntervalsT Repeat="5" OnDuration="30" OffDuration="30" OnPower="0.65" OffPower="0.8" pace="0" Cadence="90" CadenceResting="95" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="12" OnDuration="120" OffDuration="30" OnPower="0.91" OffPower="1.2" pace="0" Cadence="90" CadenceResting="95" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
    </workout>
</workout_file>