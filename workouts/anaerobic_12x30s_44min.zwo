<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>The Wringer 12x30s (44min)</name>
    <description>Warmup: 8min ramp from 30% to 100% FTP | Main: 12 x 30s @ 180% FTP (source 205%, capped at library max) with recoveries @ 50% shrinking each rep from 2:40 down to 1:50 — anaerobic repeatability under decreasing rest | Cooldown: 5min ramp from 70% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
