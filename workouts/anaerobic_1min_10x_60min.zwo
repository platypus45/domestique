<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 1min/1min 10x (60min)</name>
    <description>Warmup: 6min from 50% to 70% FTP | Microintervals: 10 x (1min @ 120% / 1min @ 50%) | Cooldown: 5min 15s from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="360" PowerLow="0.5" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <IntervalsT Repeat="3" OnDuration="25" OffDuration="30" OnPower="0.75" OffPower="0.85" pace="0" />
        <SteadyState Duration="180" Power="0.6" pace="0" />
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="1.2" OffPower="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.6" pace="0" />
        <IntervalsT Repeat="5" OnDuration="120" OffDuration="60" OnPower="0.93" OffPower="1.05" pace="0" />
        <SteadyState Duration="180" Power="0.6" pace="0" />
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="1.2" OffPower="0.5" pace="0" />
        <Cooldown Duration="315" PowerLow="0.6" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>