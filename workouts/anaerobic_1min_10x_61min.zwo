<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 1min/2min 10x (61min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Microintervals: 10 x (1min @ 140% / 2min @ 50%) | Cooldown: 10min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="0.75" OffPower="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.81" pace="0" />
        <IntervalsT Repeat="10" OnDuration="60" OffDuration="120" OnPower="1.4" OffPower="0.5" pace="0" />
        <Cooldown Duration="600" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>