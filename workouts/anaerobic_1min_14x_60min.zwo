<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 1min/1min 14x (65min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 14 x (1min @ 125% / 1min @ 50%) | Cooldown: 5min from 50% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="4" OnDuration="30" OffDuration="30" OnPower="0.75" OffPower="0.85" pace="0" />
        <SteadyState Duration="180" Power="0.6" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <SteadyState Duration="300" Power="0.6" pace="0" />
        <IntervalsT Repeat="7" OnDuration="60" OffDuration="60" OnPower="1.25" OffPower="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.6" pace="0" />
        <IntervalsT Repeat="7" OnDuration="60" OffDuration="60" OnPower="1.25" OffPower="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.50" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>