<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 1min/2min 16x (77min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 16 x (1min @ 145% / 2min 30s @ 50%) | Cooldown: 5min from 40% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="3" OnDuration="30" OffDuration="30" OnPower="1.0" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.4" pace="0" />
        <IntervalsT Repeat="16" OnDuration="60" OffDuration="150" OnPower="1.45" OffPower="0.5" pace="0" />
        <SteadyState Duration="60" Power="0.4" pace="0" />
        <Cooldown Duration="300" PowerLow="0.4" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>