<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 1min/1min 30x (74min)</name>
    <description>Warmup: 10min from 50% to 95% FTP | Microintervals: 30 x (1min @ 150% / 1min @ 35%)</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.95" pace="0" />
        <SteadyState Duration="30" Power="1.25" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.35" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.45" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <IntervalsT Repeat="30" OnDuration="60" OffDuration="60" OnPower="1.5" OffPower="0.35" pace="0" />
    </workout>
</workout_file>