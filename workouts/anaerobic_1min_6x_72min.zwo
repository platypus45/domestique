<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 1min/1min 6x (76min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 6 x (1min @ 138% / 1min @ 69%) | Cooldown: 5min from 70% to 45% FTP</description>
