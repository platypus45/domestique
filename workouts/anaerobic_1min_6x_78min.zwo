<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 1min/1min 6x (78min)</name>
    <description>Warmup: 15min from 50% to 75% FTP | Microintervals: 6 x (1min @ 114% / 1min 15s @ 50%) | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="90" OnPower="0.9" OffPower="0.6" pace="0" />
        <IntervalsT Repeat="8" OnDuration="25" OffDuration="35" OnPower="1.4" OffPower="0.5" pace="0" />
        <SteadyState Duration="600" Power="0.5" pace="0" />
        <IntervalsT Repeat="6" OnDuration="60" OffDuration="75" OnPower="1.14" OffPower="0.5" pace="0" />
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <SteadyState Duration="240" Power="0.95" pace="0" />
        <SteadyState Duration="240" Power="0.55" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="120" Power="0.95" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>