<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 1min/1min 7x (55min)</name>
    <description>Warmup: 20min from 50% to 75% FTP | Microintervals: 7 x (1min @ 125% / 1min @ 55%)</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="1200" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="120" OnPower="0.95" OffPower="0.7" pace="0" />
        <IntervalsT Repeat="7" OnDuration="60" OffDuration="60" OnPower="1.25" OffPower="0.55" pace="0" />
        <Ramp Duration="600" PowerLow="0.7" PowerHigh="0.5" pace="0" />
        <FreeRide Duration="300" FlatRoad="0" />
    </workout>
</workout_file>