<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 1min/1min 8x (64min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 8 x (1min @ 125% / 1min @ 65%) | Cooldown: 5min from 75% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="60" Power="0.81" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="0.95" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="1.09" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <IntervalsT Repeat="2" OnDuration="10" OffDuration="50" OnPower="1.5" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="60" OnPower="1.25" OffPower="0.65" pace="0" />
        <Ramp Duration="300" PowerLow="0.76" PowerHigh="0.89" pace="0" />
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="60" OnPower="1.25" OffPower="0.65" pace="0" />
        <Ramp Duration="300" PowerLow="0.76" PowerHigh="0.89" pace="0" />
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="60" OnPower="1.25" OffPower="0.65" pace="0" />
        <Ramp Duration="300" PowerLow="0.76" PowerHigh="0.89" pace="0" />
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="60" OnPower="1.25" OffPower="0.65" pace="0" />
        <Ramp Duration="300" PowerLow="0.76" PowerHigh="0.89" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>