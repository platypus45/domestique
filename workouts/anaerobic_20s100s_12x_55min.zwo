<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 20s/2min 12x (60min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 12 x (20s @ 120% / 1min 40s @ 60%) | Cooldown: 5min from 40% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="3" OnDuration="30" OffDuration="30" OnPower="1.0" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.4" pace="0" />
        <IntervalsT Repeat="2" OnDuration="20" OffDuration="100" OnPower="1.2" OffPower="0.6" pace="0" />
        <SteadyState Duration="150" Power="0.5" pace="0" />
