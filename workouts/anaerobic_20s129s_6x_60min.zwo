<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 20s/2min 6x (60min)</name>
    <description>Warmup: 5min from 30% to 50% FTP | Microintervals: 6 x (20s @ 125% / 2min 9s @ 79%) | Cooldown: 3min from 55% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.3" PowerHigh="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.6" pace="0" />
        <SteadyState Duration="180" Power="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <IntervalsT Repeat="6" OnDuration="130" OffDuration="20" OnPower="0.8" OffPower="1.25" pace="0" />
        <IntervalsT Repeat="6" OnDuration="125" OffDuration="15" OnPower="0.75" OffPower="1.2" pace="0" />
        <IntervalsT Repeat="6" OnDuration="120" OffDuration="10" OnPower="0.7" OffPower="1.15" pace="0" />
        <Cooldown Duration="180" PowerLow="0.55" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>