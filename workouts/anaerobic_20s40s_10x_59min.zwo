<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 20s/40s 10x (59min)</name>
    <description>Warmup: 10min from 41% to 100% FTP | Microintervals: 10 x (20s @ 140% / 40s @ 90%) | Cooldown: 6min from 62% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.41" PowerHigh="1.0" pace="0" />
        <SteadyState Duration="60" Power="0.81" pace="0" Cadence="85" />
        <SteadyState Duration="120" Power="0.9" pace="0" Cadence="60" />
        <SteadyState Duration="120" Power="0.92" pace="0" Cadence="55" />
        <SteadyState Duration="120" Power="0.9" pace="0" Cadence="60" />
        <SteadyState Duration="120" Power="0.95" pace="0" Cadence="50" />
        <SteadyState Duration="120" Power="1.0" pace="0" Cadence="50" />
        <SteadyState Duration="180" Power="1.0" pace="0" Cadence="120" />
        <SteadyState Duration="60" Power="1.4" pace="0" Cadence="120" />
        <SteadyState Duration="120" Power="0.3" pace="0" Cadence="80" />
        <SteadyState Duration="300" Power="0.5" pace="0" Cadence="90" />
        <SteadyState Duration="180" Power="0.9" pace="0" />
        <IntervalsT Repeat="5" OnDuration="20" OffDuration="40" OnPower="1.4" OffPower="0.9" pace="0" />
        <SteadyState Duration="60" Power="0.33" pace="0" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.9" pace="0" />
        <IntervalsT Repeat="5" OnDuration="20" OffDuration="40" OnPower="1.4" OffPower="0.9" pace="0" />
        <Cooldown Duration="360" PowerLow="0.62" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>