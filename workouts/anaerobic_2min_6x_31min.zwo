<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 2min/2min 6x (33min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 6 x (1min 30s @ 125% / 1min 30s @ 55%) | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="90" Power="1.25" pace="0" />
        <SteadyState Duration="90" Power="0.55" pace="0" />
        <SteadyState Duration="90" Power="1.25" pace="0" />
        <SteadyState Duration="90" Power="0.55" pace="0" />
        <SteadyState Duration="90" Power="1.25" pace="0" />
        <SteadyState Duration="90" Power="0.55" pace="0" />
        <SteadyState Duration="90" Power="1.25" pace="0" />
        <SteadyState Duration="90" Power="0.55" pace="0" />
        <SteadyState Duration="90" Power="1.25" pace="0" />
        <SteadyState Duration="90" Power="0.55" pace="0" />
        <SteadyState Duration="90" Power="1.25" pace="0" />
        <SteadyState Duration="90" Power="0.55" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>