        <SteadyState Duration="60" Power="1.02" pace="0" />
        <SteadyState Duration="60" Power="0.48" pace="0" />
        <SteadyState Duration="90" Power="0.45" pace="0" />
        <SteadyState Duration="120" Power="1.32" pace="0" />
        <SteadyState Duration="330" Power="0.45" pace="0" />
        <SteadyState Duration="120" Power="1.26" pace="0" />
        <SteadyState Duration="300" Power="0.45" pace="0" />
        <SteadyState Duration="120" Power="1.2" pace="0" />
        <SteadyState Duration="285" Power="0.45" pace="0" />
