<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic (54min)</name>
    <description>Warmup: 10min from 50% to 75% FTP | Steady: 2min @ 55% FTP | Steady: 2min 30s @ 122% FTP | Steady: 10min @ 75% FTP | Steady: 2min 30s @ 123% FTP | Steady: 10min @ 75% FTP | Steady: 2min 30s @ 122% FTP | Steady: 10min @ 75% FTP | Cooldown: 5min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="150" Power="1.22" pace="0" />
        <SteadyState Duration="600" Power="0.75" pace="0" />
        <SteadyState Duration="150" Power="1.23" pace="0" />
        <SteadyState Duration="600" Power="0.75" pace="0" />
        <SteadyState Duration="150" Power="1.22" pace="0" />
        <SteadyState Duration="600" Power="0.75" pace="0" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>