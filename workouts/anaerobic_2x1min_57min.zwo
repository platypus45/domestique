<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 2x1min (57min)</name>
    <description>Warmup: 5min from 45% to 75% FTP | Intervals: 2 x (1min @ 98% / 1min @ 50%) | Cooldown: 5min from 75% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.45" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="60" OnPower="0.8" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="60" OnPower="0.98" OffPower="0.5" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <Ramp Duration="120" PowerLow="1.5" PowerHigh="1.21" pace="0" />
        <SteadyState Duration="20" Power="1.3" pace="0" Cadence="85" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Ramp Duration="120" PowerLow="1.5" PowerHigh="1.21" pace="0" />
        <SteadyState Duration="20" Power="1.3" pace="0" Cadence="85" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Ramp Duration="120" PowerLow="1.5" PowerHigh="1.21" pace="0" />
