        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Ramp Duration="120" PowerLow="1.5" PowerHigh="1.21" pace="0" />
        <SteadyState Duration="20" Power="1.3" pace="0" Cadence="85" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="1.5" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="1.41" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
