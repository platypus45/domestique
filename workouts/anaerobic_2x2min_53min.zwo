<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 2x2min (53min)</name>
    <description>Warmup: 20min from 55% to 75% FTP | Intervals: 2 x (1min 30s @ 125% / 1min 30s @ 55%)</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="1200" PowerLow="0.55" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="120" OnPower="0.95" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="2" OnDuration="90" OffDuration="90" OnPower="1.25" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="60" OnPower="1.25" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="2" OnDuration="30" OffDuration="30" OnPower="1.25" OffPower="0.55" pace="0" />
        <Ramp Duration="600" PowerLow="0.7" PowerHigh="0.55" pace="0" />
        <FreeRide Duration="300" FlatRoad="0" />
    </workout>
</workout_file>