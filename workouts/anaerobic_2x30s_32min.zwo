<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular (36min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Steady: 30s @ 100% FTP | Steady: 30s @ 50% FTP | Steady: 30s @ 110% FTP | Steady: 30s @ 50% FTP | Steady: 30s @ 120% FTP | Steady: 4min @ 61% FTP | Steady: 1min @ 200% FTP | Steady: 3min @ 55% FTP | Steady: 3min @ 61% FTP | Steady: 3min @ 55% FTP | Steady: 1min @ 200% FTP | Steady: 3min @ 50% FTP | Cooldown: 5min from 50% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="630" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="30" Power="1" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.1" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.2" pace="0" />
        <SteadyState Duration="240" Power="0.61" pace="0" />
        <SteadyState Duration="60" Power="2" pace="0" />
        <Ramp Duration="180" PowerLow="0.5" PowerHigh="0.61" pace="0" />
        <SteadyState Duration="180" Power="0.61" pace="0" />
        <Ramp Duration="180" PowerLow="0.61" PowerHigh="0.5" pace="0" />
        <SteadyState Duration="60" Power="2" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.5" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>