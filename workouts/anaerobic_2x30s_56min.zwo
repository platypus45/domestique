<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 2x30s (56min)</name>
    <description>Warmup: 7min from 50% to 75% FTP | Intervals: 2 x (30s @ 110% / 30s @ 55%) | Cooldown: 5min from 55% to 35% FTP</description>
