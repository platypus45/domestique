<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic (56min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Steady: 2min @ 55% FTP | Steady: 3min @ 95% FTP | Steady: 2min @ 55% FTP | Steady: 1min @ 115% FTP | Steady: 3min @ 55% FTP | Steady: 1min @ 150% FTP | Steady: 6min @ 55% FTP | Steady: 1min @ 160% FTP | Steady: 6min @ 55% FTP | Steady: 1min @ 170% FTP | Steady: 17min @ 55% FTP | Cooldown: 5min from 50% to 75% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="180" Power="0.95" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="60" Power="1.15" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="60" Power="1.5" pace="0" />
        <SteadyState Duration="360" Power="0.55" pace="0" />
        <SteadyState Duration="60" Power="1.6" pace="0" />
        <SteadyState Duration="360" Power="0.55" pace="0" />
        <SteadyState Duration="60" Power="1.7" pace="0" />
        <SteadyState Duration="360" Power="0.55" pace="0" />
        <SteadyState Duration="360" Power="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <Cooldown Duration="300" PowerLow="0.5" PowerHigh="0.75" pace="0" />
    </workout>
</workout_file>