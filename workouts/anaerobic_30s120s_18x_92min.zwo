<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 30s/2min 18x (92min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Microintervals: 18 x (30s @ 120% / 2min @ 90%) | Cooldown: 10min from 65% to 26% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="6" OnDuration="30" OffDuration="120" OnPower="1.2" OffPower="0.9" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <IntervalsT Repeat="6" OnDuration="30" OffDuration="120" OnPower="1.2" OffPower="0.9" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <IntervalsT Repeat="6" OnDuration="30" OffDuration="120" OnPower="1.2" OffPower="0.9" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <IntervalsT Repeat="2" OnDuration="180" OffDuration="180" OnPower="1.06" OffPower="0.66" pace="0" />
        <Cooldown Duration="600" PowerLow="0.65" PowerHigh="0.26" pace="0" />
    </workout>
</workout_file>