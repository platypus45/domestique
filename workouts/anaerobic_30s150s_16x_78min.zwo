<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 30s/2min 16x (78min)</name>
    <description>Warmup: 20min from 50% to 75% FTP | Microintervals: 16 x (30s @ 125% / 2min 30s @ 50%) | Cooldown: 10min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="1200" PowerLow="0.5" PowerHigh="0.75" pace="0" Cadence="95" />
        <IntervalsT Repeat="16" OnDuration="30" OffDuration="150" OnPower="1.25" OffPower="0.5" pace="0" Cadence="105" CadenceResting="90" />
        <Cooldown Duration="600" PowerLow="0.75" PowerHigh="0.25" pace="0" Cadence="90" />
    </workout>
</workout_file>