<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 30-20-10 microbursts 2x3 (48min)</name>
    <description>Warmup: 7min ramp from 45% to 75% FTP, 3 x 30s fast-pedal drill @ 82%, primer 1min @ 88% + 1min @ 102% | Constant-ratio descending microbursts: 2 sets x 3 cycles of (30s @ 124%, 20s @ 134%, 10s @ 144%) with 90s / 60s / 30s @ 50% after each rung, work:rest pinned at 1:3 the whole way, 4min @ 45% between sets | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="420" PowerLow="0.45" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="30" Power="0.82" pace="0" Cadence="110" />
