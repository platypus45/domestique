<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 30s/4min 6x (52min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Microintervals: 6 x (30s @ 120% / 4min 12s @ 50%) | Cooldown: 5min from 25% to 75% FTP</description>
