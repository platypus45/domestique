<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 30s/5min 8x (63min)</name>
    <description>Warmup: 3min from 30% to 50% FTP | Microintervals: 8 x (30s @ 130% / 4min 42s @ 68%) | Cooldown: 5min ramp from 65% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="180" PowerLow="0.3" PowerHigh="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="180" Power="0.6" pace="0" Cadence="95" />
        <SteadyState Duration="180" Power="0.75" pace="0" Cadence="105" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <IntervalsT Repeat="4" OnDuration="300" OffDuration="30" OnPower="0.7" OffPower="1.3" pace="0" Cadence="90" CadenceResting="115" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <IntervalsT Repeat="4" OnDuration="300" OffDuration="30" OnPower="0.7" OffPower="1.3" pace="0" Cadence="90" CadenceResting="115" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.40" /></workout>
</workout_file>