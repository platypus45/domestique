<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 30s/5min 12x (90min)</name>
    <description>Warmup: 15min from 50% to 75% FTP | Microintervals: 12 x (30s @ 140% / 5min @ 75%) | Cooldown: 9min from 70% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="12" OnDuration="30" OffDuration="300" OnPower="1.4" OffPower="0.75" pace="0" />
        <Cooldown Duration="540" PowerLow="0.7" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>