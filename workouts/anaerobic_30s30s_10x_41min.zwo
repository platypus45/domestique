<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 30s/30s 10x (42min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 10 x (30s @ 125% / 30s @ 88%) | Cooldown: 5min from 63% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="1.18" OffPower="0.95" pace="0" />
        <SteadyState Duration="420" Power="0.51" pace="0" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="30" OnPower="1.25" OffPower="0.88" pace="0" />
        <Cooldown Duration="300" PowerLow="0.63" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>