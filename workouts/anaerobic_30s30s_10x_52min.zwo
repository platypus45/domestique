<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 30s/30s 10x (54min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 10 x (30s @ 120% / 30s @ 55%) | Cooldown: 5min @ 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="2" OnDuration="30" OffDuration="30" OnPower="1.1" OffPower="0.55" pace="0" Cadence="110" CadenceResting="85" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="5" OnDuration="30" OffDuration="30" OnPower="1.2" OffPower="0.55" pace="0" />
        <SteadyState Duration="600" Power="0.92" pace="0" Cadence="90" />
        <SteadyState Duration="300" Power="0.55" pace="0" Cadence="85" />
        <IntervalsT Repeat="5" OnDuration="30" OffDuration="30" OnPower="1.2" OffPower="0.55" pace="0" />
        <SteadyState Duration="600" Power="0.92" pace="0" Cadence="90" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
    </workout>
</workout_file>