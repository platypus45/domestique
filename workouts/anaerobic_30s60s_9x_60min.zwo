<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 30s/1min 9x (64min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 9 x (30s @ 125% / 1min @ 50%) | Cooldown: 5min 15s from 75% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="3" OnDuration="20" OffDuration="40" OnPower="1.1" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.81" pace="0" />
        <IntervalsT Repeat="3" OnDuration="20" OffDuration="40" OnPower="1.15" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.81" pace="0" />
        <IntervalsT Repeat="3" OnDuration="20" OffDuration="40" OnPower="1.2" OffPower="0.5" pace="0" />
        <SteadyState Duration="240" Power="0.85" pace="0" />
        <SteadyState Duration="75" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.95" pace="0" />
        <SteadyState Duration="75" Power="0.5" pace="0" />
        <SteadyState Duration="240" Power="0.85" pace="0" />
        <SteadyState Duration="75" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.95" pace="0" />
        <SteadyState Duration="75" Power="0.5" pace="0" />
        <SteadyState Duration="240" Power="0.85" pace="0" />
        <SteadyState Duration="75" Power="0.5" pace="0" />
        <IntervalsT Repeat="9" OnDuration="30" OffDuration="60" OnPower="1.25" OffPower="0.5" pace="0" />
        <Cooldown Duration="315" PowerLow="0.75" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>