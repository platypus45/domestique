<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 30s/1min 7x (30min)</name>
    <description>Warmup: 5min from 25% to 70% FTP | Microintervals: 7 x (30s @ 120% / 1min 15s @ 41%) | Cooldown: 5min from 65% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.25" PowerHigh="0.7" pace="0" />
        <IntervalsT Repeat="7" OnDuration="45" OffDuration="30" OnPower="0.4" OffPower="1.2" pace="0" />
        <SteadyState Duration="255" Power="0.46" pace="0" />
        <IntervalsT Repeat="7" OnDuration="45" OffDuration="15" OnPower="0.75" OffPower="0.4" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>