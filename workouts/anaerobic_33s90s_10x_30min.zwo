<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 33s/2min 10x (34min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 10 x (33s @ 148% / 1min 30s @ 55%) | Cooldown: 5min ramp from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="33" Power="1.48" pace="0" />
