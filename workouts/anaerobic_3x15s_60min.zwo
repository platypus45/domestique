<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 3x15s (60min)</name>
    <description>Warmup: 4min from 40% to 75% FTP | Intervals: 3 x (15s @ 120% / 40s @ 50%) | Cooldown: 3min 45s from 75% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="240" PowerLow="0.4" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="15" OffDuration="40" OnPower="1.2" OffPower="0.5" pace="0" />
        <SteadyState Duration="30" Power="0.65" pace="0" />
