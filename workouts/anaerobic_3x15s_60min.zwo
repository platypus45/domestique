<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 3x15s (64min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Intervals: 3 x (15s @ 120% / 40s @ 50%) | Cooldown: 3min 45s from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
