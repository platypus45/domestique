<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 3x1min (37min)</name>
    <description>Intervals: 3 x (1min @ 113% / 1min @ 60%) | Cooldown: 5min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="120" Power="0.6" pace="0" />
        <SteadyState Duration="120" Power="0.7" pace="0" />
        <SteadyState Duration="120" Power="0.8" pace="0" />
        <SteadyState Duration="60" Power="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <IntervalsT Repeat="5" OnDuration="30" OffDuration="30" OnPower="1.33" OffPower="0.6" pace="0" />
        <SteadyState Duration="180" Power="0.6" pace="0" />
        <IntervalsT Repeat="4" OnDuration="40" OffDuration="40" OnPower="1.23" OffPower="0.6" pace="0" />
        <SteadyState Duration="180" Power="0.6" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="1.13" OffPower="0.6" pace="0" />
        <Cooldown Duration="300" PowerLow="0.6" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>