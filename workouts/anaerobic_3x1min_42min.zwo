<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 3x1min (44min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 3 x (1min @ 150% / 1min @ 55%) | Cooldown: 5min from 55% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="615" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="2" OnDuration="30" OffDuration="30" OnPower="1.15" OffPower="0.55" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="60" OffDuration="60" OnPower="1.5" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="45" OffDuration="60" OnPower="1.35" OffPower="0.55" pace="0" />
        <FreeRide Duration="30" FlatRoad="0" />
        <SteadyState Duration="360" Power="0.45" pace="0" />
        <IntervalsT Repeat="1" OnDuration="60" OffDuration="60" OnPower="1.5" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="45" OffDuration="60" OnPower="1.35" OffPower="0.55" pace="0" />
        <FreeRide Duration="30" FlatRoad="0" />
        <SteadyState Duration="360" Power="0.45" pace="0" />
        <IntervalsT Repeat="1" OnDuration="60" OffDuration="60" OnPower="1.5" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="45" OffDuration="60" OnPower="1.35" OffPower="0.55" pace="0" />
        <FreeRide Duration="30" FlatRoad="0" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>