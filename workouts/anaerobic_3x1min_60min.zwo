<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 3x1min (60min)</name>
    <description>Warmup: 20min @ 40% FTP | Intervals: 3 x (1min @ 150% / 3min @ 55%) | Cooldown: 10min @ 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="1200" Power="0.4" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="180" OnPower="1.5" OffPower="0.55" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="900" Power="0.93" pace="0" />
        <SteadyState Duration="600" Power="0.4" pace="0" />
    </workout>
</workout_file>