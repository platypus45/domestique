<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 3x1min (90min)</name>
    <description>Warmup: 15min from 25% to 75% FTP | Intervals: 3 x (1min @ 120% / 5min @ 50%) | Cooldown: 10min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="300" OnPower="1.2" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="300" OnPower="1.05" OffPower="0.5" pace="0" />
        <SteadyState Duration="1830" Power="0.65" pace="0" />
        <Cooldown Duration="600" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>