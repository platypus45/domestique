<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 3x20s (52min)</name>
    <description>Warmup: 10min from 40% to 70% FTP | Intervals: 3 x (20s @ 120% / 0s @ 55%) | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <Ramp Duration="180" PowerLow="0.8" PowerHigh="1" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="20" Power="1.2" pace="0" />
        <SteadyState Duration="20" Power="1.4" pace="0" />
        <SteadyState Duration="20" Power="1.6" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="20" Power="1.2" pace="0" />
        <SteadyState Duration="20" Power="1.4" pace="0" />
        <SteadyState Duration="20" Power="1.6" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="20" Power="1.2" pace="0" />
        <SteadyState Duration="20" Power="1.4" pace="0" />
        <SteadyState Duration="20" Power="1.6" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>