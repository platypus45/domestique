<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 4x30s (54min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 4 x (30s @ 116% / 0s @ 55%) | Cooldown: 5min from 45% to 75% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="30" Power="1.16" pace="0" />
        <Ramp Duration="120" PowerLow="1.11" PowerHigh="1.28" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.16" pace="0" />
