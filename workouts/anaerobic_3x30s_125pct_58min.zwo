<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 3x30s (58min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 3 x (30s @ 125% / 4min @ 80%) | Cooldown: 5min from 50% to 45% FTP</description>
