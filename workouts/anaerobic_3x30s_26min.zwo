<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 3x30s (26min)</name>
    <description>Warmup: 3min from 35% to 55% FTP | Intervals: 3 x (30s @ 130% / 1min @ 45%) | Cooldown: 3min from 55% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="180" PowerLow="0.35" PowerHigh="0.55" pace="0" />
        <SteadyState Duration="30" Power="1.3" pace="0" />
        <SteadyState Duration="60" Power="0.45" pace="0" />
        <SteadyState Duration="30" Power="1.3" pace="0" />
        <SteadyState Duration="60" Power="0.45" pace="0" />
        <SteadyState Duration="30" Power="1.3" pace="0" />
        <SteadyState Duration="60" Power="0.45" pace="0" />
        <SteadyState Duration="60" Power="1.25" pace="0" />
        <SteadyState Duration="90" Power="0.45" pace="0" />
        <SteadyState Duration="60" Power="1.25" pace="0" />
        <SteadyState Duration="90" Power="0.45" pace="0" />
        <SteadyState Duration="60" Power="1.25" pace="0" />
        <SteadyState Duration="90" Power="0.45" pace="0" />
        <SteadyState Duration="90" Power="1.23" pace="0" />
        <SteadyState Duration="120" Power="0.45" pace="0" />
        <SteadyState Duration="90" Power="1.23" pace="0" />
        <SteadyState Duration="120" Power="0.45" pace="0" />
        <SteadyState Duration="90" Power="1.23" pace="0" />
        <Cooldown Duration="180" PowerLow="0.55" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>