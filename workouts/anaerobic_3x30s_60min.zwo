<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 3x30s (60min)</name>
    <description>Warmup: 5min @ 50% FTP | Intervals: 3 x (30s @ 150% / 10min @ 90%) | Cooldown: 5min from 50% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <SteadyState Duration="180" Power="0.8" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="540" OnPower="1.5" OffPower="0.9" pace="0" />
        <SteadyState Duration="30" Power="1.3" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="600" OnPower="1.5" OffPower="0.9" pace="0" />
        <SteadyState Duration="30" Power="1.3" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="720" OnPower="1.5" OffPower="0.9" pace="0" />
        <SteadyState Duration="30" Power="1.3" pace="0" />
        <Cooldown Duration="300" PowerLow="0.5" PowerHigh="0.3" pace="0" />
    </workout>
</workout_file>