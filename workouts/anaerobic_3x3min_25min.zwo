<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 3x20s (34min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 3 x (20s @ 125% / 3min @ 60%) | Cooldown: 5min ramp from 75% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="20" Power="1.25" pace="0" />
        <Ramp Duration="180" PowerLow="0.56" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="20" Power="1.25" pace="0" />
        <Ramp Duration="180" PowerLow="0.66" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="20" Power="1.25" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="1.21" pace="0" />
        <SteadyState Duration="300" Power="0.35" pace="0" />
        <SteadyState Duration="120" Power="1.21" pace="0" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.4" /></workout>
</workout_file>