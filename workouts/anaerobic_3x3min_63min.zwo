<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 3x3min (63min)</name>
    <description>Warmup: 5min from 45% to 70% FTP | Intervals: 3 x (3min @ 95% / 1min @ 110%) | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.45" PowerHigh="0.7" pace="0" />
        <IntervalsT Repeat="2" OnDuration="10" OffDuration="50" OnPower="1.75" OffPower="0.5" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.8" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="1.09" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="1.0" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="45" OffDuration="120" OnPower="1.4" OffPower="0.6" pace="0" />
        <SteadyState Duration="600" Power="0.85" pace="0" />
        <IntervalsT Repeat="1" OnDuration="180" OffDuration="60" OnPower="0.95" OffPower="1.1" pace="0" />
        <SteadyState Duration="120" Power="0.6" pace="0" />
        <IntervalsT Repeat="1" OnDuration="180" OffDuration="60" OnPower="0.95" OffPower="1.1" pace="0" />
        <SteadyState Duration="120" Power="0.6" pace="0" />
        <IntervalsT Repeat="1" OnDuration="180" OffDuration="60" OnPower="0.95" OffPower="1.1" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
    </workout>
</workout_file>