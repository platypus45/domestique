<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 3x40s (59min)</name>
    <description>Warmup: 20min from 41% to 137% FTP | Intervals: 3 x (40s @ 120% / 1min @ 75%) | Cooldown: 5min from 74% to 41% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="1200" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="60" Power="0.89" pace="0" />
        <SteadyState Duration="60" Power="0.85" pace="0" />
        <SteadyState Duration="60" Power="1.06" pace="0" />
        <SteadyState Duration="180" Power="1.37" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.85" pace="0" />
        <SteadyState Duration="10" Power="1.5" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <IntervalsT Repeat="3" OnDuration="40" OffDuration="60" OnPower="1.2" OffPower="0.6" pace="0" />
        <SteadyState Duration="60" Power="0.74" pace="0" />
        <SteadyState Duration="20" Power="1.5" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="120" Power="0.91" pace="0" />
        <SteadyState Duration="60" Power="0.89" pace="0" />
        <SteadyState Duration="30" Power="1.5" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <Cooldown Duration="300" PowerLow="0.74" PowerHigh="0.41" pace="0" />
    </workout>
</workout_file>