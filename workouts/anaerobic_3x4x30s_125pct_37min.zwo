<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 30s/1min 12x (37min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 12 x (30s @ 125% / 1min 27s @ 68%) | Cooldown: 5min from 60% to 25% FTP</description>
