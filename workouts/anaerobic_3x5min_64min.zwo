<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 3x5min (64min)</name>
    <description>Warmup: 8min from 45% to 75% FTP | Intervals: 3 x (5min @ 100% / 5min @ 60%) | Cooldown: 8min from 75% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.45" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="300" Power="1.0" pace="0" />
        <SteadyState Duration="300" Power="0.6" pace="0" />
        <SteadyState Duration="120" Power="1.2" pace="0" />
        <SteadyState Duration="240" Power="0.6" pace="0" />
        <SteadyState Duration="300" Power="1.0" pace="0" />
        <SteadyState Duration="300" Power="0.6" pace="0" />
        <SteadyState Duration="120" Power="1.2" pace="0" />
        <SteadyState Duration="240" Power="0.6" pace="0" />
        <SteadyState Duration="300" Power="1.0" pace="0" />
        <SteadyState Duration="300" Power="0.6" pace="0" />
        <SteadyState Duration="120" Power="1.2" pace="0" />
        <SteadyState Duration="240" Power="0.6" pace="0" />
        <Cooldown Duration="480" PowerLow="0.75" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>