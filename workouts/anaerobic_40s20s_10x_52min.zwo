<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 40s/20s 10x (52min)</name>
    <description>Warmup: 8min from 50% to 80% FTP | Microintervals: 10 x (40s @ 120% / 20s @ 55%) | Cooldown: 5min @ 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.8" pace="0" Cadence="85" />
        <IntervalsT Repeat="2" OnDuration="30" OffDuration="30" OnPower="1.1" OffPower="0.55" pace="0" Cadence="110" CadenceResting="85" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="5" OnDuration="40" OffDuration="20" OnPower="1.2" OffPower="0.55" pace="0" />
        <SteadyState Duration="600" Power="0.92" pace="0" Cadence="90" />
        <SteadyState Duration="300" Power="0.55" pace="0" Cadence="85" />
        <IntervalsT Repeat="5" OnDuration="40" OffDuration="20" OnPower="1.2" OffPower="0.55" pace="0" />
        <SteadyState Duration="600" Power="0.92" pace="0" Cadence="90" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
    </workout>
</workout_file>