<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 40s/20s 10x (60min)</name>
    <description>Warmup: 8min 10s from 50% to 52% FTP | Microintervals: 10 x (40s @ 120% / 20s @ 50%) | Cooldown: 9min from 65% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="10" Power="0.5" pace="0" />
        <Ramp Duration="480" PowerLow="0.45" PowerHigh="0.6" pace="0" Cadence="50" />
        <SteadyState Duration="10" Power="1.1" pace="0" />
        <SteadyState Duration="20" Power="0.5" pace="0" />
        <SteadyState Duration="10" Power="1.2" pace="0" />
        <SteadyState Duration="20" Power="0.5" pace="0" />
        <SteadyState Duration="10" Power="1.3" pace="0" />
        <SteadyState Duration="20" Power="0.5" pace="0" />
        <SteadyState Duration="10" Power="1.4" pace="0" />
        <SteadyState Duration="20" Power="0.5" pace="0" />
        <SteadyState Duration="10" Power="1.5" pace="0" />
        <SteadyState Duration="40" Power="0.5" pace="0" />
        <SteadyState Duration="600" Power="0.75" pace="0" Cadence="55" />
        <SteadyState Duration="600" Power="0.85" pace="0" Cadence="60" />
        <SteadyState Duration="600" Power="0.95" pace="0" Cadence="65" />
        <IntervalsT Repeat="10" OnDuration="40" OffDuration="20" OnPower="1.2" OffPower="0.5" pace="0" />
        <Cooldown Duration="540" PowerLow="0.65" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>