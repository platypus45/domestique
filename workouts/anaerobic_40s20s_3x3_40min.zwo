<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 40s/20s 3x3 (40min)</name>
    <description>Warmup: 7min ramp from 45% to 75% FTP, 3 x 30s fast-pedal drill @ 82%, primer 1min @ 88% + 1min @ 102% | Supramaximal microintervals: 3 sets x 3 x (40s @ 130% / 20s @ 50%), 4min 40s between sets | Cooldown: 6min from 50% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="420" PowerLow="0.45" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="30" Power="0.82" pace="0" Cadence="110" />
        <SteadyState Duration="30" Power="0.45" pace="0" Cadence="85" />
        <SteadyState Duration="30" Power="0.82" pace="0" Cadence="110" />
        <SteadyState Duration="30" Power="0.45" pace="0" Cadence="85" />
        <SteadyState Duration="30" Power="0.82" pace="0" Cadence="110" />
        <SteadyState Duration="30" Power="0.45" pace="0" Cadence="85" />
        <SteadyState Duration="60" Power="0.88" pace="0" />
        <SteadyState Duration="60" Power="0.48" pace="0" />
        <SteadyState Duration="60" Power="1.02" pace="0" />
        <SteadyState Duration="60" Power="0.48" pace="0" />
        <SteadyState Duration="105" Power="0.45" pace="0" />
        <IntervalsT Repeat="3" OnDuration="40" OffDuration="20" OnPower="1.3" OffPower="0.5" pace="0" Cadence="95" CadenceResting="85" />
        <SteadyState Duration="280" Power="0.45" pace="0" />
        <IntervalsT Repeat="3" OnDuration="40" OffDuration="20" OnPower="1.3" OffPower="0.5" pace="0" Cadence="95" CadenceResting="85" />
        <SteadyState Duration="280" Power="0.45" pace="0" />
        <IntervalsT Repeat="3" OnDuration="40" OffDuration="20" OnPower="1.3" OffPower="0.5" pace="0" Cadence="95" CadenceResting="85" />
        <Cooldown Duration="360" PowerLow="0.50" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>
