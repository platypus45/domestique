<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 40s/5min 6x (56min)</name>
    <description>Microintervals: 6 x (40s @ 125% / 4min 40s @ 71%) | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="240" Power="0.7" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="240" Power="0.8" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="40" Power="1.25" pace="0" />
        <Ramp Duration="360" PowerLow="0.75" PowerHigh="0.88" pace="0" />
        <SteadyState Duration="40" Power="1.25" pace="0" />
        <Ramp Duration="360" PowerLow="0.88" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="40" Power="1.25" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="40" Power="1.25" pace="0" />
        <Ramp Duration="360" PowerLow="0.75" PowerHigh="0.88" pace="0" />
        <SteadyState Duration="40" Power="1.25" pace="0" />
        <Ramp Duration="360" PowerLow="0.88" PowerHigh="0.74" pace="0" />
        <SteadyState Duration="40" Power="1.25" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="240" Power="0.8" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
    </workout>
</workout_file>