<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 45s/2min 12x (60min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Microintervals: 12 x (45s @ 130% / 2min @ 90%) | Cooldown: 9min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="0.75" OffPower="0.5" pace="0" Cadence="110" CadenceResting="80" />
        <SteadyState Duration="120" Power="0.9" pace="0" />
        <IntervalsT Repeat="12" OnDuration="45" OffDuration="120" OnPower="1.3" OffPower="0.9" pace="0" Cadence="100" CadenceResting="88" />
        <Cooldown Duration="540" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>