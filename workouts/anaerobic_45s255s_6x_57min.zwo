<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 45s/4min 6x (64min)</name>
    <description>Microintervals: 6 x (45s @ 175% / 4min 15s @ 60%) | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="2" OnDuration="60" OffDuration="60" OnPower="0.75" OffPower="0.5" pace="0" Cadence="90" CadenceResting="80" />
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="60" OnPower="0.9" OffPower="0.5" pace="0" Cadence="100" CadenceResting="80" />
        <SteadyState Duration="180" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="6" OnDuration="45" OffDuration="255" OnPower="1.75" OffPower="0.6" pace="0" Cadence="100" CadenceResting="80" />
        <SteadyState Duration="180" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="300" Power="0.95" pace="0" Cadence="95" />
        <SteadyState Duration="300" Power="0.5" pace="0" Cadence="85" />
    </workout>
</workout_file>