<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 4x1min (30min)</name>
    <description>Warmup: 8min from 50% to 75% FTP | Intervals: 4 x (1min @ 110% / 0s @ 55%) | Cooldown: 2min from 50% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" pace="0" Cadence="85" />
        <SteadyState Duration="120" Power="1.0" pace="0" Cadence="90" />
        <SteadyState Duration="120" Power="0.65" pace="0" Cadence="85" />
        <SteadyState Duration="60" Power="1.1" pace="0" Cadence="90" />
        <SteadyState Duration="60" Power="1.3" pace="0" Cadence="100" />
        <SteadyState Duration="120" Power="0.65" pace="0" Cadence="85" />
        <SteadyState Duration="60" Power="1.1" pace="0" Cadence="90" />
        <SteadyState Duration="60" Power="1.3" pace="0" Cadence="100" />
        <SteadyState Duration="120" Power="0.65" pace="0" Cadence="85" />
        <SteadyState Duration="60" Power="1.1" pace="0" Cadence="90" />
        <SteadyState Duration="60" Power="1.3" pace="0" Cadence="100" />
        <SteadyState Duration="120" Power="0.65" pace="0" Cadence="85" />
        <SteadyState Duration="60" Power="1.1" pace="0" Cadence="90" />
        <SteadyState Duration="60" Power="1.3" pace="0" Cadence="100" />
        <SteadyState Duration="120" Power="0.65" pace="0" Cadence="85" />
        <Cooldown Duration="120" PowerLow="0.5" PowerHigh="0.3" pace="0" Cadence="85" />
    </workout>
