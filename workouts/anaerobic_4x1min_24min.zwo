<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 1min/1min 6x (33min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 6 x (1min @ 124% / 1min 24s @ 45%) | Cooldown: 5min ramp from 75% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="30" Power="1.3" pace="0" />
        <SteadyState Duration="60" Power="0.45" pace="0" />
        <SteadyState Duration="30" Power="1.3" pace="0" />
        <SteadyState Duration="60" Power="0.45" pace="0" />
        <SteadyState Duration="30" Power="1.3" pace="0" />
        <SteadyState Duration="60" Power="0.45" pace="0" />
        <SteadyState Duration="60" Power="1.25" pace="0" />
        <SteadyState Duration="60" Power="0.45" pace="0" />
        <SteadyState Duration="60" Power="1.25" pace="0" />
        <SteadyState Duration="60" Power="0.45" pace="0" />
        <SteadyState Duration="60" Power="1.25" pace="0" />
        <SteadyState Duration="60" Power="0.45" pace="0" />
        <SteadyState Duration="60" Power="1.23" pace="0" />
        <SteadyState Duration="120" Power="0.45" pace="0" />
        <SteadyState Duration="60" Power="1.23" pace="0" />
        <SteadyState Duration="120" Power="0.45" pace="0" />
        <SteadyState Duration="60" Power="1.23" pace="0" />
        <Cooldown Duration="330" PowerLow="0.75" PowerHigh="0.4" /></workout>
</workout_file>