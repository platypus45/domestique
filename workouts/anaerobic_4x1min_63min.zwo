<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 4x1min (63min)</name>
    <description>Warmup: 5min from 45% to 75% FTP | Intervals: 4 x (1min @ 90% / 1min @ 65%) | Cooldown: 5min from 75% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.45" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="0.9" OffPower="0.65" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="60" Power="1.15" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="60" Power="1.5" pace="0" />
        <SteadyState Duration="360" Power="0.55" pace="0" />
        <SteadyState Duration="60" Power="1.6" pace="0" />
        <SteadyState Duration="360" Power="0.55" pace="0" />
        <SteadyState Duration="60" Power="1.7" pace="0" />
        <SteadyState Duration="360" Power="0.55" pace="0" />
        <FreeRide Duration="60" FlatRoad="0" />
        <SteadyState Duration="360" Power="0.55" pace="0" />
        <FreeRide Duration="60" FlatRoad="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>