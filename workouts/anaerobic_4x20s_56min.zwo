<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 4x20s (56min)</name>
    <description>Warmup: 8min @ 50% FTP | Intervals: 4 x (20s @ 125% / 5min @ 84%) | Cooldown: 5min from 55% to 80% FTP</description>
