<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 4x20s (59min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 4 x (20s @ 125% / 5min @ 84%) | Cooldown: 5min from 80% to 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="640" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="60" Power="1.25" pace="0" />
        <Ramp Duration="300" PowerLow="0.76" PowerHigh="0.91" pace="0" />
        <SteadyState Duration="20" Power="1.25" pace="0" />
        <SteadyState Duration="120" Power="0.91" pace="0" />
        <SteadyState Duration="20" Power="1.25" pace="0" />
        <Ramp Duration="300" PowerLow="0.91" PowerHigh="0.76" pace="0" />
        <SteadyState Duration="30" Power="1.25" pace="0" />
        <SteadyState Duration="300" Power="0.76" pace="0" />
        <SteadyState Duration="60" Power="1.25" pace="0" />
        <Ramp Duration="300" PowerLow="0.76" PowerHigh="0.91" pace="0" />
        <SteadyState Duration="20" Power="1.25" pace="0" />
        <SteadyState Duration="120" Power="0.91" pace="0" />
        <SteadyState Duration="20" Power="1.25" pace="0" />
        <Ramp Duration="300" PowerLow="0.91" PowerHigh="0.76" pace="0" />
        <SteadyState Duration="30" Power="1.25" pace="0" />
        <SteadyState Duration="300" Power="0.76" pace="0" />
        <SteadyState Duration="60" Power="1.25" pace="0" />
        <SteadyState Duration="240" Power="0.76" pace="0" />
        <Cooldown Duration="300" PowerLow="0.8" PowerHigh="0.55" pace="0" />
    </workout>
</workout_file>