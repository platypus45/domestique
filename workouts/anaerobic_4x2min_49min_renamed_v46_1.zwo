<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 4x2min (52min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 4 x (2min @ 136% / 0s @ 55%) | Cooldown: 5min from 45% to 75% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="640" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="20" Power="1.17" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Ramp Duration="120" PowerLow="1.29" PowerHigh="1.12" pace="0" />
        <SteadyState Duration="20" Power="1.17" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Ramp Duration="120" PowerLow="1.29" PowerHigh="1.12" pace="0" />
        <SteadyState Duration="20" Power="1.17" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Ramp Duration="120" PowerLow="1.29" PowerHigh="1.12" pace="0" />
        <SteadyState Duration="20" Power="1.17" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="1.29" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="1.23" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="1.18" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="1.13" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.45" PowerHigh="0.75" pace="0" />
    </workout>
</workout_file>