<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 4x3min (67min)</name>
    <description>Warmup: 15min from 45% to 65% FTP | Steady: 5min @ 52% FTP | Steady: 3min @ 98% FTP | Steady: 3min @ 105% FTP | Steady: 3min @ 98% FTP | Steady: 2min @ 120% FTP | Steady: 5min @ 52% FTP | Steady: 3min @ 98% FTP | Steady: 3min @ 105% FTP | Steady: 3min @ 98% FTP | Steady: 2min @ 120% FTP | Steady: 10min @ 52% FTP | Cooldown: 10min from 52% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.45" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.52" pace="0" />
        <SteadyState Duration="180" Power="0.98" pace="0" />
