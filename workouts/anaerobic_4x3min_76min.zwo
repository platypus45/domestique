<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 4x3min (76min)</name>
    <description>Warmup: 15min from 45% to 65% FTP | Intervals: 4 x (3min @ 98% / 0s @ 55%) | Cooldown: 10min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.45" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.52" pace="0" />
        <SteadyState Duration="180" Power="0.98" pace="0" />
        <SteadyState Duration="180" Power="1.05" pace="0" />
        <SteadyState Duration="180" Power="0.98" pace="0" />
        <SteadyState Duration="120" Power="1.3" pace="0" />
        <SteadyState Duration="120" Power="1.6" pace="0" />
        <SteadyState Duration="600" Power="0.52" pace="0" />
        <SteadyState Duration="180" Power="0.98" pace="0" />
        <SteadyState Duration="180" Power="1.05" pace="0" />
        <SteadyState Duration="180" Power="0.98" pace="0" />
        <SteadyState Duration="120" Power="1.3" pace="0" />
        <SteadyState Duration="120" Power="1.6" pace="0" />
        <SteadyState Duration="600" Power="0.52" pace="0" />
        <Cooldown Duration="600" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>