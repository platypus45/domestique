<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 4x45s (47min)</name>
    <description>Warmup: 8min from 40% to 80% FTP | Intervals: 4 x (45s @ 130% / 45s @ 55%) | Cooldown: 5min ramp from 75% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.4" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.3" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="45" OffDuration="45" OnPower="1.3" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="60" OffDuration="60" OnPower="1.3" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="45" OffDuration="45" OnPower="1.3" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.3" OffPower="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <SteadyState Duration="420" Power="0.9" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.3" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="45" OffDuration="45" OnPower="1.3" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="60" OffDuration="60" OnPower="1.3" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="45" OffDuration="45" OnPower="1.3" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.3" OffPower="0.55" pace="0" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.4" /></workout>
</workout_file>