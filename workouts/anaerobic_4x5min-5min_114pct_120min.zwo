<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 4x5min (120min)</name>
    <description>Warmup: 20min from 25% to 75% FTP | Intervals: 4 x (5min @ 114% / 5min @ 50%) | Cooldown: 15min from 60% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="1200" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="900" Power="0.65" pace="0" />
        <IntervalsT Repeat="4" OnDuration="300" OffDuration="300" OnPower="1.14" OffPower="0.5" pace="0" />
        <SteadyState Duration="1800" Power="0.65" pace="0" />
        <Cooldown Duration="900" PowerLow="0.60" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>