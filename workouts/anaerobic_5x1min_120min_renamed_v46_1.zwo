<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 5x1min (120min)</name>
    <description>Intervals: 5 x (1min @ 120% / 2min @ 55%) | Cooldown: 5min from 50% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="120" Power="0.4" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.6" pace="0" />
        <SteadyState Duration="120" Power="0.7" pace="0" />
        <SteadyState Duration="120" Power="0.8" pace="0" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="30" OnPower="1.2" OffPower="0.55" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="600" Power="1.0" pace="0" />
        <SteadyState Duration="900" Power="0.65" pace="0" />
        <IntervalsT Repeat="6" OnDuration="180" OffDuration="20" OnPower="0.75" OffPower="1.2" pace="0" />
        <SteadyState Duration="900" Power="0.65" pace="0" />
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="120" OnPower="1.2" OffPower="0.55" pace="0" />
        <SteadyState Duration="900" Power="0.65" pace="0" />
        <SteadyState Duration="600" Power="1.0" pace="0" />
        <Cooldown Duration="300" PowerLow="0.5" PowerHigh="0.3" pace="0" />
    </workout>
</workout_file>