<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 5x2min (62min)</name>
    <description>Warmup: 9min from 45% to 65% FTP | Intervals: 5 x (2min @ 120% / 2min @ 50%) | Cooldown: 6min from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="540" PowerLow="0.45" PowerHigh="0.65" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="0.85" OffPower="0.55" pace="0" />
        <SteadyState Duration="40" Power="0.9" pace="0" />
        <SteadyState Duration="40" Power="1.05" pace="0" />
        <SteadyState Duration="40" Power="1.2" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="40" Power="0.9" pace="0" />
        <SteadyState Duration="40" Power="1.05" pace="0" />
        <SteadyState Duration="40" Power="1.2" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="40" Power="0.9" pace="0" />
        <SteadyState Duration="40" Power="1.05" pace="0" />
        <SteadyState Duration="40" Power="1.2" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="120" Power="1.2" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="120" OffDuration="120" OnPower="1.2" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Cooldown Duration="360" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>