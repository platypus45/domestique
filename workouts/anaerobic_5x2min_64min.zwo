<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 5x2min (69min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 5 x (2min @ 92% / 40s @ 130%) | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="640" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="60" Power="1.1" pace="0" />
        <SteadyState Duration="60" Power="0.6" pace="0" />
        <SteadyState Duration="300" Power="0.8" pace="0" />
        <SteadyState Duration="60" Power="0.65" pace="0" />
        <IntervalsT Repeat="5" OnDuration="30" OffDuration="30" OnPower="0.75" OffPower="0.9" pace="0" />
        <SteadyState Duration="120" Power="0.65" pace="0" />
        <IntervalsT Repeat="5" OnDuration="90" OffDuration="30" OnPower="0.92" OffPower="1.3" pace="0" />
        <SteadyState Duration="120" Power="0.65" pace="0" />
        <IntervalsT Repeat="5" OnDuration="120" OffDuration="40" OnPower="0.92" OffPower="1.3" pace="0" />
        <SteadyState Duration="120" Power="0.65" pace="0" />
        <Ramp Duration="600" PowerLow="0.92" PowerHigh="1.02" pace="0" />
        <SteadyState Duration="60" Power="1.25" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
    </workout>
</workout_file>