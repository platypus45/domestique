<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 5x2min (67min)</name>
    <description>Warmup: 10min ramp from 50% to 70% FTP | Intervals: 5 x (2min 30s @ 90% / 30s @ 125%) | Cooldown: 8min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.7" /><IntervalsT Repeat="5" OnDuration="150" OffDuration="30" OnPower="0.7" OffPower="1.25" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="150" OffDuration="30" OnPower="0.8" OffPower="1.25" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="150" OffDuration="30" OnPower="0.9" OffPower="1.25" pace="0" />
        <Cooldown Duration="480" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>