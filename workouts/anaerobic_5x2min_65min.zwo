<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 5x2min (65min)</name>
    <description>Warmup: 6min from 50% to 75% FTP | Intervals: 5 x (2min 30s @ 90% / 30s @ 125%) | Cooldown: 8min from 65% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="360" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="150" OffDuration="30" OnPower="0.7" OffPower="1.25" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="150" OffDuration="30" OnPower="0.8" OffPower="1.25" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="150" OffDuration="30" OnPower="0.9" OffPower="1.25" pace="0" />
        <Cooldown Duration="480" PowerLow="0.65" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>