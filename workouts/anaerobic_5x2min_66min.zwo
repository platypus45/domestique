<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 5x2min (66min)</name>
    <description>Warmup: 20min from 56% to 74% FTP | Intervals: 5 x (2min 30s @ 123% / 2min 30s @ 55%)</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="1200" PowerLow="0.56" PowerHigh="0.74" pace="0" />
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="120" OnPower="0.92" OffPower="0.68" pace="0" />
        <IntervalsT Repeat="5" OnDuration="150" OffDuration="150" OnPower="1.23" OffPower="0.55" pace="0" />
        <Ramp Duration="600" PowerLow="0.74" PowerHigh="0.56" pace="0" />
        <FreeRide Duration="300" FlatRoad="0" />
    </workout>
</workout_file>