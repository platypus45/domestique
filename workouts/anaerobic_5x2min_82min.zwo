<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 2x2min (59min)</name>
    <description>Warmup: 15min from 25% to 69% FTP | Intervals: 2 x (1min 30s @ 150% / 3min @ 50%) | Cooldown: 15min from 60% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.25" PowerHigh="0.69" pace="0" />
        <SteadyState Duration="300" Power="0.72" pace="0" />
        <IntervalsT Repeat="2" OnDuration="90" OffDuration="180" OnPower="1.5" OffPower="0.5" pace="0" />
        <SteadyState Duration="900" Power="0.75" pace="0" />
        <Cooldown Duration="900" PowerLow="0.60" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>