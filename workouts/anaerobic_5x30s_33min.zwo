<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 5x30s (33min)</name>
    <description>Warmup: 6min from 40% to 75% FTP | Intervals: 5 x (30s @ 180% / 0s @ 55%) | Cooldown: 8min from 40% to 65% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="360" PowerLow="0.4" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="30" Power="1.2" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="15" Power="1.2" pace="0" />
        <SteadyState Duration="30" Power="1.2" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="15" Power="1.2" pace="0" />
        <SteadyState Duration="30" Power="1.2" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="15" Power="1.2" pace="0" />
        <SteadyState Duration="30" Power="1.2" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="15" Power="1.2" pace="0" />
        <SteadyState Duration="30" Power="1.2" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="15" Power="1.2" pace="0" />
        <Cooldown Duration="480" PowerLow="0.65" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>