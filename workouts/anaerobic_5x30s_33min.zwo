<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 4x45s (37min)</name>
    <description>Warmup: 10min from 50% to 75% FTP | Intervals: 4 x (45s @ 120% / 3min @ 55%) | Cooldown: 8min from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="615" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="30" Power="1.2" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="45" Power="1.2" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="45" Power="1.2" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="45" Power="1.2" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="45" Power="1.2" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="15" Power="1.2" pace="0" />
        <Cooldown Duration="480" PowerLow="0.60" PowerHigh="0.40" pace="0" />
    </workout>
</workout_file>