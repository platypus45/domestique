<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 5x30s (60min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Intervals: 5 x (30s @ 130% / 30s @ 70%) | Cooldown: 7min from 50% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="30" Power="0.8" pace="0" Cadence="95" />
        <SteadyState Duration="60" Power="0.65" pace="0" Cadence="85" />
        <SteadyState Duration="30" Power="0.9" pace="0" Cadence="105" />
        <SteadyState Duration="60" Power="0.65" pace="0" Cadence="85" />
        <SteadyState Duration="30" Power="1.05" pace="0" Cadence="115" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="300" Power="0.95" pace="0" Cadence="95" />
        <Ramp Duration="30" PowerLow="1.0" PowerHigh="1.5" pace="0" />
        <SteadyState Duration="150" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="300" Power="0.95" pace="0" Cadence="95" />
        <Ramp Duration="30" PowerLow="1.0" PowerHigh="1.5" pace="0" />
        <SteadyState Duration="150" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="300" Power="0.95" pace="0" Cadence="95" />
        <Ramp Duration="30" PowerLow="1.0" PowerHigh="1.5" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="5" OnDuration="30" OffDuration="30" OnPower="1.3" OffPower="0.7" pace="0" Cadence="100" CadenceResting="90" />
        <SteadyState Duration="180" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="5" OnDuration="30" OffDuration="30" OnPower="1.4" OffPower="0.6" pace="0" Cadence="100" CadenceResting="90" />
        <Cooldown Duration="420" PowerLow="0.5" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>