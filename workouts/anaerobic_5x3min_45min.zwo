<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 5x3min (45min)</name>
    <description>Warmup: 6min @ 50% FTP | Intervals: 5 x (3min @ 120% / 3min @ 40%) | Cooldown: 3min from 25% to 75% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <Ramp Duration="60" PowerLow="0.5" PowerHigh="0.72" pace="0" />
        <SteadyState Duration="300" Power="0.72" pace="0" />
        <Ramp Duration="60" PowerLow="0.72" PowerHigh="0.96" pace="0" />
        <SteadyState Duration="120" Power="0.96" pace="0" />
        <SteadyState Duration="180" Power="1.2" pace="0" />
        <SteadyState Duration="180" Power="0.4" pace="0" />
        <SteadyState Duration="180" Power="1.2" pace="0" />
        <SteadyState Duration="180" Power="0.4" pace="0" />
        <SteadyState Duration="180" Power="1.2" pace="0" />
        <SteadyState Duration="180" Power="0.4" pace="0" />
        <SteadyState Duration="180" Power="1.2" pace="0" />
        <SteadyState Duration="180" Power="0.4" pace="0" />
        <SteadyState Duration="180" Power="1.2" pace="0" />
        <Cooldown Duration="180" PowerLow="0.25" PowerHigh="0.75" pace="0" />
    </workout>
</workout_file>