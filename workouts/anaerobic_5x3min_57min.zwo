<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 5x3min (57min)</name>
    <description>Warmup: 6min @ 50% FTP | Intervals: 5 x (3min @ 120% / 5min @ 40%) | Cooldown: 5min @ 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <Ramp Duration="60" PowerLow="0.5" PowerHigh="0.72" pace="0" />
        <SteadyState Duration="300" Power="0.72" pace="0" />
        <Ramp Duration="60" PowerLow="0.72" PowerHigh="0.96" pace="0" />
        <SteadyState Duration="120" Power="0.96" pace="0" />
        <FreeRide Duration="120" FlatRoad="0" />
        <IntervalsT Repeat="5" OnDuration="180" OffDuration="300" OnPower="1.2" OffPower="0.4" pace="0" />
    </workout>
</workout_file>