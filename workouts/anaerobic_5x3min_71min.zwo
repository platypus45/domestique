<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 5x3min (71min)</name>
    <description>Warmup: 20min from 56% to 74% FTP | Intervals: 5 x (3min @ 123% / 3min @ 55%)</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="1200" PowerLow="0.56" PowerHigh="0.74" pace="0" />
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="120" OnPower="0.92" OffPower="0.67" pace="0" />
        <IntervalsT Repeat="5" OnDuration="180" OffDuration="180" OnPower="1.23" OffPower="0.55" pace="0" />
        <Ramp Duration="600" PowerLow="0.7" PowerHigh="0.55" pace="0" />
        <FreeRide Duration="300" FlatRoad="0" />
    </workout>
</workout_file>