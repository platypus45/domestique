<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 5x4min (56min)</name>
    <description>Warmup: 6min @ 50% FTP | Intervals: 5 x (4min @ 120% / 4min @ 40%) | Cooldown: 3min from 50% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <Ramp Duration="60" PowerLow="0.5" PowerHigh="0.72" pace="0" />
        <SteadyState Duration="300" Power="0.72" pace="0" />
        <Ramp Duration="60" PowerLow="0.72" PowerHigh="0.96" pace="0" />
        <SteadyState Duration="120" Power="0.96" pace="0" />
        <FreeRide Duration="120" FlatRoad="0" />
        <SteadyState Duration="240" Power="1.2" pace="0" />
        <SteadyState Duration="240" Power="0.4" pace="0" />
        <SteadyState Duration="240" Power="1.2" pace="0" />
        <SteadyState Duration="240" Power="0.4" pace="0" />
        <SteadyState Duration="240" Power="1.2" pace="0" />
        <SteadyState Duration="240" Power="0.4" pace="0" />
        <SteadyState Duration="240" Power="1.2" pace="0" />
        <SteadyState Duration="240" Power="0.4" pace="0" />
        <SteadyState Duration="240" Power="1.2" pace="0" />
        <Cooldown Duration="180" PowerLow="0.5" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>