<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 30s/0s 6x (51min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 6 x (30s @ 118% / 0s @ 55%) | Cooldown: 6min from 50% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="30" Power="1.18" pace="0" />
        <Ramp Duration="120" PowerLow="1.12" PowerHigh="1.3" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
