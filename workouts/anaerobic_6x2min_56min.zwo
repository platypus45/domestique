<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 6x2min (56min)</name>
    <description>Warmup: 8min from 50% to 65% FTP | Intervals: 6 x (2min @ 120% / 2min @ 50%) | Cooldown: 3min from 65% to 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.65" pace="0" />
        <IntervalsT Repeat="3" OnDuration="10" OffDuration="180" OnPower="1.25" OffPower="0.55" pace="0" />
        <SteadyState Duration="240" Power="0.85" pace="0" />
        <SteadyState Duration="180" Power="1.0" pace="0" />
        <SteadyState Duration="60" Power="1.15" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="120" OnPower="1.2" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="120" OnPower="1.2" OffPower="0.5" pace="0" />
        <Cooldown Duration="180" PowerLow="0.65" PowerHigh="0.55" pace="0" />
    </workout>
</workout_file>