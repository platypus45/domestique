<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 6x5min (80min)</name>
    <description>Intervals: 6 x (5min @ 120% / 5min @ 65%)</description>
    <sportType>bike</sportType>
    <workout>
        <FreeRide Duration="300" FlatRoad="0" />
        <SteadyState Duration="300" Power="0.65" />
        <SteadyState Duration="300" Power="0.80" />
        <SteadyState Duration="300" Power="0.95" />
        <FreeRide Duration="300" FlatRoad="0" />
        <SteadyState Duration="300" Power="1.20" />
        <FreeRide Duration="300" FlatRoad="0" />
        <SteadyState Duration="300" Power="1.20" />
        <FreeRide Duration="300" FlatRoad="0" />
        <SteadyState Duration="300" Power="1.20" />
        <FreeRide Duration="300" FlatRoad="0" />
        <SteadyState Duration="300" Power="1.20" />
        <FreeRide Duration="300" FlatRoad="0" />
        <SteadyState Duration="300" Power="1.20" />
        <FreeRide Duration="300" FlatRoad="0" />
        <SteadyState Duration="300" Power="1.20" />
    </workout>
</workout_file>