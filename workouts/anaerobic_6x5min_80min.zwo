        <FreeRide Duration="300" FlatRoad="0" />
        <SteadyState Duration="300" Power="1.12" />
        <FreeRide Duration="300" FlatRoad="0" />
        <SteadyState Duration="300" Power="1.12" />
        <FreeRide Duration="300" FlatRoad="0" />
        <SteadyState Duration="300" Power="1.12" />
