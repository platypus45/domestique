<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 3x30s (124min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 3 x (30s @ 100% / 3min @ 65%) | Cooldown: 5min from 50% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="30" Power="1.0" pace="0" Cadence="105" />
        <Ramp Duration="60" PowerLow="1.0" PowerHigh="0.65" pace="0" Cadence="105" />
        <SteadyState Duration="210" Power="0.65" pace="0" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="180" OnPower="1.0" OffPower="0.65" pace="0" Cadence="105" CadenceResting="90" />
