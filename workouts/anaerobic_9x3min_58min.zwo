<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 9x3min (63min)</name>
    <description>Warmup: 10min from 50% to 90% FTP | Intervals: 9 x (3min @ 111% / 1min 45s @ 50%)</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="30" Power="1.05" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.08" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.11" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="180" OnPower="0.5" OffPower="1.11" pace="0" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="180" OnPower="0.5" OffPower="1.11" pace="0" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="180" OnPower="0.5" OffPower="1.11" pace="0" />
    <Cooldown Duration="330" PowerLow="0.55" PowerHigh="0.4" /></workout>
</workout_file>