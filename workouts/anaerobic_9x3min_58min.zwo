<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 9x3min (58min)</name>
    <description>Warmup: 10min from 50% to 90% FTP | Intervals: 9 x (3min @ 120% / 1min 45s @ 50%)</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="30" Power="1.1" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.15" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.2" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="180" OnPower="0.5" OffPower="1.2" pace="0" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="180" OnPower="0.5" OffPower="1.2" pace="0" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="180" OnPower="0.5" OffPower="1.2" pace="0" />
    </workout>
</workout_file>