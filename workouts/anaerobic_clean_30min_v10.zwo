<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 30s/2min 8x (30min)</name>
    <description>Warmup: 5min from 50% to 75% FTP | Microintervals: 8 x (30s @ 140% / 2min @ 50%) | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="8" OnDuration="30" OffDuration="120" OnPower="1.4" OffPower="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>