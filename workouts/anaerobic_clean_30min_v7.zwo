<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 30s/2min 6x (31min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 6 x (30s @ 150% / 2min @ 50%) | Cooldown: 6min from 50% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="6" OnDuration="30" OffDuration="120" OnPower="1.5" OffPower="0.5" pace="0" />
        <Cooldown Duration="360" PowerLow="0.50" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>