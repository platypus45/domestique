<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 45s/3min 6x (35min)</name>
    <description>Warmup: 7min 30s from 50% to 75% FTP | Microintervals: 6 x (45s @ 140% / 3min @ 50%) | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="450" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="6" OnDuration="45" OffDuration="180" OnPower="1.4" OffPower="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>