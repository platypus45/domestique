<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 1min/3min 6x (35min)</name>
    <description>Warmup: 6min from 50% to 75% FTP | Microintervals: 6 x (1min @ 130% / 3min @ 50%) | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="360" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="6" OnDuration="60" OffDuration="180" OnPower="1.3" OffPower="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>