<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 30s/4min 6x (42min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 6 x (30s @ 150% / 4min @ 45%) | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="6" OnDuration="30" OffDuration="240" OnPower="1.5" OffPower="0.45" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>