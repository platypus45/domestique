<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 30s/4min 6x (45min)</name>
    <description>Warmup: 11min from 50% to 75% FTP | Microintervals: 6 x (30s @ 150% / 4min @ 45%) | Cooldown: 7min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="660" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="6" OnDuration="30" OffDuration="240" OnPower="1.5" OffPower="0.45" pace="0" />
        <Cooldown Duration="420" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>