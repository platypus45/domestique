<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic (60min)</name>
    <description>Warmup: 20min from 25% to 75% FTP | Steady: 5min @ 50% FTP | Steady: 5min @ 125% FTP | Steady: 25min @ 65% FTP | Cooldown: 5min from 65% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="1200" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="1.25" pace="0" />
        <SteadyState Duration="1500" Power="0.65" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>