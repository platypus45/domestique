<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 4 cycles (46min)</name>
    <description>Warmup: 8min from 30% to 75% FTP | Over-Under: 4 cycles (alternating above/below threshold) | Cooldown: 6min from 25% to 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.3" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="10" Power="1.2" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <SteadyState Duration="10" Power="1.2" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <SteadyState Duration="10" Power="1.2" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Ramp Duration="180" PowerLow="0.7" PowerHigh="1.05" pace="0" />
        <SteadyState Duration="60" Power="1.7" pace="0" />
        <SteadyState Duration="180" Power="0.4" pace="0" />
        <Ramp Duration="180" PowerLow="0.7" PowerHigh="1.05" pace="0" />
        <SteadyState Duration="60" Power="1.7" pace="0" />
        <SteadyState Duration="180" Power="0.4" pace="0" />
        <Ramp Duration="180" PowerLow="0.7" PowerHigh="1.05" pace="0" />
        <SteadyState Duration="60" Power="1.7" pace="0" />
        <SteadyState Duration="180" Power="0.4" pace="0" />
        <Ramp Duration="180" PowerLow="0.7" PowerHigh="1.05" pace="0" />
        <SteadyState Duration="60" Power="1.7" pace="0" />
        <SteadyState Duration="180" Power="0.4" pace="0" />
        <Cooldown Duration="360" PowerLow="0.25" PowerHigh="0.55" pace="0" />
    </workout>
</workout_file>