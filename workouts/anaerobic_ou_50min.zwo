<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 4 cycles (55min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Over-Under: 4 cycles (alternating above/below threshold) | Cooldown: 5min 30s from 65% to 26% FTP</description>
