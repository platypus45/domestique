<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 4 cycles (62min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Over-Under: 4 cycles (alternating above/below threshold) | Cooldown: 8min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="90" Power="0.9" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <SteadyState Duration="90" Power="0.91" pace="0" />
        <SteadyState Duration="60" Power="0.81" pace="0" />
        <SteadyState Duration="60" Power="0.65" pace="0" />
        <SteadyState Duration="150" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="0.65" pace="0" />
        <SteadyState Duration="60" Power="0.81" pace="0" />
        <SteadyState Duration="90" Power="1.0" pace="0" />
        <SteadyState Duration="60" Power="1.3" pace="0" />
