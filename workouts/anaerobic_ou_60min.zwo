        <SteadyState Duration="60" Power="1.1" pace="0" />
        <SteadyState Duration="90" Power="0.91" pace="0" />
        <Cooldown Duration="480" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
