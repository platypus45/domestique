<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 30s/0s 10x (39min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 10 x (30s @ 125% / 0s @ 55%) | Cooldown: 5min ramp from 60% to 40% FTP</description>
    <sportType>bike</sportType>
