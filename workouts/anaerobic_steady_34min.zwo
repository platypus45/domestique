<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max (34min)</name>
    <description>Steady: 3min @ 50% FTP | Steady: 6min @ 65% FTP | Steady: 2min @ 50% FTP | Steady: 2min @ 55% FTP | Steady: 1min @ 130% FTP | Steady: 2min @ 55% FTP | Steady: 2min @ 120% FTP | Steady: 3min @ 55% FTP | Steady: 1min @ 130% FTP | Steady: 7min @ 55% FTP | Cooldown: 5min from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <Ramp Duration="360" PowerLow="0.5" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="60" Power="1.3" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="120" Power="1.2" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="60" Power="1.3" pace="0" />
        <SteadyState Duration="240" Power="0.55" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>