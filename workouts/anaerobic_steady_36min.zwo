<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 3 cycles (37min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Over-Under: 3 cycles (alternating above/below threshold) | Cooldown: 6min from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="40" Power="0.9" pace="0" />
        <SteadyState Duration="40" Power="1.05" pace="0" />
        <SteadyState Duration="40" Power="1.2" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="40" Power="0.9" pace="0" />
        <SteadyState Duration="40" Power="1.05" pace="0" />
        <SteadyState Duration="40" Power="1.2" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="40" Power="0.9" pace="0" />
        <SteadyState Duration="40" Power="1.05" pace="0" />
        <SteadyState Duration="40" Power="1.2" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="120" Power="1.2" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Cooldown Duration="360" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>