<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (37min)</name>
    <description>Warmup: 5min from 45% to 75% FTP | Steady: 3min @ 50% FTP | Steady: 30s @ 125% FTP | Steady: 10min @ 65% FTP | Steady: 3min @ 62% FTP | Steady: 30s @ 125% FTP | Steady: 10min @ 83% FTP | Cooldown: 5min from 45% to 75% FTP</description>
