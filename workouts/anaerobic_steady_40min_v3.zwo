<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max (40min)</name>
    <description>Warmup: 10min from 40% to 75% FTP | Steady: 3min @ 55% FTP | Steady: 2min @ 115% FTP | Steady: 12min @ 50% FTP | Steady: 30s @ 150% FTP | Cooldown: 12min from 65% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="120" Power="1.15" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.5" pace="0" />
        <Cooldown Duration="720" PowerLow="0.65" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>