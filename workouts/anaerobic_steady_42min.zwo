<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (42min)</name>
    <description>Warmup: 6min from 50% to 65% FTP | Steady: 4min @ 72% FTP | Steady: 3min @ 88% FTP | Steady: 4min @ 52% FTP | Steady: 10s @ 135% FTP | Steady: 5min @ 53% FTP | Steady: 10min @ 62% FTP | Cooldown: 10min from 65% to 75% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="360" PowerLow="0.5" PowerHigh="0.65" pace="0" />
        <Ramp Duration="240" PowerLow="0.7" PowerHigh="0.75" pace="0" />
        <Ramp Duration="180" PowerLow="0.85" PowerHigh="0.9" pace="0" />
        <Ramp Duration="240" PowerLow="0.5" PowerHigh="0.55" pace="0" />
        <SteadyState Duration="10" Power="1.35" pace="0" />
        <SteadyState Duration="300" Power="0.53" pace="0" />
        <SteadyState Duration="600" Power="0.62" pace="0" />
        <Cooldown Duration="600" PowerLow="0.65" PowerHigh="0.75" pace="0" />
    </workout>
</workout_file>