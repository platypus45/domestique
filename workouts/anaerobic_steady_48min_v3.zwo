<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 30s/0s 6x (48min)</name>
    <description>Warmup: 5min from 45% to 75% FTP | Microintervals: 6 x (30s @ 130% / 0s @ 55%) | Cooldown: 6min from 25% to 75% FTP</description>
