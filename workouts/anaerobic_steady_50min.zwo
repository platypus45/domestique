<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 3 cycles (50min)</name>
    <description>Warmup: 5min from 65% to 75% FTP | Over-Under: 3 cycles (alternating above/below threshold) | Cooldown: 5min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.65" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="300" Power="0.75" pace="0" />
        <SteadyState Duration="180" Power="0.85" pace="0" />
        <SteadyState Duration="180" Power="0.9" pace="0" />
        <Ramp Duration="240" PowerLow="0.9" PowerHigh="0.6" pace="0" />
        <SteadyState Duration="300" Power="0.6" pace="0" />
        <Ramp Duration="300" PowerLow="0.6" PowerHigh="0.95" pace="0" />
        <SteadyState Duration="60" Power="1.25" pace="0" />
        <SteadyState Duration="120" Power="1.15" pace="0" />
        <SteadyState Duration="180" Power="1.05" pace="0" />
        <SteadyState Duration="240" Power="0.95" pace="0" />
        <SteadyState Duration="300" Power="0.85" pace="0" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>