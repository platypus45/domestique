<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 3x20s (56min)</name>
    <description>Warmup: 8min from 45% to 65% FTP | Intervals: 3 x (20s @ 100% / 0s @ 55%) | Cooldown: 5min from 45% to 55% FTP</description>
