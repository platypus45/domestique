<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 3x2min (77min)</name>
    <description>Intervals: 3 x (2min @ 120% / 0s @ 55%)</description>
    <sportType>bike</sportType>
    <workout>
        <FreeRide Duration="300" FlatRoad="1" />
        <SteadyState Duration="300" Power="0.65" />
        <SteadyState Duration="180" Power="0.80" />
        <SteadyState Duration="120" Power="0.95" />
        <FreeRide Duration="300" FlatRoad="1" />
        <SteadyState Duration="60" Power="1.20" />
        <FreeRide Duration="120" FlatRoad="1" />
        <SteadyState Duration="60" Power="1.20" />
        <FreeRide Duration="120" FlatRoad="1" />
        <SteadyState Duration="120" Power="1.20" />
        <SteadyState Duration="480" Power="1.00" />
        <FreeRide Duration="480" FlatRoad="1" />
        <SteadyState Duration="120" Power="1.20" />
        <SteadyState Duration="480" Power="1.00" />
        <FreeRide Duration="480" FlatRoad="1" />
        <SteadyState Duration="120" Power="1.20" />
        <SteadyState Duration="480" Power="1.00" />
    <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.40" /></workout>
</workout_file>