<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance 10s/6min20 8x (84min)</name>
    <description>Warmup: 12min from 55% to 72% FTP | Aerobic primer: 8min from 72% to 88% FTP, then 4min @ 90% FTP | Sprints: 8 x (10s @ 185% / 6min20 @ 68% FTP) | Cooldown: 8min from 68% to 42% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="720" PowerLow="0.55" PowerHigh="0.72" pace="0" />
        <Ramp Duration="480" PowerLow="0.72" PowerHigh="0.88" pace="0" />
        <SteadyState Duration="240" Power="0.9" pace="0" />
        <IntervalsT Repeat="8" OnDuration="10" OffDuration="380" OnPower="1.85" OffPower="0.68" pace="0" />
        <Cooldown Duration="480" PowerLow="0.68" PowerHigh="0.42" pace="0" />
    </workout>
</workout_file>
