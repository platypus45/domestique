<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance 17x15s (119min)</name>
    <description>Warmup: 10min from 25% to 65% FTP | Intervals: 17 x (15s @ 95% / 5min @ 65%) | Cooldown: 15min from 65% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <IntervalsT Repeat="17" OnDuration="15" OffDuration="300" OnPower="0.95" OffPower="0.65" pace="0" />
        <Cooldown Duration="900" PowerLow="0.65" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>