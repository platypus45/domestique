<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (60min)</name>
    <description>Warmup: 5min from 30% to 50% FTP | Steady: 10min @ 65% FTP | Steady: 10min @ 67% FTP | Steady: 10min @ 70% FTP | Steady: 10min @ 73% FTP | Steady: 10min @ 75% FTP | Cooldown: 5min from 50% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.3" PowerHigh="0.5" pace="0" />
        <SteadyState Duration="600" Power="0.65" pace="0" />
        <SteadyState Duration="600" Power="0.67" pace="0" />
        <SteadyState Duration="600" Power="0.7" pace="0" />
        <SteadyState Duration="600" Power="0.73" pace="0" />
        <SteadyState Duration="600" Power="0.75" pace="0" />
        <Cooldown Duration="300" PowerLow="0.5" PowerHigh="0.3" pace="0" />
    </workout>
</workout_file>