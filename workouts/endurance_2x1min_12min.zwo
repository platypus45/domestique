<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery (13min)</name>
    <description>Warmup: 1min from 40% to 60% FTP | Steady: 20s @ 110% FTP | Steady: 1min @ 65% FTP | Steady: 20s @ 110% FTP | Steady: 2min @ 77% FTP | Steady: 1min @ 50% FTP | Steady: 50s @ 95% FTP | Steady: 1min @ 105% FTP | Steady: 30s @ 50% FTP | Steady: 30s @ 110% FTP | Steady: 30s @ 50% FTP | Steady: 20s @ 120% FTP | Steady: 30s @ 50% FTP | Steady: 20s @ 120% FTP | Cooldown: 3min from 65% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="60" PowerLow="0.4" PowerHigh="0.6" pace="0" />
        <SteadyState Duration="20" Power="1.1" pace="0" />
        <Ramp Duration="60" PowerLow="0.6" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="20" Power="1.1" pace="0" />
        <Ramp Duration="120" PowerLow="0.7" PowerHigh="0.85" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="50" Power="0.95" pace="0" />
        <SteadyState Duration="60" Power="1.05" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.1" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <SteadyState Duration="20" Power="1.2" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <SteadyState Duration="20" Power="1.2" pace="0" />
        <Cooldown Duration="180" PowerLow="0.65" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>