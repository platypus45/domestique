<workout_file>
    <author>Domestique Library</author>
    <name>Endurance 3 cycles (22min)</name>
    <description>Warmup: 4min ramp from 50% to 70% FTP | Over-Under: 3 cycles (alternating above/below threshold) | Cooldown: 2min ramp from 65% to 40% FTP</description>
