<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (20min)</name>
    <description>Warmup: 4min from 40% to 60% FTP | Steady: 30s @ 109% FTP | Steady: 4min @ 70% FTP | Steady: 30s @ 109% FTP | Steady: 1min @ 65% FTP | Steady: 45s @ 105% FTP | Steady: 30s @ 115% FTP | Steady: 20s @ 125% FTP | Cooldown: 8min from 75% to 40% FTP</description>
