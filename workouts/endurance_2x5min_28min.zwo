<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (28min)</name>
    <description>Warmup: 6min from 35% to 70% FTP | Steady: 2min @ 50% FTP | Steady: 15min @ 60% FTP | Cooldown: 5min from 60% to 35% FTP</description>
