<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (30min)</name>
    <description>Warmup: 5min from 50% to 65% FTP | Steady: 4min 24s @ 62% FTP | Steady: 4min 24s @ 67% FTP | Steady: 4min 24s @ 72% FTP | Steady: 4min 24s @ 75% FTP | Steady: 4min 24s @ 67% FTP | Cooldown: 3min from 65% to 50% FTP</description>
