<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 30s/30s 7x (60min)</name>
    <description>Warmup: 3min from 30% to 50% FTP | Microintervals: 7 x (30s @ 120% / 30s @ 70%) | Cooldown: 5min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="180" PowerLow="0.3" PowerHigh="0.5" pace="0" />
        <SteadyState Duration="20" Power="1.1" pace="0" />
        <Ramp Duration="180" PowerLow="0.5" PowerHigh="0.6" pace="0" />
        <SteadyState Duration="20" Power="1.1" pace="0" />
        <Ramp Duration="180" PowerLow="0.6" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="20" Power="1.1" pace="0" />
        <SteadyState Duration="300" Power="0.85" pace="0" />
        <Ramp Duration="900" PowerLow="0.5" PowerHigh="1.0" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <Ramp Duration="900" PowerLow="1.0" PowerHigh="0.5" pace="0" />
        <IntervalsT Repeat="7" OnDuration="30" OffDuration="30" OnPower="1.2" OffPower="0.7" pace="0" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>