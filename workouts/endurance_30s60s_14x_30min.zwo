<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance 30s/1min 14x (30min)</name>
    <description>Warmup: 5min from 25% to 75% FTP | Microintervals: 14 x (30s @ 120% / 1min @ 65%) | Cooldown: 2min from 50% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.25" PowerHigh="0.75" pace="0" Cadence="85" />
        <IntervalsT Repeat="7" OnDuration="30" OffDuration="60" OnPower="1.2" OffPower="0.65" pace="0" Cadence="110" CadenceResting="85" />
        <SteadyState Duration="120" Power="0.4" pace="0" Cadence="85" />
        <IntervalsT Repeat="7" OnDuration="30" OffDuration="60" OnPower="1.2" OffPower="0.65" pace="0" Cadence="110" CadenceResting="85" />
        <Cooldown Duration="120" PowerLow="0.5" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>