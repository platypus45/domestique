<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance 3x30s (90min)</name>
    <description>Warmup: 5min from 40% to 65% FTP | Intervals: 3 x (30s @ 100% / 3min @ 65%) | Cooldown: 5min from 65% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.4" PowerHigh="0.65" pace="0" Cadence="85" />
        <Ramp Duration="60" PowerLow="0.65" PowerHigh="1.0" pace="0" Cadence="105" />
        <SteadyState Duration="30" Power="1.0" pace="0" Cadence="105" />
        <Ramp Duration="60" PowerLow="1.0" PowerHigh="0.65" pace="0" Cadence="105" />
        <SteadyState Duration="240" Power="0.65" pace="0" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="180" OnPower="1.0" OffPower="0.65" pace="0" Cadence="105" CadenceResting="90" />
        <SteadyState Duration="30" Power="1.25" pace="0" Cadence="65" />
