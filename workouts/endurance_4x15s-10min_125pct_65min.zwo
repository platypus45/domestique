<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance 4x15s (65min)</name>
    <description>Warmup: 6min @ 50% FTP | Intervals: 4 x (15s @ 125% / 10min @ 65%)</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <Ramp Duration="60" PowerLow="0.5" PowerHigh="0.72" pace="0" />
        <SteadyState Duration="300" Power="0.72" pace="0" />
        <FreeRide Duration="120" FlatRoad="0" />
        <SteadyState Duration="600" Power="0.65" pace="0" />
        <SteadyState Duration="15" Power="1.25" pace="0" />
        <SteadyState Duration="600" Power="0.65" pace="0" />
        <SteadyState Duration="15" Power="1.25" pace="0" />
        <SteadyState Duration="600" Power="0.65" pace="0" />
        <SteadyState Duration="15" Power="1.25" pace="0" />
        <SteadyState Duration="600" Power="0.65" pace="0" />
        <SteadyState Duration="15" Power="1.25" pace="0" />
        <SteadyState Duration="600" Power="0.65" pace="0" />
    </workout>
</workout_file>