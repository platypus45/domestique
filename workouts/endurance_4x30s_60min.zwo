<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance 4x30s (60min)</name>
    <description>Warmup: 6min from 40% to 75% FTP | Intervals: 4 x (30s @ 120% / 1min @ 50%) | Cooldown: 7min from 65% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="360" PowerLow="0.4" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="20" OffDuration="60" OnPower="1.3" OffPower="0.5" pace="0" />
        <Ramp Duration="1200" PowerLow="0.5" PowerHigh="1.0" pace="0" />
        <Ramp Duration="900" PowerLow="1.0" PowerHigh="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="30" OffDuration="60" OnPower="1.2" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.75" pace="0" Cadence="90" />
        <Cooldown Duration="420" PowerLow="0.65" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>