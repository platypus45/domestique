        <SteadyState Duration="180" Power="0.5" pace="0" />
        <Ramp Duration="180" PowerLow="0.96" PowerHigh="0.76" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <Ramp Duration="180" PowerLow="0.95" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <Ramp Duration="180" PowerLow="0.95" PowerHigh="0.75" pace="0" />
