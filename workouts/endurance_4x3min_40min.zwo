<workout_file>
    <author>Domestique Library</author>
    <name>Recovery (40min)</name>
    <description>Warmup: 5min from 25% to 70% FTP | Steady: 3min @ 51% FTP | Steady: 3min @ 85% FTP | Steady: 3min @ 50% FTP | Steady: 3min @ 85% FTP | Steady: 3min @ 50% FTP | Steady: 3min @ 86% FTP | Steady: 3min @ 50% FTP | Steady: 3min @ 85% FTP | Steady: 3min @ 50% FTP | Steady: 3min @ 85% FTP | Cooldown: 5min from 65% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.25" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="180" Power="0.51" pace="0" />
        <Ramp Duration="180" PowerLow="0.95" PowerHigh="0.75" pace="0" />
