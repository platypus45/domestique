<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (30min)</name>
    <description>Warmup: 10min from 40% to 75% FTP | Steady: 5min @ 85% FTP | Steady: 3min @ 80% FTP | Steady: 2min @ 95% FTP | Steady: 1min @ 110% FTP | Cooldown: 9min from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="300" Power="0.85" pace="0" />
        <SteadyState Duration="180" Power="0.8" pace="0" />
        <SteadyState Duration="120" Power="0.95" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <Cooldown Duration="540" PowerLow="0.60" PowerHigh="0.40" pace="0" />
    </workout>
</workout_file>