<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (30min)</name>
    <description>Warmup: 8min from 50% to 75% FTP | Steady: 3min @ 75% FTP | Steady: 15s @ 120% FTP | Steady: 3min @ 75% FTP | Steady: 30s @ 120% FTP | Steady: 3min @ 75% FTP | Steady: 45s @ 120% FTP | Steady: 3min @ 75% FTP | Steady: 1min @ 120% FTP | Steady: 3min @ 75% FTP | Steady: 1min 15s @ 120% FTP | Cooldown: 3min 15s from 60% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" pace="0" Cadence="85" />
        <IntervalsT Repeat="1" OnDuration="180" OffDuration="15" OnPower="0.75" OffPower="1.2" pace="0" Cadence="95" CadenceResting="100" />
        <IntervalsT Repeat="1" OnDuration="180" OffDuration="30" OnPower="0.75" OffPower="1.2" pace="0" Cadence="95" CadenceResting="105" />
        <IntervalsT Repeat="1" OnDuration="180" OffDuration="45" OnPower="0.75" OffPower="1.2" pace="0" Cadence="95" CadenceResting="110" />
        <IntervalsT Repeat="1" OnDuration="180" OffDuration="60" OnPower="0.75" OffPower="1.2" pace="0" Cadence="95" CadenceResting="105" />
        <IntervalsT Repeat="1" OnDuration="180" OffDuration="75" OnPower="0.75" OffPower="1.2" pace="0" Cadence="95" CadenceResting="100" />
        <Cooldown Duration="195" PowerLow="0.60" PowerHigh="0.30" pace="0" />
    </workout>
</workout_file>