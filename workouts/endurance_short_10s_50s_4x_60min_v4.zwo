<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance 15s/4min 8x (60min)</name>
    <description>Warmup: 5min from 42% to 70% FTP | Microintervals: 8 x (15s @ 106% / 3min 45s @ 65%)</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.42" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="240" Power="0.7" pace="0" />
        <IntervalsT Repeat="4" OnDuration="10" OffDuration="50" OnPower="1.35" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.6" pace="0" />
        <SteadyState Duration="300" Power="0.85" pace="0" />
        <SteadyState Duration="180" Power="0.6" pace="0" />
        <IntervalsT Repeat="8" OnDuration="15" OffDuration="225" OnPower="1.06" OffPower="0.65" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
    </workout>
</workout_file>