<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance 5x1min (60min)</name>
    <description>Warmup: 7min from 40% to 75% FTP | Intervals: 5 x (1min @ 105% / 2min @ 75%) | Cooldown: 8min 40s from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="420" PowerLow="0.4" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="6" OnDuration="30" OffDuration="60" OnPower="1.15" OffPower="0.7" pace="0" />
        <SteadyState Duration="120" Power="0.95" pace="0" />
        <SteadyState Duration="60" Power="1.05" pace="0" />
        <SteadyState Duration="300" Power="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.85" pace="0" />
        <SteadyState Duration="60" Power="0.95" pace="0" />
        <SteadyState Duration="30" Power="1.25" pace="0" />
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="120" OnPower="1.05" OffPower="0.75" pace="0" />
        <SteadyState Duration="60" Power="1.09" pace="0" />
        <SteadyState Duration="20" Power="1.25" pace="0" />
        <SteadyState Duration="120" Power="0.95" pace="0" />
        <SteadyState Duration="300" Power="0.85" pace="0" />
        <SteadyState Duration="30" Power="1.25" pace="0" />
        <Cooldown Duration="520" PowerLow="0.60" PowerHigh="0.40" pace="0" />
    </workout>
</workout_file>