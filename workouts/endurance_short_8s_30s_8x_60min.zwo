<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance 8s/45s 16x (60min)</name>
    <description>Warmup: 16min from 70% to 75% FTP | Microintervals: 16 x (8s @ 115% / 45s @ 73%) | Cooldown: 10min from 75% to 70% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="960" PowerLow="0.7" PowerHigh="0.75" pace="0" />
        <FreeRide Duration="900" FlatRoad="0" />
        <IntervalsT Repeat="8" OnDuration="8" OffDuration="30" OnPower="1.15" OffPower="0.73" pace="0" />
        <IntervalsT Repeat="8" OnDuration="8" OffDuration="60" OnPower="1.15" OffPower="0.73" pace="0" />
        <FreeRide Duration="300" FlatRoad="0" />
        <Cooldown Duration="600" PowerLow="0.75" PowerHigh="0.7" pace="0" />
    </workout>
</workout_file>