<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery (13min)</name>
    <description>Warmup: 4min from 40% to 70% FTP | Steady: 3min @ 60% FTP | Steady: 3min @ 50% FTP | Cooldown: 3min from 50% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="240" PowerLow="0.4" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="180" Power="0.6" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <Cooldown Duration="180" PowerLow="0.50" PowerHigh="0.40" pace="0" />
    </workout>
</workout_file>