<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance Steady (16min)</name>
    <description>Warmup: 8min from 31% to 81% FTP | Steady: 3min @ 65% FTP | Cooldown: 5min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.31" PowerHigh="0.81" pace="0" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>