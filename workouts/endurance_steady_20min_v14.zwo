<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (20min)</name>
    <description>Warmup: 8min from 50% to 80% FTP | Steady: 2min @ 60% FTP | Steady: 2min @ 65% FTP | Cooldown: 8min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="60" Power="0.6" pace="0" />
        <SteadyState Duration="60" Power="0.6" pace="0" />
        <SteadyState Duration="120" Power="0.65" pace="0" />
        <Cooldown Duration="480" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>