<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance Steady (20min)</name>
    <description>Warmup: 10min from 40% to 70% FTP | Steady: 2min @ 60% FTP | Cooldown: 8min @ 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="120" Power="0.6" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
    </workout>
</workout_file>