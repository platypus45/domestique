<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery (21min)</name>
    <description>Warmup: 1min from 35% to 55% FTP | Steady: 5min @ 75% FTP | Steady: 10min @ 55% FTP | Cooldown: 5min from 55% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="60" PowerLow="0.35" PowerHigh="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.75" pace="0" />
        <SteadyState Duration="600" Power="0.55" pace="0" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>