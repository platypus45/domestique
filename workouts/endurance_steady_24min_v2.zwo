<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance Steady (24min)</name>
    <description>Warmup: 7min from 25% to 75% FTP | Steady: 10min @ 65% FTP | Cooldown: 7min from 36% to 60% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="420" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="600" Power="0.65" pace="0" />
        <Cooldown Duration="420" PowerLow="0.36" PowerHigh="0.6" pace="0" />
    </workout>
</workout_file>