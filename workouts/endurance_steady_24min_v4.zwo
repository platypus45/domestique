<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance 3x30s (24min)</name>
    <description>Warmup: 8min from 45% to 75% FTP | Intervals: 3 x (30s @ 120% / 30s @ 50%) | Cooldown: 8min from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.45" PowerHigh="0.75" pace="0" />
        <Ramp Duration="360" PowerLow="0.64" PowerHigh="1.02" pace="0" />
        <SteadyState Duration="30" Power="1.2" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.2" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.2" pace="0" />
        <Cooldown Duration="480" PowerLow="0.60" PowerHigh="0.40" pace="0" />
    </workout>
</workout_file>