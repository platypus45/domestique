<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance Steady (30min)</name>
    <description>Warmup: 10min from 55% to 72% FTP | Steady: 10min @ 72% FTP | Cooldown: 10min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.55" PowerHigh="0.72" pace="0" />
        <SteadyState Duration="300" Power="0.72" pace="0" />
        <SteadyState Duration="300" Power="0.72" pace="0" />
        <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>