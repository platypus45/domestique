<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance Steady (35min)</name>
    <description>Warmup: 15min from 25% to 75% FTP | Steady: 10min @ 65% FTP | Cooldown: 10min from 60% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="600" Power="0.65" pace="0" />
        <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>