<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance Steady (35min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Steady: 15min @ 65% FTP | Cooldown: 10min from 75% to 26% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <Cooldown Duration="600" PowerLow="0.75" PowerHigh="0.26" pace="0" />
    </workout>
</workout_file>