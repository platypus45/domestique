<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (36min)</name>
    <description>Warmup: 3min from 40% to 60% FTP | Steady: 4min @ 60% FTP | Steady: 3min @ 68% FTP | Steady: 16min @ 75% FTP | Cooldown: 10min from 75% to 39% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="180" PowerLow="0.4" PowerHigh="0.6" pace="0" />
        <SteadyState Duration="240" Power="0.6" pace="0" />
        <Ramp Duration="180" PowerLow="0.6" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="480" Power="0.75" pace="0" />
        <SteadyState Duration="480" Power="0.75" pace="0" />
        <Cooldown Duration="600" PowerLow="0.75" PowerHigh="0.39" pace="0" />
    </workout>
</workout_file>