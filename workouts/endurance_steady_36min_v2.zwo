<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (36min)</name>
    <description>Warmup: 10min from 40% to 75% FTP | Steady: 8min @ 75% FTP | Steady: 2min @ 60% FTP | Steady: 6min @ 50% FTP | Cooldown: 10min from 65% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="480" Power="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.6" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <Cooldown Duration="600" PowerLow="0.65" PowerHigh="0.5" pace="0" />
    </workout>
