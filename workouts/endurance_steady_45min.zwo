<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance Steady (45min)</name>
    <description>Warmup: 10min from 40% to 65% FTP | Steady: 30min @ 65% FTP | Cooldown: 5min from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.65" />
        <SteadyState Duration="1800" Power="0.65" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.40" />
    </workout>
</workout_file>