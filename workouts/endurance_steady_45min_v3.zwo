<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance Steady (45min)</name>
    <description>Warmup: 10min from 30% to 80% FTP | Steady: 30min @ 60% FTP | Cooldown: 5min from 45% to 75% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.3" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="900" Power="0.6" pace="0" />
        <SteadyState Duration="900" Power="0.6" pace="0" />
        <Cooldown Duration="300" PowerLow="0.45" PowerHigh="0.75" pace="0" />
    </workout>
</workout_file>