<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance Steady (45min)</name>
    <description>Warmup: 15min from 25% to 75% FTP | Steady: 15min @ 60% FTP | Cooldown: 15min from 25% to 75% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="900" Power="0.6" pace="0" />
        <Cooldown Duration="900" PowerLow="0.25" PowerHigh="0.75" pace="0" />
    </workout>
</workout_file>