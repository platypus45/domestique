        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="600" Power="0.7" pace="0" />
        <SteadyState Duration="600" Power="0.7" pace="0" />
        <SteadyState Duration="600" Power="0.7" pace="0" />
        <SteadyState Duration="540" Power="0.7" pace="0" />
        <SteadyState Duration="60" Power="0.7" pace="0" />
        <Cooldown Duration="600" PowerLow="0.25" PowerHigh="0.7" pace="0" />
    </workout>
