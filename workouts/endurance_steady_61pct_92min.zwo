<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (92min)</name>
    <description>Warmup: 10min from 50% to 65% FTP | Steady: 30min @ 65% FTP | Steady: 10min @ 50% FTP | Steady: 30min @ 65% FTP | Cooldown: 2min ramp from 50% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.65" pace="0" />
        <IntervalsT Repeat="2" OnDuration="1800" OffDuration="600" OnPower="0.65" OffPower="0.5" pace="0" />
    <Cooldown Duration="120" PowerLow="0.50" PowerHigh="0.40" /></workout>
</workout_file>