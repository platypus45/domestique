<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery (16min)</name>
    <description>Warmup: 3min from 30% to 50% FTP | Steady: 3min @ 60% FTP | Steady: 3min @ 75% FTP | Steady: 5min @ 55% FTP | Cooldown: 2min from 55% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="180" PowerLow="0.3" PowerHigh="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.6" pace="0" />
        <SteadyState Duration="180" Power="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <Cooldown Duration="120" PowerLow="0.55" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>