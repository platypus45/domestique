<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance Steady (63min)</name>
    <description>Warmup: 8min from 50% to 70% FTP | Steady: 50min @ 70% FTP | Cooldown: 5min from 50% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="1200" Power="0.7" pace="0" Cadence="85" />
        <IntervalsT Repeat="10" OnDuration="60" OffDuration="120" OnPower="0.7" OffPower="0.7" pace="0" Cadence="110" CadenceResting="85" />
        <Cooldown Duration="300" PowerLow="0.5" PowerHigh="0.3" pace="0" />
    </workout>
</workout_file>