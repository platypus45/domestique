<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (58min)</name>
    <description>Warmup: 6min from 40% to 73% FTP | Steady: 6min @ 73% FTP | Steady: 2min @ 52% FTP | Steady: 6min @ 73% FTP | Steady: 2min @ 52% FTP | Steady: 6min @ 73% FTP | Steady: 2min @ 52% FTP | Steady: 6min @ 73% FTP | Steady: 2min @ 52% FTP | Steady: 6min @ 73% FTP | Steady: 2min @ 52% FTP | Steady: 6min @ 73% FTP | Cooldown: 6min from 60% to 40% FTP</description>
    <sportType>bike</sportType>
