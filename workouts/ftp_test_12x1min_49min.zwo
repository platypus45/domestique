<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>FTP Test 12x1min (49min)</name>
    <description>Warmup: 10min from 50% to 80% FTP | Intervals: 12 x (1min @ 95% / 1min @ 102%) | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.8" pace="0" />
        <Ramp Duration="60" PowerLow="0.8" PowerHigh="0.95" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <IntervalsT Repeat="6" OnDuration="60" OffDuration="60" OnPower="0.95" OffPower="1.02" pace="0" />
        <SteadyState Duration="360" Power="0.55" pace="0" />
        <IntervalsT Repeat="6" OnDuration="60" OffDuration="60" OnPower="0.95" OffPower="1.02" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>