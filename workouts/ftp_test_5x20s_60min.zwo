<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>FTP Test 5x20s (60min)</name>
    <description>Warmup: 6min from 50% to 70% FTP | Intervals: 5 x (20s @ 100% / 40s @ 60%) | Cooldown: 6min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="360" PowerLow="0.5" PowerHigh="0.7" pace="0" />
        <IntervalsT Repeat="5" OnDuration="20" OffDuration="40" OnPower="1.0" OffPower="0.6" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="240" Power="0.85" pace="0" />
