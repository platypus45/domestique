<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>FTP Test (45min)</name>
    <description>Warmup: 5min from 30% to 70% FTP | Steady: 20s @ 80% FTP | Steady: 20s @ 100% FTP | Steady: 20s @ 120% FTP | Steady: 3min @ 50% FTP | Steady: 3min @ 110% FTP | Steady: 2min @ 120% FTP | Steady: 6min @ 50% FTP | Steady: 20min @ 110% FTP | Cooldown: 5min from 50% to 30% FTP</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="ftp_test" />
    </tags>
    <workout>
        <Warmup Duration="300" PowerLow="0.3" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="20" Power="0.8" pace="0" />
        <SteadyState Duration="20" Power="1" pace="0" />
        <SteadyState Duration="20" Power="1.2" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="1.1" pace="0" />
        <SteadyState Duration="120" Power="1.2" pace="0" />
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <SteadyState Duration="1200" Power="1.1" pace="0" />
        <Cooldown Duration="300" PowerLow="0.5" PowerHigh="0.3" pace="0" />
    </workout>
</workout_file>