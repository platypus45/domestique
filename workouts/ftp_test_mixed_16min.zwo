<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>FTP Test (16min)</name>
    <description>Warmup: 5min from 35% to 55% FTP | Steady: 2min @ 60% FTP | Steady: 2min @ 70% FTP | Steady: 2min @ 85% FTP | Steady: 1min @ 100% FTP | Steady: 30s @ 110% FTP | Steady: 2min @ 55% FTP | Cooldown: 1min from 35% to 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.35" PowerHigh="0.55" pace="0" />
        <SteadyState Duration="120" Power="0.6" pace="0" />
        <SteadyState Duration="120" Power="0.7" pace="0" />
        <SteadyState Duration="120" Power="0.85" pace="0" />
        <SteadyState Duration="60" Power="1" pace="0" />
        <SteadyState Duration="30" Power="1.1" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <Cooldown Duration="60" PowerLow="0.35" PowerHigh="0.55" pace="0" />
    </workout>
</workout_file>