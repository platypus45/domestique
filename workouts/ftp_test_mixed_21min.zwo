<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo 21min — Z2</name>
    <description>Warmup: 9min from 45% to 65% FTP | Steady: 1min @ 70% FTP | Steady: 1min @ 80% FTP | Steady: 1min @ 90% FTP | Steady: 1min @ 100% FTP | Steady: 1min @ 110% FTP | Steady: 1min @ 55% FTP | Cooldown: 6min from 45% to 75% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="540" PowerLow="0.45" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="60" Power="0.7" pace="0" />
        <SteadyState Duration="60" Power="0.8" pace="0" />
        <SteadyState Duration="60" Power="0.9" pace="0" />
        <SteadyState Duration="60" Power="1" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <Cooldown Duration="360" PowerLow="0.45" PowerHigh="0.75" pace="0" />
    </workout>
</workout_file>