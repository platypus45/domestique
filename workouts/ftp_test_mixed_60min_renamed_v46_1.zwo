<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 60min — 2×10min/10min @ 106%</name>
    <description>Warmup: 15min from 56% to 75% FTP | Steady: 10min @ 106% FTP | Steady: 10min @ 60% FTP | Steady: 10min @ 106% FTP | Cooldown: 15min from 75% to 56% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.56" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="600" Power="1.06" pace="0" />
        <SteadyState Duration="600" Power="0.6" pace="0" />
        <SteadyState Duration="600" Power="1.06" pace="0" />
        <Cooldown Duration="900" PowerLow="0.75" PowerHigh="0.56" pace="0" />
    </workout>
</workout_file>