<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>FTP Test 4 cycles (55min)</name>
    <description>Warmup: 6min from 50% to 70% FTP | Over-Under: 4 cycles (alternating above/below threshold) | Cooldown: 6min from 45% to 60% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="360" PowerLow="0.5" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="240" Power="0.85" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <SteadyState Duration="120" Power="1" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <SteadyState Duration="120" Power="1" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <SteadyState Duration="240" Power="0.85" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <SteadyState Duration="60" Power="0.85" pace="0" />
        <SteadyState Duration="30" Power="1.1" pace="0" />
        <SteadyState Duration="120" Power="0.95" pace="0" />
        <SteadyState Duration="60" Power="1" pace="0" />
        <SteadyState Duration="120" Power="0.85" pace="0" />
        <SteadyState Duration="60" Power="0.95" pace="0" />
        <SteadyState Duration="30" Power="1.1" pace="0" />
        <SteadyState Duration="60" Power="0.85" pace="0" />
        <SteadyState Duration="60" Power="1" pace="0" />
        <Cooldown Duration="360" PowerLow="0.45" PowerHigh="0.6" pace="0" />
    </workout>
</workout_file>