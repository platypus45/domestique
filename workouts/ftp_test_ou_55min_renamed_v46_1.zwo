<workout_file>
    <author>Domestique Library</author>
    <name>Threshold Ladder 55min — 2×4min/30s @ 80%</name>
    <description>Warmup: 6min from 45% to 65% FTP | Over-Under: 3 cycles (alternating above/below threshold) | Cooldown: 7min from 45% to 55% FTP</description>
