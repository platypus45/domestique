<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>FTP Test Ramp (35min)</name>
    <description>Warmup: 6min from 50% to 56% FTP | Ramp: 24min from 62% to 200% FTP | Cooldown: 5min from 40% to 30% FTP</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="ftp_test" />
        <tag name="ftp_test_ramp" />
    </tags>
    <workout>
        <SteadyState Duration="300" Power="0.50" pace="warmup" />
        <SteadyState Duration="60" Power="0.56" Cadence="90" pace="ramp_test" />
