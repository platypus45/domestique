<workout_file>
    <author>Domestique Library</author>
    <name>Recovery (48min)</name>
    <description>Steady: 3min @ 50% FTP | Steady: 1min @ 70% FTP | Steady: 1min @ 50% FTP | Steady: 1min @ 70% FTP | Steady: 1min @ 50% FTP | Steady: 1min @ 80% FTP | Steady: 1min @ 50% FTP | Steady: 1min @ 80% FTP | Steady: 4min @ 50% FTP | Steady: 10min @ 68% FTP | Steady: 3min @ 50% FTP | Steady: 1min @ 80% FTP | Steady: 3min @ 50% FTP | Steady: 10min @ 68% FTP | Steady: 3min @ 50% FTP | Steady: 1min @ 80% FTP | Steady: 3min @ 50% FTP</description>
