<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance 3x40s (46min)</name>
    <description>Warmup: 5min from 50% to 60% FTP | Intervals: 3 x (40s @ 100% / 20s @ 50%) | Cooldown: 3min from 50% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.5" PowerHigh="0.6" pace="0" />
        <Ramp Duration="300" PowerLow="0.6" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <IntervalsT Repeat="3" OnDuration="240" OffDuration="60" OnPower="0.75" OffPower="0.5" pace="0" Cadence="90" CadenceResting="90" />
        <IntervalsT Repeat="1" OnDuration="120" OffDuration="180" OnPower="0.8" OffPower="0.9" pace="0" Cadence="90" CadenceResting="90" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="1" OnDuration="120" OffDuration="180" OnPower="0.9" OffPower="0.8" pace="0" Cadence="90" CadenceResting="90" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="40" OffDuration="20" OnPower="1.0" OffPower="0.5" pace="0" Cadence="100" CadenceResting="100" />
        <Cooldown Duration="180" PowerLow="0.50" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>