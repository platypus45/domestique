<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (48min)</name>
    <description>Warmup: 10min from 40% to 73% FTP | Steady: 5min @ 73% FTP | Steady: 2min @ 53% FTP | Steady: 5min @ 73% FTP | Steady: 2min @ 53% FTP | Steady: 5min @ 73% FTP | Steady: 2min @ 53% FTP | Steady: 5min @ 73% FTP | Steady: 2min @ 53% FTP | Steady: 5min @ 73% FTP | Cooldown: 5min from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.73" pace="0" Cadence="85" />
