<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery (40min)</name>
    <description>Warmup: 5min from 25% to 70% FTP | Steady: 2min @ 45% FTP | Steady: 2min @ 76% FTP | Steady: 2min @ 45% FTP | Steady: 2min @ 76% FTP | Steady: 2min @ 45% FTP | Steady: 2min @ 76% FTP | Steady: 2min @ 45% FTP | Steady: 2min @ 76% FTP | Steady: 4min @ 45% FTP | Steady: 2min @ 76% FTP | Steady: 2min @ 45% FTP | Steady: 2min @ 76% FTP | Steady: 2min @ 45% FTP | Steady: 2min @ 76% FTP | Cooldown: 5min from 65% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.25" PowerHigh="0.7" pace="0" />
        <IntervalsT Repeat="4" OnDuration="120" OffDuration="120" OnPower="0.45" OffPower="0.76" pace="0" Cadence="90" CadenceResting="60" />
        <SteadyState Duration="120" Power="0.45" pace="0" />
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="120" OnPower="0.45" OffPower="0.76" pace="0" Cadence="90" CadenceResting="60" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>