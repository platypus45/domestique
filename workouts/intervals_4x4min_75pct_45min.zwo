<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (45min)</name>
    <description>Warmup: 10min from 50% to 75% FTP | Steady: 2min @ 50% FTP | Steady: 4min @ 75% FTP | Steady: 3min @ 50% FTP | Steady: 4min @ 75% FTP | Steady: 3min @ 50% FTP | Steady: 4min @ 75% FTP | Steady: 3min @ 50% FTP | Steady: 4min @ 75% FTP | Steady: 3min @ 50% FTP | Cooldown: 5min from 50% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="240" OffDuration="180" OnPower="0.75" OffPower="0.5" pace="0" Cadence="100" CadenceResting="85" />
        <Cooldown Duration="300" PowerLow="0.50" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>