<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance Steady (51min)</name>
    <description>Warmup: 8min from 50% to 65% FTP | Steady: 40min @ 65% FTP | Cooldown: 3min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.65" pace="0" />
        <IntervalsT Repeat="4" OnDuration="300" OffDuration="300" OnPower="0.65" OffPower="0.65" pace="0" Cadence="85" CadenceResting="95" />
        <Cooldown Duration="180" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>