<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance 30s/30s 12x (52min)</name>
    <description>Warmup: 5min from 50% to 75% FTP | Microintervals: 12 x (30s @ 113% / 30s @ 76%) | Cooldown: 5min from 75% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="5" OnDuration="30" OffDuration="30" OnPower="0.65" OffPower="0.8" pace="0" />
        <FreeRide Duration="900" FlatRoad="0" />
        <IntervalsT Repeat="6" OnDuration="30" OffDuration="30" OnPower="1.13" OffPower="0.76" pace="0" />
        <SteadyState Duration="600" Power="0.65" pace="0" />
        <IntervalsT Repeat="6" OnDuration="30" OffDuration="30" OnPower="1.13" OffPower="0.76" pace="0" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>