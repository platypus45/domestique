<workout_file>
    <author>Domestique Library</author>
    <name>Tempo (50min)</name>
    <description>Warmup: 8min from 31% to 81% FTP | Steady: 45s @ 75% FTP | Steady: 2min 45s @ 52% FTP | Steady: 45s @ 75% FTP | Steady: 2min 45s @ 52% FTP | Steady: 45s @ 75% FTP | Steady: 2min 45s @ 52% FTP | Steady: 45s @ 75% FTP | Steady: 2min 45s @ 52% FTP | Steady: 45s @ 75% FTP | Steady: 2min 45s @ 52% FTP | Steady: 3min 30s @ 65% FTP | Steady: 2min @ 76% FTP | Steady: 2min @ 50% FTP | Steady: 2min @ 76% FTP | Steady: 2min @ 50% FTP | Steady: 2min @ 76% FTP | Steady: 2min @ 50% FTP | Steady: 2min @ 76% FTP | Steady: 2min @ 50% FTP | Cooldown: 5min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.31" PowerHigh="0.81" pace="0" />
        <IntervalsT Repeat="5" OnDuration="45" OffDuration="165" OnPower="0.75" OffPower="0.52" pace="0" Cadence="85" CadenceResting="65" />
        <SteadyState Duration="210" Power="0.65" pace="0" Cadence="100" />
        <IntervalsT Repeat="4" OnDuration="120" OffDuration="120" OnPower="0.76" OffPower="0.5" pace="0" />
