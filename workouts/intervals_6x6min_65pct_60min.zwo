<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (60min)</name>
    <description>Warmup: 6min from 50% to 65% FTP | Steady: 6min @ 65% FTP | Steady: 2min @ 50% FTP | Steady: 6min @ 65% FTP | Steady: 2min @ 50% FTP | Steady: 6min @ 65% FTP | Steady: 2min @ 50% FTP | Steady: 6min @ 65% FTP | Steady: 2min @ 50% FTP | Steady: 6min @ 65% FTP | Steady: 2min @ 50% FTP | Steady: 6min @ 65% FTP | Steady: 2min @ 50% FTP | Cooldown: 6min from 50% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="360" PowerLow="0.5" PowerHigh="0.65" pace="0" />
        <IntervalsT Repeat="6" OnDuration="360" OffDuration="120" OnPower="0.65" OffPower="0.5" pace="0" />
        <Cooldown Duration="360" PowerLow="0.50" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>