<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 30s/54s 14x (45min)</name>
    <description>Warmup: 10min ramp from 50% to 60% FTP | Microintervals: 14 x (30s @ 116% / 54s @ 41%) | Cooldown: 5min from 60% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.6" /><IntervalsT Repeat="7" OnDuration="45" OffDuration="30" OnPower="0.41" OffPower="1.16" pace="0" />
        <SteadyState Duration="165" Power="0.45" pace="0" />
        <IntervalsT Repeat="7" OnDuration="45" OffDuration="15" OnPower="0.76" OffPower="0.4" pace="0" />
        <SteadyState Duration="165" Power="0.45" pace="0" />
        <IntervalsT Repeat="7" OnDuration="45" OffDuration="30" OnPower="0.41" OffPower="1.16" pace="0" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>