<workout_file>
    <author>Domestique Library</author>
    <name>Tempo (60min)</name>
    <description>Warmup: 10min from 50% to 80% FTP | Steady: 2min @ 50% FTP | Steady: 3min 30s @ 70% FTP | Steady: 1min 30s @ 85% FTP | Steady: 3min 30s @ 70% FTP | Steady: 1min 30s @ 85% FTP | Steady: 3min 30s @ 70% FTP | Steady: 1min 30s @ 85% FTP | Steady: 3min 30s @ 70% FTP | Steady: 1min 30s @ 85% FTP | Steady: 3min 30s @ 70% FTP | Steady: 1min 30s @ 85% FTP | Steady: 3min 30s @ 70% FTP | Steady: 1min 30s @ 85% FTP | Steady: 3min 30s @ 70% FTP | Steady: 1min 30s @ 85% FTP | Steady: 3min 30s @ 70% FTP | Steady: 1min 30s @ 85% FTP | Steady: 3min 30s @ 70% FTP | Steady: 1min 30s @ 85% FTP | Cooldown: 3min from 55% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.8" pace="0" Cadence="85" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="9" OnDuration="210" OffDuration="90" OnPower="0.7" OffPower="0.85" pace="0" Cadence="90" CadenceResting="65" />
        <Cooldown Duration="180" PowerLow="0.55" PowerHigh="0.35" pace="0" />
    </workout>
