<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 10s/2min 10x (58min)</name>
    <description>Warmup: 13min from 50% to 90% FTP | Microintervals: 10 x (10s @ 200% / 1min 50s @ 52%) | Cooldown: 10min from 65% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="780" PowerLow="0.5" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="300" Power="0.53" pace="0" />
        <IntervalsT Repeat="5" OnDuration="10" OffDuration="110" OnPower="2.0" OffPower="0.52" pace="0" />
        <SteadyState Duration="600" Power="0.62" pace="0" />
        <IntervalsT Repeat="5" OnDuration="10" OffDuration="110" OnPower="2.0" OffPower="0.52" pace="0" />
        <Cooldown Duration="600" PowerLow="0.65" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>