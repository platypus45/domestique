<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 10s/2min 15x (83min)</name>
    <description>Warmup: 6min from 50% to 65% FTP | Microintervals: 15 x (10s @ 200% / 1min 50s @ 65%) | Cooldown: 10min from 75% to 65% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="360" PowerLow="0.5" PowerHigh="0.65" pace="0" />
        <Ramp Duration="240" PowerLow="0.7" PowerHigh="0.75" pace="0" />
        <Ramp Duration="180" PowerLow="0.85" PowerHigh="0.9" pace="0" />
        <Ramp Duration="290" PowerLow="0.5" PowerHigh="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.53" pace="0" />
        <IntervalsT Repeat="5" OnDuration="10" OffDuration="110" OnPower="2.0" OffPower="0.65" pace="0" />
        <SteadyState Duration="600" Power="0.53" pace="0" />
        <IntervalsT Repeat="5" OnDuration="10" OffDuration="110" OnPower="2.0" OffPower="0.65" pace="0" />
        <SteadyState Duration="600" Power="0.53" pace="0" />
        <IntervalsT Repeat="5" OnDuration="10" OffDuration="110" OnPower="2.0" OffPower="0.65" pace="0" />
        <Cooldown Duration="600" PowerLow="0.75" PowerHigh="0.65" pace="0" />
    </workout>
</workout_file>