<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 10s/2min 8x (35min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 8 x (10s @ 225% / 2min 30s @ 55%) | Cooldown: 5min ramp from 60% to 40% FTP</description>
