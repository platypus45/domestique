<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 10s/35s 26x (110min)</name>
    <description>Warmup: 12min from 25% to 95% FTP | Microintervals: 26 x (10s @ 200% / 35s @ 30%) | Cooldown: 10min from 65% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="720" PowerLow="0.25" PowerHigh="0.95" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="9" OnDuration="10" OffDuration="35" OnPower="2.0" OffPower="0.3" pace="0" />
        <SteadyState Duration="505" Power="0.5" pace="0" />
        <IntervalsT Repeat="9" OnDuration="10" OffDuration="35" OnPower="2.0" OffPower="0.3" pace="0" />
        <SteadyState Duration="505" Power="0.5" pace="0" />
        <IntervalsT Repeat="8" OnDuration="10" OffDuration="20" OnPower="2.0" OffPower="0.3" pace="0" />
        <SteadyState Duration="505" Power="0.5" pace="0" />
        <IntervalsT Repeat="8" OnDuration="15" OffDuration="295" OnPower="1.4" OffPower="0.75" pace="0" />
        <Cooldown Duration="600" PowerLow="0.65" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>