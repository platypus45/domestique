<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 10s/35s 17x (60min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Microintervals: 17 x (10s @ 200% / 35s @ 50%) | Cooldown: 10min from 50% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="9" OnDuration="10" OffDuration="35" OnPower="2.0" OffPower="0.5" pace="0" />
        <SteadyState Duration="505" Power="0.5" pace="0" />
        <IntervalsT Repeat="8" OnDuration="20" OffDuration="70" OnPower="1.75" OffPower="0.5" pace="0" />
        <SteadyState Duration="505" Power="0.5" pace="0" />
        <IntervalsT Repeat="8" OnDuration="10" OffDuration="35" OnPower="2.0" OffPower="0.5" pace="0" />
        <Cooldown Duration="600" PowerLow="0.50" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>