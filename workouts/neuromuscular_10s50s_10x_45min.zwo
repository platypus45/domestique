<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 10s/50s 10x (49min)</name>
    <description>Microintervals: 10 x (10s @ 200% / 50s @ 55%) | Cooldown: 5min 50s @ 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="180" Power="0.83" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.93" pace="0" Cadence="70" />
        <SteadyState Duration="360" Power="0.55" pace="0" />
        <IntervalsT Repeat="5" OnDuration="10" OffDuration="50" OnPower="2.0" OffPower="0.55" pace="0" />
        <SteadyState Duration="420" Power="0.55" pace="0" />
        <IntervalsT Repeat="5" OnDuration="10" OffDuration="50" OnPower="2.0" OffPower="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
    </workout>
</workout_file>