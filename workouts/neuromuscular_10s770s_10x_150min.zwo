<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 10s/13min 10x (150min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Microintervals: 10 x (10s @ 200% / 12min @ 70%) | Cooldown: 10min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="10" OnDuration="10" OffDuration="770" OnPower="2.0" OffPower="0.7" pace="0" />
        <Cooldown Duration="600" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>