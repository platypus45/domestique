<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 11 cycles (60min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Over-Under: 11 cycles (alternating above/below threshold) | Cooldown: 7min 20s from 60% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="0.75" OffPower="0.5" pace="0" Cadence="110" CadenceResting="80" />
        <SteadyState Duration="180" Power="0.85" pace="0" />
