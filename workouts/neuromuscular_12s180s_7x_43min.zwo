<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 7x12s Sprints (43min)</name>
    <description>Warmup: 7min from 45% to 75% FTP + 3 openers | Sprints: 7 x (12s @ 210% / 3min @ 55%) with full recoveries | Finish: 4min @ 85% tempo | Seven maximal stabs - quality over grind, each one from a fully recovered tank | Cooldown: 5min from 55% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="420" PowerLow="0.45" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="15" Power="1.1" pace="0" />
        <SteadyState Duration="75" Power="0.55" pace="0" />
        <SteadyState Duration="15" Power="1.2" pace="0" />
        <SteadyState Duration="75" Power="0.55" pace="0" />
        <SteadyState Duration="15" Power="1.3" pace="0" />
        <SteadyState Duration="45" Power="0.55" pace="0" />
        <IntervalsT Repeat="7" OnDuration="12" OffDuration="180" OnPower="2.1" OffPower="0.55" pace="0" />
        <SteadyState Duration="240" Power="0.85" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>
