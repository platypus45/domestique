<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 12s/24s 6x (120min)</name>
    <description>Warmup: 15min from 25% to 75% FTP | Microintervals: 6 x (12s @ 200% / 24s @ 50%) | Cooldown: 15min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="12" OffDuration="24" OnPower="1.45" OffPower="0.5" pace="0" />
        <SteadyState Duration="900" Power="0.92" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <IntervalsT Repeat="3" OnDuration="12" OffDuration="24" OnPower="1.45" OffPower="0.5" pace="0" />
        <SteadyState Duration="900" Power="0.92" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <SteadyState Duration="2784" Power="0.81" pace="0" />
        <Cooldown Duration="900" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>