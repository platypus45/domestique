<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 15s/15s 24x (58min)</name>
    <description>Warmup: 8min from 50% to 80% FTP | Microintervals: 24 x (15s @ 120% / 15s @ 80%) | Cooldown: 3min from 55% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.8" pace="0" Cadence="85" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="30" OnPower="1.2" OffPower="0.55" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="30" Power="1.5" pace="0" />
        <IntervalsT Repeat="8" OnDuration="15" OffDuration="15" OnPower="1.2" OffPower="0.8" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <SteadyState Duration="30" Power="1.5" pace="0" />
        <IntervalsT Repeat="8" OnDuration="15" OffDuration="15" OnPower="1.3" OffPower="0.7" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <SteadyState Duration="30" Power="1.5" pace="0" />
        <IntervalsT Repeat="8" OnDuration="15" OffDuration="15" OnPower="1.2" OffPower="0.8" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <SteadyState Duration="30" Power="1.5" pace="0" />
        <IntervalsT Repeat="8" OnDuration="15" OffDuration="15" OnPower="1.3" OffPower="0.7" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <SteadyState Duration="30" Power="1.5" pace="0" />
        <IntervalsT Repeat="8" OnDuration="15" OffDuration="15" OnPower="1.2" OffPower="0.8" pace="0" />
        <Cooldown Duration="180" PowerLow="0.55" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>