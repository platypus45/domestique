<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 15s/15s 60x (60min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Microintervals: 60 x (15s @ 150% / 15s @ 50%) | Cooldown: 4min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="0.75" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="20" OnDuration="15" OffDuration="15" OnPower="1.5" OffPower="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="20" OnDuration="15" OffDuration="15" OnPower="1.5" OffPower="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="20" OnDuration="15" OffDuration="15" OnPower="1.5" OffPower="0.5" pace="0" />
        <Cooldown Duration="240" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>