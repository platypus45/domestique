<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 15s/15s 60x (60min)</name>
    <description>Microintervals: 60 x (15s @ 150% / 15s @ 50%) | Cooldown: 10min from 50% to 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="120" Power="0.6" pace="0" />
        <SteadyState Duration="120" Power="0.65" pace="0" />
        <SteadyState Duration="120" Power="0.7" pace="0" />
        <SteadyState Duration="120" Power="0.75" pace="0" />
        <IntervalsT Repeat="20" OnDuration="15" OffDuration="15" OnPower="1.5" OffPower="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.75" pace="0" />
        <IntervalsT Repeat="20" OnDuration="15" OffDuration="15" OnPower="1.5" OffPower="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.75" pace="0" />
        <IntervalsT Repeat="20" OnDuration="15" OffDuration="15" OnPower="1.5" OffPower="0.5" pace="0" />
        <SteadyState Duration="600" Power="0.55" pace="0" />
    </workout>
</workout_file>