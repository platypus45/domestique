<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 15s/15s 60x (60min)</name>
    <description>Warmup: 10min from 40% to 70% FTP | Microintervals: 60 x (15s @ 110% / 15s @ 50%) | Cooldown: 10min from 75% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.7" pace="0" />
        <IntervalsT Repeat="20" OnDuration="15" OffDuration="15" OnPower="1.1" OffPower="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.6" pace="0" />
        <IntervalsT Repeat="20" OnDuration="15" OffDuration="15" OnPower="1.1" OffPower="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.6" pace="0" />
        <IntervalsT Repeat="20" OnDuration="15" OffDuration="15" OnPower="1.1" OffPower="0.5" pace="0" />
        <Cooldown Duration="600" PowerLow="0.75" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>