<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 15s/15s 60x (60min)</name>
    <description>Warmup: 10min from 55% to 72% FTP | Microintervals: 60 x (15s @ 160% / 15s @ 55%) | Cooldown: 10min from 72% to 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.55" PowerHigh="0.72" pace="0" />
        <IntervalsT Repeat="20" OnDuration="15" OffDuration="15" OnPower="1.6" OffPower="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.72" pace="0" />
        <IntervalsT Repeat="20" OnDuration="15" OffDuration="15" OnPower="1.6" OffPower="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.72" pace="0" />
        <IntervalsT Repeat="20" OnDuration="15" OffDuration="15" OnPower="1.6" OffPower="0.55" pace="0" />
        <Cooldown Duration="600" PowerLow="0.72" PowerHigh="0.55" pace="0" />
    </workout>
</workout_file>