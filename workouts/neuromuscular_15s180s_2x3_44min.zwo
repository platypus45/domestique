<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 6x15s Sprint Sets (44min)</name>
    <description>Warmup: 7min from 45% to 75% FTP + 3 openers | Sprint sets: 2 sets of 3 x (15s @ 215% / 3min @ 55%), 4min @ 55% between sets | Finish: 4min @ 84% tempo | Two clusters of three - the set break resets the tank for a second round of maximal efforts | Cooldown: 5min from 55% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="420" PowerLow="0.45" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="15" Power="1.1" pace="0" />
        <SteadyState Duration="75" Power="0.55" pace="0" />
        <SteadyState Duration="15" Power="1.2" pace="0" />
        <SteadyState Duration="75" Power="0.55" pace="0" />
        <SteadyState Duration="15" Power="1.3" pace="0" />
        <SteadyState Duration="45" Power="0.55" pace="0" />
        <IntervalsT Repeat="3" OnDuration="15" OffDuration="180" OnPower="2.15" OffPower="0.55" pace="0" />
        <SteadyState Duration="240" Power="0.55" pace="0" />
        <IntervalsT Repeat="3" OnDuration="15" OffDuration="180" OnPower="2.15" OffPower="0.55" pace="0" />
        <SteadyState Duration="240" Power="0.84" pace="0" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>
