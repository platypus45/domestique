<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 15s/4min 10x (62min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Microintervals: 10 x (15s @ 350% / 4min @ 75%) | Cooldown: 5min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="30" OnPower="1.15" OffPower="0.5" pace="0" />
        <FreeRide Duration="120" FlatRoad="0" />
        <IntervalsT Repeat="9" OnDuration="15" OffDuration="240" OnPower="2" OffPower="0.6" pace="0" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>