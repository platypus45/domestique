<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 15s/25s 30x (90min)</name>
    <description>Warmup: 15min from 30% to 90% FTP | Microintervals: 30 x (15s @ 240% / 25s @ 60%) | Cooldown: 10min from 46% to 30% FTP</description>
