        <IntervalsT Repeat="10" OnDuration="15" OffDuration="25" OnPower="2.4" OffPower="0.6" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <SteadyState Duration="300" Power="0.38" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <IntervalsT Repeat="10" OnDuration="15" OffDuration="25" OnPower="2.4" OffPower="0.6" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <SteadyState Duration="300" Power="0.38" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <IntervalsT Repeat="10" OnDuration="15" OffDuration="25" OnPower="2.4" OffPower="0.6" pace="0" />
