<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 15s/4min 20x (120min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Microintervals: 20 x (15s @ 150% / 4min 30s @ 65%) | Cooldown: 15min from 65% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="20" OnDuration="15" OffDuration="270" OnPower="1.5" OffPower="0.65" pace="0" />
        <Cooldown Duration="900" PowerLow="0.65" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>