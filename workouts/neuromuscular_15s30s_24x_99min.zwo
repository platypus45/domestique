<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 15s/3min 5x (99min)</name>
    <description>Warmup: 15min from 49% to 92% FTP | Microintervals: 5 x (15s @ 300% / 3min @ 49%) | Cooldown: 15min from 54% to 49% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.49" PowerHigh="0.92" pace="0" />
        <SteadyState Duration="180" Power="0.51" pace="0" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="150" OnPower="1.23" OffPower="0.49" pace="0" Cadence="100" CadenceResting="100" />
        <IntervalsT Repeat="5" OnDuration="30" OffDuration="120" OnPower="1.15" OffPower="0.92" pace="0" />
        <SteadyState Duration="600" Power="0.51" pace="0" />
        <IntervalsT Repeat="12" OnDuration="30" OffDuration="30" OnPower="1.26" OffPower="0.7" pace="0" Cadence="100" CadenceResting="100" />
        <SteadyState Duration="600" Power="0.51" pace="0" />
        <SteadyState Duration="20" Power="0.49" pace="0" />
        <IntervalsT Repeat="5" OnDuration="15" OffDuration="180" OnPower="3.0" OffPower="0.49" pace="0" Cadence="107" CadenceResting="100" />
        <Cooldown Duration="900" PowerLow="0.54" PowerHigh="0.49" pace="0" />
    </workout>
</workout_file>