<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 15s/30s 8x (58min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 8 x (15s @ 170% / 30s @ 65%) | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="60" Power="1.09" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Ramp Duration="180" PowerLow="0.5" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="240" Power="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="30" OffDuration="15" OnPower="0.65" OffPower="1.7" pace="0" />
        <SteadyState Duration="600" Power="0.92" pace="0" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="30" OffDuration="15" OnPower="0.65" OffPower="1.7" pace="0" />
        <SteadyState Duration="600" Power="0.91" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
    </workout>
</workout_file>