<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 15s contracting recovery 12x (44min)</name>
    <description>Warmup: 7min ramp from 45% to 75% FTP, 3 x 30s fast-pedal drill @ 82%, primer 1min @ 88% + 1min @ 102% | Contracting-recovery sprint set: 12 x 15s @ 160% FTP, power identical on every rep while the recovery shrinks from 2min15s to 1min25s in exact 5s steps @ 45%, no recovery after the last rep | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="420" PowerLow="0.45" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="30" Power="0.82" pace="0" Cadence="110" />
