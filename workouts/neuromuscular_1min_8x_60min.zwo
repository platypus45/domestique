<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 1min/2min 8x (69min)</name>
    <description>Microintervals: 8 x (1min @ 135% / 2min @ 50%) | Cooldown: 5min ramp from 75% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="4" OnDuration="10" OffDuration="50" OnPower="1.75" OffPower="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.7" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.85" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <Ramp Duration="240" PowerLow="0.95" PowerHigh="1.04" pace="0" />
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="120" OnPower="1.35" OffPower="0.5" pace="0" Cadence="80" CadenceResting="90" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <Ramp Duration="240" PowerLow="0.95" PowerHigh="1.05" pace="0" />
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="120" OnPower="1.35" OffPower="0.5" pace="0" Cadence="80" CadenceResting="90" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.4" /></workout>
</workout_file>