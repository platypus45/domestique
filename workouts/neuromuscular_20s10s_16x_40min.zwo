<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 20s/10s 16x (40min)</name>
    <description>Warmup: 20min @ 50% FTP | Microintervals: 16 x (20s @ 200% / 10s @ 50%) | Cooldown: 10min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="1200" Power="0.5" pace="0" />
        <IntervalsT Repeat="8" OnDuration="20" OffDuration="10" OnPower="2.0" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <IntervalsT Repeat="8" OnDuration="20" OffDuration="10" OnPower="2.0" OffPower="0.5" pace="0" />
        <SteadyState Duration="600" Power="0.5" pace="0" />
    </workout>
</workout_file>