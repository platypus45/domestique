<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 20s/20s 12x (50min)</name>
    <description>Warmup: 20min @ 50% FTP | Microintervals: 12 x (20s @ 175% / 20s @ 50%) | Cooldown: 10min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="1200" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="20" OffDuration="20" OnPower="1.75" OffPower="0.5" pace="0" />
        <SteadyState Duration="420" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="20" OffDuration="20" OnPower="1.75" OffPower="0.5" pace="0" />
        <SteadyState Duration="420" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="20" OffDuration="20" OnPower="1.75" OffPower="0.5" pace="0" />
        <SteadyState Duration="600" Power="0.5" pace="0" />
    </workout>
</workout_file>