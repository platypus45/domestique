<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 20s/10s 8x (43min)</name>
    <description>Warmup: 3min from 25% to 75% FTP | Microintervals: 8 x (20s @ 190% / 10s @ 45%) | Cooldown: 3min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="180" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <Ramp Duration="420" PowerLow="0.8" PowerHigh="1.05" pace="0" Cadence="105" />
        <SteadyState Duration="15" Power="1.4" pace="0" />
        <SteadyState Duration="120" Power="1.05" pace="0" />
        <SteadyState Duration="15" Power="2.0" pace="0" />
        <SteadyState Duration="150" Power="0.8" pace="0" />
        <SteadyState Duration="15" Power="1.4" pace="0" />
        <SteadyState Duration="120" Power="1.05" pace="0" />
        <SteadyState Duration="15" Power="2.0" pace="0" />
        <SteadyState Duration="150" Power="0.8" pace="0" />
        <SteadyState Duration="15" Power="1.4" pace="0" />
        <SteadyState Duration="120" Power="1.05" pace="0" />
        <SteadyState Duration="15" Power="2.0" pace="0" />
        <SteadyState Duration="150" Power="0.8" pace="0" />
        <Ramp Duration="300" PowerLow="0.8" PowerHigh="1.0" pace="0" Cadence="100" />
        <IntervalsT Repeat="4" OnDuration="30" OffDuration="30" OnPower="1.75" OffPower="0.5" pace="0" />
        <FreeRide Duration="120" FlatRoad="0" />
        <IntervalsT Repeat="8" OnDuration="20" OffDuration="10" OnPower="1.9" OffPower="0.45" pace="0" />
        <Cooldown Duration="180" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>