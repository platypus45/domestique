<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 20s/65s 5x (45min)</name>
    <description>Warmup: 3min from 25% to 75% FTP | Microintervals: 5 x (20s @ 190% / 65s @ 45%) | Cooldown: 5min ramp from 75% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="180" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <Ramp Duration="420" PowerLow="0.8" PowerHigh="1.05" pace="0" Cadence="105" />
        <Ramp Duration="300" PowerLow="0.8" PowerHigh="1.0" pace="0" Cadence="100" />
        <IntervalsT Repeat="4" OnDuration="30" OffDuration="200" OnPower="1.75" OffPower="0.5" pace="0" />
        <FreeRide Duration="120" FlatRoad="0" />
        <IntervalsT Repeat="5" OnDuration="20" OffDuration="65" OnPower="1.9" OffPower="0.45" pace="0" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.4" /></workout>
</workout_file>