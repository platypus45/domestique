<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 20s/40s 10x (69min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 10 x (20s @ 150% / 40s @ 50%) | Cooldown: 5min ramp from 50% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="3" OnDuration="15" OffDuration="30" OnPower="1.1" OffPower="0.5" pace="0" />
        <Ramp Duration="60" PowerLow="0.6" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="15" OffDuration="30" OnPower="1.2" OffPower="0.5" pace="0" />
        <Ramp Duration="60" PowerLow="0.65" PowerHigh="0.8" pace="0" />
        <IntervalsT Repeat="3" OnDuration="15" OffDuration="30" OnPower="1.3" OffPower="0.5" pace="0" />
        <SteadyState Duration="60" Power="0.6" pace="0" />
        <SteadyState Duration="60" Power="0.7" pace="0" />
        <SteadyState Duration="60" Power="0.8" pace="0" />
        <IntervalsT Repeat="5" OnDuration="20" OffDuration="40" OnPower="1.5" OffPower="0.5" pace="0" />
        <SteadyState Duration="150" Power="0.5" pace="0" />
        <IntervalsT Repeat="6" OnDuration="15" OffDuration="35" OnPower="1.75" OffPower="0.5" pace="0" />
        <SteadyState Duration="150" Power="0.5" pace="0" />
        <IntervalsT Repeat="7" OnDuration="10" OffDuration="30" OnPower="2.0" OffPower="0.5" pace="0" />
        <SteadyState Duration="150" Power="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="20" OffDuration="40" OnPower="1.5" OffPower="0.5" pace="0" />
        <SteadyState Duration="150" Power="0.5" pace="0" />
        <IntervalsT Repeat="6" OnDuration="15" OffDuration="35" OnPower="1.75" OffPower="0.5" pace="0" />
        <SteadyState Duration="150" Power="0.5" pace="0" />
        <IntervalsT Repeat="7" OnDuration="10" OffDuration="30" OnPower="2.0" OffPower="0.5" pace="0" />
        <Cooldown Duration="325" PowerLow="0.50" PowerHigh="0.40" /></workout>
</workout_file>