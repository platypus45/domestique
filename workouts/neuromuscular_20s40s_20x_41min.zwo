<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 20s/40s 20x (44min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 20 x (20s @ 160% / 40s @ 40%) | Cooldown: 5min from 70% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="5" OnDuration="20" OffDuration="40" OnPower="1.6" OffPower="0.4" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="20" OffDuration="40" OnPower="1.6" OffPower="0.4" pace="0" />
        <SteadyState Duration="180" Power="0.51" pace="0" />
        <IntervalsT Repeat="5" OnDuration="20" OffDuration="40" OnPower="1.6" OffPower="0.4" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="20" OffDuration="40" OnPower="1.6" OffPower="0.4" pace="0" />
        <Cooldown Duration="300" PowerLow="0.7" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>