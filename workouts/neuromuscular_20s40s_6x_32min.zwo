<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 20s/40s 6x (32min)</name>
    <description>Warmup: 5min from 55% to 75% FTP | Microintervals: 6 x (20s @ 130% / 40s @ 95%) | Cooldown: 5min from 55% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.55" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="1" OnDuration="15" OffDuration="45" OnPower="0.9" OffPower="0.65" pace="0" Cadence="90" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="15" OffDuration="45" OnPower="1.0" OffPower="0.65" pace="0" Cadence="100" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="15" OffDuration="45" OnPower="1.1" OffPower="0.65" pace="0" Cadence="110" CadenceResting="85" />
        <SteadyState Duration="180" Power="0.55" pace="0" Cadence="85" />
        <IntervalsT Repeat="2" OnDuration="10" OffDuration="50" OnPower="1.5" OffPower="0.65" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" Cadence="85" />
        <SteadyState Duration="15" Power="1.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="20" OffDuration="40" OnPower="1.3" OffPower="0.95" pace="0" Cadence="110" CadenceResting="90" />
        <SteadyState Duration="15" Power="1.5" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <SteadyState Duration="15" Power="1.5" pace="0" Cadence="0" />
        <IntervalsT Repeat="3" OnDuration="20" OffDuration="40" OnPower="1.3" OffPower="0.95" pace="0" />
        <SteadyState Duration="15" Power="1.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>