<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 25s/3min 10x (60min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Microintervals: 10 x (25s @ 200% / 3min @ 75%) | Cooldown: 10min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="0.75" OffPower="0.5" pace="0" Cadence="110" CadenceResting="90" />
        <IntervalsT Repeat="10" OnDuration="25" OffDuration="180" OnPower="2.0" OffPower="0.75" pace="0" Cadence="50" CadenceResting="90" />
        <Cooldown Duration="600" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>