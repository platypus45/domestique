<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 2x1min (56min)</name>
    <description>Warmup: 5min from 45% to 75% FTP | Intervals: 2 x (1min @ 98% / 1min @ 50%)</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.45" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="60" OnPower="0.8" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="60" OnPower="0.98" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Ramp Duration="480" PowerLow="0.76" PowerHigh="0.91" pace="0" Cadence="80" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <Ramp Duration="480" PowerLow="0.75" PowerHigh="0.9" pace="0" Cadence="80" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="6" OnDuration="165" OffDuration="15" OnPower="0.75" OffPower="1.6" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
    </workout>
</workout_file>