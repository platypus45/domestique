<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Microbursts 15s/15s 2x20 (39min)</name>
    <description>Warmup: 5min ramp from 35% to 75% FTP | Priming: 3 x (30s @ 100% / 30s @ 50%) + 2min @ 40% | Main: 2 sets of 20 x (15s @ 115% / 15s @ 50%), 3min @ 50% between sets — microbursts, 2-set rung of the 3x20/4x20 ladder | Cooldown: 1min @ 40% + 5min ramp from 40% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.35" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="30" OnPower="1.0" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.4" pace="0" />
        <IntervalsT Repeat="20" OnDuration="15" OffDuration="15" OnPower="1.15" OffPower="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="20" OnDuration="15" OffDuration="15" OnPower="1.15" OffPower="0.5" pace="0" />
        <SteadyState Duration="60" Power="0.4" pace="0" />
        <Cooldown Duration="300" PowerLow="0.4" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>
