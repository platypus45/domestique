<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 2x3min (57min)</name>
    <description>Warmup: 10min from 48% to 91% FTP | Intervals: 2 x (3min @ 100% / 1min @ 50%) | Cooldown: 5min from 38% to 49% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.48" PowerHigh="0.91" pace="0" Cadence="85" />
        <IntervalsT Repeat="2" OnDuration="180" OffDuration="60" OnPower="1.0" OffPower="0.5" pace="0" Cadence="70" CadenceResting="80" />
        <IntervalsT Repeat="2" OnDuration="180" OffDuration="60" OnPower="1.05" OffPower="0.5" pace="0" Cadence="60" CadenceResting="90" />
        <IntervalsT Repeat="2" OnDuration="180" OffDuration="60" OnPower="1.1" OffPower="0.5" pace="0" Cadence="50" CadenceResting="100" />
        <SteadyState Duration="240" Power="0.42" pace="0" />
        <IntervalsT Repeat="20" OnDuration="10" OffDuration="20" OnPower="2.0" OffPower="0.4" pace="0" />
        <IntervalsT Repeat="7" OnDuration="10" OffDuration="20" OnPower="2.0" OffPower="0.4" pace="0" />
        <SteadyState Duration="30" Power="2.0" pace="0" />
        <Cooldown Duration="300" PowerLow="0.38" PowerHigh="0.49" pace="0" />
    </workout>
</workout_file>