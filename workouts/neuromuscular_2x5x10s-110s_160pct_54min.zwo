<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 10s/2min 10x (54min)</name>
    <description>Warmup: 6min from 40% to 60% FTP | Microintervals: 10 x (10s @ 160% / 1min 50s @ 53%) | Cooldown: 10min from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="360" PowerLow="0.4" PowerHigh="0.6" pace="0" Cadence="85" />
        <Ramp Duration="240" PowerLow="0.6" PowerHigh="0.75" pace="0" Cadence="90" />
