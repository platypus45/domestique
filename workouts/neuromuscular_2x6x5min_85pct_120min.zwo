<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 12x5min (120min)</name>
    <description>Warmup: 5min from 25% to 65% FTP | Intervals: 12 x (5min @ 85% / 5s @ 200%) | Cooldown: 9min from 55% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.25" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" Cadence="95" />
        <SteadyState Duration="60" Power="0.75" pace="0" Cadence="100" />
        <SteadyState Duration="60" Power="0.8" pace="0" Cadence="100" />
        <SteadyState Duration="30" Power="0.55" pace="0" Cadence="85" />
        <SteadyState Duration="60" Power="0.85" pace="0" Cadence="105" />
        <SteadyState Duration="60" Power="0.9" pace="0" Cadence="105" />
        <SteadyState Duration="30" Power="0.55" pace="0" Cadence="85" />
        <SteadyState Duration="60" Power="0.95" pace="0" Cadence="110" />
        <SteadyState Duration="60" Power="1.0" pace="0" Cadence="110" />
        <SteadyState Duration="180" Power="0.55" pace="0" Cadence="85" />
        <IntervalsT Repeat="6" OnDuration="300" OffDuration="5" OnPower="0.85" OffPower="2.0" pace="0" Cadence="90" CadenceResting="110" />
        <SteadyState Duration="360" Power="0.55" pace="0" Cadence="85" />
        <IntervalsT Repeat="6" OnDuration="300" OffDuration="5" OnPower="0.85" OffPower="2.0" pace="0" Cadence="90" CadenceResting="110" />
        <SteadyState Duration="360" Power="0.55" pace="0" Cadence="85" />
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="1.15" OffPower="0.55" pace="0" Cadence="100" CadenceResting="85" />
        <SteadyState Duration="120" Power="0.4" pace="0" Cadence="85" />
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="1.15" OffPower="0.55" pace="0" Cadence="100" CadenceResting="85" />
        <Cooldown Duration="540" PowerLow="0.55" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>