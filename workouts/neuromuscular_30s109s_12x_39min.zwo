<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 30s/3.5min 7x (41min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 7 x (30s @ 205% / 3.5min @ 50%) | Cooldown: 5min from 70% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="30" Power="2.05" pace="0" />
        <SteadyState Duration="210" Power="0.5" pace="0" />
