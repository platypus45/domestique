<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 30s/6min 3x (70min)</name>
    <description>Warmup: 10min from 50% to 65% FTP | Microintervals: 3 x (30s @ 160% / 6min @ 87%) | Cooldown: 10min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <SteadyState Duration="300" Power="0.87" pace="0" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="360" OnPower="1.6" OffPower="0.87" pace="0" />
        <SteadyState Duration="300" Power="0.87" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="265" OnPower="1.6" OffPower="0.87" pace="0" Cadence="105" CadenceResting="85" />
        <Cooldown Duration="600" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>