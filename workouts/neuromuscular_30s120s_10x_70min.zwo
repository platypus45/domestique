<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 30s/2min 10x (70min)</name>
    <description>Warmup: 10min from 50% to 65% FTP | Microintervals: 10 x (30s @ 160% / 2min @ 87%) | Cooldown: 10min from 72% to 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <SteadyState Duration="300" Power="0.87" pace="0" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="120" OnPower="1.6" OffPower="0.87" pace="0" />
        <SteadyState Duration="300" Power="0.87" pace="0" />
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="1.6" OffPower="0.87" pace="0" Cadence="105" CadenceResting="85" />
        <Cooldown Duration="600" PowerLow="0.72" PowerHigh="0.55" pace="0" />
    </workout>
</workout_file>