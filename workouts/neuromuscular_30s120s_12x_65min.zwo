<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 30s/235s 7x (65min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Microintervals: 7 x (30s @ 200% / 235s @ 70%) | Cooldown: 8min from 65% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="0.75" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.7" pace="0" />
        <IntervalsT Repeat="7" OnDuration="30" OffDuration="235" OnPower="2.0" OffPower="0.7" pace="0" />
        <Ramp Duration="180" PowerLow="0.9" PowerHigh="1.15" pace="0" />
        <SteadyState Duration="180" Power="0.7" pace="0" />
        <Ramp Duration="180" PowerLow="0.9" PowerHigh="1.15" pace="0" />
        <Cooldown Duration="480" PowerLow="0.65" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>