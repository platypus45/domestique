<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 30s/2min 9x (52min)</name>
    <description>Warmup: 10min from 25% to 100% FTP | Microintervals: 9 x (30s @ 175% / 2min @ 50%) | Cooldown: 5min from 65% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="1.0" pace="0" />
        <IntervalsT Repeat="10" OnDuration="15" OffDuration="45" OnPower="1.75" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="9" OnDuration="30" OffDuration="120" OnPower="1.75" OffPower="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>