<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 30s/3min 10x (55min)</name>
    <description>Warmup: 9min from 25% to 75% FTP | Microintervals: 10 x (30s @ 200% / 3min @ 55%) | Cooldown: 10min from 75% to 25% FTP</description>
