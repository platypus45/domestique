        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="1" OnDuration="30" OffDuration="210" OnPower="2.25" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="210" OnPower="2.25" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="210" OnPower="2.25" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="210" OnPower="2.25" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="210" OnPower="2.25" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="90" OnPower="2.25" OffPower="0.55" pace="0" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.4" /></workout>
</workout_file>