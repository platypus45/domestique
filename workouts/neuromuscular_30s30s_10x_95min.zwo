<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 30s/30s 10x (95min)</name>
    <description>Warmup: 10min from 40% to 75% FTP | Microintervals: 10 x (30s @ 150% / 30s @ 65%) | Cooldown: 3min from 50% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.75" pace="0" />
