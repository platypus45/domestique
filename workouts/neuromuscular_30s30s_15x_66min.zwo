<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 30s/30s 15x (66min)</name>
    <description>Warmup: 5min from 50% to 85% FTP | Microintervals: 15 x (30s @ 130% / 30s @ 71%) | Cooldown: 10min from 75% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.5" PowerHigh="0.85" pace="0" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <IntervalsT Repeat="15" OnDuration="30" OffDuration="30" OnPower="1.3" OffPower="0.71" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <IntervalsT Repeat="6" OnDuration="15" OffDuration="15" OnPower="1.6" OffPower="0.6" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <IntervalsT Repeat="4" OnDuration="15" OffDuration="15" OnPower="1.6" OffPower="0.6" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <SteadyState Duration="180" Power="1.09" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <SteadyState Duration="120" Power="1.25" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <SteadyState Duration="60" Power="1.35" pace="0" />
        <Cooldown Duration="600" PowerLow="0.75" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>