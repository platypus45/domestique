<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 30s/30s 24x (67min)</name>
    <description>Microintervals: 24 x (30s @ 115% / 30s @ 50%) | Cooldown: 5min from 70% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="4" OnDuration="10" OffDuration="50" OnPower="2.0" OffPower="0.65" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Ramp Duration="300" PowerLow="0.5" PowerHigh="0.85" pace="0" />
        <SteadyState Duration="300" Power="0.92" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="12" OnDuration="30" OffDuration="30" OnPower="1.15" OffPower="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="12" OnDuration="30" OffDuration="30" OnPower="1.15" OffPower="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.7" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>