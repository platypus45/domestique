<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 30s/1.5min 16x (72min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 16 x (30s @ 170% / 1.5min @ 50%) | Cooldown: 10min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" />
        <IntervalsT Repeat="6" OnDuration="30" OffDuration="90" OnPower="1.7" OffPower="0.5" pace="0" />
        <SteadyState Duration="600" Power="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="30" OffDuration="90" OnPower="1.7" OffPower="0.5" pace="0" />
        <SteadyState Duration="600" Power="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="30" OffDuration="90" OnPower="1.7" OffPower="0.5" pace="0" />
        <SteadyState Duration="600" Power="0.5" pace="0" />
    </workout>
</workout_file>