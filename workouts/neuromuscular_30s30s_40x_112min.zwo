<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 30s/55s 25x (112min)</name>
    <description>Warmup: 12min from 35% to 90% FTP | Microintervals: 25 x (30s @ 140% / 55s @ 35%) | Cooldown: 7min from 60% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="720" PowerLow="0.35" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="13" OnDuration="30" OffDuration="55" OnPower="1.4" OffPower="0.35" pace="0" />
        <SteadyState Duration="475" Power="0.5" pace="0" />
        <IntervalsT Repeat="12" OnDuration="30" OffDuration="55" OnPower="1.4" OffPower="0.35" pace="0" />
        <SteadyState Duration="475" Power="0.5" pace="0" />
        <Ramp Duration="300" PowerLow="0.75" PowerHigh="0.9" pace="0" />
        <Ramp Duration="300" PowerLow="0.75" PowerHigh="0.9" pace="0" />
        <Ramp Duration="300" PowerLow="0.75" PowerHigh="0.9" pace="0" />
        <Ramp Duration="300" PowerLow="0.75" PowerHigh="0.9" pace="0" />
        <Ramp Duration="300" PowerLow="0.75" PowerHigh="0.9" pace="0" />
        <Ramp Duration="300" PowerLow="0.75" PowerHigh="0.9" pace="0" />
        <Ramp Duration="300" PowerLow="0.75" PowerHigh="0.9" pace="0" />
        <Ramp Duration="300" PowerLow="0.75" PowerHigh="0.9" pace="0" />
        <Cooldown Duration="420" PowerLow="0.60" PowerHigh="0.25" pace="0" />
