<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 30s/30s 8x (54min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 8 x (30s @ 140% / 30s @ 30%) | Cooldown: 5min 30s from 30% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="30" Power="1.09" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.09" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="8" OnDuration="30" OffDuration="30" OnPower="1.4" OffPower="0.3" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="8" OnDuration="20" OffDuration="30" OnPower="1.6" OffPower="0.3" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="8" OnDuration="10" OffDuration="30" OnPower="1.7" OffPower="0.3" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
    </workout>
</workout_file>