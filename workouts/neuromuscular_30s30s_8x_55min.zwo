<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 30s/30s 8x (58min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 8 x (30s @ 108% / 30s @ 50%) | Cooldown: 5min 30s @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="30" Power="1.01" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.01" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="8" OnDuration="30" OffDuration="30" OnPower="1.08" OffPower="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="8" OnDuration="30" OffDuration="30" OnPower="1.09" OffPower="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="8" OnDuration="30" OffDuration="30" OnPower="1.1" OffPower="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
    </workout>
</workout_file>