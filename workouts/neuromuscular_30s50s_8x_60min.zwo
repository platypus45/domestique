<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 30s/50s 8x (60min)</name>
    <description>Warmup: 3min 30s from 40% to 55% FTP | Microintervals: 8 x (30s @ 150% / 50s @ 50%) | Cooldown: 5min 40s from 75% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="210" PowerLow="0.4" PowerHigh="0.55" pace="0" />
        <IntervalsT Repeat="4" OnDuration="15" OffDuration="30" OnPower="1.1" OffPower="0.5" pace="0" />
        <Ramp Duration="150" PowerLow="0.5" PowerHigh="0.65" pace="0" />
        <IntervalsT Repeat="4" OnDuration="15" OffDuration="30" OnPower="1.2" OffPower="0.5" pace="0" />
        <Ramp Duration="150" PowerLow="0.6" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="4" OnDuration="15" OffDuration="30" OnPower="1.3" OffPower="0.5" pace="0" />
        <SteadyState Duration="60" Power="0.6" pace="0" />
        <SteadyState Duration="60" Power="0.7" pace="0" />
        <SteadyState Duration="60" Power="0.8" pace="0" />
        <IntervalsT Repeat="8" OnDuration="30" OffDuration="50" OnPower="1.5" OffPower="0.5" pace="0" />
        <SteadyState Duration="210" Power="0.5" pace="0" />
        <IntervalsT Repeat="8" OnDuration="20" OffDuration="40" OnPower="1.75" OffPower="0.5" pace="0" />
        <SteadyState Duration="210" Power="0.5" pace="0" />
        <IntervalsT Repeat="8" OnDuration="10" OffDuration="25" OnPower="2.0" OffPower="0.5" pace="0" />
        <SteadyState Duration="210" Power="0.5" pace="0" />
        <Cooldown Duration="340" PowerLow="0.75" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>