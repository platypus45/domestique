<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 30s/70s 6x (67min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 6 x (30s @ 150% / 70s @ 50%) | Cooldown: 5min 40s from 75% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="630" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="4" OnDuration="15" OffDuration="30" OnPower="1.1" OffPower="0.5" pace="0" />
        <Ramp Duration="150" PowerLow="0.5" PowerHigh="0.65" pace="0" />
        <IntervalsT Repeat="4" OnDuration="15" OffDuration="30" OnPower="1.2" OffPower="0.5" pace="0" />
        <Ramp Duration="150" PowerLow="0.6" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="4" OnDuration="15" OffDuration="30" OnPower="1.3" OffPower="0.5" pace="0" />
        <SteadyState Duration="60" Power="0.6" pace="0" />
        <SteadyState Duration="60" Power="0.7" pace="0" />
        <SteadyState Duration="60" Power="0.8" pace="0" />
        <IntervalsT Repeat="6" OnDuration="30" OffDuration="70" OnPower="1.5" OffPower="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="6" OnDuration="20" OffDuration="60" OnPower="1.75" OffPower="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="10" OffDuration="35" OnPower="2.0" OffPower="0.5" pace="0" />
        <SteadyState Duration="210" Power="0.5" pace="0" />
        <Cooldown Duration="340" PowerLow="0.75" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>