<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 30s/1min 10x (62min)</name>
    <description>Warmup: 8min from 50% to 85% FTP | Microintervals: 10 x (30s @ 170% / 1min @ 50%) | Cooldown: 4min from 50% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
