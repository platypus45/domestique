<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 30s/1min 10x (65min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 10 x (30s @ 170% / 1min @ 50%) | Cooldown: 5min ramp from 75% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="180" Power="0.95" pace="0" Cadence="80" />
        <SteadyState Duration="60" Power="0.6" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" Cadence="70" />
        <SteadyState Duration="60" Power="0.6" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" Cadence="60" />
        <SteadyState Duration="60" Power="0.6" pace="0" />
        <SteadyState Duration="180" Power="1.0" pace="0" Cadence="50" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.7" pace="0" />
        <SteadyState Duration="60" Power="0.9" pace="0" Cadence="70" />
        <SteadyState Duration="60" Power="0.9" pace="0" Cadence="60" />
        <SteadyState Duration="60" Power="0.9" pace="0" Cadence="50" />
        <SteadyState Duration="60" Power="0.9" pace="0" Cadence="60" />
        <SteadyState Duration="60" Power="0.9" pace="0" Cadence="70" />
        <SteadyState Duration="60" Power="0.9" pace="0" Cadence="80" />
        <SteadyState Duration="60" Power="0.9" pace="0" Cadence="90" />
        <SteadyState Duration="60" Power="0.9" pace="0" Cadence="100" />
        <SteadyState Duration="60" Power="0.9" pace="0" Cadence="110" />
        <SteadyState Duration="60" Power="0.9" pace="0" Cadence="120" />
        <SteadyState Duration="60" Power="0.9" pace="0" Cadence="110" />
        <SteadyState Duration="60" Power="0.9" pace="0" Cadence="100" />
        <SteadyState Duration="60" Power="0.9" pace="0" Cadence="90" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="60" OnPower="1.7" OffPower="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.4" /></workout>
</workout_file>