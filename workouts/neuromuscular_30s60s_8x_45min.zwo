<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 30s/1min 8x (45min)</name>
    <description>Warmup: 10min from 50% to 75% FTP | Microintervals: 8 x (30s @ 163% / 1min @ 30%) | Cooldown: 5min from 55% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="60" OnPower="1.0" OffPower="0.8" pace="0" Cadence="90" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.1" OffPower="0.5" pace="0" Cadence="100" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.2" OffPower="0.5" pace="0" Cadence="105" CadenceResting="85" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="30" OffDuration="60" OnPower="1.63" OffPower="0.3" pace="0" Cadence="110" CadenceResting="85" />
        <SteadyState Duration="600" Power="0.65" pace="0" Cadence="85" />
        <IntervalsT Repeat="4" OnDuration="30" OffDuration="60" OnPower="1.63" OffPower="0.3" pace="0" Cadence="110" CadenceResting="85" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>