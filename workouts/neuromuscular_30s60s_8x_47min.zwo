<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 30s/1min 8x (52min)</name>
    <description>Microintervals: 8 x (30s @ 130% / 1min @ 50%)</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="60" Power="0.8" pace="0" />
        <SteadyState Duration="60" Power="0.9" pace="0" />
        <SteadyState Duration="60" Power="0.6" pace="0" />
        <SteadyState Duration="60" Power="0.7" pace="0" />
        <SteadyState Duration="60" Power="0.8" pace="0" />
        <SteadyState Duration="60" Power="0.9" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="30" OnPower="1.1" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="8" OnDuration="10" OffDuration="20" OnPower="1.5" OffPower="0.5" pace="0" />
        <SteadyState Duration="150" Power="0.5" pace="0" />
        <IntervalsT Repeat="8" OnDuration="20" OffDuration="40" OnPower="1.4" OffPower="0.5" pace="0" />
        <SteadyState Duration="150" Power="0.5" pace="0" />
        <IntervalsT Repeat="8" OnDuration="30" OffDuration="60" OnPower="1.3" OffPower="0.5" pace="0" />
        <Cooldown Duration="180" PowerLow="0.50" PowerHigh="0.40" /></workout>
</workout_file>