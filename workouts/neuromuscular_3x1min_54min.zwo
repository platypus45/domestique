<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 3x1min (59min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 3 x (1min @ 150% / 1min 30s @ 55%) | Cooldown: 5min from 65% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="640" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="3" OnDuration="60" OffDuration="90" OnPower="1.5" OffPower="0.55" pace="0" />
        <SteadyState Duration="10" Power="2.65" pace="0" />
