<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 3x2min (53min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 3 x (2min @ 90% / 2min @ 55%) | Cooldown: 2min from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="60" Power="0.8" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <SteadyState Duration="60" Power="0.9" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <SteadyState Duration="60" Power="1.0" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="120" OnPower="0.9" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="4" OnDuration="30" OffDuration="90" OnPower="1.6" OffPower="0.5" pace="0" />
        <SteadyState Duration="210" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="30" OffDuration="90" OnPower="1.6" OffPower="0.5" pace="0" />
        <SteadyState Duration="210" Power="0.5" pace="0" />
        <Cooldown Duration="120" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>