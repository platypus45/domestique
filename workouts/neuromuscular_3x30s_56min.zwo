<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 3x30s (60min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 3 x (30s @ 120% / 1min 30s @ 55%) | Cooldown: 10min from 65% to 25% FTP</description>
