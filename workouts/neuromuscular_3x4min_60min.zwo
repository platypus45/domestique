<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 3x4min (65min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 3 x (4min @ 90% / 2min @ 50%) | Cooldown: 5min from 75% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="20" Power="1.1" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <SteadyState Duration="20" Power="1.15" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <SteadyState Duration="20" Power="1.2" pace="0" />
        <SteadyState Duration="20" Power="0.5" pace="0" />
        <SteadyState Duration="20" Power="1.25" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="240" OffDuration="120" OnPower="0.9" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="30" OffDuration="60" OnPower="1.5" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.75" pace="0" />
        <SteadyState Duration="90" Power="0.85" pace="0" />
        <SteadyState Duration="60" Power="0.95" pace="0" />
        <SteadyState Duration="30" Power="1.05" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="15" OffDuration="45" OnPower="1.8" OffPower="0.4" pace="0" />
        <SteadyState Duration="25" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.75" pace="0" />
        <SteadyState Duration="90" Power="0.85" pace="0" />
        <SteadyState Duration="60" Power="0.95" pace="0" />
        <SteadyState Duration="30" Power="1.05" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="15" OffDuration="45" OnPower="1.8" OffPower="0.4" pace="0" />
        <SteadyState Duration="25" Power="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>