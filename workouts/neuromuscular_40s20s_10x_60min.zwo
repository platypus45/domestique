<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 40s/35s 6x (60min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Microintervals: 6 x (40s @ 125% / 35s @ 50%) | Cooldown: 5min from 50% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="50" OnPower="1.15" OffPower="0.5" pace="0" />
        <FreeRide Duration="200" FlatRoad="0" />
        <IntervalsT Repeat="6" OnDuration="40" OffDuration="35" OnPower="1.25" OffPower="0.5" pace="0" Cadence="110" CadenceResting="80" />
        <SteadyState Duration="505" Power="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="30" OffDuration="50" OnPower="1.25" OffPower="0.5" pace="0" Cadence="110" CadenceResting="80" />
        <SteadyState Duration="505" Power="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="20" OffDuration="65" OnPower="2.0" OffPower="0.5" pace="0" Cadence="110" CadenceResting="80" />
        <Cooldown Duration="300" PowerLow="0.5" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>