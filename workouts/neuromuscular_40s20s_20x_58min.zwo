<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular Rønnestad-style 2x10x40/20s (58min)</name>
    <description>Microintervals: 20 x (40s @ 109% / 20s @ 55%) | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="10" OffDuration="50" OnPower="1.75" OffPower="0.5" pace="0" Cadence="110" CadenceResting="80" />
        <SteadyState Duration="180" Power="0.7" pace="0" Cadence="85" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="300" Power="0.9" pace="0" Cadence="90" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="10" OnDuration="40" OffDuration="20" OnPower="1.09" OffPower="0.55" pace="0" Cadence="95" CadenceResting="80" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="10" OnDuration="40" OffDuration="20" OnPower="1.09" OffPower="0.55" pace="0" Cadence="95" CadenceResting="80" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="1.25" pace="0" Cadence="90" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
    </workout>
</workout_file>