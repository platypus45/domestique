<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 40s/23s 15x (51min)</name>
    <description>Microintervals: 15 x (40s @ 109% / 23s @ 55%) | Cooldown: 5min 20s from 55% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="10" OffDuration="50" OnPower="1.75" OffPower="0.5" pace="0" Cadence="110" CadenceResting="80" />
        <SteadyState Duration="180" Power="0.7" pace="0" Cadence="95" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.9" pace="0" Cadence="90" />
        <SteadyState Duration="180" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="5" OnDuration="40" OffDuration="30" OnPower="1.09" OffPower="0.55" pace="0" Cadence="95" CadenceResting="80" />
        <SteadyState Duration="300" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="5" OnDuration="40" OffDuration="20" OnPower="1.09" OffPower="0.55" pace="0" Cadence="95" CadenceResting="80" />
        <SteadyState Duration="300" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="5" OnDuration="40" OffDuration="20" OnPower="1.09" OffPower="0.55" pace="0" Cadence="95" CadenceResting="80" />
        <SteadyState Duration="300" Power="0.5" pace="0" Cadence="85" />
    </workout>
</workout_file>