<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 4x10min (110min)</name>
    <description>Warmup: 12min from 35% to 90% FTP | Intervals: 4 x (10min @ 95% / 2min @ 50%) | Cooldown: 8min from 50% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="720" PowerLow="0.35" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="600" OffDuration="120" OnPower="0.95" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="10" OnDuration="15" OffDuration="45" OnPower="2.0" OffPower="0.35" pace="0" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="150" OnPower="2.0" OffPower="0.5" pace="0" />
        <Cooldown Duration="480" PowerLow="0.5" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>