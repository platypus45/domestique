<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 110min — 4×10s/1min @ 280%</name>
    <description>Warmup: 5min from 38% to 68% FTP | Intervals: 4 x (10s @ 280% / 1min @ 79%) | Cooldown: 5min from 60% to 38% FTP</description>
