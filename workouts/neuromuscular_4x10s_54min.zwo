<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 4x10s (62min)</name>
    <description>Intervals: 4 x (10s @ 175% / 50s @ 50%)</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="4" OnDuration="10" OffDuration="50" OnPower="1.75" OffPower="0.5" pace="0" Cadence="110" CadenceResting="80" />
        <SteadyState Duration="180" Power="0.7" pace="0" Cadence="95" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.9" pace="0" Cadence="90" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="300" OffDuration="60" OnPower="0.8" OffPower="0.61" pace="0" Cadence="95" CadenceResting="80" />
        <Cooldown Duration="300" PowerLow="0.61" PowerHigh="0.40" /></workout>
</workout_file>