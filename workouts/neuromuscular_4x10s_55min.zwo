        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <FreeRide Duration="2100" FlatRoad="0" />
    </workout>
</workout_file>