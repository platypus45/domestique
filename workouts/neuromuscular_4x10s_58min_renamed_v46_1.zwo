<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 4x10s (65min)</name>
    <description>Intervals: 4 x (10s @ 175% / 50s @ 50%) | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="4" OnDuration="10" OffDuration="50" OnPower="1.75" OffPower="0.5" pace="0" />
        <SteadyState Duration="240" Power="0.7" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.85" pace="0" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <Ramp Duration="240" PowerLow="0.91" PowerHigh="1.05" pace="0" />
        <SteadyState Duration="120" Power="1.05" pace="0" />
        <Ramp Duration="240" PowerLow="1.05" PowerHigh="0.91" pace="0" />
        <SteadyState Duration="300" Power="0.91" pace="0" />
        <Ramp Duration="240" PowerLow="0.91" PowerHigh="1.05" pace="0" />
        <SteadyState Duration="120" Power="1.05" pace="0" />
        <Ramp Duration="240" PowerLow="1.05" PowerHigh="0.91" pace="0" />
        <SteadyState Duration="300" Power="0.91" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
    </workout>
</workout_file>