<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 4x10s (59min)</name>
    <description>Warmup: 5min from 42% to 70% FTP | Intervals: 4 x (10s @ 175% / 50s @ 50%) | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.42" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.7" pace="0" />
        <IntervalsT Repeat="4" OnDuration="10" OffDuration="50" OnPower="1.75" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="240" Power="0.8" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="45" Power="1.25" pace="0" Cadence="80" />
        <Ramp Duration="255" PowerLow="1.06" PowerHigh="0.88" pace="0" Cadence="90" />
        <SteadyState Duration="45" Power="1.25" pace="0" Cadence="70" />
        <SteadyState Duration="300" Power="0.8" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <Ramp Duration="420" PowerLow="0.88" PowerHigh="1.06" pace="0" />
        <SteadyState Duration="120" Power="0.65" pace="0" />
        <Ramp Duration="180" PowerLow="0.8" PowerHigh="0.98" pace="0" />
        <SteadyState Duration="30" Power="1.25" pace="0" Cadence="60" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <Ramp Duration="180" PowerLow="0.95" PowerHigh="1.07" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" Cadence="70" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
    </workout>
</workout_file>