<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 4x10s (64min)</name>
    <description>Warmup: 5min from 42% to 70% FTP | Intervals: 4 x (10s @ 175% / 50s @ 50%) | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.42" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.7" pace="0" />
        <IntervalsT Repeat="4" OnDuration="10" OffDuration="50" OnPower="1.75" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <Ramp Duration="300" PowerLow="1.03" PowerHigh="1.08" pace="0" />
        <SteadyState Duration="40" Power="1.2" pace="0" Cadence="60" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <Ramp Duration="300" PowerLow="1.03" PowerHigh="1.08" pace="0" />
        <SteadyState Duration="40" Power="1.2" pace="0" Cadence="60" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <Ramp Duration="300" PowerLow="1.03" PowerHigh="1.08" pace="0" />
        <SteadyState Duration="40" Power="1.2" pace="0" Cadence="60" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <Ramp Duration="300" PowerLow="1.03" PowerHigh="1.08" pace="0" />
        <SteadyState Duration="40" Power="1.2" pace="0" Cadence="60" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
    </workout>
</workout_file>