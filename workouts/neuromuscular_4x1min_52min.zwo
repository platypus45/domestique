<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 4x1min (55min)</name>
    <description>Warmup: 10min from 45% to 95% FTP | Intervals: 4 x (1min @ 120% / 1min @ 55%) | Cooldown: 5min ramp from 75% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.95" pace="0" Cadence="85" />
        <IntervalsT Repeat="1" OnDuration="120" OffDuration="20" OnPower="0.4" OffPower="1.55" pace="0" Cadence="100" CadenceResting="85" />
        <SteadyState Duration="120" Power="0.55" pace="0" Cadence="85" />
        <IntervalsT Repeat="4" OnDuration="15" OffDuration="45" OnPower="1.65" OffPower="0.55" pace="0" Cadence="100" CadenceResting="90" />
        <SteadyState Duration="300" Power="0.55" pace="0" Cadence="85" />
        <IntervalsT Repeat="4" OnDuration="30" OffDuration="30" OnPower="1.4" OffPower="0.55" pace="0" Cadence="100" CadenceResting="90" />
        <SteadyState Duration="300" Power="0.55" pace="0" Cadence="85" />
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="1.2" OffPower="0.55" pace="0" Cadence="100" CadenceResting="90" />
        <SteadyState Duration="300" Power="0.55" pace="0" Cadence="85" />
        <IntervalsT Repeat="4" OnDuration="15" OffDuration="45" OnPower="1.65" OffPower="0.55" pace="0" Cadence="100" CadenceResting="90" />
        <Cooldown Duration="340" PowerLow="0.75" PowerHigh="0.4" /></workout>
</workout_file>