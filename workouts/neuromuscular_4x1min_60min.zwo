<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 4x1min (63min)</name>
    <description>Intervals: 4 x (1min @ 90% / 1min @ 110%) | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="180" Power="0.8" pace="0" Cadence="75" />
        <SteadyState Duration="120" Power="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <IntervalsT Repeat="2" OnDuration="10" OffDuration="50" OnPower="2.0" OffPower="0.55" pace="0" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.5" pace="0" />
        <SteadyState Duration="180" Power="1.0" pace="0" />
        <SteadyState Duration="120" Power="0.4" pace="0" />
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="0.9" OffPower="1.1" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.55" pace="0" />
        <SteadyState Duration="180" Power="1.02" pace="0" />
        <SteadyState Duration="120" Power="0.4" pace="0" />
        <SteadyState Duration="600" Power="0.95" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
    </workout>
</workout_file>