<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 4x30s (45min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Intervals: 4 x (30s @ 100% / 30s @ 85%) | Cooldown: 5min from 65% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="4" OnDuration="30" OffDuration="30" OnPower="1.0" OffPower="0.85" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="30" OffDuration="30" OnPower="1.05" OffPower="0.9" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="30" OffDuration="30" OnPower="1.2" OffPower="0.95" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="15" OffDuration="30" OnPower="2.0" OffPower="1.0" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>