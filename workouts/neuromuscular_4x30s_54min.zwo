<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 4x30s (54min)</name>
    <description>Warmup: 10min from 25% to 60% FTP | Intervals: 4 x (30s @ 200% / 0s @ 55%) | Cooldown: 10min from 25% to 75% FTP</description>
