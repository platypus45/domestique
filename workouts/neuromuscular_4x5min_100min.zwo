<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 4x5min (100min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Intervals: 4 x (5min @ 100% / 5min @ 50%) | Cooldown: 10min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="4" OnDuration="300" OffDuration="300" OnPower="1.0" OffPower="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="6" OnDuration="60" OffDuration="120" OnPower="1.25" OffPower="0.5" pace="0" />
        <SteadyState Duration="450" Power="0.5" pace="0" />
        <IntervalsT Repeat="10" OnDuration="15" OffDuration="45" OnPower="1.75" OffPower="0.5" pace="0" />
        <Cooldown Duration="600" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>