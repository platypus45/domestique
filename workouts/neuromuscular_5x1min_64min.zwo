<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 5x1min (64min)</name>
    <description>Warmup: 5min from 45% to 75% FTP | Intervals: 5 x (1min @ 115% / 1min @ 50%) | Cooldown: 5min 35s from 75% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.45" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="5" OnDuration="15" OffDuration="50" OnPower="1.2" OffPower="0.5" pace="0" />
        <SteadyState Duration="360" Power="0.92" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="40" OffDuration="60" OnPower="1.1" OffPower="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.6" pace="0" />
        <IntervalsT Repeat="3" OnDuration="40" OffDuration="60" OnPower="1.1" OffPower="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.6" pace="0" />
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="1.15" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="15" OffDuration="45" OnPower="1.6" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.88" pace="0" />
        <Cooldown Duration="335" PowerLow="0.75" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>