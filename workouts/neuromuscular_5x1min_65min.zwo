<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 5x1min (65min)</name>
    <description>Warmup: 5min 30s from 50% to 55% FTP | Intervals: 5 x (1min @ 130% / 1min @ 50%) | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="0.55" pace="0" />
        <SteadyState Duration="30" Power="0.6" pace="0" />
        <SteadyState Duration="30" Power="0.65" pace="0" />
        <SteadyState Duration="30" Power="0.7" pace="0" />
        <SteadyState Duration="30" Power="0.75" pace="0" />
        <SteadyState Duration="30" Power="0.8" pace="0" />
        <SteadyState Duration="30" Power="0.85" pace="0" />
        <SteadyState Duration="30" Power="0.9" pace="0" />
        <SteadyState Duration="30" Power="0.95" pace="0" />
        <SteadyState Duration="30" Power="1.0" pace="0" />
        <IntervalsT Repeat="5" OnDuration="15" OffDuration="45" OnPower="1.75" OffPower="0.55" pace="0" />
        <SteadyState Duration="150" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="1.0" pace="0" />
        <SteadyState Duration="150" Power="0.8" pace="0" />
        <SteadyState Duration="240" Power="1.0" pace="0" />
        <SteadyState Duration="120" Power="0.8" pace="0" />
        <SteadyState Duration="180" Power="1.0" pace="0" />
        <SteadyState Duration="90" Power="0.8" pace="0" />
        <SteadyState Duration="120" Power="1.0" pace="0" />
        <SteadyState Duration="60" Power="0.8" pace="0" />
        <SteadyState Duration="60" Power="1.0" pace="0" />
        <SteadyState Duration="150" Power="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="1.3" OffPower="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="1.0" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
    </workout>
</workout_file>