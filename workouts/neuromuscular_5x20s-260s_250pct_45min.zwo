<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 5x20s (45min)</name>
    <description>Warmup: 5min @ 55% FTP | Intervals: 5 x (20s @ 250% / 4min 20s @ 55%) | Cooldown: 11min @ 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <Ramp Duration="300" PowerLow="0.6" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <IntervalsT Repeat="5" OnDuration="20" OffDuration="260" OnPower="2.5" OffPower="0.55" pace="0" />
        <SteadyState Duration="420" Power="0.55" pace="0" />
    </workout>
</workout_file>