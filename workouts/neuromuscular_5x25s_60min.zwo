<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 5x25s (67min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 5 x (25s @ 150% / 1min @ 50%) | Cooldown: 5min ramp from 50% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="40" Power="1.05" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.15" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <SteadyState Duration="20" Power="1.25" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <SteadyState Duration="15" Power="1.35" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <SteadyState Duration="20" Power="1.25" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.15" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <SteadyState Duration="40" Power="1.05" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <Ramp Duration="600" PowerLow="0.6" PowerHigh="0.95" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="15" OffDuration="45" OnPower="1.75" OffPower="0.5" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <Ramp Duration="600" PowerLow="0.6" PowerHigh="0.95" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="15" OffDuration="45" OnPower="1.85" OffPower="0.5" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.85" pace="0" />
        <IntervalsT Repeat="5" OnDuration="25" OffDuration="60" OnPower="1.5" OffPower="0.5" pace="0" />
        <Cooldown Duration="310" PowerLow="0.50" PowerHigh="0.40" /></workout>
</workout_file>