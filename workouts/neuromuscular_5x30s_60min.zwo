<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 5x30s (60min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Intervals: 5 x (30s @ 150% / 0s @ 55%) | Cooldown: 10min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="0.75" OffPower="0.5" pace="0" Cadence="110" CadenceResting="80" />
        <SteadyState Duration="30" Power="1.5" pace="0" />
