<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 5x30s (65min)</name>
    <description>Warmup: 10min from 50% to 65% FTP | Intervals: 5 x (30s @ 160% / 3min 30s @ 87%) | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.65" pace="0" />
        <IntervalsT Repeat="5" OnDuration="30" OffDuration="210" OnPower="1.6" OffPower="0.87" pace="0" />
        <SteadyState Duration="300" Power="0.87" pace="0" />
        <SteadyState Duration="300" Power="1.14" pace="0" />
        <SteadyState Duration="300" Power="0.72" pace="0" />
        <SteadyState Duration="300" Power="1.14" pace="0" />
        <SteadyState Duration="300" Power="0.72" pace="0" />
        <SteadyState Duration="300" Power="1.14" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>