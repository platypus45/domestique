<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 5x20s Flying Sprints (40min)</name>
    <description>Warmup: 7min from 45% to 75% FTP + 2 openers | Flying sprints: 5 x (45s @ 78% wind-up, 20s @ 190% flat-out, 3min @ 50%) | Finish: 3min @ 86% tempo | Build speed through the wind-up then unload at full gas already rolling - full recovery after each | Cooldown: 5min from 55% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="420" PowerLow="0.45" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="15" Power="1.1" pace="0" />
        <SteadyState Duration="90" Power="0.55" pace="0" />
        <SteadyState Duration="15" Power="1.2" pace="0" />
        <SteadyState Duration="75" Power="0.55" pace="0" />
        <SteadyState Duration="45" Power="0.78" pace="0" />
        <SteadyState Duration="20" Power="1.9" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="45" Power="0.78" pace="0" />
        <SteadyState Duration="20" Power="1.9" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="45" Power="0.78" pace="0" />
        <SteadyState Duration="20" Power="1.9" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="45" Power="0.78" pace="0" />
        <SteadyState Duration="20" Power="1.9" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
