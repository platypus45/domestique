<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 5x5min (89min)</name>
    <description>Warmup: 15min from 49% to 92% FTP | Intervals: 5 x (5min @ 87% / 5min @ 54%) | Cooldown: 10min from 57% to 49% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.49" PowerHigh="0.92" pace="0" />
        <SteadyState Duration="300" Power="0.51" pace="0" />
        <IntervalsT Repeat="5" OnDuration="300" OffDuration="300" OnPower="0.87" OffPower="0.54" pace="0" Cadence="67" CadenceResting="100" />
        <SteadyState Duration="300" Power="0.51" pace="0" />
        <IntervalsT Repeat="4" OnDuration="15" OffDuration="45" OnPower="3.0" OffPower="0.54" pace="0" Cadence="117" CadenceResting="100" />
        <Cooldown Duration="600" PowerLow="0.57" PowerHigh="0.49" pace="0" />
    </workout>
</workout_file>