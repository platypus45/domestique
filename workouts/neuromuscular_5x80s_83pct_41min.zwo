<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 30s/80s 5x (42min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Microintervals: 5 x (30s @ 200% / 80s @ 83%) | Cooldown: 5min from 60% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="300" Power="0.8" pace="0" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="80" OnPower="2.0" OffPower="0.83" pace="0" />
        <SteadyState Duration="390" Power="0.5" pace="0" />
        <IntervalsT Repeat="2" OnDuration="30" OffDuration="80" OnPower="2.0" OffPower="0.83" pace="0" />
        <SteadyState Duration="300" Power="0.8" pace="0" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>