<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 6s/14s 12x (52min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 12 x (6s @ 150% / 14s @ 75%) | Cooldown: 5min from 60% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="6" Power="1.5" pace="0" />
        <SteadyState Duration="54" Power="0.76" pace="0" />
        <SteadyState Duration="6" Power="1.5" pace="0" />
        <SteadyState Duration="114" Power="0.76" pace="0" />
        <SteadyState Duration="15" Power="1.5" pace="0" />
        <SteadyState Duration="225" Power="0.75" pace="0" />
        <SteadyState Duration="30" Power="1.5" pace="0" />
        <SteadyState Duration="330" Power="0.76" pace="0" />
        <IntervalsT Repeat="12" OnDuration="6" OffDuration="14" OnPower="1.5" OffPower="0.75" pace="0" />
        <SteadyState Duration="360" Power="0.75" pace="0" />
        <IntervalsT Repeat="4" OnDuration="15" OffDuration="45" OnPower="1.5" OffPower="0.75" pace="0" />
        <SteadyState Duration="360" Power="0.75" pace="0" />
        <IntervalsT Repeat="2" OnDuration="30" OffDuration="90" OnPower="1.5" OffPower="0.75" pace="0" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>