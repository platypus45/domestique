<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 6x2min (85min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 6 x (2min @ 88% / 30s @ 140%) | Cooldown: 10min from 60% to 29% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="640" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="10" Power="2" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <SteadyState Duration="10" Power="2" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <SteadyState Duration="60" Power="0.89" pace="0" />
        <SteadyState Duration="900" Power="0.81" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="6" OnDuration="120" OffDuration="30" OnPower="0.88" OffPower="1.4" pace="0" />
        <SteadyState Duration="60" Power="0.88" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.74" pace="0" />
        <SteadyState Duration="420" Power="0.75" pace="0" />
        <IntervalsT Repeat="4" OnDuration="40" OffDuration="20" OnPower="0.92" OffPower="0.84" pace="0" />
        <SteadyState Duration="300" Power="0.89" pace="0" />
        <SteadyState Duration="120" Power="0.97" pace="0" />
        <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.29" pace="0" />
    </workout>
</workout_file>