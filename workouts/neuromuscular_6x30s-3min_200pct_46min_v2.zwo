<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 30s/3min 6x (46min)</name>
    <description>Warmup: 15min from 25% to 65% FTP | Microintervals: 6 x (30s @ 200% / 3min @ 55%) | Cooldown: 10min from 55% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.25" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="30" Power="2.0" pace="0" Cadence="90" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
