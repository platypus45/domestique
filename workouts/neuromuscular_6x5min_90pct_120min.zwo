<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 30s/1min 20x (120min)</name>
    <description>Warmup: 15min from 30% to 90% FTP | Microintervals: 20 x (30s @ 150% / 1min @ 40%) | Cooldown: 5min @ 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.3" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.6" pace="0" />
