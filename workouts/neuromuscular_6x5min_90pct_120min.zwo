        <SteadyState Duration="300" Power="0.9" pace="0" Cadence="80" />
        <SteadyState Duration="300" Power="0.9" pace="0" Cadence="70" />
        <SteadyState Duration="300" Power="0.9" pace="0" Cadence="60" />
        <SteadyState Duration="300" Power="0.6" pace="0" />
