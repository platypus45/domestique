<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 7x10s Peak Sprints (43min)</name>
    <description>Warmup: 7min from 45% to 75% FTP + 3 openers | Peak sprints: 7 x (10s @ 250% / 3min @ 50%) with full recoveries | Finish: 4min @ 85% tempo | Ten seconds of everything you have - peak power lives here, and only full rest lets you find it again | Cooldown: 5min from 55% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="420" PowerLow="0.45" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="15" Power="1.1" pace="0" />
        <SteadyState Duration="75" Power="0.55" pace="0" />
        <SteadyState Duration="15" Power="1.2" pace="0" />
        <SteadyState Duration="75" Power="0.55" pace="0" />
        <SteadyState Duration="15" Power="1.3" pace="0" />
        <SteadyState Duration="45" Power="0.55" pace="0" />
        <IntervalsT Repeat="7" OnDuration="10" OffDuration="180" OnPower="2.5" OffPower="0.5" pace="0" />
        <SteadyState Duration="240" Power="0.85" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>
