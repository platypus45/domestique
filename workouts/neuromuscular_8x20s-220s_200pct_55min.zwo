<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 20s/4min 8x (55min)</name>
    <description>Warmup: 14min from 50% to 75% FTP | Microintervals: 8 x (20s @ 200% / 3min 40s @ 50%) | Cooldown: 9min from 50% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="840" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="8" OnDuration="20" OffDuration="220" OnPower="2" OffPower="0.5" pace="0" />
        <Cooldown Duration="540" PowerLow="0.50" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>