<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 30s/3min 8x (53min)</name>
    <description>Warmup: 15min @ 40% FTP | Microintervals: 8 x (30s @ 200% / 3min @ 55%) | Cooldown: 13min from 55% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="900" Power="0.4" pace="0" />
        <IntervalsT Repeat="8" OnDuration="30" OffDuration="180" OnPower="2.0" OffPower="0.55" pace="0" />
        <SteadyState Duration="600" Power="0.4" pace="0" />
    </workout>
</workout_file>