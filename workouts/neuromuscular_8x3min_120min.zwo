<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 8x3min (121min)</name>
    <description>Warmup: 5min from 30% to 50% FTP | Intervals: 8 x (3min @ 95% / 2min @ 85%) | Cooldown: 5min ramp from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.3" PowerHigh="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <SteadyState Duration="180" Power="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <IntervalsT Repeat="4" OnDuration="15" OffDuration="45" OnPower="2.0" OffPower="0.55" pace="0" />
        <SteadyState Duration="300" Power="1.0" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <IntervalsT Repeat="3" OnDuration="15" OffDuration="45" OnPower="2.0" OffPower="0.55" pace="0" />
        <SteadyState Duration="360" Power="1.0" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <IntervalsT Repeat="2" OnDuration="15" OffDuration="45" OnPower="2.0" OffPower="0.55" pace="0" />
        <SteadyState Duration="420" Power="1.0" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="15" OffDuration="45" OnPower="2.0" OffPower="0.55" pace="0" />
        <SteadyState Duration="480" Power="1.0" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <IntervalsT Repeat="4" OnDuration="180" OffDuration="120" OnPower="0.95" OffPower="0.85" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <IntervalsT Repeat="4" OnDuration="180" OffDuration="120" OnPower="0.95" OffPower="0.85" pace="0" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.40" /></workout>
</workout_file>