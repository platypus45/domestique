<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 10s/2min 12x (35min)</name>
    <description>Warmup: 6min from 50% to 75% FTP | Microintervals: 12 x (10s @ 200% / 1min 50s @ 50%) | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="360" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="12" OnDuration="10" OffDuration="110" OnPower="2" OffPower="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>