    <workout>
        <Warmup Duration="570" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="8" OnDuration="15" OffDuration="165" OnPower="2" OffPower="0.5" pace="0" />
        <Cooldown Duration="390" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>