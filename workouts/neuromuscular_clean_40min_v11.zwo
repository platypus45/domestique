<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 15s/3min 8x (40min)</name>
    <description>Warmup: 9min 30s from 50% to 75% FTP | Microintervals: 8 x (15s @ 200% / 2min 45s @ 50%) | Cooldown: 6min 30s from 65% to 45% FTP</description>
