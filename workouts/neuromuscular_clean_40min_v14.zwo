<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 20s/3min 10x (45min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 10 x (20s @ 200% / 2min 40s @ 50%) | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="10" OnDuration="20" OffDuration="160" OnPower="2" OffPower="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>