<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 3 cycles (32min)</name>
    <description>Over-Under: 3 cycles (alternating above/below threshold) | Cooldown: 1min from 50% to 150% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="60" Power="1.3" pace="0" />
        <SteadyState Duration="120" Power="0.25" pace="0" />
