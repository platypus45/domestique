        <Ramp Duration="60" PowerLow="1.5" PowerHigh="0.25" pace="0" />
        <Ramp Duration="60" PowerLow="0.5" PowerHigh="1.6" pace="0" />
        <Ramp Duration="45" PowerLow="1.6" PowerHigh="0.9" pace="0" />
        <Ramp Duration="45" PowerLow="0.9" PowerHigh="1.6" pace="0" />
        <Ramp Duration="60" PowerLow="1.6" PowerHigh="0.5" pace="0" />
