<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 5 cycles (60min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Over-Under: 5 cycles (alternating above/below threshold) | Cooldown: 6min from 60% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="0.75" OffPower="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.9" pace="0" />
        <SteadyState Duration="120" Power="1.0" pace="0" />
        <SteadyState Duration="15" Power="2.0" pace="0" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <SteadyState Duration="180" Power="0.9" pace="0" />
        <SteadyState Duration="120" Power="1.0" pace="0" />
        <SteadyState Duration="15" Power="2.0" pace="0" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <SteadyState Duration="180" Power="0.9" pace="0" />
        <SteadyState Duration="120" Power="1.0" pace="0" />
        <SteadyState Duration="15" Power="2.0" pace="0" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <SteadyState Duration="180" Power="0.9" pace="0" />
        <SteadyState Duration="120" Power="1.0" pace="0" />
        <SteadyState Duration="15" Power="2.0" pace="0" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <SteadyState Duration="180" Power="0.9" pace="0" />
        <SteadyState Duration="120" Power="1.0" pace="0" />
        <SteadyState Duration="15" Power="2.0" pace="0" />
        <Cooldown Duration="360" PowerLow="0.60" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>