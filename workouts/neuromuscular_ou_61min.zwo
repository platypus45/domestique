<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 5 cycles (61min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Over-Under: 5 cycles (alternating above/below threshold) | Cooldown: 5min from 75% to 25% FTP</description>
