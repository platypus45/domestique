<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 4 cycles (70min)</name>
    <description>Warmup: 15min @ 40% FTP | Over-Under: 4 cycles (alternating above/below threshold) | Cooldown: 20min from 55% to 40% FTP</description>
