<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 10s/10s 12x (67min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 12 x (10s @ 110% / 10s @ 65%) | Cooldown: 5min ramp from 75% to 40% FTP</description>
