        <IntervalsT Repeat="12" OnDuration="10" OffDuration="170" OnPower="1.41" OffPower="0.82" pace="0" />
        <FreeRide Duration="240" FlatRoad="0" />
        <Ramp Duration="600" PowerLow="0.87" PowerHigh="0.95" pace="0" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
