<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 10s/3min 12x (70min)</name>
    <description>Warmup: 15min from 58% to 75% FTP | Microintervals: 12 x (10s @ 141% / 2min 50s @ 82%) | Cooldown: 5min from 75% to 25% FTP</description>
