<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 10x2min (43min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 10 x (2min @ 90% / 45s @ 105%) | Cooldown: 5min from 60% to 45% FTP</description>
