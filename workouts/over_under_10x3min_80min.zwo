<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 10x3min (80min)</name>
    <description>Warmup: 15min from 25% to 75% FTP | Intervals: 10 x (3min @ 90% / 30s @ 110%) | Cooldown: 15min from 65% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.25" PowerHigh="0.75" pace="0" Cadence="75" />
        <IntervalsT Repeat="5" OnDuration="180" OffDuration="30" OnPower="0.9" OffPower="1.1" pace="0" Cadence="75" CadenceResting="65" />
        <SteadyState Duration="900" Power="0.6" pace="0" Cadence="85" />
        <IntervalsT Repeat="5" OnDuration="180" OffDuration="30" OnPower="0.9" OffPower="1.1" pace="0" Cadence="75" CadenceResting="65" />
        <Cooldown Duration="900" PowerLow="0.65" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>