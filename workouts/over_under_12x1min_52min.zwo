<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 12x1min (52min)</name>
    <description>Warmup: 5min from 45% to 75% FTP | Intervals: 12 x (1min @ 92% / 1min @ 97%) | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.45" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="5" OnDuration="30" OffDuration="30" OnPower="0.65" OffPower="0.89" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="240" Power="0.81" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.1" pace="0" />
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="0.92" OffPower="0.97" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.1" pace="0" />
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="0.92" OffPower="0.97" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.1" pace="0" />
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="0.92" OffPower="0.97" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
    </workout>
</workout_file>