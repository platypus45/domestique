<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 12x3min (50min)</name>
    <description>Warmup: 6min from 40% to 90% FTP | Intervals: 12 x (3min @ 95% / 1min @ 50%) | Cooldown: 3min from 25% to 75% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="360" PowerLow="0.4" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
