<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 12x3min (56min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 12 x (3min @ 95% / 1min @ 50%) | Cooldown: 5min ramp from 65% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="180" Power="0.95" pace="0" Cadence="110" />
