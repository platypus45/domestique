<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 12x3min (56min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 12 x (3min @ 95% / 0s @ 55%) | Cooldown: 5min from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="655" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="180" Power="0.95" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <SteadyState Duration="30" Power="1.75" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <SteadyState Duration="20" Power="1.75" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <SteadyState Duration="15" Power="1.75" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.40" pace="0" />
    </workout>
</workout_file>