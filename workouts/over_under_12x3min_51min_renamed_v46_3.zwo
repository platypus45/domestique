<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 12x3min (51min)</name>
    <description>Warmup: 6min from 50% to 90% FTP | Intervals: 12 x (3min @ 95% / 0s @ 55%) | Cooldown: 5min from 75% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="360" PowerLow="0.5" PowerHigh="0.9" pace="0" Cadence="71" />
        <SteadyState Duration="180" Power="0.95" pace="0" Cadence="110" />
        <SteadyState Duration="180" Power="0.95" pace="0" Cadence="55" />
        <SteadyState Duration="180" Power="0.95" pace="0" Cadence="110" />
        <SteadyState Duration="30" Power="2.0" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="180" Power="0.95" pace="0" Cadence="55" />
        <SteadyState Duration="180" Power="0.95" pace="0" Cadence="110" />
        <SteadyState Duration="180" Power="0.95" pace="0" Cadence="55" />
        <SteadyState Duration="20" Power="2.0" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="180" Power="0.95" pace="0" Cadence="110" />
        <SteadyState Duration="180" Power="0.95" pace="0" Cadence="55" />
        <SteadyState Duration="180" Power="0.95" pace="0" Cadence="110" />
        <SteadyState Duration="15" Power="2.0" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="180" Power="0.95" pace="0" Cadence="55" />
        <SteadyState Duration="180" Power="0.95" pace="0" Cadence="110" />
        <SteadyState Duration="180" Power="0.95" pace="0" Cadence="55" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>