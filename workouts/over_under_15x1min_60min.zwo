<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 15x1min (66min)</name>
    <description>Warmup: 10min ramp from 50% to 65% FTP | Intervals: 15 x (1min @ 92% / 1min @ 97%) | Cooldown: 10min from 75% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="630" PowerLow="0.5" PowerHigh="0.65" /><IntervalsT Repeat="5" OnDuration="30" OffDuration="30" OnPower="0.65" OffPower="0.89" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.1" pace="0" />
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="0.92" OffPower="0.97" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.1" pace="0" />
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="0.92" OffPower="0.97" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.1" pace="0" />
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="0.92" OffPower="0.97" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Cooldown Duration="600" PowerLow="0.75" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>