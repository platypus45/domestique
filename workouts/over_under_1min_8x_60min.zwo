<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 1min/4min 8x (68min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 8 x (1min @ 105% / 4min @ 88%) | Cooldown: 5min ramp from 75% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="3" OnDuration="15" OffDuration="30" OnPower="1.05" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="15" OffDuration="30" OnPower="1.15" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="10" OffDuration="30" OnPower="1.25" OffPower="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.6" pace="0" />
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="240" OnPower="1.05" OffPower="0.88" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="240" OnPower="1.05" OffPower="0.88" pace="0" />
        <Cooldown Duration="330" PowerLow="0.75" PowerHigh="0.4" /></workout>
</workout_file>