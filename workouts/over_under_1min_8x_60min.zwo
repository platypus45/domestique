<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 1min/4min 8x (60min)</name>
    <description>Warmup: 4min from 40% to 70% FTP | Microintervals: 8 x (1min @ 105% / 4min @ 88%) | Cooldown: 3min 30s from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="240" PowerLow="0.4" PowerHigh="0.7" pace="0" />
        <IntervalsT Repeat="3" OnDuration="15" OffDuration="30" OnPower="1.05" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="15" OffDuration="30" OnPower="1.15" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="10" OffDuration="30" OnPower="1.25" OffPower="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.6" pace="0" />
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="240" OnPower="1.05" OffPower="0.88" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="240" OnPower="1.05" OffPower="0.88" pace="0" />
        <Cooldown Duration="210" PowerLow="0.6" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>