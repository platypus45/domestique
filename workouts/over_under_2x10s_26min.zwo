<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 28min — 3×10s/1min @ 300%</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Intervals: 3 x (10s @ 300% / 2min @ 70%) | Cooldown: 3min from 30% to 70% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="510" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="10" Power="3" pace="0" />
        <SteadyState Duration="60" Power="0.75" pace="0" />
        <SteadyState Duration="10" Power="3" pace="0" />
        <SteadyState Duration="60" Power="0.75" pace="0" />
        <SteadyState Duration="10" Power="3" pace="0" />
        <SteadyState Duration="240" Power="0.6" pace="0" />
        <SteadyState Duration="600" Power="0.89" pace="0" />
        <Cooldown Duration="180" PowerLow="0.3" PowerHigh="0.7" pace="0" />
    </workout>
</workout_file>