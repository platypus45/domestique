<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 3x10s (26min)</name>
    <description>Warmup: 5min from 30% to 70% FTP | Intervals: 3 x (10s @ 300% / 2min @ 70%) | Cooldown: 3min from 30% to 70% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.3" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="120" Power="0.75" pace="0" />
        <SteadyState Duration="10" Power="3" pace="0" />
        <SteadyState Duration="60" Power="0.75" pace="0" />
        <SteadyState Duration="10" Power="3" pace="0" />
        <SteadyState Duration="60" Power="0.75" pace="0" />
        <SteadyState Duration="10" Power="3" pace="0" />
        <SteadyState Duration="240" Power="0.6" pace="0" />
        <SteadyState Duration="600" Power="0.89" pace="0" />
        <Cooldown Duration="180" PowerLow="0.3" PowerHigh="0.7" pace="0" />
    </workout>
</workout_file>