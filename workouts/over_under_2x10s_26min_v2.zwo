<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 27min — Z2</name>
    <description>Warmup: 5min from 30% to 70% FTP | Steady: 2min @ 75% FTP | Steady: 10s @ 150% FTP | Steady: 1min @ 75% FTP | Steady: 10s @ 200% FTP | Steady: 1min @ 75% FTP | Steady: 10s @ 250% FTP | Steady: 4min @ 60% FTP | Steady: 10min @ 77% FTP | Cooldown: 3min from 30% to 70% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.3" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="120" Power="0.75" pace="0" />
        <SteadyState Duration="10" Power="1.5" pace="0" />
        <SteadyState Duration="60" Power="0.75" pace="0" />
        <SteadyState Duration="10" Power="2" pace="0" />
        <SteadyState Duration="60" Power="0.75" pace="0" />
        <SteadyState Duration="10" Power="2.5" pace="0" />
        <SteadyState Duration="240" Power="0.6" pace="0" />
        <Ramp Duration="600" PowerLow="0.65" PowerHigh="0.89" pace="0" />
        <Cooldown Duration="180" PowerLow="0.3" PowerHigh="0.7" pace="0" />
    </workout>
</workout_file>