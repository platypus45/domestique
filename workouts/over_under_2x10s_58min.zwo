<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 2x10s (58min)</name>
    <description>Warmup: 5min from 45% to 70% FTP | Intervals: 2 x (10s @ 175% / 50s @ 50%) | Cooldown: 5min @ 50% FTP</description>
