    <workout>
        <Warmup Duration="300" PowerLow="0.45" PowerHigh="0.7" pace="0" />
        <IntervalsT Repeat="2" OnDuration="10" OffDuration="50" OnPower="1.75" OffPower="0.5" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.8" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
