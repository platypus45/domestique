<workout_file>
    <author>Domestique Library</author>
    <name>Tempo (31min)</name>
    <description>Warmup: 2min from 40% to 65% FTP | Steady: 2min @ 62% FTP | Steady: 2min @ 72% FTP | Steady: 4min @ 80% FTP | Steady: 1min @ 110% FTP | Steady: 4min @ 80% FTP | Steady: 1min @ 110% FTP | Steady: 4min @ 80% FTP | Steady: 1min @ 60% FTP | Steady: 5min @ 65% FTP | Steady: 2min @ 62% FTP | Cooldown: 3min from 40% to 75% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="120" PowerLow="0.4" PowerHigh="0.65" pace="0" />
        <Ramp Duration="120" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <Ramp Duration="120" PowerLow="0.6" PowerHigh="0.85" pace="0" />
        <SteadyState Duration="240" Power="0.8" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <SteadyState Duration="240" Power="0.8" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <SteadyState Duration="240" Power="0.8" pace="0" />
        <SteadyState Duration="60" Power="0.6" pace="0" />
        <Ramp Duration="300" PowerLow="0.5" PowerHigh="0.8" pace="0" />
        <Ramp Duration="60" PowerLow="0.75" PowerHigh="0.5" pace="0" />
        <Ramp Duration="60" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <Cooldown Duration="180" PowerLow="0.4" PowerHigh="0.75" pace="0" />
    </workout>
