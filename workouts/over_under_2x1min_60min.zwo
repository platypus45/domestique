<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 2x1min (60min)</name>
    <description>Warmup: 5min from 45% to 75% FTP | Intervals: 2 x (1min @ 98% / 1min @ 50%) | Cooldown: 5min @ 50% FTP</description>
