<workout_file>
    <author>Domestique Library</author>
    <name>Tempo (21min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Steady: 20s @ 60% FTP | Steady: 2min @ 80% FTP | Steady: 20s @ 60% FTP | Steady: 2min @ 85% FTP | Steady: 20s @ 60% FTP | Steady: 1min @ 90% FTP | Steady: 20s @ 60% FTP | Steady: 1min @ 95% FTP | Steady: 20s @ 60% FTP | Steady: 30s @ 102% FTP | Steady: 20s @ 60% FTP | Steady: 1min @ 104% FTP | Steady: 20s @ 60% FTP | Steady: 15s @ 110% FTP | Cooldown: 3min ramp from 65% to 40% FTP</description>
