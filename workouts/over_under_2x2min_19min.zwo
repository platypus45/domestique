<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (19min)</name>
    <description>Warmup: 5min from 25% to 75% FTP | Steady: 1min @ 125% FTP | Steady: 2min @ 100% FTP | Steady: 1min @ 115% FTP | Steady: 2min @ 98% FTP | Steady: 2min @ 108% FTP | Steady: 2min @ 95% FTP | Steady: 2min @ 92% FTP | Cooldown: 2min from 25% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="60" Power="1.25" pace="0" />
        <SteadyState Duration="120" Power="1" pace="0" />
        <SteadyState Duration="60" Power="1.15" pace="0" />
        <SteadyState Duration="120" Power="0.98" pace="0" />
        <SteadyState Duration="120" Power="1.08" pace="0" />
        <SteadyState Duration="120" Power="0.95" pace="0" />
        <SteadyState Duration="120" Power="0.92" pace="0" />
        <Cooldown Duration="120" PowerLow="0.25" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>