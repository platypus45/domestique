<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (34min)</name>
    <description>Warmup: 6min from 40% to 70% FTP | Steady: 30s @ 100% FTP | Steady: 30s @ 50% FTP | Steady: 30s @ 110% FTP | Steady: 30s @ 50% FTP | Steady: 30s @ 120% FTP | Steady: 3min @ 50% FTP | Steady: 8min @ 92% FTP | Steady: 3min @ 50% FTP | Steady: 2min @ 90% FTP | Steady: 2min @ 98% FTP | Steady: 2min @ 102% FTP | Cooldown: 5min from 45% to 65% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="360" PowerLow="0.4" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="30" Power="1" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.1" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.2" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="480" Power="0.92" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.9" pace="0" />
        <Ramp Duration="120" PowerLow="0.95" PowerHigh="1" pace="0" />
        <Ramp Duration="120" PowerLow="1" PowerHigh="1.05" pace="0" />
        <Cooldown Duration="300" PowerLow="0.45" PowerHigh="0.65" pace="0" />
    </workout>
</workout_file>