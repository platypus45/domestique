<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (36min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Steady: 30s @ 100% FTP | Steady: 30s @ 50% FTP | Steady: 30s @ 110% FTP | Steady: 30s @ 50% FTP | Steady: 30s @ 120% FTP | Steady: 3min @ 50% FTP | Steady: 8min @ 92% FTP | Steady: 3min @ 50% FTP | Steady: 2min @ 90% FTP | Steady: 2min @ 98% FTP | Steady: 2min @ 102% FTP | Cooldown: 5min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="510" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="30" Power="1" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.1" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.2" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="480" Power="0.92" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.9" pace="0" />
        <Ramp Duration="120" PowerLow="0.95" PowerHigh="1" pace="0" />
        <Ramp Duration="120" PowerLow="1" PowerHigh="1.05" pace="0" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>