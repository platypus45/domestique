<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance 3x10s (9min)</name>
    <description>Warmup: 2min from 65% to 80% FTP | Intervals: 3 x (10s @ 125% / 50s @ 72%) | Cooldown: 2min ramp from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="120" PowerLow="0.65" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="60" Power="0.78" pace="0" />
        <SteadyState Duration="60" Power="0.78" pace="0" />
        <SteadyState Duration="10" Power="1.25" pace="0" />
        <SteadyState Duration="50" Power="0.72" pace="0" />
        <SteadyState Duration="10" Power="1.25" pace="0" />
        <SteadyState Duration="50" Power="0.72" pace="0" />
        <SteadyState Duration="10" Power="1.25" pace="0" />
        <Cooldown Duration="170" PowerLow="0.60" PowerHigh="0.40" /></workout>
</workout_file>