<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 3x10s (7min)</name>
    <description>Warmup: 2min from 65% to 80% FTP | Intervals: 3 x (10s @ 125% / 50s @ 72%) | Cooldown: 50s from 65% to 70% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="120" PowerLow="0.65" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="60" Power="0.78" pace="0" />
        <SteadyState Duration="60" Power="0.78" pace="0" />
        <SteadyState Duration="10" Power="1.25" pace="0" />
        <SteadyState Duration="50" Power="0.72" pace="0" />
        <SteadyState Duration="10" Power="1.25" pace="0" />
        <SteadyState Duration="50" Power="0.72" pace="0" />
        <SteadyState Duration="10" Power="1.25" pace="0" />
        <Cooldown Duration="50" PowerLow="0.65" PowerHigh="0.7" pace="0" />
    </workout>
</workout_file>