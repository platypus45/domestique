<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 4x30s (38min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 4 x (30s @ 115% / 5min @ 65%) | Cooldown: 5min from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="630" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="300" Power="0.95" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <Ramp Duration="30" PowerLow="1.2" PowerHigh="1.1" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <Ramp Duration="30" PowerLow="1.1" PowerHigh="1.2" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <Ramp Duration="30" PowerLow="1.2" PowerHigh="1.1" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.40" pace="0" />
    </workout>
</workout_file>