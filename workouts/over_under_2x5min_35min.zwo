<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 4x30s (35min)</name>
    <description>Warmup: 5min from 40% to 75% FTP | Intervals: 4 x (30s @ 115% / 5min @ 65%) | Cooldown: 5min from 40% to 65% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.4" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Ramp Duration="30" PowerLow="1.1" PowerHigh="1.2" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <Ramp Duration="30" PowerLow="1.2" PowerHigh="1.1" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <Ramp Duration="30" PowerLow="1.1" PowerHigh="1.2" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <Ramp Duration="30" PowerLow="1.2" PowerHigh="1.1" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <Cooldown Duration="300" PowerLow="0.4" PowerHigh="0.65" pace="0" />
    </workout>
</workout_file>