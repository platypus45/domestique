<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (44min)</name>
    <description>Warmup: 10min from 40% to 73% FTP | Steady: 2min @ 73% FTP | Steady: 2min @ 88% FTP | Steady: 1min @ 100% FTP | Steady: 11min @ 53% FTP | Steady: 5min @ 100% FTP | Steady: 3min @ 53% FTP | Steady: 5min @ 100% FTP | Cooldown: 5min ramp from 75% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.73" pace="0" />
        <SteadyState Duration="120" Power="0.73" pace="0" />
        <SteadyState Duration="120" Power="0.88" pace="0" />
        <SteadyState Duration="60" Power="1" pace="0" />
        <SteadyState Duration="300" Power="0.53" pace="0" />
        <SteadyState Duration="360" Power="0.53" pace="0" />
        <SteadyState Duration="300" Power="1" pace="0" />
        <SteadyState Duration="180" Power="0.53" pace="0" />
        <SteadyState Duration="300" Power="1" pace="0" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.4" /></workout>
</workout_file>