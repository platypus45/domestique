<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 3 cycles (51min)</name>
    <description>Warmup: 10min from 46% to 78% FTP | Over-Under: 3 cycles (alternating above/below threshold) | Cooldown: 5min from 49% to 38% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.46" PowerHigh="0.78" pace="0" />
        <SteadyState Duration="300" Power="0.8" pace="0" />
        <SteadyState Duration="300" Power="0.86" pace="0" />
        <SteadyState Duration="300" Power="0.9" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <SteadyState Duration="180" Power="1.05" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <Ramp Duration="180" PowerLow="0.6" PowerHigh="1" pace="0" />
        <SteadyState Duration="120" Power="0.43" pace="0" />
        <SteadyState Duration="30" Power="2.01" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="2" pace="0" />
        <Cooldown Duration="300" PowerLow="0.49" PowerHigh="0.38" pace="0" />
    </workout>
</workout_file>