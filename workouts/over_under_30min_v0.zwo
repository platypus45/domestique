<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo 7 cycles (30min)</name>
    <description>Warmup: 5min from 50% to 75% FTP | Over-Under: 7 cycles (alternating above/below threshold) | Cooldown: 3min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="60" Power="0.7" pace="0" />
        <SteadyState Duration="120" Power="0.85" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <SteadyState Duration="120" Power="0.85" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <SteadyState Duration="120" Power="0.85" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <SteadyState Duration="120" Power="0.85" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <SteadyState Duration="120" Power="0.85" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <SteadyState Duration="120" Power="0.85" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <SteadyState Duration="120" Power="0.85" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <Cooldown Duration="180" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>