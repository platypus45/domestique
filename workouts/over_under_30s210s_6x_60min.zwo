<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 30s/4min 6x (61min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 6 x (30s @ 110% / 3min 30s @ 81%) | Cooldown: 6min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="3" OnDuration="30" OffDuration="30" OnPower="1.2" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.65" pace="0" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="210" OnPower="1.1" OffPower="0.81" pace="0" />
        <SteadyState Duration="120" Power="0.6" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="180" OnPower="1.05" OffPower="0.85" pace="0" />
        <SteadyState Duration="120" Power="0.6" pace="0" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="210" OnPower="1.1" OffPower="0.81" pace="0" />
        <Cooldown Duration="360" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>