<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 30s/40s 10x (70min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 10 x (30s @ 110% / 40s @ 90%) | Cooldown: 5min ramp from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="4" OnDuration="20" OffDuration="30" OnPower="1.1" OffPower="0.5" pace="0" />
        <Ramp Duration="120" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="4" OnDuration="20" OffDuration="30" OnPower="1.15" OffPower="0.5" pace="0" />
        <Ramp Duration="120" PowerLow="0.6" PowerHigh="0.85" pace="0" />
        <IntervalsT Repeat="4" OnDuration="20" OffDuration="30" OnPower="1.2" OffPower="0.5" pace="0" />
        <SteadyState Duration="240" Power="0.8" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <SteadyState Duration="240" Power="0.8" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <SteadyState Duration="240" Power="0.8" pace="0" />
        <SteadyState Duration="90" Power="0.6" pace="0" />
        <IntervalsT Repeat="5" OnDuration="15" OffDuration="45" OnPower="1.5" OffPower="0.5" pace="0" />
        <Ramp Duration="300" PowerLow="0.5" PowerHigh="0.8" pace="0" />
        <IntervalsT Repeat="5" OnDuration="30" OffDuration="40" OnPower="1.1" OffPower="0.9" pace="0" />
        <Ramp Duration="90" PowerLow="0.75" PowerHigh="0.5" pace="0" />
        <Ramp Duration="90" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="5" OnDuration="30" OffDuration="40" OnPower="1.1" OffPower="0.9" pace="0" />
        <Cooldown Duration="350" PowerLow="0.60" PowerHigh="0.40" /></workout>
</workout_file>