<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 3x15s (40min)</name>
    <description>Warmup: 3min from 25% to 75% FTP | Intervals: 3 x (15s @ 140% / 0s @ 55%) | Cooldown: 3min from 25% to 75% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="180" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <Ramp Duration="420" PowerLow="0.8" PowerHigh="1.05" pace="0" />
        <SteadyState Duration="15" Power="1.4" pace="0" />
        <SteadyState Duration="120" Power="1.05" pace="0" />
        <SteadyState Duration="15" Power="2" pace="0" />
        <SteadyState Duration="120" Power="0.8" pace="0" />
        <SteadyState Duration="15" Power="1.4" pace="0" />
        <SteadyState Duration="120" Power="1.05" pace="0" />
        <SteadyState Duration="15" Power="2" pace="0" />
        <SteadyState Duration="120" Power="0.8" pace="0" />
        <SteadyState Duration="15" Power="1.4" pace="0" />
        <SteadyState Duration="120" Power="1.05" pace="0" />
        <SteadyState Duration="15" Power="2" pace="0" />
        <SteadyState Duration="120" Power="0.8" pace="0" />
        <Ramp Duration="420" PowerLow="0.8" PowerHigh="1" pace="0" />
        <Ramp Duration="360" PowerLow="0.5" PowerHigh="1" pace="0" />
        <Cooldown Duration="180" PowerLow="0.25" PowerHigh="0.75" pace="0" />
    </workout>
</workout_file>