<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 3x15s (51min)</name>
    <description>Warmup: 6min from 25% to 90% FTP | Intervals: 3 x (15s @ 175% / 1min 45s @ 50%) | Cooldown: 5min from 75% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="360" PowerLow="0.25" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="300" Power="0.89" pace="0" />
        <SteadyState Duration="180" Power="1.0" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <SteadyState Duration="300" Power="0.89" pace="0" />
        <SteadyState Duration="180" Power="1.0" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <SteadyState Duration="120" Power="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.89" pace="0" />
        <SteadyState Duration="180" Power="1.0" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <IntervalsT Repeat="3" OnDuration="15" OffDuration="105" OnPower="1.75" OffPower="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>