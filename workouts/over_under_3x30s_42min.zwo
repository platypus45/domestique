<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 3x30s (42min)</name>
    <description>Warmup: 5min from 40% to 75% FTP | Intervals: 3 x (30s @ 125% / 6min 30s @ 90%) | Cooldown: 5min from 65% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.4" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="2" OnDuration="10" OffDuration="50" OnPower="1.5" OffPower="0.65" pace="0" Cadence="110" CadenceResting="85" />
        <SteadyState Duration="180" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="390" OnPower="1.25" OffPower="0.9" pace="0" Cadence="105" CadenceResting="90" />
        <SteadyState Duration="180" Power="0.65" pace="0" Cadence="90" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="390" OnPower="1.25" OffPower="0.9" pace="0" Cadence="105" CadenceResting="90" />
        <SteadyState Duration="180" Power="0.65" pace="0" Cadence="90" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="390" OnPower="1.25" OffPower="0.9" pace="0" Cadence="105" CadenceResting="90" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>