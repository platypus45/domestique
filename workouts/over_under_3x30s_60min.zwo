<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance 3x30s (60min)</name>
    <description>Warmup: 3min from 30% to 50% FTP | Intervals: 3 x (30s @ 100% / 3min 40s @ 68%) | Cooldown: 5min from 55% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="180" PowerLow="0.3" PowerHigh="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="180" Power="0.6" pace="0" Cadence="95" />
        <SteadyState Duration="180" Power="0.75" pace="0" Cadence="105" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <IntervalsT Repeat="3" OnDuration="210" OffDuration="30" OnPower="0.75" OffPower="1.0" pace="0" Cadence="90" CadenceResting="115" />
        <SteadyState Duration="240" Power="0.55" pace="0" />
        <IntervalsT Repeat="3" OnDuration="210" OffDuration="30" OnPower="0.75" OffPower="1.15" pace="0" Cadence="90" CadenceResting="115" />
        <SteadyState Duration="240" Power="0.55" pace="0" />
        <IntervalsT Repeat="3" OnDuration="210" OffDuration="30" OnPower="0.75" OffPower="1.3" pace="0" Cadence="90" CadenceResting="115" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>