<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 3x30s (70min)</name>
    <description>Intervals: 3 x (30s @ 120% / 30s @ 55%) | Cooldown: 8min @ 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="120" Power="0.6" pace="0" />
        <SteadyState Duration="120" Power="0.68" pace="0" />
        <SteadyState Duration="120" Power="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.83" pace="0" />
        <SteadyState Duration="120" Power="0.9" pace="0" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="30" OnPower="1.2" OffPower="0.55" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="720" Power="0.75" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <IntervalsT Repeat="4" OnDuration="180" OffDuration="20" OnPower="0.75" OffPower="1.2" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <SteadyState Duration="360" Power="0.75" pace="0" />
        <SteadyState Duration="360" Power="1.0" pace="0" />
        <SteadyState Duration="480" Power="0.4" pace="0" />
    </workout>
</workout_file>