<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (31min)</name>
    <description>Warmup: 3min from 30% to 50% FTP | Steady: 20s @ 105% FTP | Steady: 3min @ 60% FTP | Steady: 20s @ 115% FTP | Steady: 3min @ 75% FTP | Steady: 20s @ 125% FTP | Steady: 5min @ 60% FTP | Steady: 5min @ 70% FTP | Steady: 5min @ 60% FTP | Cooldown: 6min from 40% to 65% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="180" PowerLow="0.3" PowerHigh="0.5" pace="0" />
        <SteadyState Duration="20" Power="1.05" pace="0" />
        <Ramp Duration="180" PowerLow="0.5" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="20" Power="1.15" pace="0" />
        <Ramp Duration="180" PowerLow="0.7" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="20" Power="1.25" pace="0" />
        <SteadyState Duration="300" Power="0.6" pace="0" />
        <SteadyState Duration="300" Power="0.7" pace="0" />
        <SteadyState Duration="300" Power="0.6" pace="0" />
        <Cooldown Duration="360" PowerLow="0.4" PowerHigh="0.65" pace="0" />
    </workout>
</workout_file>