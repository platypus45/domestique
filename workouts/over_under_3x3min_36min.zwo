<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance 3x20s (36min)</name>
    <description>Warmup: 3min from 45% to 55% FTP | Intervals: 3 x (20s @ 125% / 2min 40s @ 62%) | Cooldown: 10min from 50% to 75% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="180" PowerLow="0.45" PowerHigh="0.55" pace="0" />
        <SteadyState Duration="20" Power="1.25" pace="0" />
        <Ramp Duration="180" PowerLow="0.56" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="20" Power="1.25" pace="0" />
        <Ramp Duration="180" PowerLow="0.66" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="20" Power="1.25" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="1.15" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Cooldown Duration="600" PowerLow="0.5" PowerHigh="0.75" pace="0" />
    </workout>
</workout_file>