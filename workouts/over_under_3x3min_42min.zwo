<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 3 cycles (43min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Over-Under: 3 cycles (alternating above/below threshold) | Cooldown: 5min from 50% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="60" Power="0.83" pace="0" />
        <SteadyState Duration="60" Power="0.91" pace="0" />
        <SteadyState Duration="60" Power="1" pace="0" />
        <SteadyState Duration="120" Power="0.6" pace="0" />
        <SteadyState Duration="60" Power="0.85" pace="0" />
        <SteadyState Duration="30" Power="1.1" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="0.85" pace="0" />
        <SteadyState Duration="30" Power="1.19" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="0.85" pace="0" />
        <SteadyState Duration="30" Power="1.25" pace="0" />
        <SteadyState Duration="30" Power="0.49" pace="0" />
        <SteadyState Duration="60" Power="0.6" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.50" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>