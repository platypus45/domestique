<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo 3x20s (53min)</name>
    <description>Warmup: 3min from 30% to 50% FTP | Intervals: 3 x (20s @ 110% / 3min @ 61%) | Cooldown: 5min from 25% to 75% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="180" PowerLow="0.3" PowerHigh="0.5" pace="0" />
        <SteadyState Duration="20" Power="1.1" pace="0" />
        <Ramp Duration="180" PowerLow="0.5" PowerHigh="0.6" pace="0" />
        <SteadyState Duration="20" Power="1.1" pace="0" />
        <Ramp Duration="180" PowerLow="0.6" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="20" Power="1.1" pace="0" />
        <SteadyState Duration="300" Power="0.85" pace="0" />
        <Ramp Duration="900" PowerLow="0.5" PowerHigh="1" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <Ramp Duration="900" PowerLow="1" PowerHigh="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.25" PowerHigh="0.75" pace="0" />
    </workout>
</workout_file>