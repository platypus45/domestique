<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 45s/4min 8x (70min)</name>
    <description>Warmup: 10min from 50% to 72% FTP | Microintervals: 8 x (45s @ 115% / 3min 45s @ 90%) | Cooldown: 5min from 60% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.72" pace="0" />
        <SteadyState Duration="120" Power="0.9" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="45" Power="1.15" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <SteadyState Duration="45" Power="1.15" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="2" OnDuration="45" OffDuration="225" OnPower="1.15" OffPower="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="2" OnDuration="45" OffDuration="225" OnPower="1.15" OffPower="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="2" OnDuration="45" OffDuration="225" OnPower="1.15" OffPower="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="2" OnDuration="45" OffDuration="225" OnPower="1.15" OffPower="0.9" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.6" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>