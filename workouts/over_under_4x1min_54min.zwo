<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 4x1min (55min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 4 x (1min @ 95% / 0s @ 55%) | Cooldown: 5min @ 50% FTP</description>
