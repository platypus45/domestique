<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 4x2min (62min)</name>
    <description>Warmup: 7min from 42% to 75% FTP | Intervals: 4 x (2min @ 95% / 1min @ 85%)</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="420" PowerLow="0.42" PowerHigh="0.75" pace="0" />
        <Ramp Duration="300" PowerLow="0.77" PowerHigh="0.92" pace="0" />
        <Ramp Duration="180" PowerLow="0.93" PowerHigh="1.04" pace="0" />
        <FreeRide Duration="180" FlatRoad="0" />
        <IntervalsT Repeat="5" OnDuration="15" OffDuration="45" OnPower="1.36" OffPower="0.85" pace="0" />
        <FreeRide Duration="180" FlatRoad="0" />
        <IntervalsT Repeat="4" OnDuration="120" OffDuration="60" OnPower="0.95" OffPower="0.85" pace="0" Cadence="55" CadenceResting="90" />
        <FreeRide Duration="180" FlatRoad="0" />
        <IntervalsT Repeat="4" OnDuration="120" OffDuration="60" OnPower="1.02" OffPower="0.85" pace="0" Cadence="90" CadenceResting="70" />
        <Ramp Duration="240" PowerLow="0.85" PowerHigh="1.09" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.40" /></workout>
</workout_file>