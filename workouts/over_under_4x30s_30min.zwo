<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery (30min)</name>
    <description>Warmup: 5min from 55% to 65% FTP | Steady: 5min @ 75% FTP | Steady: 30s @ 82% FTP | Steady: 30s @ 55% FTP | Steady: 30s @ 100% FTP | Steady: 30s @ 55% FTP | Steady: 30s @ 110% FTP | Steady: 30s @ 55% FTP | Steady: 30s @ 115% FTP | Steady: 30s @ 55% FTP | Steady: 30s @ 130% FTP | Steady: 10min @ 55% FTP | Cooldown: 5min from 65% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.55" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.75" pace="0" />
        <SteadyState Duration="30" Power="0.82" pace="0" />
        <SteadyState Duration="30" Power="0.55" pace="0" />
        <SteadyState Duration="30" Power="1" pace="0" />
        <SteadyState Duration="30" Power="0.55" pace="0" />
        <SteadyState Duration="30" Power="1.1" pace="0" />
        <SteadyState Duration="30" Power="0.55" pace="0" />
        <SteadyState Duration="30" Power="1.15" pace="0" />
        <SteadyState Duration="30" Power="0.55" pace="0" />
        <SteadyState Duration="30" Power="1.3" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>