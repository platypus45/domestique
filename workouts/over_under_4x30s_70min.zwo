<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 4x30s (70min)</name>
    <description>Warmup: 25min from 50% to 90% FTP | Intervals: 4 x (30s @ 120% / 4min 30s @ 96%) | Cooldown: 25min from 65% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="1500" PowerLow="0.5" PowerHigh="0.9" pace="0" />
        <IntervalsT Repeat="4" OnDuration="30" OffDuration="270" OnPower="1.2" OffPower="0.96" pace="0" />
        <Cooldown Duration="1500" PowerLow="0.65" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>