<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 4x3min (62min)</name>
    <description>Warmup: 7min from 50% to 75% FTP | Intervals: 4 x (3min @ 90% / 2min @ 65%) | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="420" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="0.9" OffPower="0.7" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.88" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="1" OnDuration="180" OffDuration="120" OnPower="0.9" OffPower="0.65" pace="0" Cadence="100" CadenceResting="80" />
        <SteadyState Duration="60" Power="1.1" pace="0" Cadence="110" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="1" OnDuration="180" OffDuration="120" OnPower="0.9" OffPower="0.65" pace="0" Cadence="100" CadenceResting="80" />
        <SteadyState Duration="60" Power="1.1" pace="0" Cadence="110" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="1" OnDuration="180" OffDuration="120" OnPower="0.9" OffPower="0.65" pace="0" Cadence="100" CadenceResting="80" />
        <SteadyState Duration="60" Power="1.1" pace="0" Cadence="110" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="1" OnDuration="180" OffDuration="120" OnPower="0.9" OffPower="0.65" pace="0" Cadence="100" CadenceResting="80" />
        <SteadyState Duration="60" Power="1.1" pace="0" Cadence="110" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
    </workout>
</workout_file>