<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 4x4min (42min)</name>
    <description>Warmup: 5min from 50% to 60% FTP | Intervals: 4 x (3min 30s @ 88% / 30s @ 105%) | Cooldown: 5min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.5" PowerHigh="0.6" pace="0" />
        <Ramp Duration="300" PowerLow="0.65" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="210" OffDuration="30" OnPower="0.88" OffPower="1.05" pace="0" Cadence="60" CadenceResting="100" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <IntervalsT Repeat="1" OnDuration="210" OffDuration="30" OnPower="0.88" OffPower="1.05" pace="0" Cadence="60" CadenceResting="100" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <IntervalsT Repeat="1" OnDuration="210" OffDuration="30" OnPower="0.88" OffPower="1.05" pace="0" Cadence="60" CadenceResting="100" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <IntervalsT Repeat="1" OnDuration="210" OffDuration="30" OnPower="0.88" OffPower="1.05" pace="0" Cadence="60" CadenceResting="100" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>