<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 3x1min (61min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 3 x (1min @ 85% / 1min @ 60%) | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="120" Power="0.8" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="0.85" OffPower="0.6" pace="0" />
