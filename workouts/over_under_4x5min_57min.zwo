<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 4x5min (62min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 4 x (5min @ 96% / 5min @ 50%) | Cooldown: 5min ramp from 65% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="180" Power="0.95" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="20" Power="1.5" pace="0" />
        <SteadyState Duration="20" Power="0.5" pace="0" />
        <Ramp Duration="300" PowerLow="0.9" PowerHigh="1.04" pace="0" Cadence="75" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.4" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <Ramp Duration="300" PowerLow="0.9" PowerHigh="1.04" pace="0" Cadence="80" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="1.3" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <Ramp Duration="300" PowerLow="0.9" PowerHigh="1.04" pace="0" Cadence="85" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <Cooldown Duration="320" PowerLow="0.65" PowerHigh="0.40" /></workout>
</workout_file>