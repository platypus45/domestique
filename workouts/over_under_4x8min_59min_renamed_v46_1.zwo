<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 4x8min (59min)</name>
    <description>Warmup: 3min from 45% to 60% FTP | Intervals: 4 x (8min @ 98% / 2min @ 50%) | Cooldown: 5min from 45% to 75% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="180" PowerLow="0.45" PowerHigh="0.6" pace="0" />
        <SteadyState Duration="60" Power="0.6" pace="0" />
