<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 5x20s (48min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 5 x (20s @ 95% / 0s @ 55%) | Cooldown: 5min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="600" Power="0.95" pace="0" />
        <Ramp Duration="420" PowerLow="0.95" PowerHigh="1.1" pace="0" />
        <Ramp Duration="360" PowerLow="0.95" PowerHigh="1.1" pace="0" />
        <Ramp Duration="300" PowerLow="0.95" PowerHigh="1.1" pace="0" />
        <SteadyState Duration="30" Power="0.8" pace="0" />
        <SteadyState Duration="20" Power="0.95" pace="0" />
        <SteadyState Duration="10" Power="1.25" pace="0" />
        <SteadyState Duration="30" Power="0.8" pace="0" />
        <SteadyState Duration="20" Power="0.95" pace="0" />
        <SteadyState Duration="10" Power="1.25" pace="0" />
        <SteadyState Duration="30" Power="0.8" pace="0" />
        <SteadyState Duration="20" Power="0.95" pace="0" />
        <SteadyState Duration="10" Power="1.25" pace="0" />
        <SteadyState Duration="30" Power="0.8" pace="0" />
        <SteadyState Duration="20" Power="0.95" pace="0" />
        <SteadyState Duration="10" Power="1.25" pace="0" />
        <SteadyState Duration="30" Power="0.8" pace="0" />
        <SteadyState Duration="20" Power="0.95" pace="0" />
        <SteadyState Duration="10" Power="1.25" pace="0" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>