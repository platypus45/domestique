<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 5x20s (60min)</name>
    <description>Warmup: 10min from 30% to 78% FTP | Intervals: 5 x (20s @ 102% / 1min 8s @ 67%) | Cooldown: 9min from 60% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.3" PowerHigh="0.78" pace="0" />
        <IntervalsT Repeat="5" OnDuration="40" OffDuration="20" OnPower="0.7" OffPower="1.02" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <IntervalsT Repeat="4" OnDuration="240" OffDuration="60" OnPower="0.78" OffPower="1.1" pace="0" Cadence="90" CadenceResting="100" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="300" OffDuration="300" OnPower="0.81" OffPower="0.78" pace="0" />
        <Cooldown Duration="540" PowerLow="0.6" PowerHigh="0.3" pace="0" />
    </workout>
</workout_file>