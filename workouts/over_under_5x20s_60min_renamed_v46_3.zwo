<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 5x20s (62min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Intervals: 5 x (20s @ 125% / 40s @ 60%) | Cooldown: 4min 30s from 60% to 45% FTP</description>
