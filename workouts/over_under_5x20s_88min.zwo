<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 5x20s (88min)</name>
    <description>Warmup: 10min from 40% to 60% FTP | Intervals: 5 x (20s @ 125% / 3min 40s @ 80%) | Cooldown: 5min from 55% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.6" pace="0" />
        <IntervalsT Repeat="1" OnDuration="60" OffDuration="60" OnPower="0.8" OffPower="0.8" pace="0" Cadence="55" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="120" OffDuration="120" OnPower="0.8" OffPower="0.8" pace="0" Cadence="55" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="180" OffDuration="180" OnPower="0.8" OffPower="0.8" pace="0" Cadence="55" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="120" OffDuration="120" OnPower="0.8" OffPower="0.8" pace="0" Cadence="55" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="60" OffDuration="60" OnPower="0.8" OffPower="0.8" pace="0" Cadence="55" CadenceResting="85" />
        <SteadyState Duration="720" Power="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="60" OffDuration="60" OnPower="0.8" OffPower="0.8" pace="0" Cadence="55" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="120" OffDuration="120" OnPower="0.8" OffPower="0.8" pace="0" Cadence="55" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="180" OffDuration="180" OnPower="0.8" OffPower="0.8" pace="0" Cadence="55" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="120" OffDuration="120" OnPower="0.8" OffPower="0.8" pace="0" Cadence="55" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="60" OffDuration="60" OnPower="0.8" OffPower="0.8" pace="0" Cadence="55" CadenceResting="85" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <IntervalsT Repeat="5" OnDuration="220" OffDuration="20" OnPower="0.8" OffPower="1.25" pace="0" Cadence="85" CadenceResting="65" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>