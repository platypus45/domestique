<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 5x2min (63min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 5 x (2min @ 100% / 1min @ 55%) | Cooldown: 7min from 55% to 45% FTP</description>
