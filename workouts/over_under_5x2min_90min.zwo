<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 5x2min (90min)</name>
    <description>Warmup: 10min from 40% to 80% FTP | Intervals: 5 x (2min @ 88% / 1min @ 93%) | Cooldown: 6min from 55% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.8" pace="0" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="0.95" OffPower="0.5" pace="0" Cadence="95" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.05" OffPower="0.5" pace="0" Cadence="105" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.15" OffPower="0.5" pace="0" Cadence="115" CadenceResting="85" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="120" OffDuration="60" OnPower="0.88" OffPower="0.93" pace="0" Cadence="90" CadenceResting="60" />
        <SteadyState Duration="180" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="300" Power="0.75" pace="0" Cadence="70" />
        <SteadyState Duration="300" Power="0.83" pace="0" Cadence="85" />
        <SteadyState Duration="300" Power="0.91" pace="0" Cadence="100" />
        <SteadyState Duration="180" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="300" Power="0.91" pace="0" Cadence="100" />
        <SteadyState Duration="300" Power="0.83" pace="0" Cadence="85" />
        <IntervalsT Repeat="2" OnDuration="120" OffDuration="30" OnPower="0.75" OffPower="0.75" pace="0" Cadence="70" CadenceResting="70" />
        <SteadyState Duration="180" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="30" Power="1.1" pace="0" Cadence="65" />
        <Ramp Duration="30" PowerLow="1.1" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="300" Power="0.75" pace="0" Cadence="90" />
        <Ramp Duration="30" PowerLow="0.75" PowerHigh="1.1" pace="0" />
        <SteadyState Duration="30" Power="1.1" pace="0" Cadence="65" />
        <SteadyState Duration="60" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="30" Power="1.1" pace="0" Cadence="65" />
        <Ramp Duration="30" PowerLow="1.1" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="300" Power="0.75" pace="0" Cadence="90" />
        <Ramp Duration="30" PowerLow="0.75" PowerHigh="1.1" pace="0" />
        <SteadyState Duration="30" Power="1.1" pace="0" Cadence="65" />
        <Cooldown Duration="360" PowerLow="0.55" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>