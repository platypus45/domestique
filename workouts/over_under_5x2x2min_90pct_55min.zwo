<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 14 cycles (55min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Over-Under: 14 cycles (alternating above/below threshold) | Cooldown: 5min ramp from 60% to 40% FTP</description>
