<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 8x2min (65min)</name>
    <description>Warmup: 10min from 40% to 75% FTP | Intervals: 8 x (2min @ 88% / 30s @ 110%) | Cooldown: 5min ramp from 75% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="30" Power="0.8" pace="0" Cadence="95" />
        <SteadyState Duration="30" Power="0.95" pace="0" Cadence="95" />
        <SteadyState Duration="30" Power="0.8" pace="0" Cadence="85" />
        <SteadyState Duration="30" Power="1.05" pace="0" Cadence="105" />
        <SteadyState Duration="30" Power="0.8" pace="0" Cadence="85" />
        <SteadyState Duration="30" Power="1.1" pace="0" Cadence="110" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <Ramp Duration="30" PowerLow="0.5" PowerHigh="0.88" pace="0" />
        <IntervalsT Repeat="4" OnDuration="120" OffDuration="30" OnPower="0.88" OffPower="1.1" pace="0" Cadence="90" CadenceResting="110" />
        <Ramp Duration="30" PowerLow="0.88" PowerHigh="0.5" pace="0" />
        <SteadyState Duration="150" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="5" OnDuration="30" OffDuration="30" OnPower="1.3" OffPower="0.5" pace="0" Cadence="110" CadenceResting="85" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="5" OnDuration="30" OffDuration="30" OnPower="1.3" OffPower="0.5" pace="0" Cadence="110" CadenceResting="85" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="5" OnDuration="30" OffDuration="30" OnPower="1.3" OffPower="0.5" pace="0" Cadence="110" CadenceResting="85" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <Ramp Duration="30" PowerLow="0.5" PowerHigh="0.88" pace="0" />
        <IntervalsT Repeat="4" OnDuration="120" OffDuration="30" OnPower="0.88" OffPower="1.1" pace="0" Cadence="90" CadenceResting="110" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.4" /></workout>
</workout_file>