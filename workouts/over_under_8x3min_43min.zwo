<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 8x3min (43min)</name>
    <description>Warmup: 7min from 50% to 70% FTP | Intervals: 8 x (3min @ 89% / 30s @ 105%) | Cooldown: 5min from 70% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="420" PowerLow="0.5" PowerHigh="0.7" pace="0" Cadence="85" />
        <IntervalsT Repeat="4" OnDuration="180" OffDuration="30" OnPower="0.89" OffPower="1.05" pace="0" Cadence="90" CadenceResting="100" />
        <SteadyState Duration="180" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="4" OnDuration="180" OffDuration="30" OnPower="0.89" OffPower="1.05" pace="0" Cadence="90" CadenceResting="100" />
        <Cooldown Duration="300" PowerLow="0.7" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>