<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 8x3min (46min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 8 x (3min @ 89% / 30s @ 105%) | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="4" OnDuration="180" OffDuration="30" OnPower="0.89" OffPower="1.05" pace="0" Cadence="90" CadenceResting="100" />
        <SteadyState Duration="180" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="4" OnDuration="180" OffDuration="30" OnPower="0.89" OffPower="1.05" pace="0" Cadence="90" CadenceResting="100" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>