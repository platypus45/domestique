    <workout>
        <Warmup Duration="840" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="9" OnDuration="120" OffDuration="60" OnPower="0.9" OffPower="1.05" pace="0" />
        <Cooldown Duration="540" PowerLow="0.60" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>