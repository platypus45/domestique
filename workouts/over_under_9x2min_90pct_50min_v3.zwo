<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 9x2min (50min)</name>
    <description>Warmup: 14min from 50% to 75% FTP | Intervals: 9 x (2min @ 90% / 1min @ 105%) | Cooldown: 9min from 60% to 45% FTP</description>
