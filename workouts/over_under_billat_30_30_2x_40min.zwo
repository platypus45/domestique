<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 6x2min (40min)</name>
    <description>Warmup: 8min from 50% to 75% FTP | Intervals: 6 x (2min @ 90% / 1min @ 105%) | Cooldown: 5min from 55% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="2" OnDuration="30" OffDuration="30" OnPower="1.15" OffPower="0.55" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="60" OnPower="0.9" OffPower="1.05" pace="0" Cadence="90" CadenceResting="75" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="60" OnPower="0.9" OffPower="1.05" pace="0" Cadence="90" CadenceResting="75" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>