<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 8x2min (40min)</name>
    <description>Warmup: 12min from 50% to 75% FTP | Intervals: 8 x (1min 30s @ 90% / 1min @ 105%) | Cooldown: 8min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="720" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="8" OnDuration="90" OffDuration="60" OnPower="0.9" OffPower="1.05" pace="0" />
        <Cooldown Duration="480" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>