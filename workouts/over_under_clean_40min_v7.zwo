<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 10x2min (40min)</name>
    <description>Warmup: 7min 30s from 50% to 75% FTP | Intervals: 10 x (2min @ 90% / 45s @ 105%) | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="450" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="10" OnDuration="120" OffDuration="45" OnPower="0.9" OffPower="1.05" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>