<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 9x2min (47min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 9 x (2min 30s @ 90% / 1min @ 110%) | Cooldown: 5min 30s from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="9" OnDuration="150" OffDuration="60" OnPower="0.9" OffPower="1.1" pace="0" />
        <Cooldown Duration="330" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>