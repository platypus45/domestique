<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 8x2min (45min)</name>
    <description>Warmup: 15min from 50% to 75% FTP | Intervals: 8 x (1min 30s @ 90% / 1min @ 105%) | Cooldown: 10min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="8" OnDuration="90" OffDuration="60" OnPower="0.9" OffPower="1.05" pace="0" />
        <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>