<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 12x2min (52min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 12 x (2min @ 90% / 1min @ 105%) | Cooldown: 5min 30s from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="630" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="12" OnDuration="120" OffDuration="60" OnPower="0.9" OffPower="1.05" pace="0" />
        <Cooldown Duration="330" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>