<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 9x2min (50min)</name>
    <description>Warmup: 11min from 50% to 75% FTP | Intervals: 9 x (2min 30s @ 90% / 1min @ 110%) | Cooldown: 7min 30s from 65% to 45% FTP</description>
