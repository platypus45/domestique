<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (27min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Steady: 1min @ 125% FTP | Steady: 2min @ 100% FTP | Steady: 1min @ 115% FTP | Steady: 2min @ 98% FTP | Steady: 2min @ 108% FTP | Steady: 2min @ 95% FTP | Steady: 2min @ 92% FTP | Cooldown: 5min ramp from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="60" Power="1.25" pace="0" />
        <SteadyState Duration="120" Power="1" pace="0" />
        <SteadyState Duration="60" Power="1.15" pace="0" />
        <SteadyState Duration="120" Power="0.98" pace="0" />
        <SteadyState Duration="120" Power="1.08" pace="0" />
        <SteadyState Duration="120" Power="0.95" pace="0" />
        <SteadyState Duration="120" Power="0.92" pace="0" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.40" /></workout>
</workout_file>