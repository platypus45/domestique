<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance 5 cycles (43min)</name>
    <description>Warmup: 4min ramp from 50% to 70% FTP | Over-Under: 5 cycles (alternating above/below threshold) | Cooldown: 5min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="240" PowerLow="0.5" PowerHigh="0.7" /><SteadyState Duration="120" Power="0.85" pace="0" />
        <SteadyState Duration="15" Power="1.26" pace="0" />
        <SteadyState Duration="120" Power="0.85" pace="0" />
        <SteadyState Duration="30" Power="1.26" pace="0" />
        <SteadyState Duration="120" Power="0.85" pace="0" />
        <SteadyState Duration="45" Power="1.26" pace="0" />
        <SteadyState Duration="180" Power="0.75" pace="0" />
        <SteadyState Duration="180" Power="0.85" pace="0" />
        <SteadyState Duration="180" Power="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <SteadyState Duration="120" Power="0.75" pace="0" />
        <SteadyState Duration="10" Power="2.37" pace="0" />
        <SteadyState Duration="120" Power="0.75" pace="0" />
        <SteadyState Duration="300" Power="0.9" pace="0" />
        <SteadyState Duration="20" Power="1.53" pace="0" />
        <SteadyState Duration="300" Power="0.75" pace="0" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>