<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 3 cycles (56min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Over-Under: 3 cycles (alternating above/below threshold) | Cooldown: 5min from 75% to 25% FTP</description>
