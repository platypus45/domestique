<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 3 cycles (51min)</name>
    <description>Warmup: 6min from 25% to 90% FTP | Over-Under: 3 cycles (alternating above/below threshold) | Cooldown: 5min from 40% to 75% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="360" PowerLow="0.25" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="300" Power="0.89" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <SteadyState Duration="300" Power="0.89" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <SteadyState Duration="120" Power="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.89" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <SteadyState Duration="60" Power="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.9" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.9" pace="0" />
        <Cooldown Duration="300" PowerLow="0.4" PowerHigh="0.75" pace="0" />
    </workout>
</workout_file>