<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 3 cycles (55min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Over-Under: 3 cycles (alternating above/below threshold) | Cooldown: 5min from 75% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="300" Power="0.89" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <SteadyState Duration="300" Power="0.89" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <SteadyState Duration="120" Power="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.89" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <SteadyState Duration="60" Power="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.9" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.9" pace="0" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>