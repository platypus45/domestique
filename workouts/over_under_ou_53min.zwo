<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 5 cycles (53min)</name>
    <description>Warmup: 3min from 45% to 55% FTP | Over-Under: 5 cycles (alternating above/below threshold) | Cooldown: 3min from 45% to 65% FTP</description>
