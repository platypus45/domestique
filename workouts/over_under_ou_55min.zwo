<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 3 cycles (55min)</name>
    <description>Warmup: 8min from 50% to 80% FTP | Over-Under: 3 cycles (alternating above/below threshold) | Cooldown: 5min from 50% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="60" Power="1.5" pace="0" Cadence="110" />
        <Ramp Duration="540" PowerLow="0.88" PowerHigh="0.95" pace="0" Cadence="85" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <SteadyState Duration="45" Power="1.5" pace="0" Cadence="110" />
        <Ramp Duration="555" PowerLow="0.88" PowerHigh="0.95" pace="0" Cadence="85" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <SteadyState Duration="30" Power="1.5" pace="0" Cadence="110" />
        <Ramp Duration="570" PowerLow="0.88" PowerHigh="0.95" pace="0" Cadence="85" />
        <Cooldown Duration="300" PowerLow="0.5" PowerHigh="0.3" pace="0" />
    </workout>
</workout_file>