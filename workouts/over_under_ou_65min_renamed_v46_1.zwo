<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 3 cycles (66min)</name>
    <description>Warmup: 10min from 50% to 70% FTP | Over-Under: 3 cycles (alternating above/below threshold) | Cooldown: 5min ramp from 75% to 40% FTP</description>
