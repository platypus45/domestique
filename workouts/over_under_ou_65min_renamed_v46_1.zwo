<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 3 cycles (65min)</name>
    <description>Warmup: 10min from 50% to 70% FTP | Over-Under: 3 cycles (alternating above/below threshold) | Cooldown: 4min 30s from 55% to 35% FTP</description>
