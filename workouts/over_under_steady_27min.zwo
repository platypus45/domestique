<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (27min)</name>
    <description>Warmup: 4min from 40% to 60% FTP | Steady: 3min @ 55% FTP | Steady: 3min @ 65% FTP | Steady: 2min @ 80% FTP | Steady: 30s @ 90% FTP | Steady: 30s @ 100% FTP | Steady: 3min @ 50% FTP | Steady: 3min @ 110% FTP | Cooldown: 8min from 40% to 60% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="240" PowerLow="0.4" PowerHigh="0.6" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <SteadyState Duration="120" Power="0.8" pace="0" />
        <SteadyState Duration="30" Power="0.9" pace="0" />
        <SteadyState Duration="30" Power="1" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="1.1" pace="0" />
        <Cooldown Duration="480" PowerLow="0.4" PowerHigh="0.6" pace="0" />
    </workout>
</workout_file>