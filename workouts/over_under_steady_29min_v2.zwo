<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery (29min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Steady: 1min @ 50% FTP | Steady: 10s @ 109% FTP | Steady: 2min @ 50% FTP | Steady: 3min @ 73% FTP | Steady: 30s @ 115% FTP | Steady: 4min @ 40% FTP | Steady: 3min @ 73% FTP | Steady: 30s @ 115% FTP | Cooldown: 5min from 25% to 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="10" Power="1.09" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Ramp Duration="180" PowerLow="0.4" PowerHigh="1.05" pace="0" />
        <SteadyState Duration="30" Power="1.15" pace="0" />
        <SteadyState Duration="240" Power="0.4" pace="0" />
        <Ramp Duration="180" PowerLow="0.4" PowerHigh="1.05" pace="0" />
        <SteadyState Duration="30" Power="1.15" pace="0" />
        <Cooldown Duration="300" PowerLow="0.25" PowerHigh="0.55" pace="0" />
    </workout>
</workout_file>