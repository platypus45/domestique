<workout_file>
    <author>Domestique Library</author>
    <name>Recovery (30min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Steady: 1min @ 80% FTP | Steady: 30s @ 95% FTP | Steady: 30s @ 55% FTP | Steady: 1min @ 80% FTP | Steady: 30s @ 105% FTP | Steady: 30s @ 55% FTP | Steady: 1min @ 80% FTP | Steady: 30s @ 115% FTP | Steady: 10min @ 55% FTP | Cooldown: 4min from 55% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="60" Power="0.8" pace="0" />
        <SteadyState Duration="30" Power="0.95" pace="0" />
        <SteadyState Duration="30" Power="0.55" pace="0" />
        <SteadyState Duration="60" Power="0.8" pace="0" />
        <SteadyState Duration="30" Power="1.05" pace="0" />
        <SteadyState Duration="30" Power="0.55" pace="0" />
        <SteadyState Duration="60" Power="0.8" pace="0" />
        <SteadyState Duration="30" Power="1.15" pace="0" />
        <SteadyState Duration="30" Power="0.55" pace="0" />
        <SteadyState Duration="240" Power="0.55" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <Cooldown Duration="240" PowerLow="0.55" PowerHigh="0.25" pace="0" />
    </workout>
