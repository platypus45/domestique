<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery 4x15s (30min)</name>
    <description>Warmup: 5min from 25% to 70% FTP | Intervals: 4 x (15s @ 115% / 2min @ 40%) | Cooldown: 5min from 65% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.25" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="60" Power="0.4" pace="0" />
        <Ramp Duration="180" PowerLow="0.7" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="15" Power="1.15" pace="0" />
        <SteadyState Duration="120" Power="0.4" pace="0" />
        <Ramp Duration="180" PowerLow="0.7" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="15" Power="1.15" pace="0" />
        <SteadyState Duration="120" Power="0.4" pace="0" />
        <Ramp Duration="180" PowerLow="0.7" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="15" Power="1.15" pace="0" />
        <SteadyState Duration="120" Power="0.4" pace="0" />
        <Ramp Duration="180" PowerLow="0.7" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="15" Power="1.15" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>