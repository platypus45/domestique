<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 5 cycles (35min)</name>
    <description>Warmup: 7min from 40% to 75% FTP | Over-Under: 5 cycles (alternating above/below threshold) | Cooldown: 8min from 40% to 75% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="420" PowerLow="0.4" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.95" pace="0" />
        <SteadyState Duration="60" Power="1.05" pace="0" />
        <SteadyState Duration="300" Power="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.85" pace="0" />
        <SteadyState Duration="60" Power="0.95" pace="0" />
        <SteadyState Duration="30" Power="1.25" pace="0" />
        <SteadyState Duration="60" Power="1.09" pace="0" />
        <SteadyState Duration="20" Power="1.25" pace="0" />
        <SteadyState Duration="120" Power="0.95" pace="0" />
        <SteadyState Duration="300" Power="0.85" pace="0" />
        <SteadyState Duration="30" Power="1.25" pace="0" />
        <Cooldown Duration="480" PowerLow="0.4" PowerHigh="0.75" pace="0" />
    </workout>
</workout_file>