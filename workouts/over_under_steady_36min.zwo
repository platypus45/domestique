<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (36min)</name>
    <description>Warmup: 5min from 45% to 75% FTP | Steady: 1min @ 60% FTP | Steady: 1min @ 110% FTP | Steady: 1min @ 60% FTP | Steady: 5min @ 80% FTP | Steady: 7min @ 65% FTP | Steady: 10min @ 97% FTP | Steady: 1min @ 125% FTP | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.45" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="60" Power="0.6" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <SteadyState Duration="60" Power="0.6" pace="0" />
        <SteadyState Duration="300" Power="0.8" pace="0" />
        <SteadyState Duration="60" Power="0.65" pace="0" />
        <SteadyState Duration="120" Power="0.65" pace="0" />
        <SteadyState Duration="120" Power="0.65" pace="0" />
        <SteadyState Duration="120" Power="0.65" pace="0" />
        <Ramp Duration="600" PowerLow="0.92" PowerHigh="1.02" pace="0" />
        <SteadyState Duration="60" Power="1.25" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
    </workout>
</workout_file>