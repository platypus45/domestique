<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery (40min)</name>
    <description>Warmup: 5min from 25% to 70% FTP | Steady: 3min @ 40% FTP | Steady: 7min @ 70% FTP | Steady: 15s @ 105% FTP | Steady: 3min @ 40% FTP | Steady: 4min @ 72% FTP | Steady: 1min @ 90% FTP | Steady: 3min @ 40% FTP | Steady: 5min @ 72% FTP | Steady: 15s @ 115% FTP | Steady: 3min @ 40% FTP | Cooldown: 5min from 65% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.25" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="180" Power="0.4" pace="0" />
        <Ramp Duration="420" PowerLow="0.8" PowerHigh="0.6" pace="0" />
        <SteadyState Duration="15" Power="1.05" pace="0" />
        <SteadyState Duration="180" Power="0.4" pace="0" />
        <Ramp Duration="240" PowerLow="0.6" PowerHigh="0.85" pace="0" />
        <SteadyState Duration="60" Power="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.4" pace="0" />
        <Ramp Duration="300" PowerLow="0.6" PowerHigh="0.85" pace="0" />
        <SteadyState Duration="15" Power="1.15" pace="0" />
        <SteadyState Duration="180" Power="0.4" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>