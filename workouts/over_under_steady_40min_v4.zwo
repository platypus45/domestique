<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max (40min)</name>
    <description>Warmup: 15min from 50% to 75% FTP | Steady: 1min @ 100% FTP | Steady: 1min @ 75% FTP | Steady: 1min @ 100% FTP | Steady: 2min @ 70% FTP | Steady: 5min @ 112% FTP | Cooldown: 15min from 50% to 70% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="60" Power="1" pace="0" />
        <SteadyState Duration="60" Power="0.75" pace="0" />
        <SteadyState Duration="60" Power="1" pace="0" />
        <SteadyState Duration="120" Power="0.7" pace="0" />
        <SteadyState Duration="300" Power="1.12" pace="0" />
        <Cooldown Duration="900" PowerLow="0.5" PowerHigh="0.7" pace="0" />
    </workout>
</workout_file>