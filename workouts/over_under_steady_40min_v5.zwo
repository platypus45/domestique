<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (40min)</name>
    <description>Warmup: 10min from 40% to 75% FTP | Steady: 3min @ 55% FTP | Steady: 2min @ 115% FTP | Steady: 3min @ 75% FTP | Steady: 3min @ 73% FTP | Steady: 3min @ 70% FTP | Steady: 3min @ 63% FTP | Steady: 30s @ 150% FTP | Cooldown: 12min from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="120" Power="1.15" pace="0" />
        <SteadyState Duration="180" Power="0.75" pace="0" />
        <SteadyState Duration="180" Power="0.73" pace="0" />
        <SteadyState Duration="180" Power="0.7" pace="0" />
        <SteadyState Duration="180" Power="0.63" pace="0" />
        <SteadyState Duration="30" Power="1.5" pace="0" />
        <Cooldown Duration="720" PowerLow="0.60" PowerHigh="0.40" pace="0" />
    </workout>
</workout_file>