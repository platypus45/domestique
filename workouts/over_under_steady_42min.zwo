<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (42min)</name>
    <description>Warmup: 8min from 35% to 95% FTP | Steady: 2min @ 45% FTP | Steady: 10min @ 85% FTP | Steady: 30s @ 108% FTP | Steady: 5min @ 40% FTP | Steady: 10min @ 85% FTP | Steady: 30s @ 108% FTP | Steady: 30s @ 40% FTP | Cooldown: 5min from 60% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.35" PowerHigh="0.95" pace="0" />
        <SteadyState Duration="120" Power="0.45" pace="0" />
        <Ramp Duration="600" PowerLow="0.65" PowerHigh="1.05" pace="0" />
        <SteadyState Duration="30" Power="1.08" pace="0" />
        <SteadyState Duration="300" Power="0.4" pace="0" />
        <Ramp Duration="600" PowerLow="0.65" PowerHigh="1.05" pace="0" />
        <SteadyState Duration="30" Power="1.08" pace="0" />
        <SteadyState Duration="30" Power="0.4" pace="0" />
