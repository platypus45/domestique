<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>FTP Test 6 cycles (42min)</name>
    <description>Warmup: 4min from 40% to 70% FTP | Over-Under: 6 cycles (alternating above/below threshold) | Cooldown: 4min from 50% to 65% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="240" PowerLow="0.4" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="240" Power="0.85" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <SteadyState Duration="30" Power="1.2" pace="0" />
        <Ramp Duration="240" PowerLow="0.65" PowerHigh="0.5" pace="0" />
        <SteadyState Duration="240" Power="0.85" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <SteadyState Duration="30" Power="1.2" pace="0" />
        <Ramp Duration="240" PowerLow="0.65" PowerHigh="0.5" pace="0" />
        <SteadyState Duration="240" Power="0.85" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <SteadyState Duration="30" Power="1.2" pace="0" />
        <Cooldown Duration="240" PowerLow="0.5" PowerHigh="0.65" pace="0" />
    </workout>
</workout_file>