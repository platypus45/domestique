<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery (42min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Steady: 5min @ 80% FTP | Steady: 5min @ 85% FTP | Steady: 1min @ 105% FTP | Steady: 5min @ 50% FTP | Steady: 10min @ 80% FTP | Steady: 1min @ 120% FTP | Cooldown: 5min from 60% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="300" Power="0.8" pace="0" />
        <Ramp Duration="300" PowerLow="0.75" PowerHigh="0.95" pace="0" />
        <SteadyState Duration="60" Power="1.05" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <Ramp Duration="600" PowerLow="0.55" PowerHigh="1.05" pace="0" />
        <SteadyState Duration="60" Power="1.2" pace="0" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>