<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (47min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Steady: 2min @ 50% FTP | Steady: 5min @ 95% FTP | Steady: 5min @ 50% FTP | Steady: 30s @ 110% FTP | Steady: 9min @ 91% FTP | Steady: 5min @ 50% FTP | Steady: 30s @ 110% FTP | Steady: 9min @ 91% FTP | Cooldown: 5min from 75% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="300" Power="0.95" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.1" pace="0" />
        <Ramp Duration="540" PowerLow="0.88" PowerHigh="0.94" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.1" pace="0" />
        <Ramp Duration="540" PowerLow="0.88" PowerHigh="0.94" pace="0" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>