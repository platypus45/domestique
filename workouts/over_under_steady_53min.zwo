<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 3 cycles (53min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Over-Under: 3 cycles (alternating above/below threshold) | Cooldown: 6min from 25% to 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
