        <SteadyState Duration="10" Power="1.09" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Ramp Duration="300" PowerLow="0.65" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.92" pace="0" />
        <SteadyState Duration="40" Power="1.15" pace="0" />
        <SteadyState Duration="240" Power="0.4" pace="0" />
        <Ramp Duration="300" PowerLow="0.65" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.92" pace="0" />
        <SteadyState Duration="40" Power="1.15" pace="0" />
        <SteadyState Duration="240" Power="0.4" pace="0" />
        <Ramp Duration="300" PowerLow="0.65" PowerHigh="0.9" pace="0" />
