<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 3x30s (58min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 3 x (30s @ 110% / 0s @ 55%) | Cooldown: 5min from 45% to 75% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="630" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="300" Power="0.95" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.1" pace="0" />
        <Ramp Duration="420" PowerLow="0.88" PowerHigh="0.94" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.1" pace="0" />
        <Ramp Duration="420" PowerLow="0.88" PowerHigh="0.94" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.1" pace="0" />
        <Ramp Duration="420" PowerLow="0.88" PowerHigh="0.94" pace="0" />
        <Cooldown Duration="300" PowerLow="0.45" PowerHigh="0.75" pace="0" />
    </workout>
</workout_file>