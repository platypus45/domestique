<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 3x30s (61min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 3 x (30s @ 140% / 0s @ 55%) | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="630" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="180" Power="0.8" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="1.09" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="1" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.4" pace="0" />
        <Ramp Duration="420" PowerLow="1.05" PowerHigh="0.91" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <SteadyState Duration="30" Power="1.4" pace="0" />
        <Ramp Duration="420" PowerLow="1.05" PowerHigh="0.91" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <SteadyState Duration="30" Power="1.4" pace="0" />
        <Ramp Duration="420" PowerLow="1.05" PowerHigh="0.91" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
    </workout>
</workout_file>