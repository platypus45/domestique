<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 4x5min (57min)</name>
    <description>Warmup: 7min from 45% to 75% FTP | Intervals: 4 x (5min @ 96% / 5min @ 50%) | Cooldown: 3min from 30% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="420" PowerLow="0.45" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="20" Power="1.5" pace="0" />
        <SteadyState Duration="20" Power="0.5" pace="0" />
        <Ramp Duration="300" PowerLow="0.9" PowerHigh="1.04" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.4" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <Ramp Duration="300" PowerLow="0.9" PowerHigh="1.04" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="1.3" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <Ramp Duration="300" PowerLow="0.9" PowerHigh="1.04" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <Cooldown Duration="180" PowerLow="0.3" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>