        <SteadyState Duration="60" Power="0.83" pace="0" />
        <SteadyState Duration="60" Power="0.9" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
    </workout>
</workout_file>