<workout_file>
    <author>Domestique Library</author>
    <name>Recovery (26min)</name>
    <description>Warmup: 10min from 40% to 75% FTP | Steady: 30s @ 80% FTP | Steady: 30s @ 95% FTP | Steady: 30s @ 80% FTP | Steady: 30s @ 105% FTP | Steady: 30s @ 80% FTP | Steady: 30s @ 110% FTP | Steady: 2min @ 50% FTP | Steady: 1min @ 69% FTP | Steady: 8min @ 50% FTP | Steady: 30s @ 69% FTP | Cooldown: 2min from 25% to 50% FTP</description>
    <sportType>bike</sportType>
