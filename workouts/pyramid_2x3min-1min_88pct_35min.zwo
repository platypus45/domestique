<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (35min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Steady: 1min @ 88% FTP | Steady: 1min @ 55% FTP | Steady: 2min @ 88% FTP | Steady: 1min @ 55% FTP | Steady: 3min @ 88% FTP | Steady: 1min @ 55% FTP | Steady: 4min @ 88% FTP | Steady: 1min @ 55% FTP | Steady: 3min @ 88% FTP | Steady: 1min @ 55% FTP | Steady: 2min @ 88% FTP | Steady: 1min @ 55% FTP | Steady: 1min @ 88% FTP | Cooldown: 5min from 60% to 45% FTP</description>
