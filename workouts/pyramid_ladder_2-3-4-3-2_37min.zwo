<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (37min)</name>
    <description>Warmup: 10min from 50% to 70% FTP | Steady: 2min @ 100% FTP | Steady: 2min @ 55% FTP | Steady: 3min @ 100% FTP | Steady: 2min @ 55% FTP | Steady: 4min @ 100% FTP | Steady: 2min @ 55% FTP | Steady: 3min @ 100% FTP | Steady: 2min @ 55% FTP | Steady: 2min @ 100% FTP | Cooldown: 5min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="120" Power="1" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="180" Power="1" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="240" Power="1" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="180" Power="1" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="120" Power="1" pace="0" />
        <Cooldown Duration="300" PowerLow="0.6" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>