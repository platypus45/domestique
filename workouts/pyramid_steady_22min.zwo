<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (22min)</name>
    <description>Warmup: 4min from 35% to 55% FTP | Steady: 4min @ 64% FTP | Steady: 1min @ 75% FTP | Steady: 1min @ 83% FTP | Steady: 30s @ 100% FTP | Steady: 8min @ 55% FTP | Cooldown: 3min from 35% to 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="240" PowerLow="0.35" PowerHigh="0.55" pace="0" />
        <Ramp Duration="240" PowerLow="0.6" PowerHigh="0.68" pace="0" />
        <SteadyState Duration="60" Power="0.75" pace="0" />
        <SteadyState Duration="60" Power="0.83" pace="0" />
        <SteadyState Duration="30" Power="1" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <Cooldown Duration="180" PowerLow="0.35" PowerHigh="0.55" pace="0" />
    </workout>
</workout_file>