<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery (23min)</name>
    <description>Warmup: 8min from 50% to 65% FTP | Steady: 4min @ 85% FTP | Steady: 3min @ 100% FTP | Steady: 1min @ 115% FTP | Steady: 4min @ 55% FTP | Cooldown: 3min from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="240" Power="0.85" pace="0" />
        <SteadyState Duration="180" Power="1" pace="0" />
        <SteadyState Duration="60" Power="1.15" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <Cooldown Duration="180" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>