<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery Rønnestad-style 10x30/30s (60min)</name>
    <description>Warmup: 20min from 25% to 50% FTP | Intervals: 10 x (30s @ 100% / 30s @ 50%)</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="1200" PowerLow="0.25" PowerHigh="0.5" pace="0" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="30" OnPower="1.0" OffPower="0.5" pace="0" />
        <FreeRide Duration="1800" FlatRoad="0" />
    </workout>
</workout_file>