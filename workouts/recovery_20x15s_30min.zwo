<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery Rønnestad-style 20x15/15s (30min)</name>
    <description>Warmup: 10min from 25% to 50% FTP | Intervals: 20 x (15s @ 100% / 15s @ 50%)</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.5" pace="0" />
        <IntervalsT Repeat="20" OnDuration="15" OffDuration="15" OnPower="1.0" OffPower="0.5" pace="0" />
        <FreeRide Duration="600" FlatRoad="0" />
    </workout>
</workout_file>