<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery 2x30s (52min)</name>
    <description>Warmup: 15min from 49% to 92% FTP | Intervals: 2 x (30s @ 125% / 2min 30s @ 49%) | Cooldown: 20min from 64% to 51% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.49" PowerHigh="0.92" pace="0" />
        <SteadyState Duration="180" Power="0.51" pace="0" />
        <IntervalsT Repeat="2" OnDuration="30" OffDuration="150" OnPower="1.25" OffPower="0.49" pace="0" Cadence="105" CadenceResting="100" />
        <SteadyState Duration="300" Power="0.51" pace="0" />
        <FreeRide Duration="180" FlatRoad="0" />
        <Cooldown Duration="1200" PowerLow="0.64" PowerHigh="0.51" pace="0" />
    </workout>
</workout_file>