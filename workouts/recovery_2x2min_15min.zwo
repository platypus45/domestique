<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery Steady (15min)</name>
    <description>Warmup: 5min from 35% to 55% FTP | Steady: 8min @ 55% FTP | Cooldown: 2min from 35% to 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.35" PowerHigh="0.55" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <Cooldown Duration="120" PowerLow="0.35" PowerHigh="0.55" pace="0" />
    </workout>
</workout_file>