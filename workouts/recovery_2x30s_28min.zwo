<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance 3x30s (28min)</name>
    <description>Warmup: 5min @ 50% FTP | Intervals: 3 x (30s @ 130% / 3min @ 55%) | Cooldown: 5min from 30% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <SteadyState Duration="180" Power="0.8" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="30" Power="1.3" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="30" Power="1.3" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="30" Power="1.3" pace="0" />
        <Cooldown Duration="300" PowerLow="0.3" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>