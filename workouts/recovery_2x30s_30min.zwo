<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (30min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Steady: 30s @ 95% FTP | Steady: 30s @ 50% FTP | Steady: 30s @ 105% FTP | Steady: 30s @ 50% FTP | Steady: 30s @ 115% FTP | Steady: 2min 30s @ 50% FTP | Steady: 10min @ 65% FTP | Cooldown: 5min from 25% to 55% FTP</description>
