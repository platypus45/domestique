<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery (34min)</name>
    <description>Warmup: 10min from 50% to 72% FTP | Steady: 2min @ 90% FTP | Steady: 1min @ 50% FTP | Steady: 45s @ 115% FTP | Steady: 30s @ 50% FTP | Steady: 45s @ 115% FTP | Steady: 14min @ 50% FTP | Cooldown: 5min from 50% to 60% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.72" pace="0" />
        <SteadyState Duration="120" Power="0.9" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="45" Power="1.15" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <SteadyState Duration="45" Power="1.15" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.5" PowerHigh="0.6" pace="0" />
    </workout>
</workout_file>