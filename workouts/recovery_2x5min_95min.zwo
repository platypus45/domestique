<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery 2x5min (95min)</name>
    <description>Warmup: 10min from 45% to 65% FTP | Intervals: 2 x (5min @ 88% / 5min @ 52%) | Cooldown: 10min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.65" pace="0" />
        <IntervalsT Repeat="2" OnDuration="300" OffDuration="300" OnPower="0.88" OffPower="0.52" pace="0" />
        <SteadyState Duration="1200" Power="0.52" pace="0" />
        <IntervalsT Repeat="3" OnDuration="10" OffDuration="290" OnPower="1.6" OffPower="0.52" pace="0" />
        <SteadyState Duration="1200" Power="0.52" pace="0" />
        <Cooldown Duration="600" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>