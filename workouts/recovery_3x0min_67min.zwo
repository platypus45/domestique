<workout_file>
    <author>Domestique Library</author>
    <name>Recovery 3x30s (67min)</name>
    <description>Warmup: 15min from 49% to 92% FTP | Intervals: 3 x (30s @ 123% / 2min 30s @ 49%) | Cooldown: 15min from 53% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.49" PowerHigh="0.92" pace="0" />
        <SteadyState Duration="180" Power="0.51" pace="0" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="150" OnPower="1.23" OffPower="0.49" pace="0" Cadence="102" CadenceResting="100" />
        <SteadyState Duration="300" Power="0.53" pace="0" />
        <FreeRide Duration="1200" FlatRoad="0" />
        <Cooldown Duration="900" PowerLow="0.53" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>