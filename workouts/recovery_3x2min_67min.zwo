<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 3x2min (67min)</name>
    <description>Warmup: 8min from 45% to 65% FTP | Intervals: 3 x (2min @ 90% / 2min @ 55%) | Cooldown: 10min from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.45" PowerHigh="0.65" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="0.8" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="120" OnPower="0.9" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="4" OnDuration="20" OffDuration="100" OnPower="1.2" OffPower="0.55" pace="0" />
        <SteadyState Duration="210" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="20" OffDuration="100" OnPower="1.2" OffPower="0.55" pace="0" />
        <SteadyState Duration="210" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="20" OffDuration="100" OnPower="1.2" OffPower="0.55" pace="0" />
        <Cooldown Duration="600" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>