<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (20min)</name>
    <description>Warmup: 3min from 30% to 45% FTP | Steady: 20s @ 95% FTP | Steady: 3min @ 52% FTP | Steady: 20s @ 100% FTP | Steady: 3min @ 68% FTP | Steady: 20s @ 110% FTP | Steady: 5min @ 50% FTP | Cooldown: 5min from 25% to 75% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="180" PowerLow="0.3" PowerHigh="0.45" pace="0" />
        <SteadyState Duration="20" Power="0.95" pace="0" />
        <Ramp Duration="180" PowerLow="0.45" PowerHigh="0.6" pace="0" />
        <SteadyState Duration="20" Power="1" pace="0" />
        <Ramp Duration="180" PowerLow="0.6" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="20" Power="1.1" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.25" PowerHigh="0.75" pace="0" />
    </workout>
</workout_file>