<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery 3x5min (65min)</name>
    <description>Warmup: 10min from 25% to 50% FTP | Intervals: 3 x (5min @ 90% / 10min @ 50%) | Cooldown: 10min from 50% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="300" OffDuration="600" OnPower="0.9" OffPower="0.5" pace="0" />
        <Cooldown Duration="600" PowerLow="0.5" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>