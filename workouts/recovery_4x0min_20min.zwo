<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery 4x8s (23min)</name>
    <description>Warmup: 2min from 35% to 55% FTP | Intervals: 4 x (8s @ 140% / 1min 42s @ 55%)</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="120" PowerLow="0.35" PowerHigh="0.55" pace="0" />
        <SteadyState Duration="60" Power="0.6" pace="0" />
        <SteadyState Duration="60" Power="0.65" pace="0" />
        <SteadyState Duration="60" Power="0.7" pace="0" />
        <SteadyState Duration="60" Power="0.75" pace="0" />
        <SteadyState Duration="60" Power="0.8" pace="0" />
        <SteadyState Duration="60" Power="0.85" pace="0" />
        <SteadyState Duration="60" Power="0.9" pace="0" />
        <SteadyState Duration="120" Power="1.0" pace="0" />
        <SteadyState Duration="120" Power="0.6" pace="0" />
        <IntervalsT Repeat="4" OnDuration="8" OffDuration="102" OnPower="1.4" OffPower="0.55" pace="0" />
    <Cooldown Duration="160" PowerLow="0.7" PowerHigh="0.4" /></workout>
</workout_file>