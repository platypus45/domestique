<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 4x10s (61min)</name>
    <description>Intervals: 4 x (10s @ 150% / 50s @ 50%) | Cooldown: 5min @ 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="10" OffDuration="50" OnPower="1.5" OffPower="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.7" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <Ramp Duration="180" PowerLow="0.65" PowerHigh="1.05" pace="0" Cadence="75" />
        <SteadyState Duration="240" Power="0.55" pace="0" />
        <Ramp Duration="180" PowerLow="0.65" PowerHigh="1.05" pace="0" Cadence="75" />
        <SteadyState Duration="240" Power="0.55" pace="0" />
        <Ramp Duration="180" PowerLow="0.65" PowerHigh="1.05" pace="0" Cadence="75" />
        <SteadyState Duration="240" Power="0.55" pace="0" />
        <Ramp Duration="180" PowerLow="0.75" PowerHigh="0.95" pace="0" Cadence="65" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <Ramp Duration="180" PowerLow="0.75" PowerHigh="0.95" pace="0" Cadence="65" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <Ramp Duration="180" PowerLow="0.75" PowerHigh="0.95" pace="0" Cadence="65" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
    </workout>
</workout_file>