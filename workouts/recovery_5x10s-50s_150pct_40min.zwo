<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery 5x10s (40min)</name>
    <description>Warmup: 10min from 50% to 75% FTP | Intervals: 5 x (10s @ 150% / 50s @ 55%) | Cooldown: 7min from 50% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="5" OnDuration="10" OffDuration="50" OnPower="1.5" OffPower="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <FreeRide Duration="30" FlatRoad="0" />
        <FreeRide Duration="10" FlatRoad="0" />
        <FreeRide Duration="30" FlatRoad="0" />
        <SteadyState Duration="240" Power="0.55" pace="0" />
        <FreeRide Duration="30" FlatRoad="0" />
        <FreeRide Duration="10" FlatRoad="0" />
        <FreeRide Duration="30" FlatRoad="0" />
        <SteadyState Duration="240" Power="0.55" pace="0" />
        <FreeRide Duration="30" FlatRoad="0" />
        <FreeRide Duration="10" FlatRoad="0" />
        <FreeRide Duration="30" FlatRoad="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Cooldown Duration="420" PowerLow="0.50" PowerHigh="0.40" pace="0" />
    </workout>
</workout_file>