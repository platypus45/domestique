<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery 2x30s (30min)</name>
    <description>Warmup: 8min from 40% to 53% FTP | Intervals: 2 x (30s @ 130% / 30s @ 50%) | Cooldown: 2min from 50% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="240" Power="0.4" pace="0" />
        <SteadyState Duration="240" Power="0.53" pace="0" />
        <SteadyState Duration="240" Power="0.67" pace="0" />
        <SteadyState Duration="240" Power="0.8" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="180" Power="1.05" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="60" Power="1.15" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <IntervalsT Repeat="2" OnDuration="30" OffDuration="30" OnPower="1.3" OffPower="0.5" pace="0" />
        <Cooldown Duration="120" PowerLow="0.5" PowerHigh="0.3" pace="0" />
    </workout>
</workout_file>