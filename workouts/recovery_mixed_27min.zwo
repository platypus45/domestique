<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery (27min)</name>
    <description>Warmup: 6min @ 50% FTP | Steady: 1min @ 61% FTP | Steady: 5min @ 72% FTP | Steady: 12min @ 30% FTP | Cooldown: 3min from 20% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <Ramp Duration="60" PowerLow="0.5" PowerHigh="0.72" pace="0" />
        <SteadyState Duration="300" Power="0.72" pace="0" />
        <SteadyState Duration="240" Power="0.3" pace="0" />
        <SteadyState Duration="240" Power="0.3" pace="0" />
        <SteadyState Duration="240" Power="0.3" pace="0" />
        <Cooldown Duration="180" PowerLow="0.2" PowerHigh="0.3" pace="0" />
    </workout>
</workout_file>