<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (36min)</name>
    <description>Warmup: 8min from 50% to 75% FTP | Steady: 15s @ 120% FTP | Steady: 45s @ 55% FTP | Steady: 15s @ 150% FTP | Steady: 1min 45s @ 55% FTP | Steady: 10s @ 65% FTP | Steady: 3min 40s @ 55% FTP | Steady: 20s @ 65% FTP | Steady: 3min 40s @ 55% FTP | Steady: 20s @ 65% FTP | Steady: 3min 40s @ 55% FTP | Steady: 20s @ 65% FTP | Steady: 3min 40s @ 55% FTP | Steady: 20s @ 65% FTP | Steady: 3min 40s @ 55% FTP | Steady: 20s @ 65% FTP | Cooldown: 5min from 55% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="1" OnDuration="15" OffDuration="45" OnPower="1.2" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="15" OffDuration="105" OnPower="1.5" OffPower="0.55" pace="0" />
        <FreeRide Duration="10" FlatRoad="0" />
        <SteadyState Duration="220" Power="0.55" pace="0" />
        <FreeRide Duration="20" FlatRoad="0" />
        <SteadyState Duration="220" Power="0.55" pace="0" />
        <FreeRide Duration="20" FlatRoad="0" />
        <SteadyState Duration="220" Power="0.55" pace="0" />
        <FreeRide Duration="20" FlatRoad="0" />
        <SteadyState Duration="220" Power="0.55" pace="0" />
        <FreeRide Duration="20" FlatRoad="0" />
        <SteadyState Duration="220" Power="0.55" pace="0" />
        <FreeRide Duration="20" FlatRoad="0" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>