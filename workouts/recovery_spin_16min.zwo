<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery (16min)</name>
    <description>Steady: 2min @ 48% FTP | Steady: 2min @ 58% FTP | Steady: 2min @ 68% FTP | Steady: 2min @ 78% FTP | Steady: 2min @ 88% FTP | Steady: 2min @ 98% FTP | Steady: 1min @ 55% FTP | Steady: 1min @ 118% FTP | Cooldown: 2min from 55% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="120" Power="0.48" pace="0" />
        <SteadyState Duration="120" Power="0.58" pace="0" />
        <SteadyState Duration="120" Power="0.68" pace="0" />
        <SteadyState Duration="120" Power="0.78" pace="0" />
        <SteadyState Duration="120" Power="0.88" pace="0" />
        <SteadyState Duration="120" Power="0.98" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <SteadyState Duration="60" Power="1.18" pace="0" />
        <Cooldown Duration="120" PowerLow="0.55" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>