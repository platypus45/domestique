<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>FTP Test (28min)</name>
    <description>Steady: 2min @ 60% FTP | Steady: 2min 30s @ 70% FTP | Steady: 3min @ 80% FTP | Steady: 3min 30s @ 90% FTP | Steady: 45s @ 120% FTP | Steady: 4min @ 45% FTP | Steady: 2min @ 60% FTP | Steady: 2min 30s @ 75% FTP | Steady: 3min @ 85% FTP | Steady: 3min 30s @ 95% FTP | Cooldown: 1min from 55% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="120" Power="0.6" pace="0" />
        <SteadyState Duration="150" Power="0.7" pace="0" />
        <SteadyState Duration="180" Power="0.8" pace="0" />
        <SteadyState Duration="210" Power="0.9" pace="0" />
        <SteadyState Duration="45" Power="1.2" pace="0" />
        <SteadyState Duration="240" Power="0.45" pace="0" />
        <SteadyState Duration="120" Power="0.6" pace="0" />
        <SteadyState Duration="150" Power="0.75" pace="0" />
        <SteadyState Duration="180" Power="0.85" pace="0" />
        <SteadyState Duration="210" Power="0.95" pace="0" />
        <Cooldown Duration="60" PowerLow="0.55" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>