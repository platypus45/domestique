<workout_file>
    <author>Domestique Library</author>
    <name>Recovery (30min)</name>
    <description>Warmup: 5min from 25% to 50% FTP | Steady: 5min @ 50% FTP | Steady: 1min @ 60% FTP | Steady: 30s @ 65% FTP | Steady: 5min @ 50% FTP | Steady: 1min @ 60% FTP | Steady: 30s @ 65% FTP | Steady: 4min @ 50% FTP | Steady: 1min @ 60% FTP | Steady: 30s @ 65% FTP | Steady: 3min @ 50% FTP | Steady: 1min @ 60% FTP | Steady: 30s @ 65% FTP | Cooldown: 2min from 50% to 25% FTP</description>
    <sportType>bike</sportType>
