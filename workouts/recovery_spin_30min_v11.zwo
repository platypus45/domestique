<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery Steady (30min)</name>
    <description>Warmup: 15min from 25% to 65% FTP | Cooldown: 15min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.25" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="900" Power="0.5" pace="0" />
    </workout>
</workout_file>