<workout_file>
    <author>Domestique Library</author>
    <name>Mixed (30min)</name>
    <description>Warmup: 3min from 55% to 75% FTP | Steady: 2min @ 50% FTP | Steady: 3min @ 85% FTP | Steady: 2min @ 50% FTP | Steady: 1min @ 95% FTP | Steady: 1min @ 50% FTP | Steady: 2min @ 95% FTP | Steady: 2min @ 50% FTP | Steady: 2min @ 102% FTP | Steady: 2min @ 50% FTP | Steady: 1min @ 110% FTP | Steady: 2min @ 50% FTP | Steady: 2min @ 110% FTP | Steady: 2min @ 50% FTP | Cooldown: 3min from 65% to 45% FTP</description>
