<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo 4x1min (40min)</name>
    <description>Warmup: 8min from 55% to 80% FTP | Intervals: 4 x (1min @ 102% / 4min @ 82%) | Cooldown: 4min from 65% to 45% FTP</description>
