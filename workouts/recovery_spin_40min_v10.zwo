    <workout>
        <Warmup Duration="480" PowerLow="0.55" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="120" Power="0.76" pace="0" />
        <SteadyState Duration="60" Power="1.02" pace="0" />
        <SteadyState Duration="240" Power="0.8" pace="0" />
        <SteadyState Duration="60" Power="1.02" pace="0" />
        <SteadyState Duration="120" Power="0.86" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <SteadyState Duration="120" Power="0.8" pace="0" />
        <SteadyState Duration="60" Power="1.02" pace="0" />
        <SteadyState Duration="240" Power="0.84" pace="0" />
        <SteadyState Duration="60" Power="1.02" pace="0" />
        <SteadyState Duration="120" Power="0.9" pace="0" />
        <Cooldown Duration="240" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>