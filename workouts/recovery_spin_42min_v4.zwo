<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (42min)</name>
    <description>Steady: 2min @ 60% FTP | Steady: 2min @ 70% FTP | Steady: 2min @ 80% FTP | Steady: 1min @ 90% FTP | Steady: 3min @ 55% FTP | Steady: 4min @ 100% FTP | Steady: 3min @ 55% FTP | Steady: 4min @ 100% FTP | Steady: 3min @ 55% FTP | Steady: 30s @ 65% FTP | Steady: 2min @ 55% FTP | Steady: 30s @ 65% FTP | Steady: 2min @ 55% FTP | Steady: 2min @ 65% FTP | Steady: 4min @ 55% FTP | Steady: 2min @ 65% FTP | Cooldown: 5min from 65% to 45% FTP</description>
