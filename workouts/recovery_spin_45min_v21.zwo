<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery 1min/4min 6x (45min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Microintervals: 6 x (1min @ 110% / 4min @ 50%) | Cooldown: 5min from 50% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" Cadence="60" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" Cadence="60" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" Cadence="60" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" Cadence="60" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" Cadence="60" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" Cadence="60" />
        <Cooldown Duration="300" PowerLow="0.5" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>