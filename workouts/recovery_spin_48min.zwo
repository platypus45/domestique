<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (52min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Steady: 1min @ 55% FTP | Steady: 5min @ 81% FTP | Steady: 3min @ 50% FTP | Steady: 6min @ 98% FTP | Steady: 2min @ 55% FTP | Steady: 6min @ 95% FTP | Steady: 2min @ 55% FTP | Steady: 6min @ 91% FTP | Steady: 2min @ 55% FTP | Cooldown: 10min from 75% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="300" Power="0.81" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="360" Power="0.98" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="360" Power="0.95" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="360" Power="0.91" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <Cooldown Duration="600" PowerLow="0.75" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>