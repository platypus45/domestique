<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 3x30s (51min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Intervals: 3 x (30s @ 120% / 1min 30s @ 55%) | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="30" Power="1.2" pace="0" Cadence="125" />
        <SteadyState Duration="90" Power="0.55" pace="0" />
        <SteadyState Duration="30" Power="1.2" pace="0" Cadence="125" />
        <SteadyState Duration="90" Power="0.55" pace="0" />
        <SteadyState Duration="30" Power="1.2" pace="0" Cadence="125" />
        <SteadyState Duration="90" Power="0.55" pace="0" />
        <SteadyState Duration="600" Power="0.93" pace="0" Cadence="95" />
        <SteadyState Duration="180" Power="1.05" pace="0" Cadence="80" />
        <SteadyState Duration="120" Power="0.9" pace="0" />
        <SteadyState Duration="120" Power="1.02" pace="0" />
        <SteadyState Duration="180" Power="0.9" pace="0" Cadence="80" />
        <SteadyState Duration="300" Power="0.93" pace="0" Cadence="95" />
        <SteadyState Duration="60" Power="1.05" pace="0" Cadence="75" />
        <SteadyState Duration="60" Power="1.1" pace="0" Cadence="75" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" Cadence="85" />
    </workout>
</workout_file>