<workout_file>
    <author>Domestique Library</author>
    <name>Mixed (52min)</name>
    <description>Warmup: 7min from 50% to 70% FTP | Steady: 18min @ 94% FTP | Steady: 4min @ 50% FTP | Steady: 18min @ 94% FTP | Cooldown: 5min from 70% to 50% FTP</description>
