<workout_file>
    <author>Domestique Library</author>
    <name>Mixed (60min)</name>
    <description>Steady: 3min @ 50% FTP | Steady: 1min @ 60% FTP | Steady: 1min @ 65% FTP | Steady: 1min @ 81% FTP | Steady: 1min @ 95% FTP | Steady: 2min @ 50% FTP | Steady: 4min @ 80% FTP | Steady: 3min @ 50% FTP | Steady: 7min @ 65% FTP | Steady: 3min @ 70% FTP | Steady: 7min @ 65% FTP | Steady: 7min @ 68% FTP | Steady: 5min @ 75% FTP | Steady: 7min @ 70% FTP | Steady: 5min @ 65% FTP | Cooldown: 3min from 65% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="180" Power="0.5" pace="0" />
