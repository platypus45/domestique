<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 5 cycles (79min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Over-Under: 5 cycles (alternating above/below threshold) | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
