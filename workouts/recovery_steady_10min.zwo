<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery Steady (10min)</name>
    <description>Warmup: 3min from 35% to 55% FTP | Steady: 4min @ 55% FTP | Cooldown: 3min from 35% to 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="180" PowerLow="0.35" PowerHigh="0.55" pace="0" />
        <SteadyState Duration="240" Power="0.55" pace="0" />
        <Cooldown Duration="180" PowerLow="0.35" PowerHigh="0.55" pace="0" />
    </workout>
</workout_file>