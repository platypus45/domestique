<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery Steady (13min)</name>
    <description>Warmup: 5min from 35% to 75% FTP | Steady: 3min @ 40% FTP | Cooldown: 5min from 40% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.35" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.4" pace="0" />
        <SteadyState Duration="60" Power="0.4" pace="0" />
        <Cooldown Duration="300" PowerLow="0.4" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>