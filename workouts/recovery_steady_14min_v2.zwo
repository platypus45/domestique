<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery Steady (14min)</name>
    <description>Warmup: 5min from 25% to 70% FTP | Steady: 4min @ 45% FTP | Cooldown: 5min from 45% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.25" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="120" Power="0.45" pace="0" />
        <SteadyState Duration="120" Power="0.45" pace="0" />
        <Cooldown Duration="300" PowerLow="0.45" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>