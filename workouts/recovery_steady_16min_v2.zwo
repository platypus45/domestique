<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery Steady (16min)</name>
    <description>Warmup: 5min from 25% to 70% FTP | Steady: 6min @ 46% FTP | Cooldown: 5min from 65% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.25" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="180" Power="0.46" pace="0" />
        <SteadyState Duration="180" Power="0.45" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>