<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed Steady (16min)</name>
    <description>Warmup: 10min from 50% to 90% FTP | Cooldown: 6min @ 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
    </workout>
</workout_file>