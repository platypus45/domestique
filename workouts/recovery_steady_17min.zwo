<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery Steady (17min)</name>
    <description>Warmup: 5min from 50% to 75% FTP | Steady: 7min @ 50% FTP | Cooldown: 5min from 30% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.3" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>