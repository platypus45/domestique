<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed Steady (17min)</name>
    <description>Warmup: 7min from 50% to 75% FTP | Steady: 4min @ 50% FTP | Cooldown: 6min from 40% to 65% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="420" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <Cooldown Duration="360" PowerLow="0.4" PowerHigh="0.65" pace="0" />
    </workout>
</workout_file>