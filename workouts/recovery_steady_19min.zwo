<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance Steady (19min)</name>
    <description>Warmup: 8min from 55% to 75% FTP | Steady: 1min @ 55% FTP | Cooldown: 10min from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.55" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <Cooldown Duration="600" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>