<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery (20min)</name>
    <description>Warmup: 9min from 40% to 80% FTP | Steady: 1min @ 40% FTP | Steady: 5min @ 45% FTP | Cooldown: 5min from 35% to 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="540" PowerLow="0.4" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="60" Power="0.4" pace="0" />
        <SteadyState Duration="300" Power="0.45" pace="0" />
        <Cooldown Duration="300" PowerLow="0.35" PowerHigh="0.55" pace="0" />
    </workout>
</workout_file>