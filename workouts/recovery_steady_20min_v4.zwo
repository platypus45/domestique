<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed Steady (20min)</name>
    <description>Warmup: 6min from 50% to 75% FTP | Steady: 6min @ 50% FTP | Cooldown: 8min from 50% to 65% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="360" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Cooldown Duration="480" PowerLow="0.5" PowerHigh="0.65" pace="0" />
    </workout>
</workout_file>