<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery Steady (21min)</name>
    <description>Warmup: 8min from 50% to 75% FTP | Steady: 8min @ 50% FTP | Cooldown: 5min from 63% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="420" Power="0.51" pace="0" />
        <Cooldown Duration="300" PowerLow="0.63" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>