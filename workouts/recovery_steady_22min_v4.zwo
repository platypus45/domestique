<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery Steady (22min)</name>
    <description>Warmup: 12min from 35% to 90% FTP | Steady: 2min @ 50% FTP | Cooldown: 8min from 25% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="720" PowerLow="0.35" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Cooldown Duration="480" PowerLow="0.25" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>