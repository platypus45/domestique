<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery Steady (23min)</name>
    <description>Warmup: 10min from 45% to 80% FTP | Steady: 8min @ 55% FTP | Cooldown: 5min from 75% to 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.55" pace="0" />
    </workout>
</workout_file>