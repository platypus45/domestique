<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery (23min)</name>
    <description>Warmup: 5min from 40% to 75% FTP | Steady: 5min @ 50% FTP | Steady: 8min @ 55% FTP | Cooldown: 5min from 40% to 65% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.4" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="240" Power="0.55" pace="0" />
        <SteadyState Duration="240" Power="0.55" pace="0" />
        <Cooldown Duration="300" PowerLow="0.4" PowerHigh="0.65" pace="0" />
    </workout>
</workout_file>