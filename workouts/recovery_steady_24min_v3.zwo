<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery (24min)</name>
    <description>Warmup: 7min from 50% to 75% FTP | Steady: 2min @ 50% FTP | Steady: 5min @ 55% FTP | Steady: 5min @ 50% FTP | Cooldown: 5min from 40% to 60% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="420" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.4" PowerHigh="0.6" pace="0" />
    </workout>
</workout_file>