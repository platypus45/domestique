<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed Steady (24min)</name>
    <description>Warmup: 15min from 55% to 80% FTP | Steady: 1min @ 55% FTP | Cooldown: 8min from 50% to 70% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.55" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <Cooldown Duration="480" PowerLow="0.5" PowerHigh="0.7" pace="0" />
    </workout>
</workout_file>