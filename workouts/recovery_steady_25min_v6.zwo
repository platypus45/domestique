<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery Steady (25min)</name>
    <description>Warmup: 15min from 25% to 50% FTP | Cooldown: 10min from 25% to 65% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.25" PowerHigh="0.5" pace="0" />
        <Cooldown Duration="600" PowerLow="0.25" PowerHigh="0.65" pace="0" />
    </workout>
</workout_file>