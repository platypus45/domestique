<workout_file>
    <author>Domestique Library</author>
    <name>Recovery (27min)</name>
    <description>Warmup: 6min from 42% to 70% FTP | Steady: 1min @ 50% FTP | Steady: 1min @ 109% FTP | Steady: 2min @ 50% FTP | Steady: 4min @ 90% FTP | Cooldown: 13min @ 50% FTP</description>
