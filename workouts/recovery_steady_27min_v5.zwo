<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed Steady (27min)</name>
    <description>Warmup: 8min from 50% to 80% FTP | Steady: 10min @ 50% FTP | Cooldown: 9min from 50% to 70% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <Cooldown Duration="540" PowerLow="0.5" PowerHigh="0.7" pace="0" />
    </workout>
</workout_file>