<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance 3x20s (28min)</name>
    <description>Warmup: 5min from 55% to 75% FTP | Intervals: 3 x (20s @ 120% / 0s @ 55%) | Cooldown: 5min from 35% to 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.55" PowerHigh="0.75" pace="0" />
        <Ramp Duration="180" PowerLow="0.9" PowerHigh="1.05" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="20" Power="1.2" pace="0" />
        <SteadyState Duration="15" Power="1.3" pace="0" />
        <SteadyState Duration="300" Power="0.4" pace="0" />
        <SteadyState Duration="20" Power="1.2" pace="0" />
        <SteadyState Duration="15" Power="1.3" pace="0" />
        <SteadyState Duration="300" Power="0.4" pace="0" />
        <SteadyState Duration="20" Power="1.2" pace="0" />
        <SteadyState Duration="15" Power="1.3" pace="0" />
        <Cooldown Duration="300" PowerLow="0.35" PowerHigh="0.55" pace="0" />
    </workout>
</workout_file>