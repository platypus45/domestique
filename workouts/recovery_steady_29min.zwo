<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery Steady (29min)</name>
    <description>Warmup: 15min from 49% to 92% FTP | Cooldown: 14min from 51% to 49% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.49" PowerHigh="0.92" pace="0" />
        <SteadyState Duration="180" Power="0.51" pace="0" />
        <SteadyState Duration="300" Power="0.53" pace="0" />
        <SteadyState Duration="360" Power="0.49" pace="0" />
    </workout>
</workout_file>