<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed Steady (30min)</name>
    <description>Warmup: 10min from 45% to 95% FTP | Steady: 17min @ 55% FTP | Cooldown: 3min from 40% to 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.95" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <Cooldown Duration="180" PowerLow="0.4" PowerHigh="0.55" pace="0" />
    </workout>
</workout_file>