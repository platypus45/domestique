<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery (32min)</name>
    <description>Warmup: 10min from 50% to 75% FTP | Steady: 13min @ 55% FTP | Steady: 2min @ 50% FTP | Cooldown: 7min from 65% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <SteadyState Duration="240" Power="0.55" pace="0" />
        <SteadyState Duration="240" Power="0.55" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Cooldown Duration="420" PowerLow="0.65" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>