<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery Steady (36min)</name>
    <description>Warmup: 15min from 25% to 75% FTP | Steady: 6min @ 50% FTP | Cooldown: 15min from 25% to 75% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <Cooldown Duration="900" PowerLow="0.25" PowerHigh="0.75" pace="0" />
    </workout>
</workout_file>