<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery Steady (40min)</name>
    <description>Warmup: 15min from 30% to 90% FTP | Steady: 15min @ 38% FTP | Cooldown: 10min from 46% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.3" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="300" Power="0.38" pace="0" />
        <SteadyState Duration="600" Power="0.38" pace="0" />
        <Cooldown Duration="600" PowerLow="0.46" PowerHigh="0.3" pace="0" />
    </workout>
</workout_file>