    <workout>
        <Warmup Duration="1200" PowerLow="0.3" PowerHigh="0.55" pace="0" />
        <Cooldown Duration="1200" PowerLow="0.3" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>