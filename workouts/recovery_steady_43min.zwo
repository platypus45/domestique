<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed Steady (43min)</name>
    <description>Warmup: 15min from 49% to 92% FTP | Steady: 8min @ 51% FTP | Cooldown: 20min from 51% to 64% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.49" PowerHigh="0.92" pace="0" />
        <SteadyState Duration="180" Power="0.51" pace="0" />
        <SteadyState Duration="300" Power="0.51" pace="0" />
        <Cooldown Duration="1200" PowerLow="0.51" PowerHigh="0.64" pace="0" />
    </workout>
</workout_file>