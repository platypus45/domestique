<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed Steady (45min)</name>
    <description>Warmup: 20min from 50% to 75% FTP | Steady: 15min @ 55% FTP | Cooldown: 10min from 50% to 75% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="1200" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <Cooldown Duration="600" PowerLow="0.5" PowerHigh="0.75" pace="0" />
    </workout>
</workout_file>