<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance Steady (11min)</name>
    <description>Warmup: 4min from 50% to 70% FTP | Steady: 3min @ 50% FTP | Cooldown: 4min from 50% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="240" PowerLow="0.5" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <Cooldown Duration="240" PowerLow="0.50" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>