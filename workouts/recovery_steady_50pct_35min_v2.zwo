<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery Steady (35min)</name>
    <description>Warmup: 9min from 45% to 65% FTP | Steady: 20min @ 50% FTP | Cooldown: 6min from 50% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="540" PowerLow="0.45" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="1200" Power="0.5" pace="0" />
        <Cooldown Duration="360" PowerLow="0.50" PowerHigh="0.40" pace="0" />
    </workout>
</workout_file>