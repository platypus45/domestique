        <SteadyState Duration="600" Power="0.51" pace="0" />
        <SteadyState Duration="20" Power="0.49" pace="0" />
        <Cooldown Duration="900" PowerLow="0.49" PowerHigh="0.54" pace="0" />
    </workout>
