<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery Steady (20min)</name>
    <description>Warmup: 10min from 35% to 65% FTP | Cooldown: 10min @ 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.35" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="600" Power="0.55" pace="0" />
    </workout>
</workout_file>