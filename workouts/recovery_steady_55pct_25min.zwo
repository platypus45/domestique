<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery Steady (25min)</name>
    <description>Warmup: 10min from 30% to 78% FTP | Steady: 6min @ 55% FTP | Cooldown: 9min from 55% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.3" PowerHigh="0.78" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <Cooldown Duration="540" PowerLow="0.55" PowerHigh="0.30" pace="0" />
    </workout>
</workout_file>