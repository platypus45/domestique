<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery Steady (31min)</name>
    <description>Warmup: 10min from 45% to 80% FTP | Steady: 14min @ 55% FTP | Cooldown: 7min from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="240" Power="0.55" pace="0" />
        <SteadyState Duration="240" Power="0.55" pace="0" />
        <SteadyState Duration="240" Power="0.55" pace="0" />
        <Cooldown Duration="420" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>