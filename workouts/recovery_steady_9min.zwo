<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery Steady (9min)</name>
    <description>Warmup: 5min from 25% to 75% FTP | Steady: 2min @ 40% FTP | Cooldown: 2min from 25% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.4" pace="0" />
        <Cooldown Duration="120" PowerLow="0.25" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>