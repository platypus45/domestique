<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance Steady (9min)</name>
    <description>Warmup: 5min from 45% to 80% FTP | Steady: 1min @ 55% FTP | Cooldown: 3min from 55% to 75% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.45" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <Cooldown Duration="180" PowerLow="0.55" PowerHigh="0.75" pace="0" />
    </workout>
</workout_file>