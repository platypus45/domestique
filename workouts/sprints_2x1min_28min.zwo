<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 3x10s (33min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 3 x (10s @ 278% / 1min 40s @ 68%) | Cooldown: 5min from 60% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="630" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="10" Power="2.78" pace="0" />
        <SteadyState Duration="60" Power="0.64" pace="0" />
        <SteadyState Duration="10" Power="2.78" pace="0" />
        <SteadyState Duration="60" Power="0.64" pace="0" />
        <SteadyState Duration="10" Power="2.78" pace="0" />
        <SteadyState Duration="180" Power="0.75" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.1" pace="0" />
        <SteadyState Duration="20" Power="1.2" pace="0" />
        <SteadyState Duration="10" Power="1.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>