<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 5x10s (46min)</name>
    <description>Warmup: 6min from 30% to 70% FTP | Intervals: 5 x (10s @ 265% / 1min 54s @ 52%) | Cooldown: 5min from 30% to 70% FTP</description>
