    <workout>
        <Warmup Duration="360" PowerLow="0.3" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="10" Power="2.65" pace="0" />
        <SteadyState Duration="120" Power="0.65" pace="0" />
        <SteadyState Duration="10" Power="2.65" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <SteadyState Duration="10" Power="2.65" pace="0" />
        <SteadyState Duration="60" Power="0.45" pace="0" />
        <SteadyState Duration="10" Power="2.65" pace="0" />
        <SteadyState Duration="30" Power="0.35" pace="0" />
        <SteadyState Duration="10" Power="2.65" pace="0" />
        <SteadyState Duration="300" Power="0.6" pace="0" />
        <SteadyState Duration="600" Power="0.89" pace="0" />
        <SteadyState Duration="300" Power="0.6" pace="0" />
        <SteadyState Duration="600" Power="0.89" pace="0" />
        <Cooldown Duration="300" PowerLow="0.3" PowerHigh="0.7" pace="0" />
    </workout>
