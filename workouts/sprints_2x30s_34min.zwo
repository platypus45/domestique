<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 4x30s (34min)</name>
    <description>Warmup: 7min from 45% to 65% FTP | Intervals: 4 x (30s @ 100% / 30s @ 50%) | Cooldown: 5min from 30% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="420" PowerLow="0.45" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="30" Power="1" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.1" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.2" pace="0" />
        <SteadyState Duration="180" Power="0.61" pace="0" />
        <SteadyState Duration="30" Power="1" pace="0" />
        <SteadyState Duration="15" Power="2.8" pace="0" />
        <Ramp Duration="360" PowerLow="0.55" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="30" Power="1" pace="0" />
        <SteadyState Duration="15" Power="2.8" pace="0" />
        <Ramp Duration="360" PowerLow="0.55" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="30" Power="1" pace="0" />
        <SteadyState Duration="15" Power="2.8" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.3" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>