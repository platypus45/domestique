<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (40min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Steady: 10s @ 120% FTP | Steady: 20s @ 50% FTP | Steady: 10s @ 130% FTP | Steady: 20s @ 50% FTP | Steady: 10s @ 140% FTP | Steady: 20s @ 50% FTP | Steady: 10s @ 150% FTP | Steady: 20s @ 50% FTP | Steady: 10s @ 160% FTP | Steady: 2min @ 50% FTP | Steady: 5min @ 90% FTP | Steady: 12min @ 50% FTP | Steady: 5min @ 90% FTP | Cooldown: 5min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="530" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="10" Power="1.2" pace="0" />
