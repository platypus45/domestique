<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 30s/2min 11x (30min)</name>
    <description>Warmup: 5min from 50% to 80% FTP | Microintervals: 11 x (30s @ 150% / 1min 30s @ 55%) | Cooldown: 3min from 70% to 45% FTP</description>
