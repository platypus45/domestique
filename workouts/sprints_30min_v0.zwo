<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 30s/2min 11x (36min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 11 x (30s @ 150% / 1min 30s @ 55%) | Cooldown: 5min ramp from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="30" Power="1.5" pace="0" />
        <SteadyState Duration="90" Power="0.55" pace="0" />
        <SteadyState Duration="30" Power="1.5" pace="0" />
        <SteadyState Duration="90" Power="0.55" pace="0" />
