<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular (35min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Steady: 30s @ 100% FTP | Steady: 30s @ 50% FTP | Steady: 30s @ 110% FTP | Steady: 30s @ 50% FTP | Steady: 30s @ 120% FTP | Steady: 2min @ 50% FTP | Steady: 20s @ 180% FTP | Steady: 2min @ 60% FTP | Steady: 20s @ 190% FTP | Steady: 2min @ 60% FTP | Steady: 20s @ 200% FTP | Steady: 5min @ 65% FTP | Steady: 20s @ 180% FTP | Steady: 2min @ 60% FTP | Steady: 20s @ 190% FTP | Steady: 2min @ 60% FTP | Steady: 20s @ 200% FTP | Steady: 2min @ 61% FTP | Cooldown: 3min from 61% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
