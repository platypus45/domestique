<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 30s/2min 16x (47min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 16 x (30s @ 150% / 1min 30s @ 55%) | Cooldown: 5min from 55% to 45% FTP</description>
    <sportType>bike</sportType>
