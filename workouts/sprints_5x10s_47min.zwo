<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 10s/1min 10x (47min)</name>
    <description>Warmup: 6min from 40% to 60% FTP | Microintervals: 10 x (10s @ 160% / 1min @ 53%) | Cooldown: 10min from 40% to 60% FTP</description>
