<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 5x20s (52min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 5 x (20s @ 170% / 1min 12s @ 54%) | Cooldown: 5min from 60% to 25% FTP</description>
