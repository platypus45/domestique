<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 20s/2min 6x (34min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 6 x (20s @ 170% / 2min @ 50%) | Cooldown: 5min from 65% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="300" Power="0.89" pace="0" />
        <SteadyState Duration="120" Power="0.4" pace="0" />
        <SteadyState Duration="20" Power="1.7" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="20" Power="1.7" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="20" Power="1.7" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="20" Power="1.7" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="20" Power="1.7" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="20" Power="1.7" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.40" pace="0" />
    </workout>
