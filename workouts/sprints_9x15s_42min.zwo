<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 5x15s (45min)</name>
    <description>Warmup: 3min from 25% to 75% FTP | Intervals: 5 x (15s @ 140% / 0s @ 55%) | Cooldown: 5min ramp from 65% to 40% FTP</description>
