<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (12min)</name>
    <description>Warmup: 5min from 40% to 85% FTP | Steady: 10s @ 170% FTP | Steady: 1min @ 105% FTP | Steady: 1min @ 98% FTP | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.4" PowerHigh="0.85" pace="0" />
        <SteadyState Duration="10" Power="1.7" pace="0" />
        <SteadyState Duration="60" Power="1.05" pace="0" />
        <SteadyState Duration="60" Power="0.98" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>