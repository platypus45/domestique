<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (105min)</name>
    <description>Warmup: 15min from 55% to 72% FTP | Steady: 5min @ 114% FTP | Steady: 5min @ 72% FTP | Steady: 20min @ 95% FTP | Steady: 10min @ 72% FTP | Steady: 20min @ 95% FTP | Steady: 15min @ 72% FTP | Cooldown: 15min from 72% to 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.55" PowerHigh="0.72" pace="0" />
        <SteadyState Duration="300" Power="1.14" pace="0" />
        <SteadyState Duration="300" Power="0.72" pace="0" />
        <SteadyState Duration="1200" Power="0.95" pace="0" />
        <SteadyState Duration="600" Power="0.72" pace="0" />
        <SteadyState Duration="1200" Power="0.95" pace="0" />
        <SteadyState Duration="900" Power="0.72" pace="0" />
        <Cooldown Duration="900" PowerLow="0.72" PowerHigh="0.55" pace="0" />
    </workout>
</workout_file>