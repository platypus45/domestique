<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (20min)</name>
    <description>Warmup: 5min from 25% to 75% FTP | Steady: 3min @ 100% FTP | Steady: 30s @ 125% FTP | Steady: 2min 30s @ 100% FTP | Steady: 30s @ 120% FTP | Steady: 2min @ 100% FTP | Steady: 30s @ 115% FTP | Steady: 1min 30s @ 100% FTP | Steady: 30s @ 110% FTP | Steady: 1min @ 100% FTP | Steady: 30s @ 105% FTP | Cooldown: 2min 30s from 50% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.25" PowerHigh="0.75" pace="0" Cadence="85" />
        <SteadyState Duration="180" Power="1.0" pace="0" Cadence="90" />
        <SteadyState Duration="30" Power="1.25" pace="0" Cadence="110" />
        <SteadyState Duration="150" Power="1.0" pace="0" Cadence="90" />
        <SteadyState Duration="30" Power="1.2" pace="0" Cadence="110" />
        <SteadyState Duration="120" Power="1.0" pace="0" Cadence="90" />
        <SteadyState Duration="30" Power="1.15" pace="0" Cadence="110" />
        <SteadyState Duration="90" Power="1.0" pace="0" Cadence="90" />
        <SteadyState Duration="30" Power="1.1" pace="0" Cadence="110" />
        <SteadyState Duration="60" Power="1.0" pace="0" Cadence="90" />
        <SteadyState Duration="30" Power="1.05" pace="0" Cadence="110" />
        <Cooldown Duration="150" PowerLow="0.5" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>