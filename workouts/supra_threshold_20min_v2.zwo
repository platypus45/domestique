<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (20min)</name>
    <description>Warmup: 5min from 25% to 75% FTP | Steady: 1min @ 125% FTP | Steady: 2min @ 100% FTP | Steady: 1min 30s @ 115% FTP | Steady: 2min @ 98% FTP | Steady: 2min @ 108% FTP | Steady: 2min @ 95% FTP | Steady: 2min @ 92% FTP | Steady: 30s @ 65% FTP | Cooldown: 2min from 50% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.25" PowerHigh="0.75" pace="0" Cadence="85" />
        <SteadyState Duration="60" Power="1.25" pace="0" Cadence="110" />
        <SteadyState Duration="120" Power="1.0" pace="0" Cadence="100" />
        <SteadyState Duration="90" Power="1.15" pace="0" Cadence="105" />
        <SteadyState Duration="120" Power="0.98" pace="0" Cadence="95" />
        <SteadyState Duration="120" Power="1.08" pace="0" Cadence="100" />
        <SteadyState Duration="120" Power="0.95" pace="0" Cadence="90" />
        <SteadyState Duration="120" Power="0.92" pace="0" Cadence="95" />
        <FreeRide Duration="30" FlatRoad="0" />
        <Cooldown Duration="120" PowerLow="0.5" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>