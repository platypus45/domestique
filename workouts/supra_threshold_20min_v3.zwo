        <SteadyState Duration="30" Power="0.5" pace="0" Cadence="85" />
        <FreeRide Duration="60" FlatRoad="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="60" Power="0.95" pace="0" Cadence="90" />
        <SteadyState Duration="15" Power="0.5" pace="0" Cadence="85" />
