<workout_file>
    <author>Domestique Library</author>
    <name>VO2max (27min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Steady: 30s @ 125% FTP | Steady: 1min @ 50% FTP | Steady: 1min @ 95% FTP | Steady: 15s @ 50% FTP | Steady: 1min @ 105% FTP | Steady: 15s @ 50% FTP | Steady: 1min @ 115% FTP | Steady: 30s @ 50% FTP | Steady: 1min @ 65% FTP | Steady: 2min @ 50% FTP | Steady: 1min @ 95% FTP | Steady: 15s @ 50% FTP | Steady: 1min @ 105% FTP | Steady: 15s @ 50% FTP | Steady: 1min @ 115% FTP | Steady: 30s @ 50% FTP | Steady: 1min @ 65% FTP | Steady: 1min 30s @ 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="30" Power="1.25" pace="0" Cadence="100" />
