<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery (32min)</name>
    <description>Warmup: 7min from 45% to 65% FTP | Steady: 30s @ 100% FTP | Steady: 30s @ 50% FTP | Steady: 30s @ 110% FTP | Steady: 30s @ 50% FTP | Steady: 30s @ 120% FTP | Steady: 4min @ 61% FTP | Steady: 1min @ 65% FTP | Steady: 3min @ 55% FTP | Steady: 3min @ 61% FTP | Steady: 3min @ 55% FTP | Steady: 1min @ 65% FTP | Steady: 3min @ 50% FTP | Cooldown: 5min from 50% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="420" PowerLow="0.45" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="30" Power="1.0" pace="0" Cadence="95" />
        <SteadyState Duration="30" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="30" Power="1.1" pace="0" Cadence="100" />
        <SteadyState Duration="30" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="30" Power="1.2" pace="0" Cadence="105" />
        <SteadyState Duration="240" Power="0.61" pace="0" />
        <FreeRide Duration="60" FlatRoad="0" />
        <Ramp Duration="180" PowerLow="0.5" PowerHigh="0.61" pace="0" />
        <SteadyState Duration="180" Power="0.61" pace="0" />
        <Ramp Duration="180" PowerLow="0.61" PowerHigh="0.5" pace="0" />
        <FreeRide Duration="60" FlatRoad="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.5" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>