<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 3x15s (36min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Intervals: 3 x (15s @ 200% / 1min @ 75%) | Cooldown: 6min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="15" Power="2.0" pace="0" />
        <SteadyState Duration="60" Power="0.75" pace="0" />
        <SteadyState Duration="15" Power="2.0" pace="0" />
        <SteadyState Duration="60" Power="0.75" pace="0" />
        <SteadyState Duration="15" Power="2.0" pace="0" />
        <SteadyState Duration="60" Power="0.75" pace="0" />
        <SteadyState Duration="60" Power="1.2" pace="0" />
        <SteadyState Duration="120" Power="0.75" pace="0" />
        <SteadyState Duration="60" Power="1.2" pace="0" />
        <SteadyState Duration="120" Power="0.75" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <Cooldown Duration="360" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>