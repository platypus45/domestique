<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (40min)</name>
    <description>Warmup: 20min from 25% to 90% FTP | Steady: 2min @ 100% FTP | Steady: 5min @ 50% FTP | Steady: 3min @ 65% FTP | Cooldown: 10min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="1200" PowerLow="0.25" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="120" Power="1.0" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <FreeRide Duration="180" FlatRoad="0" />
        <SteadyState Duration="600" Power="0.5" pace="0" />
    </workout>
</workout_file>