<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 4x8min (59min)</name>
    <description>Warmup: 10min from 50% to 75% FTP | Intervals: 4 x (8min @ 104% / 3min @ 55%) | Cooldown: 5min from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="480" Power="1.04" pace="0" Cadence="80" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="480" Power="1.04" pace="0" Cadence="80" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="480" Power="1.04" pace="0" Cadence="80" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="480" Power="1.04" pace="0" Cadence="80" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>