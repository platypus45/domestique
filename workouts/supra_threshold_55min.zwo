<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (55min)</name>
    <description>Warmup: 10min from 40% to 80% FTP | Steady: 15min @ 100% FTP | Steady: 10min @ 60% FTP | Steady: 15min @ 100% FTP | Cooldown: 5min from 75% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="900" Power="1.0" pace="0" />
        <SteadyState Duration="600" Power="0.6" pace="0" />
        <SteadyState Duration="900" Power="1.0" pace="0" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>