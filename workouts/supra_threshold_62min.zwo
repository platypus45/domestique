<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 4x10min (64min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 4 x (10min @ 104% / 2min @ 50%) | Cooldown: 8min from 75% to 47% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="600" Power="1.04" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="600" Power="1.04" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="600" Power="1.04" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="600" Power="1.04" pace="0" />
        <Cooldown Duration="480" PowerLow="0.75" PowerHigh="0.47" pace="0" />
    </workout>
</workout_file>