    <workout>
        <Warmup Duration="480" PowerLow="0.49" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="600" Power="1.04" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="600" Power="1.04" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="600" Power="1.04" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="600" Power="1.04" pace="0" />
        <Cooldown Duration="480" PowerLow="0.75" PowerHigh="0.47" pace="0" />
    </workout>
</workout_file>