<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 4x10min (65min)</name>
    <description>Warmup: 8min from 49% to 75% FTP | Intervals: 4 x (10min @ 104% / 3min @ 50%) | Cooldown: 8min from 75% to 47% FTP</description>
