<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 4 cycles (65min)</name>
    <description>Warmup: 4min from 40% to 70% FTP | Over-Under: 4 cycles (alternating above/below threshold) | Cooldown: 4min 30s from 60% to 40% FTP</description>
