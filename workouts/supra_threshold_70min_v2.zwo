<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max (70min)</name>
    <description>Warmup: 10min from 25% to 80% FTP | Steady: 5min @ 105% FTP | Steady: 45min @ 65% FTP | Cooldown: 10min from 65% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="300" Power="1.05" pace="0" />
        <SteadyState Duration="900" Power="0.65" pace="0" />
        <FreeRide Duration="1200" FlatRoad="0" />
        <SteadyState Duration="600" Power="0.65" pace="0" />
        <Cooldown Duration="600" PowerLow="0.65" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>