<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 10x2min (51min)</name>
    <description>Warmup: 8min ramp from 50% to 65% FTP | Intervals: 10 x (2min 30s @ 92% / 30s @ 120%) | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.65" /><IntervalsT Repeat="5" OnDuration="30" OffDuration="30" OnPower="0.65" OffPower="0.8" pace="0" Cadence="90" CadenceResting="95" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="10" OnDuration="150" OffDuration="30" OnPower="0.92" OffPower="1.2" pace="0" Cadence="90" CadenceResting="95" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
    </workout>
</workout_file>