<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery (15min)</name>
    <description>Steady: 3min @ 60% FTP | Steady: 2min @ 70% FTP | Steady: 2min @ 80% FTP | Steady: 2min @ 90% FTP | Cooldown: 6min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="180" Power="0.6" pace="0" />
        <SteadyState Duration="120" Power="0.7" pace="0" />
        <SteadyState Duration="120" Power="0.8" pace="0" />
        <SteadyState Duration="120" Power="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
    </workout>
</workout_file>