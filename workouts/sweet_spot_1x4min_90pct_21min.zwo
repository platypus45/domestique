<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (21min)</name>
    <description>Warmup: 6min from 50% to 70% FTP | Steady: 1min @ 56% FTP | Steady: 1min @ 109% FTP | Steady: 2min @ 57% FTP | Steady: 4min @ 90% FTP | Steady: 3min @ 57% FTP | Cooldown: 4min from 57% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="360" PowerLow="0.5" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="60" Power="0.56" pace="0" />
        <SteadyState Duration="60" Power="1.09" pace="0" />
        <SteadyState Duration="120" Power="0.57" pace="0" />
        <SteadyState Duration="240" Power="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.57" pace="0" />
        <Cooldown Duration="240" PowerLow="0.57" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>