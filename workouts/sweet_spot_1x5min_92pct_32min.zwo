<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (32min)</name>
    <description>Steady: 4min @ 50% FTP | Steady: 3min @ 75% FTP | Steady: 2min @ 60% FTP | Steady: 5min @ 72% FTP | Steady: 5min @ 92% FTP | Steady: 8min @ 50% FTP | Cooldown: 5min from 50% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.6" pace="0" />
        <Ramp Duration="300" PowerLow="0.6" PowerHigh="0.85" pace="0" />
        <SteadyState Duration="300" Power="0.92" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.50" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>