<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (49min)</name>
    <description>Warmup: 10min from 40% to 75% FTP | Steady: 3min @ 55% FTP | Steady: 3min @ 50% FTP | Steady: 8min @ 85% FTP | Steady: 6min @ 50% FTP | Steady: 8min @ 95% FTP | Steady: 3min @ 50% FTP | Cooldown: 8min from 50% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="480" Power="0.85" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="480" Power="0.95" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <Cooldown Duration="480" PowerLow="0.50" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>