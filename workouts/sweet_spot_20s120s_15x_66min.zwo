<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 20s/2min 15x (66min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Microintervals: 15 x (20s @ 120% / 2min @ 88%) | Cooldown: 8min from 60% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="0.75" OffPower="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.81" pace="0" />
        <SteadyState Duration="120" Power="0.88" pace="0" />
        <IntervalsT Repeat="15" OnDuration="20" OffDuration="120" OnPower="1.2" OffPower="0.88" pace="0" />
        <Cooldown Duration="480" PowerLow="0.60" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>