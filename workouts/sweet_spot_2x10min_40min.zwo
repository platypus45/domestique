<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (40min)</name>
    <description>Warmup: 8min from 50% to 80% FTP | Steady: 2min @ 50% FTP | Steady: 10min @ 92% FTP | Steady: 5min @ 55% FTP | Steady: 10min @ 92% FTP | Cooldown: 5min @ 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="600" Power="0.92" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <SteadyState Duration="600" Power="0.92" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
    </workout>
</workout_file>