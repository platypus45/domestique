<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 2x15min (53min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Intervals: 2 x (15min @ 90% / 5min @ 55%) | Cooldown: 5min from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="2" OnDuration="900" OffDuration="300" OnPower="0.9" OffPower="0.55" pace="0" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>