<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>FTP Test 2x15min (70min)</name>
    <description>Intervals: 2 x (15min @ 88% / 5min @ 55%) | Cooldown: 6min from 55% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="120" Power="0.6" pace="0" />
        <SteadyState Duration="120" Power="0.68" pace="0" />
        <SteadyState Duration="120" Power="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.83" pace="0" />
        <SteadyState Duration="120" Power="0.9" pace="0" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="30" OnPower="1.2" OffPower="0.55" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <IntervalsT Repeat="2" OnDuration="900" OffDuration="300" OnPower="0.88" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="1.15" OffPower="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.4" pace="0" />
    </workout>
</workout_file>