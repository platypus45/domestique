<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (27min)</name>
    <description>Warmup: 5min from 50% to 70% FTP | Steady: 5min @ 90% FTP | Steady: 1min @ 50% FTP | Steady: 5min @ 90% FTP | Steady: 1min @ 50% FTP | Steady: 5min @ 90% FTP | Cooldown: 5min from 50% to 70% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.5" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="300" Power="0.9" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.9" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.9" pace="0" />
        <Cooldown Duration="300" PowerLow="0.5" PowerHigh="0.7" pace="0" />
    </workout>
</workout_file>