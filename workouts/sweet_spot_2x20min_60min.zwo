<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 2x20min (60min)</name>
    <description>Intervals: 2 x (20min @ 90% / 3min @ 55%) | Cooldown: 2min from 50% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <IntervalsT Repeat="1" OnDuration="180" OffDuration="240" OnPower="0.45" OffPower="0.6" pace="0" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.0" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.1" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.2" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="2" OnDuration="1200" OffDuration="180" OnPower="0.9" OffPower="0.55" pace="0" />
        <Cooldown Duration="120" PowerLow="0.5" PowerHigh="0.3" pace="0" />
    </workout>
</workout_file>