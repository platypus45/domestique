<workout_file>
    <author>Domestique Library</author>
    <name>Tempo (29min)</name>
    <description>Warmup: 4min from 50% to 70% FTP | Steady: 5min @ 85% FTP | Steady: 3min @ 50% FTP | Steady: 5min @ 85% FTP | Steady: 3min @ 50% FTP | Steady: 5min @ 85% FTP | Cooldown: 4min from 70% to 50% FTP</description>
