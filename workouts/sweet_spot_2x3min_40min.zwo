<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (40min)</name>
    <description>Warmup: 12min from 45% to 65% FTP | Steady: 3min @ 78% FTP | Steady: 3min @ 88% FTP | Steady: 3min @ 53% FTP | Steady: 3min @ 88% FTP | Steady: 3min @ 78% FTP | Steady: 3min @ 53% FTP | Cooldown: 10min from 50% to 65% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="720" PowerLow="0.45" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="180" Power="0.78" pace="0" />
        <SteadyState Duration="180" Power="0.88" pace="0" />
        <SteadyState Duration="180" Power="0.53" pace="0" />
        <SteadyState Duration="180" Power="0.88" pace="0" />
        <SteadyState Duration="180" Power="0.78" pace="0" />
        <SteadyState Duration="180" Power="0.53" pace="0" />
        <Cooldown Duration="600" PowerLow="0.5" PowerHigh="0.65" pace="0" />
    </workout>
</workout_file>