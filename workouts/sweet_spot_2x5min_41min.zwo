<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (41min)</name>
    <description>Steady: 3min @ 50% FTP | Steady: 3min @ 70% FTP | Steady: 2min @ 57% FTP | Steady: 5min @ 90% FTP | Steady: 3min @ 56% FTP | Steady: 15min @ 89% FTP | Steady: 5min @ 56% FTP | Cooldown: 5min from 56% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.7" pace="0" />
        <SteadyState Duration="120" Power="0.57" pace="0" />
        <SteadyState Duration="300" Power="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.56" pace="0" />
        <SteadyState Duration="300" Power="0.89" pace="0" />
        <SteadyState Duration="300" Power="0.89" pace="0" />
        <SteadyState Duration="300" Power="0.89" pace="0" />
        <SteadyState Duration="300" Power="0.56" pace="0" />
        <Cooldown Duration="300" PowerLow="0.56" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>