<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (28min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Steady: 2min @ 50% FTP | Steady: 6min @ 90% FTP | Steady: 3min @ 65% FTP | Steady: 6min @ 90% FTP | Steady: 3min @ 65% FTP | Cooldown: 2min from 40% to 65% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="360" Power="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <SteadyState Duration="360" Power="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <Cooldown Duration="120" PowerLow="0.4" PowerHigh="0.65" pace="0" />
    </workout>
</workout_file>