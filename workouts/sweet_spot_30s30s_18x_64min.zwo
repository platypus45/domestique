        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="6" OnDuration="30" OffDuration="30" OnPower="1.05" OffPower="0.7" pace="0" />
        <Cooldown Duration="315" PowerLow="0.65" PowerHigh="0.40" pace="0" />
    </workout>
</workout_file>