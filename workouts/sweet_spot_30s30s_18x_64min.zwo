<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 30s/30s 18x (68min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Microintervals: 18 x (30s @ 105% / 30s @ 70%) | Cooldown: 5min 15s from 65% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="3" OnDuration="15" OffDuration="30" OnPower="1.15" OffPower="0.5" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <IntervalsT Repeat="3" OnDuration="15" OffDuration="30" OnPower="1.2" OffPower="0.5" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
