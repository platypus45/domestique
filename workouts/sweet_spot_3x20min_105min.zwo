<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 3x20min (105min)</name>
    <description>Warmup: 15min from 25% to 75% FTP | Intervals: 3 x (20min @ 88% / 5min @ 50%) | Cooldown: 15min from 50% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="1200" OffDuration="300" OnPower="0.88" OffPower="0.5" pace="0" />
        <Cooldown Duration="900" PowerLow="0.50" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>