<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 3x2min (63min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Intervals: 3 x (2min @ 120% / 2min @ 50%) | Cooldown: 5min from 75% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="2" OnDuration="60" OffDuration="60" OnPower="0.8" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="60" OnPower="0.98" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="8" OnDuration="15" OffDuration="180" OnPower="1.5" OffPower="0.88" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="120" OnPower="1.2" OffPower="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>