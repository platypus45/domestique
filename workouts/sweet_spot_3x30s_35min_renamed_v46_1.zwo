<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 3x30s (35min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Intervals: 3 x (30s @ 200% / 50s @ 75%) | Cooldown: 6min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="30" Power="2.0" pace="0" />
        <SteadyState Duration="45" Power="0.75" pace="0" />
        <SteadyState Duration="30" Power="2.0" pace="0" />
        <SteadyState Duration="45" Power="0.75" pace="0" />
        <SteadyState Duration="30" Power="2.0" pace="0" />
        <SteadyState Duration="60" Power="0.75" pace="0" />
        <SteadyState Duration="120" Power="1.2" pace="0" />
        <SteadyState Duration="60" Power="0.75" pace="0" />
        <SteadyState Duration="60" Power="1.4" pace="0" />
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.93" pace="0" />
        <Cooldown Duration="360" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>