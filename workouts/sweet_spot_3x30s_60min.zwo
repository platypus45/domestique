<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 3x30s (66min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Intervals: 3 x (30s @ 110% / 3min @ 65%) | Cooldown: 7min from 65% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="510" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="30" Power="1.1" pace="0" />
        <Ramp Duration="180" PowerLow="0.5" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="30" Power="1.1" pace="0" />
        <Ramp Duration="180" PowerLow="0.65" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="30" Power="1.1" pace="0" />
        <SteadyState Duration="60" Power="0.9" pace="0" />
        <SteadyState Duration="60" Power="0.65" pace="0" />
        <SteadyState Duration="120" Power="0.9" pace="0" />
        <SteadyState Duration="60" Power="0.65" pace="0" />
        <SteadyState Duration="180" Power="0.9" pace="0" />
        <SteadyState Duration="60" Power="0.65" pace="0" />
        <SteadyState Duration="240" Power="0.9" pace="0" />
        <SteadyState Duration="60" Power="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.9" pace="0" />
        <SteadyState Duration="60" Power="0.65" pace="0" />
        <SteadyState Duration="360" Power="0.9" pace="0" />
        <SteadyState Duration="60" Power="0.65" pace="0" />
        <SteadyState Duration="420" Power="0.9" pace="0" />
        <SteadyState Duration="60" Power="0.65" pace="0" />
        <SteadyState Duration="480" Power="0.9" pace="0" />
        <Cooldown Duration="420" PowerLow="0.65" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>