<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 3x30s (80min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Intervals: 3 x (30s @ 115% / 30s @ 50%) | Cooldown: 10min from 60% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="30" OnPower="1.15" OffPower="0.5" pace="0" />
        <FreeRide Duration="120" FlatRoad="0" />
        <SteadyState Duration="480" Power="0.88" pace="0" Cadence="95" />
        <SteadyState Duration="240" Power="0.97" pace="0" Cadence="65" />
        <SteadyState Duration="480" Power="0.88" pace="0" Cadence="95" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="480" Power="0.88" pace="0" Cadence="95" />
        <SteadyState Duration="240" Power="0.97" pace="0" Cadence="65" />
        <SteadyState Duration="480" Power="0.88" pace="0" Cadence="95" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" Cadence="110" />
        <SteadyState Duration="60" Power="0.5" pace="0" Cadence="65" />
        <SteadyState Duration="45" Power="1.2" pace="0" Cadence="110" />
        <SteadyState Duration="45" Power="0.5" pace="0" Cadence="65" />
        <SteadyState Duration="30" Power="1.3" pace="0" Cadence="110" />
        <SteadyState Duration="30" Power="0.5" pace="0" Cadence="65" />
        <SteadyState Duration="15" Power="1.5" pace="0" Cadence="110" />
        <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>