<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 3x4min (79min)</name>
    <description>Warmup: 20min from 35% to 85% FTP | Intervals: 3 x (4min @ 105% / 4min @ 40%) | Cooldown: 9min @ 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="1200" PowerLow="0.35" PowerHigh="0.85" pace="0" />
        <SteadyState Duration="300" Power="0.4" pace="0" />
        <SteadyState Duration="900" Power="0.92" pace="0" />
        <SteadyState Duration="600" Power="0.4" pace="0" />
        <IntervalsT Repeat="3" OnDuration="240" OffDuration="240" OnPower="1.05" OffPower="0.4" pace="0" />
        <SteadyState Duration="300" Power="0.4" pace="0" />
    </workout>
</workout_file>