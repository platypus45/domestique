<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 6 cycles (56min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Over-Under: 6 cycles (alternating above/below threshold) | Cooldown: 5min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="510" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="180" Power="0.85" pace="0" />
        <SteadyState Duration="30" Power="1.25" pace="0" />
        <SteadyState Duration="180" Power="0.85" pace="0" />
        <SteadyState Duration="60" Power="1.15" pace="0" />
        <SteadyState Duration="180" Power="0.85" pace="0" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.9" pace="0" />
        <SteadyState Duration="30" Power="1.3" pace="0" />
        <SteadyState Duration="180" Power="0.9" pace="0" />
        <SteadyState Duration="60" Power="1.2" pace="0" />
        <SteadyState Duration="180" Power="0.9" pace="0" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <SteadyState Duration="240" Power="0.9" pace="0" />
        <SteadyState Duration="30" Power="1.35" pace="0" />
        <SteadyState Duration="240" Power="0.9" pace="0" />
        <SteadyState Duration="60" Power="1.25" pace="0" />
        <SteadyState Duration="240" Power="0.9" pace="0" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>