<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (45min)</name>
    <description>Warmup: 8min from 50% to 75% FTP | Steady: 2min @ 70% FTP | Steady: 7min @ 90% FTP | Steady: 3min @ 55% FTP | Steady: 7min @ 90% FTP | Steady: 3min @ 55% FTP | Steady: 7min @ 90% FTP | Steady: 3min @ 55% FTP | Cooldown: 5min from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.7" pace="0" />
        <SteadyState Duration="420" Power="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="420" Power="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="420" Power="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>