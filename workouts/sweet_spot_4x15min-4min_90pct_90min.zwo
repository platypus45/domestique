<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 4x15min (90min)</name>
    <description>Warmup: 8min 30s from 50% to 75% FTP | Intervals: 4 x (15min @ 90% / 4min @ 55%) | Cooldown: 5min 30s from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="510" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="4" OnDuration="900" OffDuration="240" OnPower="0.9" OffPower="0.55" pace="0" />
        <Cooldown Duration="330" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>