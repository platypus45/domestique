<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 4x15s (30min)</name>
    <description>Warmup: 8min from 50% to 75% FTP | Intervals: 4 x (15s @ 150% / 0s @ 55%)</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" pace="0" Cadence="85" />
        <SteadyState Duration="15" Power="1.5" pace="0" Cadence="110" />
        <Ramp Duration="300" PowerLow="0.88" PowerHigh="0.95" pace="0" Cadence="90" />
        <SteadyState Duration="15" Power="1.5" pace="0" Cadence="110" />
        <Ramp Duration="300" PowerLow="0.88" PowerHigh="0.95" pace="0" Cadence="90" />
        <SteadyState Duration="15" Power="1.5" pace="0" Cadence="110" />
        <Ramp Duration="300" PowerLow="0.88" PowerHigh="0.95" pace="0" Cadence="90" />
        <SteadyState Duration="15" Power="1.5" pace="0" Cadence="110" />
        <Ramp Duration="240" PowerLow="0.88" PowerHigh="0.95" pace="0" Cadence="90" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
    </workout>
</workout_file>