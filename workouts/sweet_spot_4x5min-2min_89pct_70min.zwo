<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 4x5min (70min)</name>
    <description>Warmup: 10min from 50% to 65% FTP | Intervals: 4 x (5min @ 89% / 2min @ 52%) | Cooldown: 5min from 52% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="180" Power="0.78" pace="0" />
        <SteadyState Duration="180" Power="0.88" pace="0" />
        <SteadyState Duration="180" Power="0.53" pace="0" />
        <SteadyState Duration="180" Power="0.88" pace="0" />
        <SteadyState Duration="180" Power="0.78" pace="0" />
        <SteadyState Duration="180" Power="0.53" pace="0" />
        <SteadyState Duration="180" Power="0.78" pace="0" />
        <SteadyState Duration="180" Power="0.88" pace="0" />
        <SteadyState Duration="180" Power="0.53" pace="0" />
        <IntervalsT Repeat="4" OnDuration="300" OffDuration="120" OnPower="0.89" OffPower="0.52" pace="0" />
        <Cooldown Duration="300" PowerLow="0.52" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>