<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>FTP Test 4x6min (60min)</name>
    <description>Intervals: 4 x (6min @ 90% / 4min @ 55%) | Cooldown: 9min from 55% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="120" Power="0.6" pace="0" />
        <SteadyState Duration="120" Power="0.68" pace="0" />
        <SteadyState Duration="120" Power="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.83" pace="0" />
        <SteadyState Duration="120" Power="0.9" pace="0" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="30" OnPower="1.2" OffPower="0.55" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="360" OffDuration="240" OnPower="0.9" OffPower="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.4" pace="0" />
    </workout>
</workout_file>