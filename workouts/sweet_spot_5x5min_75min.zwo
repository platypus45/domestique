<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 5x5min (75min)</name>
    <description>Warmup: 15min from 25% to 75% FTP | Intervals: 5 x (5min @ 89% / 5min @ 50%) | Cooldown: 10min from 50% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="5" OnDuration="300" OffDuration="300" OnPower="0.89" OffPower="0.5" pace="0" />
        <Cooldown Duration="600" PowerLow="0.50" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>