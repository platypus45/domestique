<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>SST Med 6x5min (85min)</name>
    <description>Warmup: 10min ramp from 40% to 85% FTP | Main: 2 sets of 3 x (5min @ 95% / 5min @ 86%) — continuous sweet spot oscillation; set break of 3min @ 50%, 1min attack @ 110%, 1min @ 50% | Cooldown: 10min ramp from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.85" pace="0" />
        <IntervalsT Repeat="3" OnDuration="300" OffDuration="300" OnPower="0.95" OffPower="0.86" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="300" OffDuration="300" OnPower="0.95" OffPower="0.86" pace="0" />
        <Cooldown Duration="600" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>
