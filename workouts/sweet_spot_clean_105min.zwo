<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 6x10min (105min)</name>
    <description>Warmup: 12min from 50% to 75% FTP | Intervals: 6 x (10min @ 90% / 4min @ 55%) | Cooldown: 8min 30s from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="750" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="6" OnDuration="600" OffDuration="240" OnPower="0.9" OffPower="0.55" pace="0" />
        <Cooldown Duration="510" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>