<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 2x15min (55min)</name>
    <description>Warmup: 9min from 50% to 75% FTP | Intervals: 2 x (15min @ 90% / 5min @ 55%) | Cooldown: 6min from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="540" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="2" OnDuration="900" OffDuration="300" OnPower="0.9" OffPower="0.55" pace="0" />
        <Cooldown Duration="360" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>