<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 4x8min (60min)</name>
    <description>Warmup: 9min 30s from 50% to 75% FTP | Intervals: 4 x (8min @ 90% / 3min @ 55%) | Cooldown: 6min 30s from 55% to 45% FTP</description>
