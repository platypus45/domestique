        <IntervalsT Repeat="4" OnDuration="480" OffDuration="180" OnPower="0.9" OffPower="0.55" pace="0" />
        <Cooldown Duration="390" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
