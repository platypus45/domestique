<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 4x12min (73min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Intervals: 4 x (12min @ 90% / 3min @ 55%) | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="4" OnDuration="720" OffDuration="180" OnPower="0.9" OffPower="0.55" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>