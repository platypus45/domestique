<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 5x8min (75min)</name>
    <description>Warmup: 9min from 50% to 75% FTP | Intervals: 5 x (8min @ 90% / 4min @ 55%) | Cooldown: 6min from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="540" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="5" OnDuration="480" OffDuration="240" OnPower="0.9" OffPower="0.55" pace="0" />
        <Cooldown Duration="360" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>