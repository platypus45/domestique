    <workout>
        <Warmup Duration="870" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="1080" OffDuration="240" OnPower="0.9" OffPower="0.55" pace="0" />
        <Cooldown Duration="570" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>