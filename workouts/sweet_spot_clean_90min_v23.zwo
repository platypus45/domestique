<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 3x18min (90min)</name>
    <description>Warmup: 14min from 50% to 75% FTP | Intervals: 3 x (18min @ 90% / 4min @ 55%) | Cooldown: 9min 30s from 55% to 45% FTP</description>
