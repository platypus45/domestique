<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 4x15min (95min)</name>
    <description>Warmup: 11min from 50% to 75% FTP | Intervals: 4 x (15min @ 90% / 4min @ 55%) | Cooldown: 7min 30s from 65% to 45% FTP</description>
