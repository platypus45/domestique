<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 6x10min (97min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Intervals: 6 x (10min @ 90% / 4min @ 55%) | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="6" OnDuration="600" OffDuration="240" OnPower="0.9" OffPower="0.55" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>