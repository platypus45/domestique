<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (63min)</name>
    <description>Warmup: 8min from 50% to 80% FTP | Steady: 2min @ 50% FTP | Steady: 14min @ 90% FTP | Steady: 3min @ 65% FTP | Steady: 14min @ 90% FTP | Steady: 3min @ 65% FTP | Steady: 14min @ 90% FTP | Cooldown: 5min from 50% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <Ramp Duration="840" PowerLow="0.85" PowerHigh="0.95" pace="0" Cadence="95" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <Ramp Duration="840" PowerLow="0.85" PowerHigh="0.95" pace="0" Cadence="95" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <Ramp Duration="840" PowerLow="0.85" PowerHigh="0.95" pace="0" Cadence="95" />
        <Cooldown Duration="300" PowerLow="0.5" PowerHigh="0.3" pace="0" />
    </workout>
