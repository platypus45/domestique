<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (75min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Steady: 4min @ 88% FTP | Steady: 4min @ 90% FTP | Steady: 4min @ 93% FTP | Steady: 5min @ 55% FTP | Steady: 5min @ 88% FTP | Steady: 5min @ 90% FTP | Steady: 5min @ 93% FTP | Steady: 10min @ 55% FTP | Steady: 6min @ 88% FTP | Steady: 6min @ 90% FTP | Steady: 6min @ 93% FTP | Cooldown: 5min from 60% to 25% FTP</description>
