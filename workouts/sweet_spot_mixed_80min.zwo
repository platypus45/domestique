<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (80min)</name>
    <description>Warmup: 10min from 50% to 75% FTP | Steady: 12min @ 91% FTP | Steady: 3min @ 55% FTP | Steady: 12min @ 91% FTP | Steady: 3min @ 55% FTP | Steady: 12min @ 91% FTP | Steady: 3min @ 55% FTP | Steady: 12min @ 92% FTP | Steady: 3min @ 55% FTP | Cooldown: 10min from 75% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" pace="0" />
