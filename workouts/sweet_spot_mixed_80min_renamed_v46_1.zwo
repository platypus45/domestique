<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (83min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Steady: 15min @ 90% FTP | Steady: 10min @ 55% FTP | Steady: 15min @ 90% FTP | Steady: 10min @ 55% FTP | Steady: 20min @ 90% FTP | Cooldown: 5min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="900" Power="0.9" pace="0" />
        <SteadyState Duration="600" Power="0.55" pace="0" />
        <SteadyState Duration="900" Power="0.9" pace="0" />
        <SteadyState Duration="600" Power="0.55" pace="0" />
        <SteadyState Duration="1200" Power="0.9" pace="0" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>