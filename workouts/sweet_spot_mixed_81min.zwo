<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (81min)</name>
    <description>Warmup: 6min from 50% to 70% FTP | Steady: 1min @ 70% FTP | Steady: 1min @ 80% FTP | Steady: 30s @ 90% FTP | Steady: 30s @ 100% FTP | Steady: 2min @ 55% FTP | Steady: 30min @ 90% FTP | Steady: 5min @ 55% FTP | Steady: 30min @ 65% FTP | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="360" PowerLow="0.5" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="60" Power="0.7" pace="0" />
        <SteadyState Duration="60" Power="0.8" pace="0" />
        <SteadyState Duration="30" Power="0.9" pace="0" />
        <SteadyState Duration="30" Power="1.0" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="1800" Power="0.9" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <FreeRide Duration="1800" FlatRoad="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>