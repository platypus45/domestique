<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (85min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Steady: 30min @ 88% FTP | Steady: 10min @ 55% FTP | Steady: 30min @ 88% FTP | Cooldown: 5min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="1800" Power="0.88" pace="0" />
        <SteadyState Duration="600" Power="0.55" pace="0" />
        <SteadyState Duration="1800" Power="0.88" pace="0" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>