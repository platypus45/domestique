        <SteadyState Duration="900" Power="0.9" pace="0" />
        <SteadyState Duration="600" Power="0.55" pace="0" Cadence="70" />
        <SteadyState Duration="900" Power="0.9" pace="0" />
        <SteadyState Duration="600" Power="0.55" pace="0" Cadence="70" />
        <SteadyState Duration="900" Power="0.9" pace="0" />
