<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (85min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Steady: 15min @ 90% FTP | Steady: 10min @ 55% FTP | Steady: 15min @ 90% FTP | Steady: 10min @ 55% FTP | Steady: 15min @ 90% FTP | Cooldown: 10min from 65% to 25% FTP</description>
