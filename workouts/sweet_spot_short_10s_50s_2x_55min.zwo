<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 2x5min (58min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Intervals: 2 x (5min @ 90% / 1min @ 50%) | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="2" OnDuration="10" OffDuration="50" OnPower="1.75" OffPower="0.5" pace="0" Cadence="110" CadenceResting="80" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="1.09" pace="0" Cadence="95" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="240" Power="0.85" pace="0" Cadence="90" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="2" OnDuration="300" OffDuration="60" OnPower="0.9" OffPower="0.5" pace="0" Cadence="95" CadenceResting="80" />
        <SteadyState Duration="540" Power="0.5" pace="0" />
        <FreeRide Duration="600" FlatRoad="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
    </workout>
</workout_file>