<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 4x5min (63min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Intervals: 4 x (5min @ 92% / 3min @ 50%) | Cooldown: 10min from 50% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="2" OnDuration="10" OffDuration="50" OnPower="1.81" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="1.09" pace="0" />
        <SteadyState Duration="120" Power="0.56" pace="0" />
        <SteadyState Duration="180" Power="0.84" pace="0" />
        <SteadyState Duration="180" Power="0.56" pace="0" />
        <IntervalsT Repeat="4" OnDuration="300" OffDuration="180" OnPower="0.92" OffPower="0.5" pace="0" Cadence="100" CadenceResting="80" />
        <Cooldown Duration="600" PowerLow="0.50" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>