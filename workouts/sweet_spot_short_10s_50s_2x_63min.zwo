<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 2x12min (66min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Intervals: 2 x (12min @ 91% / 3min @ 61%) | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="2" OnDuration="10" OffDuration="50" OnPower="1.75" OffPower="0.5" pace="0" Cadence="110" CadenceResting="80" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="60" Power="1.09" pace="0" Cadence="95" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="180" Power="1.0" pace="0" Cadence="95" />
        <SteadyState Duration="180" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="2" OnDuration="720" OffDuration="180" OnPower="0.91" OffPower="0.61" pace="0" Cadence="95" CadenceResting="80" />
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="120" OnPower="1.06" OffPower="0.5" pace="0" Cadence="95" CadenceResting="80" />
        <SteadyState Duration="180" Power="0.5" pace="0" Cadence="85" />
    </workout>
</workout_file>