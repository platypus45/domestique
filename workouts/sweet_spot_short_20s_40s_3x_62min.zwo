<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 3x4min (62min)</name>
    <description>Warmup: 5min from 45% to 70% FTP | Intervals: 3 x (4min @ 90% / 1min @ 50%) | Cooldown: 5min from 70% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.45" PowerHigh="0.7" pace="0" />
        <IntervalsT Repeat="3" OnDuration="20" OffDuration="40" OnPower="1.2" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="240" OffDuration="60" OnPower="0.8" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="240" OffDuration="60" OnPower="0.9" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="2" OnDuration="240" OffDuration="60" OnPower="1.0" OffPower="0.5" pace="0" />
        <SteadyState Duration="240" Power="1.1" pace="0" />
        <Cooldown Duration="300" PowerLow="0.7" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>