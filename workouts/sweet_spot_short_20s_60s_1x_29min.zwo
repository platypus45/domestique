<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (30min)</name>
    <description>Warmup: 8min from 40% to 80% FTP | Steady: 3min @ 55% FTP | Steady: 20s @ 140% FTP | Steady: 1min @ 55% FTP | Steady: 30s @ 130% FTP | Steady: 1min @ 55% FTP | Steady: 40s @ 120% FTP | Steady: 1min @ 55% FTP | Steady: 10min @ 92% FTP | Cooldown: 4min from 55% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.4" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="20" OffDuration="60" OnPower="1.4" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="60" OnPower="1.3" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="40" OffDuration="60" OnPower="1.2" OffPower="0.55" pace="0" />
        <SteadyState Duration="600" Power="0.92" pace="0" />
        <Cooldown Duration="240" PowerLow="0.55" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>