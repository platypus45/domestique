<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (15min)</name>
    <description>Warmup: 5min from 25% to 75% FTP | Steady: 2min @ 50% FTP | Steady: 3min @ 55% FTP | Steady: 2min @ 90% FTP | Cooldown: 3min from 55% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="60" Power="0.9" pace="0" />
        <SteadyState Duration="60" Power="0.9" pace="0" />
        <Cooldown Duration="180" PowerLow="0.55" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>