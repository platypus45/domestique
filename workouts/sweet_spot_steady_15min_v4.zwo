<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (15min)</name>
    <description>Warmup: 5min from 45% to 75% FTP | Steady: 1min @ 50% FTP | Steady: 2min @ 65% FTP | Steady: 1min @ 50% FTP | Steady: 2min @ 91% FTP | Steady: 2min @ 50% FTP | Cooldown: 2min from 45% to 65% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.45" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.65" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.91" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Cooldown Duration="120" PowerLow="0.45" PowerHigh="0.65" pace="0" />
    </workout>
</workout_file>