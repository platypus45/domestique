<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery Steady (17min)</name>
    <description>Warmup: 5min @ 50% FTP | Steady: 5min @ 90% FTP | Cooldown: 7min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
    </workout>
</workout_file>