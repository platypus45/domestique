<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot Steady (17min)</name>
    <description>Warmup: 5min from 58% to 75% FTP | Steady: 5min @ 94% FTP | Cooldown: 7min from 36% to 75% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.58" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="300" Power="0.94" pace="0" />
        <Cooldown Duration="420" PowerLow="0.36" PowerHigh="0.75" pace="0" />
    </workout>
</workout_file>