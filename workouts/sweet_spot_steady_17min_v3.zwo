<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (23min)</name>
    <description>Steady: 2min @ 50% FTP | Steady: 10min @ 90% FTP | Cooldown: 5min from 50% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="600" Power="0.9" pace="0" />
        <Cooldown Duration="300" PowerLow="0.5" PowerHigh="0.3" pace="0" />
    </workout>
</workout_file>