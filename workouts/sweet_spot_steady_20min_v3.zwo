<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance Steady (20min)</name>
    <description>Warmup: 10min from 40% to 80% FTP | Steady: 3min @ 90% FTP | Cooldown: 7min from 40% to 70% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="180" Power="0.9" pace="0" />
        <Cooldown Duration="420" PowerLow="0.4" PowerHigh="0.7" pace="0" />
    </workout>
</workout_file>