<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot Steady (21min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Steady: 2min @ 90% FTP | Cooldown: 9min from 25% to 75% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.9" pace="0" />
        <Cooldown Duration="540" PowerLow="0.25" PowerHigh="0.75" pace="0" />
    </workout>
</workout_file>