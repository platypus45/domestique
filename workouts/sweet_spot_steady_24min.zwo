        <SteadyState Duration="60" Power="0.55" pace="0" />
        <SteadyState Duration="240" Power="0.55" pace="0" />
        <SteadyState Duration="240" Power="0.55" pace="0" />
        <Cooldown Duration="300" PowerLow="0.5" PowerHigh="0.65" pace="0" />
    </workout>
