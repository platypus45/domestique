<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (24min)</name>
    <description>Warmup: 5min from 50% to 60% FTP | Steady: 5min @ 78% FTP | Steady: 9min @ 55% FTP | Cooldown: 5min from 50% to 65% FTP</description>
