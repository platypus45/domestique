<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery (24min)</name>
    <description>Warmup: 5min from 50% to 60% FTP | Steady: 5min @ 82% FTP | Steady: 1min @ 55% FTP | Steady: 8min @ 50% FTP | Cooldown: 5min from 50% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.5" PowerHigh="0.6" pace="0" />
        <Ramp Duration="300" PowerLow="0.75" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.50" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>