<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (27min)</name>
    <description>Steady: 4min @ 50% FTP | Steady: 2min @ 75% FTP | Steady: 2min @ 50% FTP | Steady: 3min @ 68% FTP | Steady: 2min @ 92% FTP | Steady: 9min @ 50% FTP | Cooldown: 5min from 45% to 70% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Ramp Duration="180" PowerLow="0.5" PowerHigh="0.85" pace="0" />
        <SteadyState Duration="120" Power="0.92" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.45" PowerHigh="0.7" pace="0" />
    </workout>
</workout_file>