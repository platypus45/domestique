<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (27min)</name>
    <description>Warmup: 5min from 45% to 75% FTP | Steady: 4min @ 65% FTP | Steady: 12min @ 89% FTP | Cooldown: 6min from 65% to 40% FTP</description>
