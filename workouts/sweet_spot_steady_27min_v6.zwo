<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (27min)</name>
    <description>Warmup: 6min from 45% to 75% FTP | Steady: 1min @ 50% FTP | Steady: 1min @ 109% FTP | Steady: 2min @ 50% FTP | Steady: 3min @ 70% FTP | Steady: 4min @ 90% FTP | Steady: 5min @ 50% FTP | Cooldown: 5min from 45% to 75% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="360" PowerLow="0.45" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="1.09" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Ramp Duration="180" PowerLow="0.5" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="240" Power="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.45" PowerHigh="0.75" pace="0" />
    </workout>
</workout_file>