<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (30min)</name>
    <description>Warmup: 10min from 30% to 80% FTP | Steady: 3min @ 65% FTP | Steady: 5min @ 91% FTP | Steady: 3min @ 89% FTP | Steady: 6min @ 74% FTP | Cooldown: 3min from 72% to 48% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.3" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.91" pace="0" />
        <SteadyState Duration="180" Power="0.89" pace="0" />
        <SteadyState Duration="360" Power="0.74" pace="0" />
        <Cooldown Duration="180" PowerLow="0.72" PowerHigh="0.48" pace="0" />
    </workout>
</workout_file>