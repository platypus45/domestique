<workout_file>
    <author>Domestique Library</author>
    <name>Tempo (32min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Steady: 2min @ 50% FTP | Steady: 6min @ 55% FTP | Steady: 12min @ 82% FTP | Steady: 2min @ 50% FTP</description>
