<workout_file>
    <author>Domestique Library</author>
    <name>Tempo (36min)</name>
    <description>Warmup: 7min from 50% to 70% FTP | Steady: 6min @ 85% FTP | Steady: 2min @ 50% FTP | Steady: 6min @ 87% FTP | Steady: 2min @ 50% FTP | Steady: 6min @ 88% FTP | Cooldown: 7min from 50% to 70% FTP</description>
