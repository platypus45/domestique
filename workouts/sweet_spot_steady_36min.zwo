        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.87" pace="0" />
        <SteadyState Duration="180" Power="0.87" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.88" pace="0" />
        <SteadyState Duration="180" Power="0.88" pace="0" />
