<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot Steady (40min)</name>
    <description>Warmup: 5min from 25% to 90% FTP | Steady: 30min @ 90% FTP | Cooldown: 5min from 25% to 90% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.25" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="1800" Power="0.9" pace="0" />
        <Cooldown Duration="300" PowerLow="0.25" PowerHigh="0.9" pace="0" />
    </workout>
</workout_file>