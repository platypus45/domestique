<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (43min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Steady: 1min @ 60% FTP | Steady: 1min @ 65% FTP | Steady: 1min @ 81% FTP | Steady: 1min @ 109% FTP | Steady: 2min @ 50% FTP | Steady: 4min @ 95% FTP | Steady: 3min @ 50% FTP | Steady: 20min @ 88% FTP | Steady: 2min @ 50% FTP | Cooldown: 2min from 50% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="60" Power="0.81" pace="0" />
        <SteadyState Duration="60" Power="1.09" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="240" Power="0.95" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <Ramp Duration="1200" PowerLow="0.85" PowerHigh="0.91" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Cooldown Duration="120" PowerLow="0.5" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>