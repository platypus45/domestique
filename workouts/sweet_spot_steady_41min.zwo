<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (41min)</name>
    <description>Warmup: 8min from 40% to 80% FTP | Steady: 3min @ 55% FTP | Steady: 10min @ 92% FTP | Steady: 6min @ 55% FTP | Steady: 10min @ 92% FTP | Cooldown: 4min from 35% to 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.4" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="600" Power="0.92" pace="0" />
        <SteadyState Duration="360" Power="0.55" pace="0" />
        <SteadyState Duration="600" Power="0.92" pace="0" />
        <Cooldown Duration="240" PowerLow="0.35" PowerHigh="0.55" pace="0" />
    </workout>
</workout_file>