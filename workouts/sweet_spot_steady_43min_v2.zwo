<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold Steady (43min)</name>
    <description>Warmup: 23min from 40% to 55% FTP | Steady: 10min @ 93% FTP | Cooldown: 10min @ 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="1200" Power="0.4" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="600" Power="0.93" pace="0" />
        <SteadyState Duration="600" Power="0.4" pace="0" />
    </workout>
</workout_file>