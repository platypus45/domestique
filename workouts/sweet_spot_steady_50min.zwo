<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (50min)</name>
    <description>Warmup: 4min from 55% to 75% FTP | Steady: 1min @ 55% FTP | Steady: 5min @ 82% FTP | Steady: 5min @ 88% FTP | Steady: 5min @ 92% FTP | Steady: 4min @ 55% FTP | Steady: 4min @ 88% FTP | Steady: 4min @ 92% FTP | Steady: 4min @ 98% FTP | Steady: 3min @ 55% FTP | Steady: 3min @ 92% FTP | Steady: 3min @ 98% FTP | Steady: 3min @ 102% FTP | Cooldown: 2min from 55% to 45% FTP</description>
