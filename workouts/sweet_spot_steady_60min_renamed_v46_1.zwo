<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot Steady (60min)</name>
    <description>Warmup: 15min from 70% to 75% FTP | Steady: 30min @ 88% FTP | Cooldown: 15min from 75% to 70% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.7" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="1800" Power="0.88" pace="0" />
        <Cooldown Duration="900" PowerLow="0.75" PowerHigh="0.7" pace="0" />
    </workout>
</workout_file>