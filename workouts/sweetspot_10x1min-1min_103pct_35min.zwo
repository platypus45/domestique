<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 10x1min (35min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 10 x (1min @ 103% / 1min @ 50%) | Cooldown: 5min from 50% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="10" OnDuration="60" OffDuration="60" OnPower="1.03" OffPower="0.5" pace="0" Cadence="90" CadenceResting="80" />
        <Cooldown Duration="300" PowerLow="0.5" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>