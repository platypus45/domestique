<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 10x1min (31min)</name>
    <description>Warmup: 6min from 50% to 70% FTP | Intervals: 10 x (1min @ 103% / 1min @ 50%) | Cooldown: 5min from 50% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="360" PowerLow="0.5" PowerHigh="0.7" pace="0" Cadence="80" />
        <IntervalsT Repeat="10" OnDuration="60" OffDuration="60" OnPower="1.03" OffPower="0.5" pace="0" Cadence="90" CadenceResting="80" />
        <Cooldown Duration="300" PowerLow="0.5" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>