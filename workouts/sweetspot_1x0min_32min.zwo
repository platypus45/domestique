<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (35min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Steady: 30s @ 95% FTP | Steady: 30s @ 50% FTP | Steady: 30s @ 105% FTP | Steady: 30s @ 50% FTP | Steady: 30s @ 115% FTP | Steady: 2min 30s @ 50% FTP | Steady: 8min @ 90% FTP | Steady: 3min @ 55% FTP | Steady: 8min @ 90% FTP | Cooldown: 3min from 55% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="0.95" OffPower="0.5" pace="0" Cadence="95" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.05" OffPower="0.5" pace="0" Cadence="105" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.15" OffPower="0.5" pace="0" Cadence="115" CadenceResting="85" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="480" Power="0.9" pace="0" Cadence="90" />
        <SteadyState Duration="180" Power="0.55" pace="0" Cadence="85" />
        <SteadyState Duration="480" Power="0.9" pace="0" Cadence="80" />
        <Cooldown Duration="180" PowerLow="0.55" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>