<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 3x15s (40min)</name>
    <description>Warmup: 5min from 55% to 75% FTP | Intervals: 3 x (15s @ 150% / 45s @ 65%) | Cooldown: 5min from 55% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.55" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="1" OnDuration="15" OffDuration="45" OnPower="0.9" OffPower="0.65" pace="0" Cadence="90" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="15" OffDuration="45" OnPower="1.0" OffPower="0.65" pace="0" Cadence="100" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="15" OffDuration="45" OnPower="1.1" OffPower="0.65" pace="0" Cadence="110" CadenceResting="85" />
        <SteadyState Duration="120" Power="0.55" pace="0" Cadence="85" />
        <IntervalsT Repeat="3" OnDuration="15" OffDuration="45" OnPower="1.5" OffPower="0.65" pace="0" Cadence="110" CadenceResting="85" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <Ramp Duration="30" PowerLow="1.5" PowerHigh="1.02" pace="0" />
        <SteadyState Duration="180" Power="1.02" pace="0" />
        <FreeRide Duration="20" FlatRoad="0" />
        <SteadyState Duration="240" Power="0.55" pace="0" />
        <Ramp Duration="30" PowerLow="1.5" PowerHigh="1.02" pace="0" />
        <SteadyState Duration="180" Power="1.02" pace="0" />
        <FreeRide Duration="20" FlatRoad="0" />
        <SteadyState Duration="240" Power="0.55" pace="0" />
        <Ramp Duration="30" PowerLow="1.5" PowerHigh="1.02" pace="0" />
        <SteadyState Duration="180" Power="1.02" pace="0" />
        <FreeRide Duration="20" FlatRoad="0" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>