<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (60min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Steady: 30s @ 95% FTP | Steady: 30s @ 50% FTP | Steady: 30s @ 105% FTP | Steady: 30s @ 50% FTP | Steady: 30s @ 115% FTP | Steady: 2min 30s @ 50% FTP | Steady: 10min @ 90% FTP | Steady: 4min @ 55% FTP | Steady: 10min @ 90% FTP | Steady: 4min @ 55% FTP | Steady: 10min @ 90% FTP | Cooldown: 7min from 55% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="0.95" OffPower="0.5" pace="0" Cadence="95" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.05" OffPower="0.5" pace="0" Cadence="105" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.15" OffPower="0.5" pace="0" Cadence="115" CadenceResting="85" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="600" Power="0.9" pace="0" Cadence="90" />
        <SteadyState Duration="240" Power="0.55" pace="0" Cadence="85" />
        <SteadyState Duration="600" Power="0.9" pace="0" Cadence="80" />
        <SteadyState Duration="240" Power="0.55" pace="0" Cadence="85" />
        <SteadyState Duration="120" Power="0.9" pace="0" Cadence="90" />
        <SteadyState Duration="60" Power="0.9" pace="0" Cadence="70" />
        <SteadyState Duration="120" Power="0.9" pace="0" Cadence="90" />
        <SteadyState Duration="60" Power="0.9" pace="0" Cadence="70" />
        <SteadyState Duration="240" Power="0.9" pace="0" Cadence="100" />
        <Cooldown Duration="420" PowerLow="0.55" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>