<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 4x4min (60min)</name>
    <description>Warmup: 7min from 25% to 75% FTP | Intervals: 4 x (4min @ 90% / 1min @ 90%) | Cooldown: 5min from 55% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="420" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="0.95" OffPower="0.5" pace="0" Cadence="95" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.05" OffPower="0.5" pace="0" Cadence="105" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.15" OffPower="0.5" pace="0" Cadence="115" CadenceResting="85" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="4" OnDuration="240" OffDuration="60" OnPower="0.9" OffPower="0.9" pace="0" Cadence="90" CadenceResting="65" />
        <SteadyState Duration="180" Power="0.55" pace="0" Cadence="85" />
        <SteadyState Duration="300" Power="0.9" pace="0" Cadence="90" />
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="0.9" OffPower="0.9" pace="0" Cadence="100" CadenceResting="70" />
        <SteadyState Duration="300" Power="0.9" pace="0" Cadence="90" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>