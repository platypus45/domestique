<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo 6x2min (60min)</name>
    <description>Warmup: 10min from 40% to 75% FTP | Intervals: 6 x (1min 30s @ 95% / 3min @ 80%) | Cooldown: 6min from 50% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="0.95" OffPower="0.5" pace="0" Cadence="95" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.05" OffPower="0.5" pace="0" Cadence="105" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.15" OffPower="0.5" pace="0" Cadence="115" CadenceResting="85" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="180" Power="0.8" pace="0" Cadence="90" />
        <Ramp Duration="90" PowerLow="0.9" PowerHigh="1.0" pace="0" Cadence="90" />
        <Ramp Duration="90" PowerLow="1.0" PowerHigh="0.9" pace="0" Cadence="90" />
        <SteadyState Duration="180" Power="0.8" pace="0" Cadence="90" />
        <SteadyState Duration="240" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="180" Power="0.8" pace="0" Cadence="80" />
        <Ramp Duration="90" PowerLow="0.9" PowerHigh="1.0" pace="0" Cadence="80" />
        <Ramp Duration="90" PowerLow="1.0" PowerHigh="0.9" pace="0" Cadence="80" />
        <SteadyState Duration="180" Power="0.8" pace="0" Cadence="90" />
        <SteadyState Duration="240" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="180" Power="0.8" pace="0" Cadence="70" />
        <Ramp Duration="90" PowerLow="0.9" PowerHigh="1.0" pace="0" Cadence="70" />
        <Ramp Duration="90" PowerLow="1.0" PowerHigh="0.9" pace="0" Cadence="70" />
        <SteadyState Duration="180" Power="0.8" pace="0" Cadence="90" />
        <SteadyState Duration="240" Power="0.5" pace="0" Cadence="85" />
        <Cooldown Duration="360" PowerLow="0.5" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>