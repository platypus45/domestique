<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 2x30s (64min)</name>
    <description>Warmup: 9min from 50% to 80% FTP | Intervals: 2 x (30s @ 95% / 2min @ 55%) | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="540" PowerLow="0.5" PowerHigh="0.8" pace="0" Cadence="90" />
        <SteadyState Duration="120" Power="0.55" pace="0" Cadence="90" />
        <IntervalsT Repeat="2" OnDuration="30" OffDuration="120" OnPower="0.95" OffPower="0.55" pace="0" Cadence="115" CadenceResting="90" />
        <SteadyState Duration="20" Power="1.0" pace="0" Cadence="100" />
        <SteadyState Duration="20" Power="1.1" pace="0" Cadence="110" />
        <SteadyState Duration="20" Power="1.2" pace="0" Cadence="120" />
        <SteadyState Duration="240" Power="0.55" pace="0" Cadence="90" />
        <SteadyState Duration="30" Power="0.3" pace="0" />
        <FreeRide Duration="60" FlatRoad="0" />
        <SteadyState Duration="30" Power="0.3" pace="0" />
        <SteadyState Duration="30" Power="0.45" pace="0" />
        <SteadyState Duration="330" Power="0.55" pace="0" Cadence="90" />
        <SteadyState Duration="30" Power="0.3" pace="0" />
        <SteadyState Duration="30" Power="1.7" pace="0" />
        <SteadyState Duration="30" Power="0.3" pace="0" />
        <SteadyState Duration="30" Power="0.45" pace="0" />
        <SteadyState Duration="330" Power="0.55" pace="0" Cadence="90" />
        <SteadyState Duration="30" Power="0.3" pace="0" />
        <SteadyState Duration="45" Power="1.5" pace="0" />
        <SteadyState Duration="30" Power="0.3" pace="0" />
        <SteadyState Duration="30" Power="0.45" pace="0" />
        <SteadyState Duration="330" Power="0.55" pace="0" Cadence="90" />
        <SteadyState Duration="30" Power="0.3" pace="0" />
        <SteadyState Duration="60" Power="1.3" pace="0" />
        <SteadyState Duration="30" Power="0.3" pace="0" />
        <SteadyState Duration="30" Power="0.45" pace="0" />
        <SteadyState Duration="360" Power="0.55" pace="0" Cadence="90" />
        <SteadyState Duration="360" Power="0.87" pace="0" Cadence="90" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45" pace="0" Cadence="90" />
    </workout>
</workout_file>