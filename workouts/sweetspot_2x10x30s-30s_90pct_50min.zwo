<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 20x30s (50min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Intervals: 20 x (30s @ 90% / 30s @ 40%) | Cooldown: 5min 50s from 55% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="10" Power="1.09" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="30" OnPower="0.9" OffPower="0.4" pace="0" Cadence="65" CadenceResting="100" />
        <Ramp Duration="180" PowerLow="0.4" PowerHigh="1.05" pace="0" />
        <SteadyState Duration="30" Power="1.15" pace="0" Cadence="65" />
        <SteadyState Duration="240" Power="0.4" pace="0" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="30" OnPower="0.9" OffPower="0.4" pace="0" Cadence="65" CadenceResting="100" />
        <Ramp Duration="180" PowerLow="0.4" PowerHigh="1.05" pace="0" />
        <SteadyState Duration="30" Power="1.15" pace="0" Cadence="65" />
        <Cooldown Duration="350" PowerLow="0.55" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>