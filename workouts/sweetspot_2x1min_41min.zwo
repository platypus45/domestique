<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance 2x2min (41min)</name>
    <description>Warmup: 7min from 50% to 75% FTP | Intervals: 2 x (1min 30s @ 90% / 1min 30s @ 55%) | Cooldown: 5min from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="420" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="2" OnDuration="90" OffDuration="90" OnPower="0.9" OffPower="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <FreeRide Duration="30" FlatRoad="0" />
        <FreeRide Duration="300" FlatRoad="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <FreeRide Duration="30" FlatRoad="0" />
        <FreeRide Duration="300" FlatRoad="0" />
        <Cooldown Duration="300" PowerLow="0.6" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>