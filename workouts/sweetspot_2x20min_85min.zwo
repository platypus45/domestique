<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 2x20min (85min)</name>
    <description>Warmup: 20min from 55% to 80% FTP | Intervals: 2 x (20min @ 92% / 5min @ 60%)</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="1200" PowerLow="0.55" PowerHigh="0.8" pace="0" />
        <IntervalsT Repeat="2" OnDuration="1200" OffDuration="300" OnPower="0.92" OffPower="0.6" pace="0" />
        <Ramp Duration="600" PowerLow="0.75" PowerHigh="0.55" pace="0" />
        <FreeRide Duration="300" FlatRoad="0" />
    </workout>
</workout_file>