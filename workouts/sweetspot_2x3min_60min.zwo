<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance 2x3min (60min)</name>
    <description>Warmup: 12min from 30% to 60% FTP | Intervals: 2 x (3min @ 100% / 3min @ 50%)</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="720" PowerLow="0.3" PowerHigh="0.6" pace="0" />
        <SteadyState Duration="180" Power="0.8" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="2" OnDuration="180" OffDuration="180" OnPower="1.0" OffPower="0.5" pace="0" />
        <SteadyState Duration="600" Power="0.5" pace="0" />
        <IntervalsT Repeat="2" OnDuration="180" OffDuration="120" OnPower="0.8" OffPower="0.5" pace="0" />
        <FreeRide Duration="600" FlatRoad="0" />
    </workout>
</workout_file>