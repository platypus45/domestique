<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 10x2min (38min)</name>
    <description>Warmup: 8min from 35% to 55% FTP | Intervals: 10 x (1min 45s @ 93% / 15s @ 144%) | Cooldown: 4min from 55% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.35" PowerHigh="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="105" OffDuration="15" OnPower="0.93" OffPower="1.48" pace="0" />
        <IntervalsT Repeat="1" OnDuration="105" OffDuration="15" OnPower="0.93" OffPower="1.48" pace="0" />
        <IntervalsT Repeat="1" OnDuration="105" OffDuration="15" OnPower="0.93" OffPower="1.48" pace="0" />
        <IntervalsT Repeat="1" OnDuration="105" OffDuration="15" OnPower="0.93" OffPower="1.48" pace="0" />
        <IntervalsT Repeat="1" OnDuration="105" OffDuration="15" OnPower="0.93" OffPower="1.48" pace="0" />
        <SteadyState Duration="360" Power="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="105" OffDuration="15" OnPower="0.93" OffPower="1.4" pace="0" />
        <IntervalsT Repeat="1" OnDuration="105" OffDuration="15" OnPower="0.93" OffPower="1.4" pace="0" />
        <IntervalsT Repeat="1" OnDuration="105" OffDuration="15" OnPower="0.93" OffPower="1.4" pace="0" />
        <IntervalsT Repeat="1" OnDuration="105" OffDuration="15" OnPower="0.93" OffPower="1.4" pace="0" />
        <IntervalsT Repeat="1" OnDuration="105" OffDuration="15" OnPower="0.93" OffPower="1.4" pace="0" />
        <Cooldown Duration="240" PowerLow="0.55" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>