<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 2x8min (60min)</name>
    <description>Warmup: 5min from 40% to 65% FTP | Intervals: 2 x (8min @ 93% / 2min @ 88%)</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.4" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" Cadence="95" />
        <SteadyState Duration="180" Power="0.8" pace="0" Cadence="100" />
        <SteadyState Duration="120" Power="0.55" pace="0" Cadence="85" />
        <IntervalsT Repeat="2" OnDuration="480" OffDuration="120" OnPower="0.93" OffPower="0.88" pace="0" Cadence="75" CadenceResting="100" />
        <SteadyState Duration="180" Power="0.65" pace="0" Cadence="85" />
        <IntervalsT Repeat="5" OnDuration="120" OffDuration="120" OnPower="0.93" OffPower="0.88" pace="0" Cadence="90" CadenceResting="70" />
        <SteadyState Duration="120" Power="0.45" pace="0" />
    </workout>
</workout_file>