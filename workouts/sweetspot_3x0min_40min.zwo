<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance 3x30s (40min)</name>
    <description>Warmup: 7min from 50% to 75% FTP | Intervals: 3 x (30s @ 100% / 30s @ 55%) | Cooldown: 6min from 65% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="420" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="30" OnPower="1.0" OffPower="0.55" pace="0" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <FreeRide Duration="30" FlatRoad="0" />
        <FreeRide Duration="1200" FlatRoad="0" />
        <Cooldown Duration="360" PowerLow="0.65" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>