<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 3x30s (44min)</name>
    <description>Warmup: 8min from 50% to 75% FTP | Intervals: 3 x (30s @ 100% / 1min @ 55%) | Cooldown: 5min from 65% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="60" OnPower="1.0" OffPower="0.55" pace="0" />
        <Ramp Duration="180" PowerLow="0.65" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <FreeRide Duration="30" FlatRoad="0" />
        <FreeRide Duration="60" FlatRoad="0" />
        <FreeRide Duration="30" FlatRoad="0" />
        <SteadyState Duration="240" Power="0.55" pace="0" />
        <FreeRide Duration="30" FlatRoad="0" />
        <FreeRide Duration="60" FlatRoad="0" />
        <FreeRide Duration="30" FlatRoad="0" />
        <SteadyState Duration="240" Power="0.55" pace="0" />
        <FreeRide Duration="30" FlatRoad="0" />
        <FreeRide Duration="60" FlatRoad="0" />
        <FreeRide Duration="30" FlatRoad="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>