<workout_file>
    <author>Domestique Library</author>
    <name>Endurance 3x30s (55min)</name>
    <description>Warmup: 5min from 40% to 70% FTP | Intervals: 3 x (30s @ 100% / 2min 50s @ 70%) | Cooldown: 5min from 50% to 40% FTP</description>
