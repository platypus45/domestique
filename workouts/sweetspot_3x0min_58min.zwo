<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance 3x30s (59min)</name>
    <description>Warmup: 10min from 50% to 70% FTP | Intervals: 3 x (30s @ 100% / 1min 30s @ 55%) | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
