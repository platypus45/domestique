<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 4x5min (65min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Intervals: 4 x (5min @ 90% / 3min @ 80%) | Cooldown: 7min from 60% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="3" OnDuration="20" OffDuration="40" OnPower="1.0" OffPower="0.6" pace="0" />
        <Ramp Duration="240" PowerLow="0.6" PowerHigh="0.8" pace="0" />
        <IntervalsT Repeat="4" OnDuration="300" OffDuration="180" OnPower="0.9" OffPower="0.8" pace="0" />
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="120" OnPower="1.15" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="20" OffDuration="40" OnPower="1.25" OffPower="0.6" pace="0" />
        <Cooldown Duration="420" PowerLow="0.60" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>