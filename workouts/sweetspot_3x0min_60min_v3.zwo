<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 4x5min (60min)</name>
    <description>Warmup: 3min from 40% to 60% FTP | Intervals: 4 x (5min @ 90% / 3min @ 80%) | Cooldown: 7min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="180" PowerLow="0.4" PowerHigh="0.6" pace="0" />
        <IntervalsT Repeat="3" OnDuration="20" OffDuration="40" OnPower="1.0" OffPower="0.6" pace="0" />
        <Ramp Duration="240" PowerLow="0.6" PowerHigh="0.8" pace="0" />
        <IntervalsT Repeat="4" OnDuration="300" OffDuration="180" OnPower="0.9" OffPower="0.8" pace="0" />
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="120" OnPower="1.15" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="20" OffDuration="40" OnPower="1.25" OffPower="0.6" pace="0" />
        <Cooldown Duration="420" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>