<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 3x12min (62min)</name>
    <description>Warmup: 6min @ 50% FTP | Intervals: 3 x (12min @ 90% / 3min @ 30%)</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <Ramp Duration="60" PowerLow="0.5" PowerHigh="0.72" pace="0" />
        <SteadyState Duration="300" Power="0.72" pace="0" />
        <Ramp Duration="60" PowerLow="0.72" PowerHigh="0.96" pace="0" />
        <SteadyState Duration="120" Power="0.96" pace="0" />
        <FreeRide Duration="120" FlatRoad="0" />
        <IntervalsT Repeat="3" OnDuration="720" OffDuration="180" OnPower="0.9" OffPower="0.3" pace="0" />
    </workout>
</workout_file>