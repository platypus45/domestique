<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 2x2min (56min)</name>
    <description>Warmup: 7min from 50% to 75% FTP | Intervals: 2 x (2min @ 95% / 10s @ 120%)</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="420" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="0.9" OffPower="0.7" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.8" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <SteadyState Duration="240" Power="0.6" pace="0" />
        <SteadyState Duration="60" Power="0.8" pace="0" />
        <SteadyState Duration="60" Power="0.85" pace="0" />
        <SteadyState Duration="60" Power="0.9" pace="0" />
        <SteadyState Duration="60" Power="0.95" pace="0" />
        <SteadyState Duration="600" Power="0.6" pace="0" />
        <IntervalsT Repeat="1" OnDuration="120" OffDuration="10" OnPower="0.95" OffPower="1.2" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <IntervalsT Repeat="1" OnDuration="120" OffDuration="10" OnPower="0.95" OffPower="1.2" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="600" Power="0.6" pace="0" />
    </workout>
</workout_file>