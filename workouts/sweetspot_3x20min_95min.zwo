<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 3x20min (95min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Intervals: 3 x (20min @ 92% / 5min @ 66%) | Cooldown: 10min from 60% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="1200" OffDuration="300" OnPower="0.92" OffPower="0.66" pace="0" />
        <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>