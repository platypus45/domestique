<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery 3x20s (32min)</name>
    <description>Warmup: 5min from 55% to 75% FTP | Intervals: 3 x (20s @ 120% / 0s @ 55%) | Cooldown: 5min from 55% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.55" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="1" OnDuration="15" OffDuration="45" OnPower="1.0" OffPower="0.65" pace="0" />
        <IntervalsT Repeat="1" OnDuration="15" OffDuration="45" OnPower="1.1" OffPower="0.65" pace="0" />
        <IntervalsT Repeat="1" OnDuration="15" OffDuration="45" OnPower="1.2" OffPower="0.65" pace="0" />
        <Ramp Duration="180" PowerLow="0.9" PowerHigh="1.05" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="20" Power="1.2" pace="0" />
        <SteadyState Duration="15" Power="1.3" pace="0" />
        <FreeRide Duration="30" FlatRoad="0" />
        <SteadyState Duration="300" Power="0.4" pace="0" />
        <SteadyState Duration="20" Power="1.2" pace="0" />
        <SteadyState Duration="15" Power="1.3" pace="0" />
        <FreeRide Duration="30" FlatRoad="0" />
        <SteadyState Duration="300" Power="0.4" pace="0" />
        <SteadyState Duration="20" Power="1.2" pace="0" />
        <SteadyState Duration="15" Power="1.3" pace="0" />
        <FreeRide Duration="30" FlatRoad="0" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>