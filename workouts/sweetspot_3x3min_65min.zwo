<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 9x3min (65min)</name>
    <description>Warmup: 10min from 40% to 75% FTP | Intervals: 9 x (3min @ 90% / 1min @ 65%) | Cooldown: 7min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="180" OffDuration="60" OnPower="0.9" OffPower="0.65" pace="0" Cadence="80" CadenceResting="80" />
        <Ramp Duration="180" PowerLow="0.4" PowerHigh="0.9" pace="0" />
        <Ramp Duration="180" PowerLow="0.9" PowerHigh="0.4" pace="0" />
        <IntervalsT Repeat="3" OnDuration="180" OffDuration="60" OnPower="0.9" OffPower="0.65" pace="0" Cadence="85" CadenceResting="80" />
        <Ramp Duration="180" PowerLow="0.5" PowerHigh="0.9" pace="0" />
        <Ramp Duration="180" PowerLow="0.9" PowerHigh="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="180" OffDuration="60" OnPower="0.9" OffPower="0.65" pace="0" Cadence="90" CadenceResting="80" />
        <Cooldown Duration="420" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>