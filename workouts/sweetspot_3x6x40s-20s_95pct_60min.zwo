<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 18x40s (60min)</name>
    <description>Warmup: 20min from 25% to 50% FTP | Intervals: 18 x (40s @ 95% / 20s @ 50%)</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="1200" PowerLow="0.25" PowerHigh="0.5" pace="0" />
        <IntervalsT Repeat="6" OnDuration="40" OffDuration="20" OnPower="0.95" OffPower="0.5" pace="0" />
        <FreeRide Duration="240" FlatRoad="0" />
        <IntervalsT Repeat="6" OnDuration="40" OffDuration="20" OnPower="0.95" OffPower="0.5" pace="0" />
        <FreeRide Duration="240" FlatRoad="0" />
        <IntervalsT Repeat="6" OnDuration="40" OffDuration="20" OnPower="0.95" OffPower="0.5" pace="0" />
        <FreeRide Duration="840" FlatRoad="0" />
    </workout>
</workout_file>