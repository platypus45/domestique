<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 4x30s (60min)</name>
    <description>Warmup: 8min from 35% to 95% FTP | Intervals: 4 x (30s @ 100% / 2min 30s @ 70%) | Cooldown: 5min from 60% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.35" PowerHigh="0.95" pace="0" />
        <SteadyState Duration="120" Power="0.45" pace="0" />
        <IntervalsT Repeat="4" OnDuration="30" OffDuration="150" OnPower="1.0" OffPower="0.7" pace="0" />
        <FreeRide Duration="60" FlatRoad="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="20" OffDuration="160" OnPower="1.1" OffPower="0.7" pace="0" />
        <FreeRide Duration="60" FlatRoad="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="15" OffDuration="165" OnPower="1.15" OffPower="0.7" pace="0" />
        <FreeRide Duration="60" FlatRoad="0" />
        <Cooldown Duration="300" PowerLow="0.6" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>