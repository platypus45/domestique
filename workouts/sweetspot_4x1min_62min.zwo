<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance 8x1min (62min)</name>
    <description>Warmup: 6min from 50% to 65% FTP | Intervals: 8 x (1min @ 95% / 4min @ 65%) | Cooldown: 6min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="360" PowerLow="0.5" PowerHigh="0.65" pace="0" />
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="240" OnPower="0.95" OffPower="0.65" pace="0" />
        <SteadyState Duration="600" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="240" OnPower="0.95" OffPower="0.65" pace="0" />
        <Cooldown Duration="360" PowerLow="0.60" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>