<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 5x20s (57min)</name>
    <description>Warmup: 15min from 70% to 75% FTP | Intervals: 5 x (20s @ 100% / 5min @ 88%) | Cooldown: 15min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.7" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="5" OnDuration="20" OffDuration="300" OnPower="1.0" OffPower="0.88" pace="0" />
        <Cooldown Duration="900" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>