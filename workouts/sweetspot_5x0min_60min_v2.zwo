<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 5x30s (60min)</name>
    <description>Warmup: 10min from 45% to 75% FTP | Intervals: 5 x (30s @ 98% / 30s @ 55%) | Cooldown: 10min from 75% to 55% FTP</description>
