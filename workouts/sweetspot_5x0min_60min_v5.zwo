<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance 40s/20s 8x (60min)</name>
    <description>Warmup: 3min from 40% to 60% FTP | Microintervals: 8 x (40s @ 115% / 20s @ 60%) | Cooldown: 10min from 70% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="180" PowerLow="0.4" PowerHigh="0.6" pace="0" />
        <IntervalsT Repeat="5" OnDuration="20" OffDuration="30" OnPower="1.0" OffPower="0.6" pace="0" />
        <Ramp Duration="170" PowerLow="0.6" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.85" pace="0" />
        <Ramp Duration="900" PowerLow="0.5" PowerHigh="1.0" pace="0" />
        <Ramp Duration="900" PowerLow="1.0" PowerHigh="0.5" pace="0" />
        <IntervalsT Repeat="8" OnDuration="40" OffDuration="20" OnPower="1.15" OffPower="0.6" pace="0" />
        <Cooldown Duration="600" PowerLow="0.7" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>