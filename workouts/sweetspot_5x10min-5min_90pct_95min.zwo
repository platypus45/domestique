<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 5x10min (95min)</name>
    <description>Warmup: 6min @ 50% FTP | Intervals: 5 x (10min @ 90% / 5min @ 30%) | Cooldown: 3min ramp @ 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <Ramp Duration="60" PowerLow="0.5" PowerHigh="0.72" pace="0" />
        <SteadyState Duration="300" Power="0.72" pace="0" />
        <Ramp Duration="60" PowerLow="0.72" PowerHigh="0.96" pace="0" />
        <SteadyState Duration="120" Power="0.96" pace="0" />
        <FreeRide Duration="120" FlatRoad="0" />
        <IntervalsT Repeat="5" OnDuration="600" OffDuration="300" OnPower="0.9" OffPower="0.3" pace="0" />
    <Cooldown Duration="180" PowerLow="0.30" PowerHigh="0.30" /></workout>
</workout_file>