<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 5x1min (42min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 5 x (1min @ 100% / 1min @ 60%) | Cooldown: 5min ramp from 75% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="60" Power="0.83" pace="0" />
        <SteadyState Duration="30" Power="1.0" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="1.0" OffPower="0.6" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <IntervalsT Repeat="5" OnDuration="30" OffDuration="60" OnPower="1.15" OffPower="0.7" pace="0" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.4" /></workout>
</workout_file>