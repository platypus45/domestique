<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 5x1min (39min)</name>
    <description>Warmup: 4min from 35% to 55% FTP | Intervals: 5 x (1min @ 100% / 1min @ 60%) | Cooldown: 3min from 55% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="240" PowerLow="0.35" PowerHigh="0.55" pace="0" />
        <Ramp Duration="240" PowerLow="0.6" PowerHigh="0.68" pace="0" />
        <SteadyState Duration="60" Power="0.75" pace="0" />
        <SteadyState Duration="60" Power="0.83" pace="0" />
        <SteadyState Duration="30" Power="1.0" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="1.0" OffPower="0.6" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <IntervalsT Repeat="5" OnDuration="30" OffDuration="60" OnPower="1.15" OffPower="0.7" pace="0" />
        <Cooldown Duration="180" PowerLow="0.55" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>