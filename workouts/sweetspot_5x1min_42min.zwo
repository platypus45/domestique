    <workout>
        <Warmup Duration="420" PowerLow="0.5" PowerHigh="1.0" pace="0" />
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="1.0" OffPower="0.73" pace="0" />
        <SteadyState Duration="600" Power="0.88" pace="0" />
        <SteadyState Duration="120" Power="0.4" pace="0" />
        <SteadyState Duration="120" Power="0.4" pace="0" />
        <SteadyState Duration="120" Power="0.4" pace="0" />
        <SteadyState Duration="120" Power="0.4" pace="0" />
        <SteadyState Duration="120" Power="0.4" pace="0" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>