<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 5x1min (42min)</name>
    <description>Warmup: 7min from 50% to 100% FTP | Intervals: 5 x (1min @ 100% / 1min @ 73%) | Cooldown: 5min from 55% to 50% FTP</description>
