<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 5x1min (55min)</name>
    <description>Warmup: 3min from 45% to 60% FTP | Intervals: 5 x (1min @ 100% / 2min @ 50%) | Cooldown: 2min from 50% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="180" PowerLow="0.45" PowerHigh="0.6" pace="0" Cadence="85" />
        <SteadyState Duration="60" Power="0.6" pace="0" Cadence="90" />
        <SteadyState Duration="60" Power="0.65" pace="0" Cadence="95" />
        <SteadyState Duration="60" Power="0.81" pace="0" Cadence="100" />
        <SteadyState Duration="60" Power="1.09" pace="0" Cadence="105" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="240" Power="0.95" pace="0" Cadence="90" />
        <SteadyState Duration="180" Power="0.5" pace="0" Cadence="85" />
        <Ramp Duration="1200" PowerLow="0.85" PowerHigh="0.91" pace="0" Cadence="90" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="120" OnPower="1.0" OffPower="0.5" pace="0" Cadence="100" CadenceResting="85" />
        <Cooldown Duration="120" PowerLow="0.5" PowerHigh="0.4" pace="0" Cadence="85" />
    </workout>
</workout_file>