<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery 5x30s (25min)</name>
    <description>Warmup: 10min from 25% to 50% FTP | Intervals: 5 x (30s @ 100% / 30s @ 50%)</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="30" OffDuration="30" OnPower="1.0" OffPower="0.5" pace="0" />
        <FreeRide Duration="600" FlatRoad="0" />
    </workout>
</workout_file>