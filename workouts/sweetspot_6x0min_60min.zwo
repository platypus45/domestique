<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 18x30s (60min)</name>
    <description>Warmup: 10min from 50% to 65% FTP | Intervals: 18 x (30s @ 95% / 30s @ 50%) | Cooldown: 6min 30s @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.81" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.81" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="6" OnDuration="30" OffDuration="30" OnPower="0.95" OffPower="0.5" pace="0" />
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <IntervalsT Repeat="6" OnDuration="30" OffDuration="30" OnPower="0.95" OffPower="0.5" pace="0" />
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <IntervalsT Repeat="6" OnDuration="30" OffDuration="30" OnPower="0.95" OffPower="0.5" pace="0" />
        <SteadyState Duration="360" Power="0.5" pace="0" />
    </workout>
</workout_file>