<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 6x2min (60min)</name>
    <description>Warmup: 4min from 25% to 50% FTP | Intervals: 6 x (2min @ 95% / 3min @ 85%) | Cooldown: 9min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="240" PowerLow="0.25" PowerHigh="0.5" pace="0" />
        <SteadyState Duration="20" Power="0.81" pace="0" />
        <SteadyState Duration="20" Power="0.95" pace="0" />
        <SteadyState Duration="20" Power="0.81" pace="0" />
        <Ramp Duration="240" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="6" OnDuration="120" OffDuration="180" OnPower="0.95" OffPower="0.85" pace="0" />
        <SteadyState Duration="120" Power="0.65" pace="0" />
        <SteadyState Duration="600" Power="0.9" pace="0" Cadence="85" />
        <Cooldown Duration="540" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>