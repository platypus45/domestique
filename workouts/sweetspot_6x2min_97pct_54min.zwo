<?xml version='1.0' encoding='utf-8'?>
<workout_file>
  <author>Domestique Library</author>
  <name>Sweet Spot 6x2min (54min)</name>
  <description>Warmup: 10min from 45% to 56% FTP | Intervals: 6 x (2min @ 97% / 2min @ 88%) | Cooldown: 15min from 56% to 40% FTP</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.56" />
    <SteadyState Duration="300" Power="0.68" />
    <IntervalsT Repeat="6" OnDuration="120" OffDuration="120" OnPower="0.97" OffPower="0.88" />
    <Cooldown Duration="900" PowerLow="0.56" PowerHigh="0.40" />
  </workout>
</workout_file>