<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 6x5min (88min)</name>
    <description>Warmup: 20min from 35% to 85% FTP | Intervals: 6 x (5min @ 90% / 5min @ 40%) | Cooldown: 3min ramp @ 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="1200" PowerLow="0.35" PowerHigh="0.85" pace="0" />
        <SteadyState Duration="300" Power="0.4" pace="0" />
        <IntervalsT Repeat="6" OnDuration="300" OffDuration="300" OnPower="0.9" OffPower="0.4" pace="0" />
    <Cooldown Duration="180" PowerLow="0.40" PowerHigh="0.40" /></workout>
</workout_file>