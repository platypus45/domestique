<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 6x6min (65min)</name>
    <description>Warmup: 6min @ 50% FTP | Intervals: 6 x (6min @ 90% / 2min @ 30%)</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <Ramp Duration="60" PowerLow="0.5" PowerHigh="0.72" pace="0" />
        <SteadyState Duration="300" Power="0.72" pace="0" />
        <Ramp Duration="60" PowerLow="0.72" PowerHigh="0.96" pace="0" />
        <SteadyState Duration="120" Power="0.96" pace="0" />
        <FreeRide Duration="120" FlatRoad="0" />
        <IntervalsT Repeat="6" OnDuration="360" OffDuration="120" OnPower="0.9" OffPower="0.3" pace="0" />
    </workout>
</workout_file>