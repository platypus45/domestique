<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 8x1min (55min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Intervals: 8 x (1min @ 100% / 1min @ 50%) | Cooldown: 3min ramp from 75% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="60" Power="0.81" pace="0" Cadence="100" />
        <SteadyState Duration="60" Power="1.09" pace="0" Cadence="105" />
        <SteadyState Duration="180" Power="0.5" pace="0" Cadence="85" />
        <Ramp Duration="1200" PowerLow="0.85" PowerHigh="0.91" pace="0" Cadence="90" />
        <SteadyState Duration="180" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="8" OnDuration="60" OffDuration="60" OnPower="1.0" OffPower="0.5" pace="0" Cadence="100" CadenceResting="85" />
        <Cooldown Duration="180" PowerLow="0.75" PowerHigh="0.4" /></workout>
</workout_file>