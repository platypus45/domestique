<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 8x1min (66min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Intervals: 8 x (1min @ 98% / 2min @ 50%) | Cooldown: 5min from 50% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="60" Power="0.81" pace="0" />
        <SteadyState Duration="60" Power="1.09" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="240" Power="0.95" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <Ramp Duration="900" PowerLow="0.88" PowerHigh="0.94" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="8" OnDuration="60" OffDuration="120" OnPower="0.98" OffPower="0.5" pace="0" Cadence="110" CadenceResting="90" />
        <Cooldown Duration="300" PowerLow="0.50" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>