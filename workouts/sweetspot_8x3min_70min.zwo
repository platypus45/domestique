<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 8x3min (70min)</name>
    <description>Warmup: 15min from 50% to 55% FTP | Intervals: 8 x (3min @ 90% / 2min @ 56%) | Cooldown: 15min from 55% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.5" PowerHigh="0.55" pace="0" />
        <IntervalsT Repeat="8" OnDuration="180" OffDuration="120" OnPower="0.9" OffPower="0.56" pace="0" />
        <Cooldown Duration="900" PowerLow="0.55" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>