<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 10x1min (58min)</name>
    <description>Warmup: 5min from 50% to 70% FTP | Intervals: 10 x (1min @ 88% / 2min @ 73%) | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.5" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.7" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <IntervalsT Repeat="10" OnDuration="60" OffDuration="120" OnPower="0.88" OffPower="0.73" pace="0" Cadence="105" CadenceResting="85" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <SteadyState Duration="600" Power="0.8" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
    </workout>
</workout_file>