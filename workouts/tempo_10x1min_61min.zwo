<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance 10x1min (61min)</name>
    <description>Warmup: 5min @ 50% FTP | Intervals: 10 x (1min @ 104% / 2min @ 72%) | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="30" OffDuration="30" OnPower="0.65" OffPower="0.8" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.8" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <IntervalsT Repeat="10" OnDuration="120" OffDuration="60" OnPower="0.75" OffPower="1.04" pace="0" Cadence="85" CadenceResting="65" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.8" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
    </workout>
</workout_file>