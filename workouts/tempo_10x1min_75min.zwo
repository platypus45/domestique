<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo 10x1min (75min)</name>
    <description>Warmup: 10min from 55% to 72% FTP | Intervals: 10 x (1min @ 87% / 1min @ 72%) | Cooldown: 10min from 75% to 60% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.55" PowerHigh="0.72" pace="0" Cadence="90" />
        <SteadyState Duration="120" Power="0.4" pace="0" Cadence="60" />
        <SteadyState Duration="120" Power="0.4" pace="0" Cadence="60" />
        <SteadyState Duration="120" Power="0.35" pace="0" Cadence="60" />
        <SteadyState Duration="120" Power="0.35" pace="0" Cadence="60" />
        <SteadyState Duration="120" Power="0.4" pace="0" Cadence="60" />
        <SteadyState Duration="120" Power="0.4" pace="0" Cadence="60" />
        <SteadyState Duration="120" Power="0.35" pace="0" Cadence="60" />
        <SteadyState Duration="120" Power="0.35" pace="0" Cadence="60" />
        <SteadyState Duration="120" Power="0.4" pace="0" Cadence="60" />
        <SteadyState Duration="120" Power="0.4" pace="0" Cadence="60" />
        <SteadyState Duration="300" Power="0.72" pace="0" Cadence="100" />
        <IntervalsT Repeat="10" OnDuration="60" OffDuration="60" OnPower="0.87" OffPower="0.72" pace="0" Cadence="110" CadenceResting="90" />
        <SteadyState Duration="600" Power="0.8" pace="0" Cadence="90" />
        <Cooldown Duration="600" PowerLow="0.75" PowerHigh="0.6" pace="0" />
    </workout>
</workout_file>