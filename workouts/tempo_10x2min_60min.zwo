<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 10x2min (64min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Intervals: 10 x (2min @ 90% / 2min @ 80%) | Cooldown: 3min ramp from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="5" OnDuration="30" OffDuration="30" OnPower="1.0" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="2" OnDuration="120" OffDuration="120" OnPower="0.9" OffPower="0.8" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <IntervalsT Repeat="2" OnDuration="120" OffDuration="120" OnPower="0.9" OffPower="0.8" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <IntervalsT Repeat="2" OnDuration="120" OffDuration="120" OnPower="0.9" OffPower="0.8" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <IntervalsT Repeat="2" OnDuration="120" OffDuration="120" OnPower="0.9" OffPower="0.8" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <IntervalsT Repeat="2" OnDuration="120" OffDuration="120" OnPower="0.9" OffPower="0.8" pace="0" />
        <Cooldown Duration="180" PowerLow="0.60" PowerHigh="0.40" /></workout>
</workout_file>