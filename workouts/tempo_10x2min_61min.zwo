<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 10x2min (61min)</name>
    <description>Warmup: 5min from 35% to 55% FTP | Intervals: 10 x (2min @ 90% / 2min @ 80%) | Cooldown: 3min from 50% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.35" PowerHigh="0.55" pace="0" />
        <IntervalsT Repeat="5" OnDuration="30" OffDuration="30" OnPower="1.0" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="2" OnDuration="120" OffDuration="120" OnPower="0.9" OffPower="0.8" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <IntervalsT Repeat="2" OnDuration="120" OffDuration="120" OnPower="0.9" OffPower="0.8" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <IntervalsT Repeat="2" OnDuration="120" OffDuration="120" OnPower="0.9" OffPower="0.8" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <IntervalsT Repeat="2" OnDuration="120" OffDuration="120" OnPower="0.9" OffPower="0.8" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <IntervalsT Repeat="2" OnDuration="120" OffDuration="120" OnPower="0.9" OffPower="0.8" pace="0" />
        <Cooldown Duration="180" PowerLow="0.5" PowerHigh="0.3" pace="0" />
    </workout>
</workout_file>