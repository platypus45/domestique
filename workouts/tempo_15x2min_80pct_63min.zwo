<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 14x30s (63min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Intervals: 14 x (30s @ 100% / 2min @ 80%) | Cooldown: 10min from 60% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="0.75" OffPower="0.5" pace="0" Cadence="100" CadenceResting="80" />
        <SteadyState Duration="120" Power="0.8" pace="0" Cadence="90" />
        <IntervalsT Repeat="14" OnDuration="30" OffDuration="120" OnPower="1.0" OffPower="0.8" pace="0" Cadence="110" CadenceResting="90" />
        <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>