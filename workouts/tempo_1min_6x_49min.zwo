<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo 1min/30s 6x (49min)</name>
    <description>Warmup: 7min from 50% to 70% FTP | Microintervals: 6 x (1min @ 110% / 30s @ 50%) | Cooldown: 5min from 70% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="420" PowerLow="0.5" PowerHigh="0.7" pace="0" Cadence="85" />
        <IntervalsT Repeat="1" OnDuration="60" OffDuration="30" OnPower="1.1" OffPower="0.5" pace="0" Cadence="100" CadenceResting="90" />
        <SteadyState Duration="480" Power="0.87" pace="0" Cadence="90" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="30" OnPower="1.1" OffPower="0.5" pace="0" Cadence="100" CadenceResting="90" />
        <SteadyState Duration="480" Power="0.87" pace="0" Cadence="90" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="30" OnPower="1.1" OffPower="0.5" pace="0" Cadence="100" CadenceResting="90" />
        <SteadyState Duration="480" Power="0.87" pace="0" Cadence="90" />
        <Cooldown Duration="300" PowerLow="0.7" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>