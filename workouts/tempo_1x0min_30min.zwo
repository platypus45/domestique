<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 4x30s (34min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Intervals: 4 x (30s @ 115% / 30s @ 50%)</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="0.85" OffPower="0.5" pace="0" Cadence="95" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.05" OffPower="0.5" pace="0" Cadence="105" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.15" OffPower="0.5" pace="0" Cadence="115" CadenceResting="85" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="180" Power="0.85" pace="0" Cadence="85" />
        <SteadyState Duration="60" Power="1.05" pace="0" Cadence="100" />
        <SteadyState Duration="30" Power="1.15" pace="0" Cadence="110" />
        <SteadyState Duration="180" Power="0.85" pace="0" Cadence="85" />
        <SteadyState Duration="60" Power="1.05" pace="0" Cadence="100" />
        <SteadyState Duration="30" Power="1.15" pace="0" Cadence="110" />
        <SteadyState Duration="180" Power="0.85" pace="0" Cadence="85" />
        <SteadyState Duration="60" Power="1.05" pace="0" Cadence="100" />
        <SteadyState Duration="30" Power="1.15" pace="0" Cadence="110" />
        <SteadyState Duration="180" Power="0.85" pace="0" Cadence="85" />
        <SteadyState Duration="60" Power="1.05" pace="0" Cadence="100" />
        <SteadyState Duration="30" Power="1.5" pace="0" Cadence="110" />
        <Cooldown Duration="180" PowerLow="0.75" PowerHigh="0.4" /></workout>
</workout_file>