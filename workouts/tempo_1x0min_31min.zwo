        <SteadyState Duration="60" Power="1.05" pace="0" Cadence="65" />
        <SteadyState Duration="30" Power="1.15" pace="0" Cadence="65" />
        <SteadyState Duration="180" Power="0.85" pace="0" Cadence="90" />
        <SteadyState Duration="60" Power="1.05" pace="0" Cadence="65" />
        <SteadyState Duration="30" Power="1.15" pace="0" Cadence="65" />
        <Cooldown Duration="180" PowerLow="0.55" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>