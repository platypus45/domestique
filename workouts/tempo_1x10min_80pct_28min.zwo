<workout_file>
    <author>Domestique Library</author>
    <name>Tempo (28min)</name>
    <description>Warmup: 5min from 50% to 70% FTP | Steady: 1min @ 55% FTP | Steady: 5min @ 70% FTP | Steady: 2min @ 55% FTP | Steady: 10min @ 80% FTP | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.5" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.7" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <SteadyState Duration="600" Power="0.8" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
    </workout>
