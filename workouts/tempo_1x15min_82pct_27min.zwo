<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo Steady (27min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Steady: 15min @ 82% FTP | Cooldown: 4min from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="900" Power="0.82" pace="0" />
        <Cooldown Duration="240" PowerLow="0.60" PowerHigh="0.40" pace="0" />
    </workout>
</workout_file>