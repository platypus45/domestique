<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (105min)</name>
    <description>Warmup: 15min from 45% to 65% FTP | Steady: 5min @ 40% FTP | Steady: 30min @ 52% FTP | Steady: 25min @ 73% FTP | Steady: 20min @ 88% FTP | Cooldown: 10min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.45" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.4" pace="0" />
        <SteadyState Duration="1800" Power="0.52" pace="0" />
        <SteadyState Duration="1500" Power="0.73" pace="0" />
        <SteadyState Duration="1200" Power="0.88" pace="0" />
        <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>