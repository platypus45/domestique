<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (21min)</name>
    <description>Steady: 2min @ 40% FTP | Steady: 2min @ 50% FTP | Steady: 2min @ 60% FTP | Steady: 2min @ 70% FTP | Steady: 2min @ 80% FTP | Steady: 2min @ 50% FTP | Steady: 6min @ 65% FTP | Cooldown: 3min from 50% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="120" Power="0.4" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.6" pace="0" />
        <SteadyState Duration="120" Power="0.7" pace="0" />
        <SteadyState Duration="120" Power="0.8" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <Cooldown Duration="180" PowerLow="0.5" PowerHigh="0.3" pace="0" />
    </workout>
</workout_file>