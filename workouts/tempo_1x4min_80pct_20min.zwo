<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance Steady (20min)</name>
    <description>Warmup: 8min from 40% to 75% FTP | Steady: 4min @ 80% FTP | Cooldown: 8min from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.4" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="240" Power="0.8" pace="0" />
        <Cooldown Duration="480" PowerLow="0.60" PowerHigh="0.40" pace="0" />
    </workout>
</workout_file>