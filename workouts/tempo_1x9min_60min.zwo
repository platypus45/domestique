<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo (60min)</name>
    <description>Steady: 2min @ 40% FTP | Steady: 2min @ 50% FTP | Steady: 2min @ 60% FTP | Steady: 2min @ 70% FTP | Steady: 2min @ 80% FTP | Steady: 2min @ 50% FTP | Steady: 9min @ 80% FTP | Steady: 3min @ 65% FTP | Steady: 9min @ 80% FTP | Steady: 3min @ 65% FTP | Steady: 9min @ 80% FTP | Steady: 3min @ 65% FTP | Steady: 9min @ 80% FTP | Cooldown: 3min from 50% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="120" Power="0.4" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.6" pace="0" />
        <SteadyState Duration="120" Power="0.7" pace="0" />
        <SteadyState Duration="120" Power="0.8" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="1" OnDuration="540" OffDuration="180" OnPower="0.8" OffPower="0.65" pace="0" Cadence="50" CadenceResting="65" />
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="60" OnPower="0.8" OffPower="0.8" pace="0" Cadence="50" CadenceResting="50" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <IntervalsT Repeat="3" OnDuration="90" OffDuration="90" OnPower="0.8" OffPower="0.8" pace="0" Cadence="50" CadenceResting="50" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="120" OnPower="0.8" OffPower="0.8" pace="0" Cadence="50" CadenceResting="50" />
        <Cooldown Duration="180" PowerLow="0.5" PowerHigh="0.3" pace="0" />
    </workout>
</workout_file>