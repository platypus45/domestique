<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 20s/10s 8x (44min)</name>
    <description>Warmup: 10min from 40% to 60% FTP | Microintervals: 8 x (20s @ 120% / 10s @ 50%) | Cooldown: 10min from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.6" pace="0" />
        <SteadyState Duration="600" Power="0.78" pace="0" />
        <IntervalsT Repeat="8" OnDuration="20" OffDuration="10" OnPower="1.2" OffPower="0.5" pace="0" />
        <SteadyState Duration="600" Power="0.78" pace="0" />
        <Cooldown Duration="600" PowerLow="0.6" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>