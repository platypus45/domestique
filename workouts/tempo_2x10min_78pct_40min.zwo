<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo Steady (40min)</name>
    <description>Warmup: 10min from 40% to 60% FTP | Steady: 20min @ 78% FTP | Cooldown: 10min from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.6" pace="0" />
        <SteadyState Duration="600" Power="0.78" pace="0" />
        <SteadyState Duration="600" Power="0.78" pace="0" />
        <Cooldown Duration="600" PowerLow="0.6" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>