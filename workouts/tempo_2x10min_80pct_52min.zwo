<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed (52min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Steady: 10min @ 80% FTP | Steady: 5min @ 95% FTP | Steady: 1min @ 102% FTP | Steady: 10min @ 80% FTP | Steady: 5min @ 95% FTP | Steady: 1min @ 102% FTP | Cooldown: 10min @ 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="600" Power="0.8" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <SteadyState Duration="60" Power="1.02" pace="0" />
        <SteadyState Duration="600" Power="0.8" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <SteadyState Duration="60" Power="1.02" pace="0" />
        <SteadyState Duration="600" Power="0.4" pace="0" />
    </workout>
</workout_file>