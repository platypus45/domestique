<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 2x12min (66min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Intervals: 2 x (12min @ 88% / 3min @ 50%) | Cooldown: 5min from 75% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="60" Power="0.81" pace="0" />
        <SteadyState Duration="60" Power="1.09" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="240" Power="0.95" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="2" OnDuration="720" OffDuration="180" OnPower="0.88" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="120" OnPower="0.98" OffPower="0.5" pace="0" Cadence="110" CadenceResting="90" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>