<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo 2x17min (105min)</name>
    <description>Warmup: 15min from 25% to 75% FTP | Intervals: 2 x (17min @ 85% / 5min @ 50%) | Cooldown: 10min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="1080" Power="0.75" pace="0" />
        <IntervalsT Repeat="2" OnDuration="1020" OffDuration="300" OnPower="0.85" OffPower="0.5" pace="0" />
        <SteadyState Duration="1080" Power="0.75" pace="0" />
        <Cooldown Duration="600" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>