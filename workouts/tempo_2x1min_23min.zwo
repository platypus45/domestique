<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo Steady (23min)</name>
    <description>Warmup: 4min from 40% to 70% FTP | Steady: 15min @ 82% FTP | Cooldown: 4min from 40% to 65% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="240" PowerLow="0.4" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="900" Power="0.82" pace="0" />
        <Cooldown Duration="240" PowerLow="0.4" PowerHigh="0.65" pace="0" />
    </workout>
</workout_file>