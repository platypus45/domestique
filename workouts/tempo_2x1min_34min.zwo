<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance 5x1min (34min)</name>
    <description>Warmup: 5min from 50% to 75% FTP | Intervals: 5 x (1min @ 90% / 3min @ 65%) | Cooldown: 5min from 50% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="60" OnPower="0.8" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="180" OnPower="0.9" OffPower="0.65" pace="0" />
        <Cooldown Duration="300" PowerLow="0.5" PowerHigh="0.3" pace="0" />
    </workout>
</workout_file>