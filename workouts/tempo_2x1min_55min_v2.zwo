<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 2x1min (55min)</name>
    <description>Warmup: 5min from 45% to 75% FTP | Intervals: 2 x (1min @ 98% / 1min @ 50%) | Cooldown: 5min from 75% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.45" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="60" OnPower="0.8" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="60" OnPower="0.98" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.1" pace="0" />
        <Ramp Duration="570" PowerLow="0.88" PowerHigh="0.94" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.1" pace="0" />
        <Ramp Duration="570" PowerLow="0.88" PowerHigh="0.94" pace="0" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>