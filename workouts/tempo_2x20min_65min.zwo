<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo (65min)</name>
    <description>Warmup: 10min from 35% to 70% FTP | Steady: 20min @ 80% FTP | Steady: 5min @ 50% FTP | Steady: 20min @ 80% FTP | Steady: 5min @ 50% FTP | Cooldown: 5min from 51% to 31% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.35" PowerHigh="0.7" pace="0" Cadence="95" />
        <IntervalsT Repeat="2" OnDuration="1200" OffDuration="300" OnPower="0.8" OffPower="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.51" PowerHigh="0.31" pace="0" />
    </workout>
</workout_file>