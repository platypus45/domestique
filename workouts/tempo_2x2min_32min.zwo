<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (33min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Steady: 10min @ 88% FTP | Steady: 10min @ 40% FTP | Cooldown: 5min @ 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="600" Power="0.88" pace="0" />
        <SteadyState Duration="120" Power="0.4" pace="0" />
        <SteadyState Duration="120" Power="0.4" pace="0" />
        <SteadyState Duration="120" Power="0.4" pace="0" />
        <SteadyState Duration="120" Power="0.4" pace="0" />
        <SteadyState Duration="120" Power="0.4" pace="0" />
        <Cooldown Duration="300" PowerLow="0.40" PowerHigh="0.40" pace="0" />
    </workout>
</workout_file>