<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo (58min)</name>
    <description>Steady: 2min @ 40% FTP | Steady: 2min @ 50% FTP | Steady: 2min @ 60% FTP | Steady: 2min @ 70% FTP | Steady: 3min @ 80% FTP | Steady: 2min @ 50% FTP | Steady: 20min @ 75% FTP | Steady: 20min @ 85% FTP | Cooldown: 5min from 30% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="120" Power="0.4" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.6" pace="0" />
        <SteadyState Duration="120" Power="0.7" pace="0" />
        <SteadyState Duration="180" Power="0.8" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="1200" Power="0.75" pace="0" />
        <SteadyState Duration="1200" Power="0.85" pace="0" />
        <Cooldown Duration="300" PowerLow="0.3" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>