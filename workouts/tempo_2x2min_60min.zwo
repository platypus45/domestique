<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 2x5min (60min)</name>
    <description>Warmup: 9min from 50% to 80% FTP | Intervals: 2 x (5min @ 103% / 2min @ 55%) | Cooldown: 5min from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="540" PowerLow="0.5" PowerHigh="0.8" pace="0" Cadence="90" />
        <SteadyState Duration="180" Power="0.55" pace="0" Cadence="90" />
        <IntervalsT Repeat="2" OnDuration="120" OffDuration="180" OnPower="0.85" OffPower="0.55" pace="0" Cadence="100" CadenceResting="85" />
        <SteadyState Duration="120" Power="1.05" pace="0" Cadence="90" />
        <SteadyState Duration="30" Power="1.3" pace="0" Cadence="100" />
        <SteadyState Duration="180" Power="0.65" pace="0" Cadence="90" />
        <SteadyState Duration="120" Power="1.05" pace="0" Cadence="90" />
        <SteadyState Duration="30" Power="1.3" pace="0" Cadence="100" />
        <SteadyState Duration="180" Power="0.65" pace="0" Cadence="90" />
        <IntervalsT Repeat="2" OnDuration="300" OffDuration="120" OnPower="1.03" OffPower="0.55" pace="0" Cadence="100" CadenceResting="85" />
        <FreeRide Duration="480" FlatRoad="0" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.45" pace="0" Cadence="90" />
    </workout>
</workout_file>