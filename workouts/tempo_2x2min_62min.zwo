<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 18x30s (62min)</name>
    <description>Warmup: 10min from 40% to 73% FTP | Intervals: 18 x (30s @ 100% / 30s @ 73%) | Cooldown: 5min from 53% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.73" pace="0" Cadence="85" />
        <SteadyState Duration="300" Power="0.88" pace="0" Cadence="90" />
        <SteadyState Duration="120" Power="0.53" pace="0" Cadence="85" />
        <IntervalsT Repeat="2" OnDuration="120" OffDuration="30" OnPower="0.88" OffPower="0.88" pace="0" Cadence="90" CadenceResting="105" />
        <SteadyState Duration="120" Power="0.53" pace="0" Cadence="85" />
        <SteadyState Duration="300" Power="0.88" pace="0" Cadence="95" />
        <SteadyState Duration="120" Power="0.53" pace="0" Cadence="85" />
        <IntervalsT Repeat="6" OnDuration="30" OffDuration="30" OnPower="1.0" OffPower="0.73" pace="0" Cadence="100" CadenceResting="85" />
        <SteadyState Duration="240" Power="0.53" pace="0" Cadence="85" />
        <IntervalsT Repeat="6" OnDuration="30" OffDuration="30" OnPower="1.0" OffPower="0.73" pace="0" Cadence="70" CadenceResting="90" />
        <SteadyState Duration="240" Power="0.53" pace="0" Cadence="85" />
        <IntervalsT Repeat="6" OnDuration="30" OffDuration="30" OnPower="1.0" OffPower="0.73" pace="0" Cadence="100" CadenceResting="85" />
        <Cooldown Duration="300" PowerLow="0.53" PowerHigh="0.4" pace="0" Cadence="85" />
    </workout>
</workout_file>