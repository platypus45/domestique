<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo (19min)</name>
    <description>Steady: 3min @ 85% FTP | Steady: 2min @ 50% FTP | Steady: 3min @ 85% FTP | Steady: 2min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="180" Power="0.85" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.85" pace="0" />
        <Cooldown Duration="180" PowerLow="0.75" PowerHigh="0.4" /></workout>
</workout_file>