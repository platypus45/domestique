<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo 2x3min (56min)</name>
    <description>Warmup: 3min from 45% to 60% FTP | Intervals: 2 x (3min @ 85% / 1min 30s @ 50%) | Cooldown: 5min from 63% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="180" PowerLow="0.45" PowerHigh="0.6" pace="0" />
        <SteadyState Duration="60" Power="0.65" pace="0" />
        <SteadyState Duration="60" Power="0.77" pace="0" />
        <SteadyState Duration="60" Power="0.91" pace="0" />
        <SteadyState Duration="60" Power="1.06" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.8" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="2" OnDuration="180" OffDuration="90" OnPower="0.85" OffPower="0.5" pace="0" />
        <SteadyState Duration="210" Power="0.5" pace="0" />
        <Ramp Duration="300" PowerLow="0.8" PowerHigh="0.95" pace="0" />
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <Ramp Duration="120" PowerLow="0.95" PowerHigh="1.07" pace="0" />
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <FreeRide Duration="240" FlatRoad="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.63" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>