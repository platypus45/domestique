<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 2x3min (56min)</name>
    <description>Warmup: 5min from 45% to 75% FTP | Intervals: 2 x (3min @ 85% / 3min @ 60%) | Cooldown: 5min from 65% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.45" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="60" Power="0.6" pace="0" />
        <SteadyState Duration="300" Power="0.8" pace="0" />
        <SteadyState Duration="60" Power="0.65" pace="0" />
        <IntervalsT Repeat="5" OnDuration="30" OffDuration="30" OnPower="0.75" OffPower="0.9" pace="0" />
        <SteadyState Duration="120" Power="0.65" pace="0" />
        <IntervalsT Repeat="4" OnDuration="120" OffDuration="180" OnPower="0.8" OffPower="0.6" pace="0" Cadence="70" CadenceResting="90" />
        <IntervalsT Repeat="2" OnDuration="180" OffDuration="180" OnPower="0.85" OffPower="0.6" pace="0" Cadence="70" CadenceResting="90" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>