<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 2x3min (61min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Intervals: 2 x (3min @ 85% / 2min @ 60%) | Cooldown: 5min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="510" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="300" Power="0.8" pace="0" />
        <SteadyState Duration="60" Power="0.65" pace="0" />
        <IntervalsT Repeat="5" OnDuration="30" OffDuration="30" OnPower="0.75" OffPower="0.9" pace="0" />
        <SteadyState Duration="120" Power="0.65" pace="0" />
        <IntervalsT Repeat="7" OnDuration="90" OffDuration="120" OnPower="0.8" OffPower="0.6" pace="0" Cadence="70" CadenceResting="95" />
        <IntervalsT Repeat="2" OnDuration="180" OffDuration="120" OnPower="0.85" OffPower="0.6" pace="0" Cadence="70" CadenceResting="95" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>