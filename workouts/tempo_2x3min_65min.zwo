<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo 8x3min (65min)</name>
    <description>Warmup: 10min from 55% to 75% FTP | Intervals: 8 x (3min @ 89% / 1min @ 98%) | Cooldown: 8min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.55" PowerHigh="0.75" pace="0" Cadence="95" />
        <IntervalsT Repeat="2" OnDuration="180" OffDuration="60" OnPower="0.89" OffPower="0.98" pace="0" Cadence="85" CadenceResting="85" />
        <SteadyState Duration="300" Power="0.55" pace="0" Cadence="95" />
        <IntervalsT Repeat="2" OnDuration="180" OffDuration="60" OnPower="0.89" OffPower="0.98" pace="0" Cadence="85" CadenceResting="85" />
        <SteadyState Duration="300" Power="0.55" pace="0" Cadence="95" />
        <IntervalsT Repeat="2" OnDuration="180" OffDuration="60" OnPower="0.89" OffPower="0.98" pace="0" Cadence="85" CadenceResting="85" />
        <SteadyState Duration="300" Power="0.55" pace="0" Cadence="95" />
        <IntervalsT Repeat="2" OnDuration="180" OffDuration="60" OnPower="0.89" OffPower="0.98" pace="0" Cadence="85" CadenceResting="85" />
        <Cooldown Duration="480" PowerLow="0.65" PowerHigh="0.45" pace="0" Cadence="95" />
    </workout>
</workout_file>