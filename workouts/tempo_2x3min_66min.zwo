<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo 4x3min (66min)</name>
    <description>Warmup: 10min from 40% to 73% FTP | Intervals: 4 x (3min @ 86% / 3min @ 89%) | Cooldown: 3min from 53% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.73" pace="0" Cadence="85" />
        <SteadyState Duration="120" Power="0.73" pace="0" Cadence="90" />
        <SteadyState Duration="120" Power="0.88" pace="0" Cadence="95" />
        <SteadyState Duration="60" Power="1.0" pace="0" Cadence="100" />
        <SteadyState Duration="300" Power="0.53" pace="0" Cadence="85" />
        <IntervalsT Repeat="2" OnDuration="180" OffDuration="180" OnPower="0.86" OffPower="0.89" pace="0" Cadence="60" CadenceResting="90" />
        <SteadyState Duration="360" Power="0.53" pace="0" Cadence="85" />
        <IntervalsT Repeat="2" OnDuration="180" OffDuration="180" OnPower="0.86" OffPower="0.89" pace="0" Cadence="60" CadenceResting="90" />
        <SteadyState Duration="300" Power="1.0" pace="0" Cadence="95" />
        <SteadyState Duration="180" Power="0.53" pace="0" Cadence="85" />
        <SteadyState Duration="300" Power="1.0" pace="0" Cadence="95" />
        <Cooldown Duration="180" PowerLow="0.53" PowerHigh="0.4" pace="0" Cadence="85" />
    </workout>
</workout_file>