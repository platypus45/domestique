<workout_file>
    <author>Domestique Library</author>
    <name>Tempo (24min)</name>
    <description>Steady: 5min @ 80% FTP | Steady: 3min @ 50% FTP | Steady: 5min @ 80% FTP | Steady: 3min @ 50% FTP</description>
