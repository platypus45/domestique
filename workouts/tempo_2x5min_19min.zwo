<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (19min)</name>
    <description>Warmup: 5min from 45% to 75% FTP | Steady: 1min @ 60% FTP | Steady: 5min @ 80% FTP | Steady: 3min @ 65% FTP | Cooldown: 5min from 65% to 45% FTP</description>
