<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo (33min)</name>
    <description>Warmup: 5min from 50% to 75% FTP | Steady: 2min @ 55% FTP | Steady: 5min @ 85% FTP | Steady: 3min @ 65% FTP | Steady: 5min @ 85% FTP | Steady: 3min @ 65% FTP | Steady: 5min @ 85% FTP | Cooldown: 5min from 35% to 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.85" pace="0" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.85" pace="0" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.85" pace="0" />
        <Cooldown Duration="300" PowerLow="0.35" PowerHigh="0.55" pace="0" />
    </workout>
</workout_file>