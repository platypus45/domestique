<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo 2x5min (55min)</name>
    <description>Warmup: 8min from 39% to 75% FTP | Intervals: 2 x (5min @ 89% / 3min @ 50%) | Cooldown: 5min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.39" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="2" OnDuration="300" OffDuration="180" OnPower="0.89" OffPower="0.5" pace="0" Cadence="55" CadenceResting="95" />
        <FreeRide Duration="180" FlatRoad="0" />
        <IntervalsT Repeat="4" OnDuration="90" OffDuration="30" OnPower="0.89" OffPower="0.99" pace="0" />
        <FreeRide Duration="300" FlatRoad="0" />
        <Ramp Duration="600" PowerLow="0.66" PowerHigh="0.95" pace="0" Cadence="100" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>