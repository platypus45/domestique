<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo 4x3min (67min)</name>
    <description>Warmup: 6min from 42% to 70% FTP | Intervals: 4 x (3min @ 95% / 6min 20s @ 72%) | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="360" PowerLow="0.42" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="1.09" pace="0" Cadence="95" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="240" Power="0.9" pace="0" Cadence="90" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="2" OnDuration="420" OffDuration="180" OnPower="0.83" OffPower="0.95" pace="0" Cadence="90" CadenceResting="95" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="2" OnDuration="420" OffDuration="180" OnPower="0.83" OffPower="0.95" pace="0" Cadence="90" CadenceResting="95" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
    </workout>
</workout_file>