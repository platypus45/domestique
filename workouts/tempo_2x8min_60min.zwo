<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 2x8min (63min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Intervals: 2 x (8min @ 85% / 2min @ 55%) | Cooldown: 3min from 55% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="2" OnDuration="30" OffDuration="30" OnPower="1.06" OffPower="0.55" pace="0" Cadence="105" CadenceResting="105" />
        <IntervalsT Repeat="2" OnDuration="480" OffDuration="120" OnPower="0.85" OffPower="0.55" pace="0" Cadence="70" CadenceResting="90" />
        <IntervalsT Repeat="2" OnDuration="360" OffDuration="120" OnPower="0.88" OffPower="0.55" pace="0" Cadence="70" CadenceResting="90" />
        <IntervalsT Repeat="2" OnDuration="240" OffDuration="120" OnPower="0.9" OffPower="0.55" pace="0" Cadence="70" CadenceResting="90" />
        <IntervalsT Repeat="2" OnDuration="30" OffDuration="30" OnPower="1.06" OffPower="0.55" pace="0" Cadence="105" CadenceResting="105" />
        <Cooldown Duration="180" PowerLow="0.55" PowerHigh="0.30" pace="0" />
    </workout>
</workout_file>