<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 2x8min (60min)</name>
    <description>Warmup: 5min from 30% to 70% FTP | Intervals: 2 x (8min @ 85% / 2min @ 55%) | Cooldown: 3min from 60% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.3" PowerHigh="0.7" pace="0" />
        <IntervalsT Repeat="2" OnDuration="30" OffDuration="30" OnPower="1.06" OffPower="0.55" pace="0" Cadence="105" CadenceResting="105" />
        <IntervalsT Repeat="2" OnDuration="480" OffDuration="120" OnPower="0.85" OffPower="0.55" pace="0" Cadence="70" CadenceResting="90" />
        <IntervalsT Repeat="2" OnDuration="360" OffDuration="120" OnPower="0.88" OffPower="0.55" pace="0" Cadence="70" CadenceResting="90" />
        <IntervalsT Repeat="2" OnDuration="240" OffDuration="120" OnPower="0.9" OffPower="0.55" pace="0" Cadence="70" CadenceResting="90" />
        <IntervalsT Repeat="2" OnDuration="30" OffDuration="30" OnPower="1.06" OffPower="0.55" pace="0" Cadence="105" CadenceResting="105" />
        <Cooldown Duration="180" PowerLow="0.6" PowerHigh="0.3" pace="0" />
    </workout>
</workout_file>