<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 3x40s (25min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Intervals: 3 x (40s @ 88% / 20s @ 72%) | Cooldown: 3min ramp from 65% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="3" OnDuration="40" OffDuration="20" OnPower="0.88" OffPower="0.72" pace="0" />
        <SteadyState Duration="60" Power="0.78" pace="0" Cadence="80" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="30" OnPower="0.92" OffPower="0.72" pace="0" />
        <SteadyState Duration="60" Power="0.78" pace="0" Cadence="80" />
        <IntervalsT Repeat="3" OnDuration="20" OffDuration="40" OnPower="0.96" OffPower="0.72" pace="0" />
        <SteadyState Duration="10" Power="1.25" pace="0" />
        <SteadyState Duration="50" Power="0.72" pace="0" />
        <SteadyState Duration="10" Power="1.25" pace="0" />
        <SteadyState Duration="50" Power="0.72" pace="0" />
        <SteadyState Duration="10" Power="1.25" pace="0" />
        <Cooldown Duration="230" PowerLow="0.65" PowerHigh="0.40" /></workout>
</workout_file>