<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed (60min)</name>
    <description>Warmup: 8min from 40% to 75% FTP | Steady: 12min @ 80% FTP | Steady: 2min @ 50% FTP | Steady: 12min @ 80% FTP | Steady: 2min @ 50% FTP | Steady: 12min @ 80% FTP | Steady: 2min @ 50% FTP | Cooldown: 10min from 75% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.4" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="720" OffDuration="120" OnPower="0.8" OffPower="0.5" pace="0" />
        <Cooldown Duration="600" PowerLow="0.75" PowerHigh="0.3" pace="0" />
    </workout>
</workout_file>