<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo 3x1min (60min)</name>
    <description>Warmup: 8min from 55% to 70% FTP | Intervals: 3 x (1min @ 110% / 2min @ 55%) | Cooldown: 5min from 65% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.55" PowerHigh="0.7" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="120" OnPower="1.1" OffPower="0.55" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="60" Power="0.9" pace="0" />
        <SteadyState Duration="480" Power="0.8" pace="0" />
        <SteadyState Duration="60" Power="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="60" Power="0.9" pace="0" />
        <SteadyState Duration="480" Power="0.8" pace="0" />
        <SteadyState Duration="60" Power="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="60" Power="0.9" pace="0" />
        <SteadyState Duration="480" Power="0.8" pace="0" />
        <SteadyState Duration="60" Power="0.9" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>