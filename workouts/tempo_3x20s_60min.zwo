<workout_file>
    <author>Domestique Library</author>
    <name>Tempo 3x20s (60min)</name>
    <description>Warmup: 4min from 35% to 55% FTP | Intervals: 3 x (20s @ 105% / 40s @ 55%) | Cooldown: 3min from 55% to 35% FTP</description>
