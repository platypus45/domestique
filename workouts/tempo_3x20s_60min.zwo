<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 3x20s (64min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Intervals: 3 x (20s @ 105% / 40s @ 55%) | Cooldown: 3min from 55% to 35% FTP</description>
