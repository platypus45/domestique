<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 3x20s (79min)</name>
    <description>Intervals: 3 x (20s @ 130% / 2min @ 55%) | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
