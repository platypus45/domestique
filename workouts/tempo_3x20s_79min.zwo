        <SteadyState Duration="300" Power="0.65" pace="0" />
        <IntervalsT Repeat="3" OnDuration="20" OffDuration="120" OnPower="1.3" OffPower="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <FreeRide Duration="30" FlatRoad="0" />
