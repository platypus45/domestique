        <FreeRide Duration="30" FlatRoad="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="420" Power="0.65" pace="0" />
        <FreeRide Duration="120" FlatRoad="0" />
