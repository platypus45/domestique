<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 6x2min (26min)</name>
    <description>Warmup: 4min from 50% to 70% FTP | Intervals: 6 x (2min @ 89% / 30s @ 105%) | Cooldown: 4min from 70% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="240" PowerLow="0.5" PowerHigh="0.7" pace="0" Cadence="85" />
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="30" OnPower="0.89" OffPower="1.05" pace="0" Cadence="90" CadenceResting="100" />
        <SteadyState Duration="180" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="30" OnPower="0.89" OffPower="1.05" pace="0" Cadence="90" CadenceResting="100" />
        <Cooldown Duration="240" PowerLow="0.7" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>