<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 6x2min (30min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Intervals: 6 x (2min @ 89% / 30s @ 105%) | Cooldown: 4min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="3" OnDuration="120" OffDuration="30" OnPower="0.89" OffPower="1.05" pace="0" Cadence="90" CadenceResting="100" />
        <SteadyState Duration="180" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="30" OnPower="0.89" OffPower="1.05" pace="0" Cadence="90" CadenceResting="100" />
        <Cooldown Duration="240" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>