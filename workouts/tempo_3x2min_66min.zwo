<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo 9x2min (66min)</name>
    <description>Warmup: 12min from 45% to 70% FTP | Intervals: 9 x (2min @ 85% / 1min @ 100%) | Cooldown: 5min from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="720" PowerLow="0.45" PowerHigh="0.7" pace="0" />
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="120" OnPower="0.8" OffPower="0.6" pace="0" />
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="60" OnPower="0.85" OffPower="1.0" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="60" OnPower="0.85" OffPower="1.0" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="60" OnPower="0.85" OffPower="1.0" pace="0" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>