<workout_file>
    <author>Domestique Library</author>
    <name>Mixed (56min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Steady: 6min @ 80% FTP | Steady: 3min @ 50% FTP | Steady: 6min @ 80% FTP | Steady: 3min @ 50% FTP | Steady: 6min @ 80% FTP | Steady: 3min @ 50% FTP | Steady: 6min @ 80% FTP | Steady: 3min @ 50% FTP | Cooldown: 10min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
