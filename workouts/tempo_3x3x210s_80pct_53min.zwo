<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 9x30s (53min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Intervals: 9 x (30s @ 95% / 3min 30s @ 80%) | Cooldown: 3min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="3" OnDuration="30" OffDuration="210" OnPower="0.95" OffPower="0.8" pace="0" Cadence="105" CadenceResting="90" />
        <SteadyState Duration="180" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="210" OnPower="0.95" OffPower="0.8" pace="0" Cadence="70" CadenceResting="90" />
        <SteadyState Duration="180" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="210" OnPower="0.95" OffPower="0.8" pace="0" Cadence="105" CadenceResting="75" />
        <Cooldown Duration="180" PowerLow="0.60" PowerHigh="0.45" pace="0" Cadence="85" />
    </workout>
</workout_file>