<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo 3x4min (67min)</name>
    <description>Warmup: 10min from 40% to 73% FTP | Intervals: 3 x (4min @ 88% / 2min @ 53%) | Cooldown: 5min from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.73" pace="0" Cadence="85" />
        <IntervalsT Repeat="3" OnDuration="240" OffDuration="120" OnPower="0.88" OffPower="0.53" pace="0" />
        <Ramp Duration="360" PowerLow="0.86" PowerHigh="0.89" pace="0" Cadence="70" />
        <SteadyState Duration="180" Power="0.53" pace="0" Cadence="85" />
        <Ramp Duration="360" PowerLow="0.89" PowerHigh="0.86" pace="0" Cadence="85" />
        <SteadyState Duration="180" Power="0.53" pace="0" Cadence="85" />
        <Ramp Duration="360" PowerLow="0.89" PowerHigh="0.72" pace="0" Cadence="100" />
        <IntervalsT Repeat="5" OnDuration="90" OffDuration="30" OnPower="0.73" OffPower="0.73" pace="0" Cadence="85" CadenceResting="65" />
        <Cooldown Duration="300" PowerLow="0.6" PowerHigh="0.4" pace="0" Cadence="85" />
    </workout>
</workout_file>