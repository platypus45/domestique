<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery (60min)</name>
    <description>Warmup: 20min from 25% to 75% FTP | Steady: 5min @ 80% FTP | Steady: 3min @ 50% FTP | Steady: 5min @ 80% FTP | Steady: 3min @ 50% FTP | Steady: 5min @ 80% FTP | Steady: 3min @ 50% FTP | Steady: 16min @ 65% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="1200" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="300" OffDuration="180" OnPower="0.8" OffPower="0.5" pace="0" />
        <FreeRide Duration="960" FlatRoad="0" />
    </workout>
</workout_file>