<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo (34min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Steady: 2min @ 55% FTP | Steady: 5min @ 85% FTP | Steady: 3min @ 65% FTP | Steady: 5min @ 85% FTP | Steady: 3min @ 65% FTP | Steady: 5min @ 85% FTP | Cooldown: 5min from 55% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="300" Power="0.85" pace="0" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.85" pace="0" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.85" pace="0" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>