<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 3x6min (36min)</name>
    <description>Warmup: 5min from 40% to 105% FTP | Intervals: 3 x (6min @ 89% / 2min @ 51%) | Cooldown: 5min from 70% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.4" PowerHigh="1.05" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="360" OffDuration="120" OnPower="0.89" OffPower="0.51" pace="0" />
        <Cooldown Duration="300" PowerLow="0.7" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>