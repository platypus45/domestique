<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 3x6min (37min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Intervals: 3 x (6min @ 89% / 2min @ 51%) | Cooldown: 5min from 70% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="3" OnDuration="360" OffDuration="120" OnPower="0.89" OffPower="0.51" pace="0" />
        <Cooldown Duration="300" PowerLow="0.7" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>