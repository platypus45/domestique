<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 1min/30s 6x (50min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Microintervals: 6 x (1min @ 110% / 30s @ 50%) | Cooldown: 5min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="1" OnDuration="60" OffDuration="30" OnPower="1.1" OffPower="0.5" pace="0" Cadence="100" CadenceResting="90" />
        <SteadyState Duration="480" Power="0.87" pace="0" Cadence="90" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="30" OnPower="1.1" OffPower="0.5" pace="0" Cadence="100" CadenceResting="90" />
        <SteadyState Duration="480" Power="0.87" pace="0" Cadence="90" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="30" OnPower="1.1" OffPower="0.5" pace="0" Cadence="100" CadenceResting="90" />
        <SteadyState Duration="480" Power="0.87" pace="0" Cadence="90" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>