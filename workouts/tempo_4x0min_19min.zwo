<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 9x40s (27min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Intervals: 9 x (40s @ 88% / 22s @ 74%) | Cooldown: 3min ramp from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="4" OnDuration="40" OffDuration="30" OnPower="0.88" OffPower="0.74" pace="0" />
        <Ramp Duration="90" PowerLow="0.9" PowerHigh="1.0" pace="0" />
        <SteadyState Duration="40" Power="0.7" pace="0" />
        <IntervalsT Repeat="3" OnDuration="40" OffDuration="20" OnPower="0.88" OffPower="0.74" pace="0" />
        <Ramp Duration="90" PowerLow="0.9" PowerHigh="1.05" pace="0" />
        <SteadyState Duration="40" Power="0.7" pace="0" />
        <IntervalsT Repeat="2" OnDuration="40" OffDuration="10" OnPower="0.88" OffPower="0.74" pace="0" />
        <Ramp Duration="90" PowerLow="0.92" PowerHigh="1.1" pace="0" />
        <Cooldown Duration="230" PowerLow="0.60" PowerHigh="0.40" /></workout>
</workout_file>