<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 9x40s (19min)</name>
    <description>Warmup: 2min from 65% to 70% FTP | Intervals: 9 x (40s @ 88% / 22s @ 74%) | Cooldown: 2min from 70% to 60% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="120" PowerLow="0.65" PowerHigh="0.7" pace="0" />
        <IntervalsT Repeat="4" OnDuration="40" OffDuration="30" OnPower="0.88" OffPower="0.74" pace="0" />
        <Ramp Duration="90" PowerLow="0.9" PowerHigh="1.0" pace="0" />
        <SteadyState Duration="40" Power="0.7" pace="0" />
        <IntervalsT Repeat="3" OnDuration="40" OffDuration="20" OnPower="0.88" OffPower="0.74" pace="0" />
        <Ramp Duration="90" PowerLow="0.9" PowerHigh="1.05" pace="0" />
        <SteadyState Duration="40" Power="0.7" pace="0" />
        <IntervalsT Repeat="2" OnDuration="40" OffDuration="10" OnPower="0.88" OffPower="0.74" pace="0" />
        <Ramp Duration="90" PowerLow="0.92" PowerHigh="1.1" pace="0" />
        <Cooldown Duration="120" PowerLow="0.7" PowerHigh="0.6" pace="0" />
    </workout>
</workout_file>