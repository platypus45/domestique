<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 4x45s (45min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 4 x (45s @ 100% / 1min 15s @ 40%) | Cooldown: 5min from 65% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="0.8" OffPower="0.4" pace="0" />
        <SteadyState Duration="180" Power="0.46" pace="0" />
        <IntervalsT Repeat="4" OnDuration="45" OffDuration="75" OnPower="1.0" OffPower="0.4" pace="0" />
        <SteadyState Duration="180" Power="0.45" pace="0" />
        <IntervalsT Repeat="4" OnDuration="30" OffDuration="90" OnPower="1.05" OffPower="0.4" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>