<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance 4x2min (26min)</name>
    <description>Warmup: 5min from 50% to 70% FTP | Intervals: 4 x (2min @ 85% / 2min @ 65%) | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.5" PowerHigh="0.7" pace="0" Cadence="80" />
        <IntervalsT Repeat="4" OnDuration="120" OffDuration="120" OnPower="0.85" OffPower="0.65" pace="0" Cadence="90" CadenceResting="85" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>