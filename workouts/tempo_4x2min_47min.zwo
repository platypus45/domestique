<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo (47min)</name>
    <description>Warmup: 10min from 40% to 80% FTP | Steady: 2min @ 50% FTP | Steady: 2min @ 80% FTP | Steady: 40s @ 45% FTP | Steady: 2min @ 80% FTP | Steady: 40s @ 45% FTP | Steady: 2min @ 80% FTP | Steady: 40s @ 45% FTP | Steady: 2min @ 80% FTP | Steady: 40s @ 45% FTP | Steady: 4min @ 55% FTP | Steady: 3min @ 80% FTP | Steady: 40s @ 45% FTP | Steady: 3min @ 80% FTP | Steady: 40s @ 45% FTP | Steady: 3min @ 80% FTP | Steady: 40s @ 45% FTP | Steady: 3min @ 80% FTP | Steady: 40s @ 45% FTP | Steady: 4min @ 55% FTP | Cooldown: 2min from 50% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="120" OffDuration="40" OnPower="0.8" OffPower="0.45" pace="0" Cadence="60" CadenceResting="65" />
        <SteadyState Duration="240" Power="0.55" pace="0" Cadence="100" />
        <IntervalsT Repeat="4" OnDuration="180" OffDuration="40" OnPower="0.8" OffPower="0.45" pace="0" Cadence="60" CadenceResting="65" />
        <SteadyState Duration="240" Power="0.55" pace="0" Cadence="100" />
        <Cooldown Duration="120" PowerLow="0.5" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>