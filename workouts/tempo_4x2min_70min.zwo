<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed (70min)</name>
    <description>Warmup: 10min from 45% to 80% FTP | Steady: 2min @ 82% FTP | Steady: 2min @ 75% FTP | Steady: 2min @ 82% FTP | Steady: 2min @ 75% FTP | Steady: 2min @ 82% FTP | Steady: 2min @ 75% FTP | Steady: 2min @ 82% FTP | Steady: 2min @ 75% FTP | Steady: 3min @ 55% FTP | Steady: 3min @ 82% FTP | Steady: 2min @ 75% FTP | Steady: 3min @ 82% FTP | Steady: 2min @ 75% FTP | Steady: 3min @ 82% FTP | Steady: 2min @ 75% FTP | Steady: 5min @ 55% FTP | Steady: 4min @ 82% FTP | Steady: 4min @ 75% FTP | Steady: 4min @ 82% FTP | Steady: 4min @ 75% FTP | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.8" pace="0" />
        <IntervalsT Repeat="4" OnDuration="120" OffDuration="120" OnPower="0.82" OffPower="0.75" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <IntervalsT Repeat="3" OnDuration="180" OffDuration="120" OnPower="0.82" OffPower="0.75" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <IntervalsT Repeat="2" OnDuration="240" OffDuration="240" OnPower="0.82" OffPower="0.75" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>