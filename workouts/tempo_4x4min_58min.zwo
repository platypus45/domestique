<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo 4x4min (58min)</name>
    <description>Warmup: 8min from 50% to 65% FTP | Intervals: 4 x (4min @ 85% / 1min @ 100%) | Cooldown: 3min from 65% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.65" pace="0" />
        <IntervalsT Repeat="3" OnDuration="10" OffDuration="50" OnPower="1.25" OffPower="0.55" pace="0" />
        <SteadyState Duration="240" Power="0.85" pace="0" />
        <SteadyState Duration="180" Power="1.0" pace="0" />
        <SteadyState Duration="60" Power="1.15" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="240" OffDuration="60" OnPower="0.85" OffPower="1.0" pace="0" Cadence="60" CadenceResting="100" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="240" OffDuration="60" OnPower="0.85" OffPower="1.0" pace="0" Cadence="60" CadenceResting="100" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="240" OffDuration="60" OnPower="0.85" OffPower="1.0" pace="0" Cadence="60" CadenceResting="100" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="240" OffDuration="60" OnPower="0.85" OffPower="1.0" pace="0" Cadence="60" CadenceResting="100" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="60" Power="0.8" pace="0" Cadence="100" />
        <SteadyState Duration="60" Power="0.8" pace="0" Cadence="110" />
        <SteadyState Duration="60" Power="0.8" pace="0" Cadence="120" />
        <SteadyState Duration="60" Power="0.8" pace="0" Cadence="100" />
        <SteadyState Duration="60" Power="0.8" pace="0" Cadence="110" />
        <SteadyState Duration="60" Power="0.8" pace="0" Cadence="120" />
        <Cooldown Duration="180" PowerLow="0.65" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>