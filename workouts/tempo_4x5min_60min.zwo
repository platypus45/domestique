<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 4x5min (60min)</name>
    <description>Warmup: 10min from 75% to 85% FTP | Intervals: 4 x (5min @ 88% / 5min @ 82%) | Cooldown: 10min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.75" PowerHigh="0.85" pace="0" />
        <IntervalsT Repeat="4" OnDuration="300" OffDuration="300" OnPower="0.88" OffPower="0.82" pace="0" />
        <Cooldown Duration="600" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>