<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 4x8min (64min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Intervals: 4 x (8min @ 85% / 2min @ 95%) | Cooldown: 8min from 75% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="30" Power="1.09" pace="0" />
        <Ramp Duration="240" PowerLow="0.6" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="30" Power="1.09" pace="0" />
        <IntervalsT Repeat="4" OnDuration="480" OffDuration="120" OnPower="0.85" OffPower="0.95" pace="0" />
        <SteadyState Duration="85" Power="0.65" pace="0" />
        <SteadyState Duration="45" Power="1.05" pace="0" />
        <SteadyState Duration="30" Power="1.15" pace="0" />
        <SteadyState Duration="20" Power="1.25" pace="0" />
        <Cooldown Duration="480" PowerLow="0.75" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>