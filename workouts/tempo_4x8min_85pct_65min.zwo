<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 3x30s (65min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Intervals: 3 x (30s @ 115% / 30s @ 50%) | Cooldown: 5min from 60% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="30" OnPower="1.15" OffPower="0.5" pace="0" />
        <FreeRide Duration="120" FlatRoad="0" />
        <SteadyState Duration="480" Power="0.85" pace="0" Cadence="100" />
        <SteadyState Duration="240" Power="0.97" pace="0" Cadence="55" />
        <SteadyState Duration="480" Power="0.85" pace="0" Cadence="100" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="480" Power="0.85" pace="0" Cadence="100" />
        <SteadyState Duration="240" Power="0.97" pace="0" Cadence="55" />
        <SteadyState Duration="480" Power="0.85" pace="0" Cadence="100" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>