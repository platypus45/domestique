<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 4x2min (60min)</name>
    <description>Warmup: 10min from 45% to 65% FTP | Intervals: 4 x (2min @ 100% / 1min @ 55%) | Cooldown: 8min from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.65" pace="0" />
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="0.8" OffPower="0.55" pace="0" />
        <SteadyState Duration="240" Power="0.75" pace="0" />
        <SteadyState Duration="40" Power="0.8" pace="0" />
        <SteadyState Duration="40" Power="0.9" pace="0" />
        <SteadyState Duration="40" Power="1.0" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <SteadyState Duration="40" Power="0.8" pace="0" />
        <SteadyState Duration="40" Power="0.9" pace="0" />
        <SteadyState Duration="40" Power="1.0" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <SteadyState Duration="40" Power="0.8" pace="0" />
        <SteadyState Duration="40" Power="0.9" pace="0" />
        <SteadyState Duration="40" Power="1.0" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <SteadyState Duration="40" Power="0.8" pace="0" />
        <SteadyState Duration="40" Power="0.9" pace="0" />
        <SteadyState Duration="40" Power="1.0" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <SteadyState Duration="240" Power="0.75" pace="0" />
        <IntervalsT Repeat="4" OnDuration="120" OffDuration="60" OnPower="1.0" OffPower="0.55" pace="0" />
        <Cooldown Duration="480" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>