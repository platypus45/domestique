<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance 5x1min (65min)</name>
    <description>Warmup: 10min from 41% to 75% FTP | Intervals: 5 x (1min @ 85% / 1min @ 50%) | Cooldown: 7min from 65% to 36% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.41" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="180" Power="1.1" pace="0" />
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="0.85" OffPower="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.69" pace="0" Cadence="100" />
        <IntervalsT Repeat="10" OnDuration="20" OffDuration="160" OnPower="0.99" OffPower="0.72" pace="0" />
        <Cooldown Duration="420" PowerLow="0.65" PowerHigh="0.36" pace="0" />
    </workout>
</workout_file>