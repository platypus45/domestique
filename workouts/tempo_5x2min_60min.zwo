    <workout>
        <Warmup Duration="420" PowerLow="0.44" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="30" Power="1.09" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.09" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="120" OffDuration="60" OnPower="0.8" OffPower="1.02" pace="0" Cadence="80" CadenceResting="70" />
        <SteadyState Duration="360" Power="0.4" pace="0" />
        <IntervalsT Repeat="5" OnDuration="120" OffDuration="60" OnPower="0.8" OffPower="1.02" pace="0" Cadence="80" CadenceResting="70" />
        <SteadyState Duration="480" Power="0.5" pace="0" />
    </workout>
</workout_file>