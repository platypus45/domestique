<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 2x5min (60min)</name>
    <description>Warmup: 8min ramp from 50% to 65% FTP | Intervals: 2 x (5min @ 96% / 3min @ 56%)</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.65" /><IntervalsT Repeat="5" OnDuration="30" OffDuration="30" OnPower="0.65" OffPower="0.8" pace="0" Cadence="85" CadenceResting="95" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="1200" Power="0.81" pace="0" Cadence="90" />
        <SteadyState Duration="300" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="2" OnDuration="300" OffDuration="180" OnPower="0.96" OffPower="0.56" pace="0" Cadence="95" CadenceResting="80" />
    <Cooldown Duration="180" PowerLow="0.56" PowerHigh="0.40" /></workout>
</workout_file>