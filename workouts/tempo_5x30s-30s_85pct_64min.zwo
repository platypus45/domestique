<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 5x30s (64min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 5 x (30s @ 85% / 30s @ 60%) | Cooldown: 6min from 50% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="640" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="5" OnDuration="30" OffDuration="30" OnPower="0.85" OffPower="0.6" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.85" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="1.02" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="15" OffDuration="45" OnPower="1.15" OffPower="0.63" pace="0" />
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="180" OnPower="1.07" OffPower="0.63" pace="0" />
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <FreeRide Duration="25" FlatRoad="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.63" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <FreeRide Duration="25" FlatRoad="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <Cooldown Duration="360" PowerLow="0.50" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>