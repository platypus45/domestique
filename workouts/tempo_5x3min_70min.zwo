<workout_file>
    <author>Domestique Library</author>
    <name>Tempo (70min)</name>
    <description>Warmup: 5min from 41% to 75% FTP | Steady: 15min @ 77% FTP | Steady: 3min @ 82% FTP | Steady: 3min @ 71% FTP | Steady: 3min @ 82% FTP | Steady: 3min @ 71% FTP | Steady: 3min @ 82% FTP | Steady: 3min @ 71% FTP | Steady: 3min @ 82% FTP | Steady: 3min @ 71% FTP | Steady: 3min @ 82% FTP | Steady: 3min @ 71% FTP | Steady: 15min @ 85% FTP | Cooldown: 5min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
