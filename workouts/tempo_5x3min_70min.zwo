        <Warmup Duration="300" PowerLow="0.41" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="900" Power="0.77" pace="0" />
        <IntervalsT Repeat="5" OnDuration="180" OffDuration="180" OnPower="0.82" OffPower="0.71" pace="0" />
