<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 2x5min (70min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Intervals: 2 x (5min @ 90% / 5min @ 60%) | Cooldown: 5min from 50% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="520" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="60" Power="0.81" pace="0" />
        <SteadyState Duration="60" Power="1.09" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="6" OnDuration="60" OffDuration="60" OnPower="0.85" OffPower="0.5" pace="0" Cadence="110" CadenceResting="85" />
        <Ramp Duration="300" PowerLow="0.6" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="20" Power="1.1" pace="0" />
        <Ramp Duration="300" PowerLow="0.75" PowerHigh="0.6" pace="0" />
        <IntervalsT Repeat="2" OnDuration="300" OffDuration="300" OnPower="0.9" OffPower="0.6" pace="0" Cadence="100" CadenceResting="90" />
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="60" OnPower="0.85" OffPower="0.5" pace="0" Cadence="110" CadenceResting="85" />
        <Cooldown Duration="300" PowerLow="0.50" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>