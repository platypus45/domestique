<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 6x1min (87min)</name>
    <description>Warmup: 10min from 55% to 72% FTP | Intervals: 6 x (1min @ 87% / 1min @ 72%) | Cooldown: 5min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.55" PowerHigh="0.72" pace="0" />
        <IntervalsT Repeat="6" OnDuration="60" OffDuration="60" OnPower="0.87" OffPower="0.72" pace="0" Cadence="120" CadenceResting="70" />
        <SteadyState Duration="900" Power="0.87" pace="0" Cadence="105" />
        <SteadyState Duration="300" Power="0.72" pace="0" Cadence="68" />
        <SteadyState Duration="900" Power="0.87" pace="0" Cadence="90" />
        <SteadyState Duration="300" Power="0.72" pace="0" Cadence="68" />
        <SteadyState Duration="900" Power="0.87" pace="0" Cadence="75" />
        <SteadyState Duration="300" Power="0.72" pace="0" Cadence="68" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45" pace="0" Cadence="68" />
    </workout>
</workout_file>