<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo 6x2min (135min)</name>
    <description>Warmup: 15min from 50% to 85% FTP | Intervals: 6 x (2min @ 85% / 2min @ 55%) | Cooldown: 10min from 65% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.5" PowerHigh="0.85" pace="0" />
        <IntervalsT Repeat="6" OnDuration="120" OffDuration="120" OnPower="0.85" OffPower="0.55" pace="0" />
        <SteadyState Duration="360" Power="0.55" pace="0" />
        <SteadyState Duration="1200" Power="0.85" pace="0" />
        <SteadyState Duration="600" Power="0.65" pace="0" />
        <SteadyState Duration="1200" Power="0.85" pace="0" />
        <SteadyState Duration="600" Power="0.65" pace="0" />
        <SteadyState Duration="1200" Power="0.85" pace="0" />
        <Cooldown Duration="600" PowerLow="0.65" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>