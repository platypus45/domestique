<workout_file>
    <author>Domestique Library</author>
    <name>Tempo 1min/2min 6x (33min)</name>
    <description>Warmup: 5min from 25% to 75% FTP | Microintervals: 6 x (1min @ 105% / 2min @ 83%) | Cooldown: 3min from 60% to 25% FTP</description>
