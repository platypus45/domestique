<workout_file>
    <author>Domestique Library</author>
    <name>Recovery 6x3min (60min)</name>
    <description>Warmup: 15min from 25% to 50% FTP | Intervals: 6 x (3min @ 85% / 2min @ 50%)</description>
    <sportType>bike</sportType>
