        <Warmup Duration="900" PowerLow="0.25" PowerHigh="0.5" pace="0" />
        <IntervalsT Repeat="6" OnDuration="180" OffDuration="120" OnPower="0.85" OffPower="0.5" pace="0" />
        <FreeRide Duration="900" FlatRoad="0" />
    </workout>
</workout_file>