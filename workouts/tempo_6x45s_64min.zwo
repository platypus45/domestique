<workout_file>
    <author>Domestique Library</author>
    <name>Tempo 6x45s (64min)</name>
    <description>Warmup: 10min from 50% to 75% FTP | Intervals: 6 x (45s @ 98% / 3min @ 55%) | Cooldown: 5min from 75% to 50% FTP</description>
