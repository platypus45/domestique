<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 7x2min (90min)</name>
    <description>Warmup: 10min from 40% to 75% FTP | Intervals: 7 x (1min 30s @ 85% / 30s @ 75%) | Cooldown: 10min from 65% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.75" pace="0" Cadence="95" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="90" OnPower="1.0" OffPower="0.7" pace="0" Cadence="105" CadenceResting="95" />
        <IntervalsT Repeat="5" OnDuration="90" OffDuration="30" OnPower="0.75" OffPower="0.6" pace="0" Cadence="105" CadenceResting="95" />
        <SteadyState Duration="480" Power="0.75" pace="0" Cadence="105" />
        <SteadyState Duration="120" Power="0.6" pace="0" Cadence="95" />
        <IntervalsT Repeat="10" OnDuration="45" OffDuration="15" OnPower="0.85" OffPower="0.6" pace="0" Cadence="110" CadenceResting="100" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="2" OnDuration="300" OffDuration="120" OnPower="0.85" OffPower="0.7" pace="0" Cadence="95" CadenceResting="105" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="7" OnDuration="90" OffDuration="30" OnPower="0.85" OffPower="0.75" pace="0" Cadence="95" CadenceResting="105" />
        <Cooldown Duration="600" PowerLow="0.65" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>