<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 8x3min (60min)</name>
    <description>Warmup: 6min from 55% to 70% FTP | Intervals: 8 x (3min @ 91% / 3min @ 75%) | Cooldown: 6min from 70% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="360" PowerLow="0.55" PowerHigh="0.7" pace="0" Cadence="85" />
        <IntervalsT Repeat="8" OnDuration="180" OffDuration="180" OnPower="0.91" OffPower="0.75" pace="0" />
        <Cooldown Duration="360" PowerLow="0.7" PowerHigh="0.45" pace="0" Cadence="85" />
    </workout>
</workout_file>