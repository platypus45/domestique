<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (64min)</name>
    <description>Warmup: 8min ramp from 50% to 65% FTP | Steady: 30s @ 65% FTP | Steady: 30s @ 80% FTP | Steady: 30s @ 65% FTP | Steady: 30s @ 80% FTP | Steady: 30s @ 65% FTP | Steady: 30s @ 80% FTP | Steady: 30s @ 65% FTP | Steady: 30s @ 80% FTP | Steady: 30s @ 65% FTP | Steady: 30s @ 80% FTP | Steady: 3min @ 50% FTP | Steady: 6min @ 89% FTP | Steady: 5min @ 50% FTP | Steady: 6min @ 89% FTP | Steady: 5min @ 50% FTP | Steady: 6min @ 89% FTP | Steady: 10min @ 65% FTP | Steady: 5min @ 95% FTP | Cooldown: 5min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.65" /><IntervalsT Repeat="5" OnDuration="30" OffDuration="30" OnPower="0.65" OffPower="0.8" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.89" pace="0" Cadence="60" />
        <SteadyState Duration="120" Power="0.89" pace="0" Cadence="65" />
        <SteadyState Duration="120" Power="0.89" pace="0" Cadence="70" />
