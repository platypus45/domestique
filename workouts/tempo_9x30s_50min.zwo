<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 9x30s (50min)</name>
    <description>Warmup: 5min from 45% to 70% FTP | Intervals: 9 x (30s @ 95% / 3min 30s @ 80%) | Cooldown: 3min from 70% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.45" PowerHigh="0.7" pace="0" Cadence="85" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="210" OnPower="0.95" OffPower="0.8" pace="0" Cadence="105" CadenceResting="90" />
        <SteadyState Duration="180" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="210" OnPower="0.95" OffPower="0.8" pace="0" Cadence="70" CadenceResting="90" />
        <SteadyState Duration="180" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="210" OnPower="0.95" OffPower="0.8" pace="0" Cadence="105" CadenceResting="75" />
        <Cooldown Duration="180" PowerLow="0.7" PowerHigh="0.45" pace="0" Cadence="85" />
    </workout>
</workout_file>