        <IntervalsT Repeat="1" OnDuration="240" OffDuration="120" OnPower="0.83" OffPower="0.55" pace="0" Cadence="60" CadenceResting="90" />
        <IntervalsT Repeat="1" OnDuration="240" OffDuration="120" OnPower="0.83" OffPower="0.55" pace="0" Cadence="55" CadenceResting="90" />
        <IntervalsT Repeat="1" OnDuration="240" OffDuration="120" OnPower="0.83" OffPower="0.55" pace="0" Cadence="65" CadenceResting="90" />
        <IntervalsT Repeat="1" OnDuration="240" OffDuration="120" OnPower="0.83" OffPower="0.55" pace="0" Cadence="60" CadenceResting="90" />
