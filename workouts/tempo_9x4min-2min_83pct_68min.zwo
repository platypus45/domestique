<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed (68min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Steady: 40s @ 80% FTP | Steady: 20s @ 55% FTP | Steady: 40s @ 80% FTP | Steady: 1min 20s @ 55% FTP | Steady: 4min @ 83% FTP | Steady: 2min @ 55% FTP | Steady: 4min @ 83% FTP | Steady: 2min @ 55% FTP | Steady: 4min @ 83% FTP | Steady: 2min @ 55% FTP | Steady: 4min @ 83% FTP | Steady: 2min @ 55% FTP | Steady: 4min @ 83% FTP | Steady: 2min @ 55% FTP | Steady: 4min @ 83% FTP | Steady: 2min @ 55% FTP | Steady: 4min @ 83% FTP | Steady: 2min @ 55% FTP | Steady: 4min @ 83% FTP | Steady: 2min @ 55% FTP | Steady: 4min @ 83% FTP | Steady: 2min @ 55% FTP | Cooldown: 3min from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="2" OnDuration="40" OffDuration="20" OnPower="0.8" OffPower="0.55" pace="0" Cadence="65" CadenceResting="90" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
