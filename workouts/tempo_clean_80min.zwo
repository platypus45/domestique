<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo Steady (80min)</name>
    <description>Warmup: 12min from 45% to 65% FTP | Steady: 60min @ 78% FTP | Cooldown: 8min from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="720" PowerLow="0.45" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="3600" Power="0.78" pace="0" />
        <Cooldown Duration="480" PowerLow="0.60" PowerHigh="0.40" pace="0" />
    </workout>
</workout_file>