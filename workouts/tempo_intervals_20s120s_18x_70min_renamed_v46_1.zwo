<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 20s/2min 18x (70min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Microintervals: 18 x (20s @ 120% / 2min @ 80%) | Cooldown: 10min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="0.75" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.8" pace="0" />
        <IntervalsT Repeat="18" OnDuration="20" OffDuration="120" OnPower="1.2" OffPower="0.8" pace="0" />
        <Cooldown Duration="600" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>