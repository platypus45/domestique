<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 3x10min (75min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Intervals: 3 x (10min @ 85% / 3min @ 50%) | Cooldown: 6min from 70% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="600" OffDuration="180" OnPower="0.85" OffPower="0.5" pace="0" />
        <Ramp Duration="300" PowerLow="0.5" PowerHigh="1.05" pace="0" />
        <Ramp Duration="300" PowerLow="1.05" PowerHigh="0.5" pace="0" />
        <IntervalsT Repeat="12" OnDuration="20" OffDuration="30" OnPower="1.2" OffPower="0.6" pace="0" />
        <Cooldown Duration="360" PowerLow="0.7" PowerHigh="0.3" pace="0" />
    </workout>
</workout_file>