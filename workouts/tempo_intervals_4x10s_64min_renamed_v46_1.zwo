<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 4x10s (64min)</name>
    <description>Warmup: 5min from 42% to 70% FTP | Intervals: 4 x (10s @ 150% / 50s @ 50%) | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.42" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.7" pace="0" />
        <IntervalsT Repeat="4" OnDuration="10" OffDuration="50" OnPower="1.5" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="180" OffDuration="60" OnPower="0.75" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="180" OffDuration="60" OnPower="0.78" OffPower="0.5" pace="0" Cadence="70" CadenceResting="90" />
        <IntervalsT Repeat="3" OnDuration="180" OffDuration="60" OnPower="0.81" OffPower="0.5" pace="0" Cadence="70" CadenceResting="90" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
    </workout>
</workout_file>