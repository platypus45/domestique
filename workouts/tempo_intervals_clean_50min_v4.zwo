<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 4x5min (50min)</name>
    <description>Warmup: 11min from 50% to 75% FTP | Intervals: 4 x (5min @ 85% / 3min @ 55%) | Cooldown: 7min from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="660" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="4" OnDuration="300" OffDuration="180" OnPower="0.85" OffPower="0.55" pace="0" />
        <Cooldown Duration="420" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>