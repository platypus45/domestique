<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery (30min)</name>
    <description>Warmup: 10min from 40% to 75% FTP | Steady: 30s @ 85% FTP | Steady: 30s @ 50% FTP | Steady: 30s @ 95% FTP | Steady: 30s @ 50% FTP | Steady: 30s @ 105% FTP | Steady: 2min 30s @ 50% FTP | Steady: 10min @ 65% FTP | Cooldown: 5min from 50% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="30" Power="0.85" pace="0" Cadence="95" />
        <SteadyState Duration="30" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="30" Power="0.95" pace="0" Cadence="105" />
        <SteadyState Duration="30" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="30" Power="1.05" pace="0" Cadence="110" />
        <SteadyState Duration="150" Power="0.5" pace="0" Cadence="85" />
        <FreeRide Duration="600" FlatRoad="0" />
        <Cooldown Duration="300" PowerLow="0.5" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>