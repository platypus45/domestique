<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (63min)</name>
    <description>Warmup: 5min from 30% to 50% FTP | Steady: 5min @ 60% FTP | Steady: 3min @ 75% FTP | Steady: 2min @ 55% FTP | Steady: 10min @ 90% FTP | Steady: 5min @ 55% FTP | Steady: 10min @ 85% FTP | Steady: 5min @ 55% FTP | Steady: 10min @ 80% FTP | Cooldown: 3min ramp from 55% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.3" PowerHigh="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.6" pace="0" />
        <SteadyState Duration="180" Power="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="600" OffDuration="300" OnPower="0.9" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="600" OffDuration="300" OnPower="0.85" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="600" OffDuration="300" OnPower="0.8" OffPower="0.55" pace="0" />
    <Cooldown Duration="180" PowerLow="0.55" PowerHigh="0.40" /></workout>
</workout_file>