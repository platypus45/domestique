<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo (120min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Steady: 30min @ 75% FTP | Steady: 15min @ 90% FTP | Steady: 5min @ 55% FTP | Steady: 30min @ 75% FTP | Steady: 15min @ 90% FTP | Steady: 5min @ 55% FTP | Cooldown: 10min from 50% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="1800" Power="0.75" pace="0" />
        <SteadyState Duration="900" Power="0.9" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <SteadyState Duration="1800" Power="0.75" pace="0" />
        <SteadyState Duration="900" Power="0.9" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <Cooldown Duration="600" PowerLow="0.5" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>