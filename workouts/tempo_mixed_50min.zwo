<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (52min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Steady: 10s @ 110% FTP | Steady: 20s @ 50% FTP | Steady: 10s @ 120% FTP | Steady: 20s @ 50% FTP | Steady: 10s @ 130% FTP | Steady: 20s @ 50% FTP | Steady: 10s @ 140% FTP | Steady: 20s @ 50% FTP | Steady: 10s @ 150% FTP | Steady: 40s @ 50% FTP | Steady: 10min @ 75% FTP | Steady: 10min @ 85% FTP | Steady: 10min @ 95% FTP | Cooldown: 9min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="610" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="10" Power="1.1" pace="0" />
        <SteadyState Duration="20" Power="0.5" pace="0" />
        <SteadyState Duration="10" Power="1.2" pace="0" />
        <SteadyState Duration="20" Power="0.5" pace="0" />
        <SteadyState Duration="10" Power="1.3" pace="0" />
        <SteadyState Duration="20" Power="0.5" pace="0" />
        <SteadyState Duration="10" Power="1.4" pace="0" />
        <SteadyState Duration="20" Power="0.5" pace="0" />
        <SteadyState Duration="10" Power="1.5" pace="0" />
        <SteadyState Duration="40" Power="0.5" pace="0" />
        <SteadyState Duration="600" Power="0.75" pace="0" />
        <SteadyState Duration="600" Power="0.85" pace="0" />
        <SteadyState Duration="600" Power="0.95" pace="0" />
        <Cooldown Duration="540" PowerLow="0.60" PowerHigh="0.45" pace="0" />
    </workout>
