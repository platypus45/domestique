<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed (60min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Steady: 10min @ 80% FTP | Steady: 10min @ 83% FTP | Steady: 10min @ 86% FTP | Steady: 10min @ 95% FTP | Steady: 5min @ 55% FTP | Cooldown: 5min from 25% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="600" Power="0.8" pace="0" />
        <SteadyState Duration="600" Power="0.83" pace="0" />
        <SteadyState Duration="600" Power="0.86" pace="0" />
        <SteadyState Duration="600" Power="0.95" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <Cooldown Duration="300" PowerLow="0.25" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>