        <SteadyState Duration="1800" Power="0.85" pace="0" />
        <SteadyState Duration="600" Power="0.93" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.4" pace="0" />
    </workout>
