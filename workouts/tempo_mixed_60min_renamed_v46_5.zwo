<workout_file>
    <author>Domestique Library</author>
    <name>Tempo (60min)</name>
    <description>Warmup: 10min @ 40% FTP | Steady: 30min @ 85% FTP | Steady: 10min @ 93% FTP | Cooldown: 10min from 55% to 40% FTP</description>
