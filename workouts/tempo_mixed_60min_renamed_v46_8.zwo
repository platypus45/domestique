<workout_file>
    <author>Domestique Library</author>
    <name>Tempo (60min)</name>
    <description>Warmup: 7min from 25% to 75% FTP | Steady: 30s @ 95% FTP | Steady: 30s @ 50% FTP | Steady: 30s @ 105% FTP | Steady: 30s @ 50% FTP | Steady: 30s @ 115% FTP | Steady: 2min 30s @ 50% FTP | Steady: 8min @ 75% FTP | Steady: 1min @ 55% FTP | Steady: 8min @ 80% FTP | Steady: 1min @ 55% FTP | Steady: 8min @ 85% FTP | Steady: 1min @ 55% FTP | Steady: 8min @ 80% FTP | Steady: 1min @ 55% FTP | Steady: 8min @ 75% FTP | Cooldown: 4min from 75% to 25% FTP</description>
