<workout_file>
    <author>Domestique Library</author>
    <name>Tempo (65min)</name>
    <description>Warmup: 10min from 45% to 65% FTP | Steady: 20min @ 65% FTP | Steady: 5min @ 50% FTP | Steady: 20min @ 81% FTP | Cooldown: 10min from 75% to 25% FTP</description>
