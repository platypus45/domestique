<workout_file>
    <author>Domestique Library</author>
    <name>Tempo (70min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Steady: 30min @ 65% FTP | Steady: 20min @ 81% FTP | Cooldown: 10min from 65% to 25% FTP</description>
