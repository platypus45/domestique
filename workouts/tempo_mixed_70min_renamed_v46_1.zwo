    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="1800" Power="0.65" pace="0" />
        <SteadyState Duration="1200" Power="0.81" pace="0" />
        <Cooldown Duration="600" PowerLow="0.65" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>