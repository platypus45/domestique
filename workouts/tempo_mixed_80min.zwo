<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed (80min)</name>
    <description>Warmup: 20min from 25% to 75% FTP | Steady: 10min @ 65% FTP | Steady: 10min @ 50% FTP | Steady: 30min @ 81% FTP | Cooldown: 10min from 60% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="1200" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="600" Power="0.65" pace="0" Cadence="95" />
        <SteadyState Duration="600" Power="0.5" pace="0" />
        <SteadyState Duration="600" Power="0.81" pace="0" Cadence="70" />
        <SteadyState Duration="600" Power="0.81" pace="0" Cadence="95" />
        <SteadyState Duration="300" Power="0.81" pace="0" Cadence="70" />
        <SteadyState Duration="300" Power="0.81" pace="0" Cadence="95" />
        <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>