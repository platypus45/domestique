<workout_file>
    <author>Domestique Library</author>
    <name>Mixed (90min)</name>
    <description>Warmup: 15min from 25% to 75% FTP | Steady: 15min @ 75% FTP | Steady: 35min @ 81% FTP | Steady: 15min @ 75% FTP | Cooldown: 10min from 75% to 25% FTP</description>
