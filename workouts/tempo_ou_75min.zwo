<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo 3 cycles (75min)</name>
    <description>Warmup: 6min from 50% to 75% FTP | Over-Under: 3 cycles (alternating above/below threshold) | Cooldown: 5min from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="360" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="20" Power="0.95" pace="0" />
        <SteadyState Duration="40" Power="0.5" pace="0" />
        <SteadyState Duration="20" Power="0.95" pace="0" />
        <SteadyState Duration="40" Power="0.5" pace="0" />
        <SteadyState Duration="15" Power="1.1" pace="0" />
        <SteadyState Duration="45" Power="0.5" pace="0" />
        <SteadyState Duration="15" Power="1.1" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="240" Power="1.1" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="480" Power="0.98" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="720" Power="0.85" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="1500" Power="0.78" pace="0" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>