<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo 2x1min (62min)</name>
    <description>Intervals: 2 x (1min @ 90% / 1min @ 50%) | Cooldown: 5min from 80% to 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="60" OnPower="0.75" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="60" OnPower="0.9" OffPower="0.5" pace="0" />
        <Ramp Duration="360" PowerLow="0.76" PowerHigh="0.91" pace="0" />
        <SteadyState Duration="120" Power="0.91" pace="0" />
        <Ramp Duration="360" PowerLow="0.91" PowerHigh="0.76" pace="0" />
        <SteadyState Duration="300" Power="0.76" pace="0" />
        <Ramp Duration="360" PowerLow="0.76" PowerHigh="0.91" pace="0" />
        <SteadyState Duration="120" Power="0.91" pace="0" />
        <Ramp Duration="360" PowerLow="0.91" PowerHigh="0.76" pace="0" />
        <SteadyState Duration="300" Power="0.76" pace="0" />
        <Ramp Duration="240" PowerLow="0.76" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="240" Power="0.8" pace="0" />
        <Cooldown Duration="300" PowerLow="0.8" PowerHigh="0.55" pace="0" />
    </workout>
</workout_file>