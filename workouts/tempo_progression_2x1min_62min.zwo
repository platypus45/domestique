<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 2x1min (67min)</name>
    <description>Intervals: 2 x (1min @ 90% / 1min @ 50%) | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="2" OnDuration="60" OffDuration="60" OnPower="0.75" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="60" OnPower="0.9" OffPower="0.5" pace="0" />
        <Ramp Duration="360" PowerLow="0.76" PowerHigh="0.91" pace="0" />
        <SteadyState Duration="120" Power="0.91" pace="0" />
        <Ramp Duration="360" PowerLow="0.91" PowerHigh="0.76" pace="0" />
        <SteadyState Duration="300" Power="0.76" pace="0" />
        <Ramp Duration="360" PowerLow="0.76" PowerHigh="0.91" pace="0" />
        <SteadyState Duration="120" Power="0.91" pace="0" />
        <Ramp Duration="360" PowerLow="0.91" PowerHigh="0.76" pace="0" />
        <SteadyState Duration="300" Power="0.76" pace="0" />
        <Ramp Duration="240" PowerLow="0.76" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="240" Power="0.8" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>