<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo 3x10min (60min)</name>
    <description>Warmup: 3min from 30% to 50% FTP | Intervals: 3 x (10min @ 85% / 2min @ 60%) | Cooldown: 4min 30s from 60% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="180" PowerLow="0.3" PowerHigh="0.5" pace="0" />
        <SteadyState Duration="30" Power="0.95" pace="0" />
        <Ramp Duration="180" PowerLow="0.5" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="30" Power="0.95" pace="0" />
        <Ramp Duration="180" PowerLow="0.65" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="60" OnPower="1.2" OffPower="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" Cadence="90" />
        <IntervalsT Repeat="3" OnDuration="600" OffDuration="120" OnPower="0.85" OffPower="0.6" pace="0" />
        <Cooldown Duration="270" PowerLow="0.6" PowerHigh="0.3" pace="0" />
    </workout>
</workout_file>