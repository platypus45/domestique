<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 3x15s (64min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Intervals: 3 x (15s @ 95% / 30s @ 50%) | Cooldown: 4min 30s from 70% to 40% FTP</description>
