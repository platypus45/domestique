<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery 3x20s (60min)</name>
    <description>Warmup: 9min from 50% to 65% FTP | Intervals: 3 x (20s @ 150% / 4min @ 55%) | Cooldown: 2min 30s from 55% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="540" PowerLow="0.5" PowerHigh="0.65" pace="0" />
        <Ramp Duration="180" PowerLow="0.94" PowerHigh="1.0" pace="0" />
        <SteadyState Duration="150" Power="0.55" pace="0" />
        <IntervalsT Repeat="3" OnDuration="20" OffDuration="240" OnPower="1.5" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="2" OnDuration="600" OffDuration="300" OnPower="0.75" OffPower="0.55" pace="0" Cadence="95" CadenceResting="95" />
        <Cooldown Duration="150" PowerLow="0.55" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>