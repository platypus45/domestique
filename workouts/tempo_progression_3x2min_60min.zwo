<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 3x2min (60min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Intervals: 3 x (2min @ 94% / 3min @ 86%)</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="0.95" OffPower="0.5" pace="0" Cadence="95" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.05" OffPower="0.5" pace="0" Cadence="105" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.15" OffPower="0.5" pace="0" Cadence="115" CadenceResting="85" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="0.88" OffPower="0.88" pace="0" Cadence="100" CadenceResting="60" />
        <SteadyState Duration="180" Power="0.55" pace="0" Cadence="85" />
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="180" OnPower="0.94" OffPower="0.86" pace="0" Cadence="90" CadenceResting="90" />
        <SteadyState Duration="180" Power="0.55" pace="0" Cadence="85" />
        <Ramp Duration="720" PowerLow="0.75" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
    </workout>
</workout_file>