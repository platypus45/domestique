<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 3x4min (67min)</name>
    <description>Warmup: 10min from 40% to 73% FTP | Intervals: 3 x (4min @ 88% / 2min @ 53%) | Cooldown: 5min from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.73" />
        <IntervalsT Repeat="3" OnDuration="240" OffDuration="120" OnPower="0.88" OffPower="0.53" />
        <Ramp Duration="360" PowerLow="0.86" PowerHigh="0.89" />
        <SteadyState Duration="180" Power="0.53" />
        <Ramp Duration="360" PowerLow="0.86" PowerHigh="0.83" />
        <SteadyState Duration="180" Power="0.53" />
        <Ramp Duration="360" PowerLow="0.89" PowerHigh="0.72" />
        <SteadyState Duration="600" Power="0.73" />
        <Cooldown Duration="300" PowerLow="0.6" PowerHigh="0.4" />
    </workout>
</workout_file>
