<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 6x15s (64min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Intervals: 6 x (15s @ 100% / 30s @ 50%) | Cooldown: 4min 30s from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="3" OnDuration="15" OffDuration="30" OnPower="1.0" OffPower="0.5" pace="0" />
        <Ramp Duration="240" PowerLow="0.6" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="15" OffDuration="30" OnPower="1.0" OffPower="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.77" pace="0" />
        <SteadyState Duration="180" Power="0.81" pace="0" />
        <SteadyState Duration="180" Power="0.85" pace="0" />
        <SteadyState Duration="60" Power="1.0" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.77" pace="0" />
        <SteadyState Duration="180" Power="0.81" pace="0" />
        <SteadyState Duration="180" Power="0.85" pace="0" />
        <SteadyState Duration="60" Power="1.0" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.77" pace="0" />
        <SteadyState Duration="180" Power="0.81" pace="0" />
        <SteadyState Duration="180" Power="0.85" pace="0" />
        <SteadyState Duration="60" Power="1.0" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.77" pace="0" />
        <SteadyState Duration="180" Power="0.81" pace="0" />
        <SteadyState Duration="180" Power="0.85" pace="0" />
        <SteadyState Duration="60" Power="1.0" pace="0" />
        <Cooldown Duration="270" PowerLow="0.60" PowerHigh="0.40" pace="0" />
    </workout>
</workout_file>