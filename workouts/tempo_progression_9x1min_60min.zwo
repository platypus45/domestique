<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance 9x1min (60min)</name>
    <description>Warmup: 3min from 45% to 60% FTP | Intervals: 9 x (1min @ 95% / 3min @ 69%) | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="180" PowerLow="0.45" PowerHigh="0.6" pace="0" />
        <SteadyState Duration="60" Power="0.65" pace="0" />
        <SteadyState Duration="60" Power="0.81" pace="0" />
        <SteadyState Duration="60" Power="1.09" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <Ramp Duration="240" PowerLow="0.51" PowerHigh="0.85" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="180" OffDuration="60" OnPower="0.75" OffPower="0.95" pace="0" Cadence="65" CadenceResting="95" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="180" OffDuration="60" OnPower="0.75" OffPower="0.95" pace="0" Cadence="65" CadenceResting="95" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="180" OffDuration="60" OnPower="0.75" OffPower="0.95" pace="0" Cadence="65" CadenceResting="95" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
    </workout>
</workout_file>