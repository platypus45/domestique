<workout_file>
    <author>Domestique Library</author>
    <name>Tempo (46min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Steady: 10min @ 87% FTP | Steady: 5min @ 94% FTP | Steady: 3min @ 50% FTP | Steady: 10min @ 87% FTP | Steady: 5min @ 94% FTP | Cooldown: 5min from 50% to 70% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="600" Power="0.87" pace="0" />
        <Ramp Duration="300" PowerLow="0.87" PowerHigh="1" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="600" Power="0.87" pace="0" />
        <Ramp Duration="300" PowerLow="0.87" PowerHigh="1" pace="0" />
        <Cooldown Duration="300" PowerLow="0.5" PowerHigh="0.7" pace="0" />
    </workout>
</workout_file>