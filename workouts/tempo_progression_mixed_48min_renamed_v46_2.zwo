<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo (50min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Steady: 3min @ 80% FTP | Steady: 1min @ 50% FTP | Steady: 6min @ 82% FTP | Steady: 2min @ 50% FTP | Steady: 6min @ 82% FTP | Steady: 2min @ 50% FTP | Steady: 6min @ 82% FTP | Steady: 2min @ 50% FTP | Steady: 6min @ 82% FTP | Steady: 2min @ 50% FTP | Steady: 3min @ 80% FTP | Cooldown: 3min from 30% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="180" Power="0.8" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <Ramp Duration="360" PowerLow="0.75" PowerHigh="0.88" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Ramp Duration="360" PowerLow="0.75" PowerHigh="0.88" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Ramp Duration="360" PowerLow="0.75" PowerHigh="0.88" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Ramp Duration="360" PowerLow="0.75" PowerHigh="0.88" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.8" pace="0" />
        <Cooldown Duration="180" PowerLow="0.3" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>