<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo (51min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Steady: 1min @ 50% FTP | Steady: 1min @ 95% FTP | Steady: 2min @ 50% FTP | Steady: 3min @ 70% FTP | Steady: 3min @ 90% FTP | Steady: 3min @ 50% FTP | Steady: 5min @ 81% FTP | Steady: 4min @ 50% FTP | Steady: 5min @ 86% FTP | Steady: 4min @ 50% FTP | Steady: 10min @ 82% FTP | Cooldown: 3min from 50% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="60" Power="0.95" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Ramp Duration="180" PowerLow="0.5" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.81" pace="0" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.86" pace="0" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <Ramp Duration="600" PowerLow="0.76" PowerHigh="0.89" pace="0" />
        <Cooldown Duration="180" PowerLow="0.5" PowerHigh="0.3" pace="0" />
    </workout>
</workout_file>