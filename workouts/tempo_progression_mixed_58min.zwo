<workout_file>
    <author>Domestique Library</author>
    <name>Tempo (60min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Steady: 1min @ 50% FTP | Steady: 1min @ 110% FTP | Steady: 1min @ 50% FTP | Steady: 3min @ 95% FTP | Steady: 1min @ 50% FTP | Steady: 8min @ 84% FTP | Steady: 3min @ 55% FTP | Steady: 8min @ 84% FTP | Steady: 3min @ 55% FTP | Steady: 8min @ 84% FTP | Steady: 3min @ 55% FTP | Steady: 8min @ 84% FTP | Cooldown: 5min @ 51% FTP</description>
    <sportType>bike</sportType>
    <workout>
