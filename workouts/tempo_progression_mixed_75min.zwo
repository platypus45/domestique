<workout_file>
    <author>Domestique Library</author>
    <name>Mixed (77min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Steady: 30s @ 110% FTP | Steady: 3min @ 68% FTP | Steady: 12min @ 81% FTP | Steady: 3min @ 65% FTP | Steady: 12min @ 81% FTP | Steady: 3min @ 65% FTP | Steady: 12min @ 81% FTP | Steady: 3min @ 65% FTP | Steady: 12min @ 81% FTP | Cooldown: 8min from 75% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="510" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="30" Power="1.1" pace="0" />
        <Ramp Duration="180" PowerLow="0.6" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="720" Power="0.81" pace="0" Cadence="75" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <SteadyState Duration="720" Power="0.81" pace="0" Cadence="80" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <SteadyState Duration="720" Power="0.81" pace="0" Cadence="85" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <SteadyState Duration="720" Power="0.81" pace="0" Cadence="90" />
        <Cooldown Duration="480" PowerLow="0.75" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>