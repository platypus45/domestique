<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo Steady (40min)</name>
    <description>Warmup: 10min from 75% to 82% FTP | Steady: 20min @ 88% FTP | Cooldown: 10min from 75% to 85% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.75" PowerHigh="0.82" pace="0" />
        <Ramp Duration="1200" PowerLow="0.82" PowerHigh="0.95" pace="0" />
        <Cooldown Duration="600" PowerLow="0.75" PowerHigh="0.85" pace="0" />
    </workout>
</workout_file>