<workout_file>
    <author>Domestique Library</author>
    <name>Tempo Steady (80min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Steady: 60min @ 85% FTP | Cooldown: 10min from 75% to 25% FTP</description>
