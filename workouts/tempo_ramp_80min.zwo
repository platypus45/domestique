<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo Ramp (80min)</name>
    <description>Warmup: 10min from 55% to 72% FTP | Ramp: 60min from 72% to 87% FTP | Cooldown: 10min from 72% to 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.55" PowerHigh="0.72" pace="0" />
        <IntervalsT Repeat="10" OnDuration="60" OffDuration="60" OnPower="0.72" OffPower="0.72" pace="0" Cadence="105" CadenceResting="85" />
        <SteadyState Duration="1200" Power="0.87" pace="0" />
        <IntervalsT Repeat="10" OnDuration="60" OffDuration="60" OnPower="0.87" OffPower="0.87" pace="0" Cadence="105" CadenceResting="85" />
        <Cooldown Duration="600" PowerLow="0.72" PowerHigh="0.55" pace="0" />
    </workout>
</workout_file>