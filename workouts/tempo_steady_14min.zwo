<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance Steady (14min)</name>
    <description>Warmup: 3min from 40% to 60% FTP | Steady: 4min @ 82% FTP | Cooldown: 7min from 25% to 75% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="180" PowerLow="0.4" PowerHigh="0.6" pace="0" />
        <SteadyState Duration="240" Power="0.82" pace="0" />
        <Cooldown Duration="420" PowerLow="0.25" PowerHigh="0.75" pace="0" />
    </workout>
</workout_file>