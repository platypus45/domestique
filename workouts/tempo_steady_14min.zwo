<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery Steady (15min)</name>
    <description>Warmup: 4min ramp from 50% to 70% FTP | Steady: 4min @ 82% FTP | Cooldown: 7min from 65% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="240" PowerLow="0.5" PowerHigh="0.7" /><SteadyState Duration="240" Power="0.82" pace="0" />
        <Cooldown Duration="420" PowerLow="0.65" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>