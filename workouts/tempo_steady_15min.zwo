<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery (15min)</name>
    <description>Warmup: 6min from 40% to 60% FTP | Steady: 4min @ 60% FTP | Steady: 3min @ 80% FTP | Steady: 2min @ 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="360" PowerLow="0.4" PowerHigh="0.6" pace="0" />
        <SteadyState Duration="240" Power="0.6" pace="0" />
        <SteadyState Duration="180" Power="0.8" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
    </workout>
</workout_file>