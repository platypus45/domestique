    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="1023" Power="0.82" pace="0" />
        <Cooldown Duration="237" PowerLow="0.60" PowerHigh="0.40" /></workout>
</workout_file>