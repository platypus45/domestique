<workout_file>
    <author>Domestique Library</author>
    <name>Tempo Steady (29min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Steady: 17min @ 82% FTP | Cooldown: 3min ramp from 60% to 40% FTP</description>
