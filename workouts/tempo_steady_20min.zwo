<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance Steady (20min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Steady: 5min @ 81% FTP | Cooldown: 5min from 25% to 75% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="300" Power="0.81" pace="0" />
        <Cooldown Duration="300" PowerLow="0.25" PowerHigh="0.75" pace="0" />
    </workout>
</workout_file>