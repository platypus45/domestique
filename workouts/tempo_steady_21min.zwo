<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed (26min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Steady: 3min @ 85% FTP | Steady: 1min @ 100% FTP | Steady: 1min 30s @ 75% FTP | Steady: 3min @ 85% FTP | Steady: 1min @ 100% FTP | Steady: 1min 30s @ 75% FTP | Steady: 3min @ 85% FTP | Steady: 1min @ 100% FTP | Cooldown: 3min from 75% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="180" Power="0.85" pace="0" />
        <SteadyState Duration="60" Power="1.0" pace="0" />
        <SteadyState Duration="90" Power="0.75" pace="0" />
        <SteadyState Duration="180" Power="0.85" pace="0" />
        <SteadyState Duration="60" Power="1.0" pace="0" />
        <SteadyState Duration="90" Power="0.75" pace="0" />
        <SteadyState Duration="180" Power="0.85" pace="0" />
        <SteadyState Duration="60" Power="1.0" pace="0" />
        <Cooldown Duration="180" PowerLow="0.75" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>