<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (21min)</name>
    <description>Warmup: 5min @ 55% FTP | Steady: 3min @ 75% FTP | Steady: 2min @ 55% FTP | Steady: 3min @ 85% FTP | Steady: 2min @ 55% FTP | Cooldown: 6min from 40% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <SteadyState Duration="180" Power="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="180" Power="0.85" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <Cooldown Duration="360" PowerLow="0.4" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>