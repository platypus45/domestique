<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (21min)</name>
    <description>Warmup: 4min from 55% to 75% FTP | Steady: 2min @ 65% FTP | Steady: 1min @ 80% FTP | Steady: 3min @ 65% FTP | Steady: 2min @ 80% FTP | Steady: 4min @ 65% FTP | Steady: 3min @ 80% FTP | Cooldown: 2min from 65% to 45% FTP</description>
