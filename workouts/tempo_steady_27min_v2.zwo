<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (27min)</name>
    <description>Warmup: 5min from 50% to 65% FTP | Steady: 5min @ 80% FTP | Steady: 3min @ 50% FTP | Steady: 5min @ 60% FTP | Steady: 3min @ 50% FTP | Cooldown: 6min from 50% to 70% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.5" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.8" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.6" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <Cooldown Duration="360" PowerLow="0.5" PowerHigh="0.7" pace="0" />
    </workout>
</workout_file>