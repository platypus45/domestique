<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo Steady (29min)</name>
    <description>Warmup: 4min from 50% to 70% FTP | Steady: 21min @ 82% FTP | Cooldown: 4min from 70% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="240" PowerLow="0.5" PowerHigh="0.7" pace="0" Cadence="85" />
        <SteadyState Duration="1260" Power="0.82" pace="0" />
        <Cooldown Duration="240" PowerLow="0.7" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>