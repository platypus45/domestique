<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance Steady (30min)</name>
    <description>Warmup: 20min from 25% to 75% FTP | Steady: 5min @ 85% FTP | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="1200" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="300" Power="0.85" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
    </workout>
</workout_file>