<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo Steady (35min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Steady: 15min @ 82% FTP | Cooldown: 10min from 45% to 60% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="900" Power="0.82" pace="0" />
        <Cooldown Duration="600" PowerLow="0.45" PowerHigh="0.6" pace="0" />
    </workout>
</workout_file>