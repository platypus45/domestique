<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (37min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Steady: 6min @ 85% FTP | Steady: 2min @ 50% FTP | Steady: 6min @ 87% FTP | Steady: 2min @ 50% FTP | Steady: 6min @ 88% FTP | Cooldown: 7min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="180" Power="0.85" pace="0" Cadence="85" />
        <SteadyState Duration="180" Power="0.85" pace="0" Cadence="90" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="180" Power="0.87" pace="0" Cadence="75" />
        <SteadyState Duration="180" Power="0.87" pace="0" Cadence="95" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="180" Power="0.88" pace="0" Cadence="80" />
        <SteadyState Duration="180" Power="0.88" pace="0" Cadence="85" />
        <Cooldown Duration="420" PowerLow="0.60" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>