<workout_file>
    <author>Domestique Library</author>
    <name>Tempo (38min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Steady: 5min @ 80% FTP | Steady: 1min @ 50% FTP | Steady: 5min @ 80% FTP | Steady: 1min @ 50% FTP | Steady: 5min @ 80% FTP | Steady: 1min @ 50% FTP | Steady: 5min @ 80% FTP | Cooldown: 5min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="300" Power="0.8" pace="0" />
