<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo 6 cycles (38min)</name>
    <description>Warmup: 7min from 50% to 70% FTP | Over-Under: 6 cycles (alternating above/below threshold) | Cooldown: 5min from 50% to 70% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="420" PowerLow="0.5" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="120" Power="0.85" pace="0" />
        <SteadyState Duration="30" Power="1.1" pace="0" />
        <SteadyState Duration="120" Power="0.85" pace="0" />
        <SteadyState Duration="60" Power="1.2" pace="0" />
        <SteadyState Duration="60" Power="0.85" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.85" pace="0" />
        <SteadyState Duration="30" Power="1.15" pace="0" />
        <SteadyState Duration="120" Power="0.85" pace="0" />
        <SteadyState Duration="60" Power="1.2" pace="0" />
        <SteadyState Duration="60" Power="0.85" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.9" pace="0" />
        <SteadyState Duration="30" Power="1.15" pace="0" />
        <SteadyState Duration="120" Power="0.9" pace="0" />
        <SteadyState Duration="60" Power="1.25" pace="0" />
        <SteadyState Duration="60" Power="0.9" pace="0" />
        <Cooldown Duration="300" PowerLow="0.5" PowerHigh="0.7" pace="0" />
    </workout>
</workout_file>