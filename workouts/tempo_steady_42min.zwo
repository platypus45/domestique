<workout_file>
    <author>Domestique Library</author>
    <name>Tempo Steady (42min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Steady: 27min @ 82% FTP | Cooldown: 5min from 60% to 25% FTP</description>
