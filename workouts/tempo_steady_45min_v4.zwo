<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo Steady (49min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Steady: 38min @ 82% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="2280" Power="0.82" pace="0" />
    <Cooldown Duration="180" PowerLow="0.65" PowerHigh="0.40" /></workout>
</workout_file>