<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo Steady (46min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Steady: 33min @ 82% FTP | Cooldown: 5min from 70% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="1980" Power="0.82" pace="0" />
        <Cooldown Duration="300" PowerLow="0.7" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>