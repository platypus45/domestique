<workout_file>
    <author>Domestique Library</author>
    <name>Tempo Steady (59min)</name>
    <description>Warmup: 5min from 25% to 75% FTP | Steady: 51min @ 82% FTP | Cooldown: 3min from 75% to 25% FTP</description>
