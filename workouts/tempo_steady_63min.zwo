<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo Steady (63min)</name>
    <description>Warmup: 10min from 40% to 73% FTP | Steady: 48min @ 82% FTP | Cooldown: 5min from 53% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.73" pace="0" Cadence="85" />
        <SteadyState Duration="2880" Power="0.82" pace="0" />
        <Cooldown Duration="300" PowerLow="0.53" PowerHigh="0.4" pace="0" Cadence="85" />
    </workout>
</workout_file>