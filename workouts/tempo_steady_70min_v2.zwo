<workout_file>
    <author>Domestique Library</author>
    <name>Tempo (70min)</name>
    <description>Warmup: 10min from 50% to 75% FTP | Steady: 15min @ 88% FTP | Steady: 30s @ 150% FTP | Steady: 5min @ 55% FTP | Steady: 10min @ 80% FTP | Steady: 10min @ 98% FTP | Steady: 5min @ 55% FTP | Steady: 5min @ 80% FTP | Steady: 5min @ 105% FTP | Cooldown: 5min from 75% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="900" Power="0.88" pace="0" Cadence="75" />
        <SteadyState Duration="30" Power="1.5" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <SteadyState Duration="600" Power="0.8" pace="0" Cadence="75" />
        <SteadyState Duration="600" Power="0.98" pace="0" />
