<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 3x20s (73min)</name>
    <description>Warmup: 20min from 30% to 70% FTP | Intervals: 3 x (20s @ 100% / 0s @ 55%) | Cooldown: 10min from 50% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="1200" PowerLow="0.3" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="20" Power="0.8" pace="0" />
        <SteadyState Duration="20" Power="1.0" pace="0" />
        <SteadyState Duration="20" Power="1.2" pace="0" />
        <SteadyState Duration="20" Power="0.8" pace="0" />
        <SteadyState Duration="20" Power="1.0" pace="0" />
        <SteadyState Duration="20" Power="1.2" pace="0" />
        <SteadyState Duration="20" Power="0.8" pace="0" />
        <SteadyState Duration="20" Power="1.0" pace="0" />
        <SteadyState Duration="20" Power="1.2" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="1.1" pace="0" />
        <SteadyState Duration="600" Power="0.5" pace="0" />
        <FreeRide Duration="1200" FlatRoad="0" />
        <Cooldown Duration="600" PowerLow="0.50" PowerHigh="0.30" pace="0" />
    </workout>
</workout_file>