<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo (90min)</name>
    <description>Warmup: 15min from 50% to 75% FTP | Steady: 15min @ 80% FTP | Steady: 5min @ 50% FTP | Steady: 5min @ 100% FTP | Steady: 15min @ 50% FTP | Steady: 15min @ 80% FTP | Steady: 5min @ 50% FTP | Steady: 5min @ 101% FTP | Cooldown: 10min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.5" PowerHigh="0.75" pace="0" Cadence="95" />
        <SteadyState Duration="900" Power="0.8" pace="0" Cadence="95" />
        <SteadyState Duration="300" Power="0.5" pace="0" Cadence="95" />
        <SteadyState Duration="300" Power="1.0" pace="0" Cadence="95" />
        <SteadyState Duration="900" Power="0.5" pace="0" Cadence="95" />
        <SteadyState Duration="900" Power="0.8" pace="0" Cadence="95" />
        <SteadyState Duration="300" Power="0.5" pace="0" Cadence="95" />
        <SteadyState Duration="300" Power="1.01" pace="0" Cadence="95" />
        <Cooldown Duration="600" PowerLow="0.75" PowerHigh="0.25" pace="0" Cadence="95" />
    </workout>
</workout_file>