<workout_file>
    <author>Domestique Library</author>
    <name>Mixed (93min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Steady: 10min @ 80% FTP | Steady: 10min @ 83% FTP | Steady: 10min @ 85% FTP | Steady: 5min @ 95% FTP | Steady: 10min @ 55% FTP | Steady: 10min @ 80% FTP | Steady: 10min @ 83% FTP | Steady: 10min @ 85% FTP | Steady: 5min @ 95% FTP | Cooldown: 5min from 55% to 25% FTP</description>
    <sportType>bike</sportType>
