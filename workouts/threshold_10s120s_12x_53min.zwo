<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 10s/2min 12x (53min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Microintervals: 12 x (10s @ 130% / 2min @ 100%) | Cooldown: 9min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="0.75" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="1.0" pace="0" />
        <IntervalsT Repeat="12" OnDuration="10" OffDuration="120" OnPower="1.3" OffPower="1.0" pace="0" />
        <Cooldown Duration="540" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>