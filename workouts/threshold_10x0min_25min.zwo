<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short Rønnestad-style 10x30/60s (25min)</name>
    <description>Warmup: 5min from 50% to 70% FTP | Microintervals: 10 x (30s @ 110% / 1min @ 50%) | Cooldown: 5min from 50% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.5" PowerHigh="0.7" pace="0" Cadence="80" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="60" OnPower="1.1" OffPower="0.5" pace="0" Cadence="95" CadenceResting="80" />
        <Cooldown Duration="300" PowerLow="0.5" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>