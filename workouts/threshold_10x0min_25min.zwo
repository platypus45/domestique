<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 30s/1min 10x (30min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 10 x (30s @ 110% / 1min @ 50%) | Cooldown: 5min from 50% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="10" OnDuration="30" OffDuration="60" OnPower="1.1" OffPower="0.5" pace="0" Cadence="95" CadenceResting="80" />
        <Cooldown Duration="300" PowerLow="0.5" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>