<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 10x1min (63min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 10 x (1min @ 100% / 1min @ 77%) | Cooldown: 10min from 50% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="20" Power="1.25" pace="0" />
        <Ramp Duration="180" PowerLow="0.56" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="20" Power="1.25" pace="0" />
        <Ramp Duration="180" PowerLow="0.66" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="20" Power="1.25" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="1.15" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <IntervalsT Repeat="10" OnDuration="60" OffDuration="60" OnPower="1.0" OffPower="0.77" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Cooldown Duration="600" PowerLow="0.50" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>