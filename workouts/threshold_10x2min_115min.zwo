<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 10x2min (115min)</name>
    <description>Warmup: 10min from 50% to 75% FTP | Intervals: 10 x (2min @ 95% / 1min @ 55%) | Cooldown: 10min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="300" Power="0.75" pace="0" />
        <IntervalsT Repeat="10" OnDuration="120" OffDuration="60" OnPower="0.95" OffPower="0.55" pace="0" />
        <SteadyState Duration="600" Power="0.75" pace="0" />
        <SteadyState Duration="300" Power="0.9" pace="0" />
        <SteadyState Duration="600" Power="0.75" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <SteadyState Duration="600" Power="0.75" pace="0" />
        <SteadyState Duration="300" Power="1.0" pace="0" />
        <SteadyState Duration="600" Power="0.75" pace="0" />
        <SteadyState Duration="300" Power="1.05" pace="0" />
        <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>