<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 10x2min (60min)</name>
    <description>Warmup: 10min from 40% to 75% FTP | Intervals: 10 x (2min @ 100% / 1min @ 85%) | Cooldown: 10min from 65% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="300" Power="0.85" pace="0" Cadence="85" />
        <SteadyState Duration="300" Power="0.9" pace="0" Cadence="90" />
        <IntervalsT Repeat="10" OnDuration="120" OffDuration="60" OnPower="1.0" OffPower="0.85" pace="0" />
        <Cooldown Duration="600" PowerLow="0.65" PowerHigh="0.40" pace="0" />
    </workout>
</workout_file>