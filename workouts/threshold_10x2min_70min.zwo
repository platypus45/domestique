<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 10x2min (75min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 10 x (2min @ 95% / 1min @ 50%) | Cooldown: 5min from 50% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="5" OnDuration="120" OffDuration="60" OnPower="0.95" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="120" OffDuration="60" OnPower="1.05" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="120" OffDuration="60" OnPower="0.95" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="120" OffDuration="60" OnPower="1.05" OffPower="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.50" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>