<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 10x5min (145min)</name>
    <description>Warmup: 10min from 40% to 85% FTP | Intervals: 10 x (5min @ 95% / 5min @ 86%) | Cooldown: 5min from 75% to 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.85" pace="0" />
        <IntervalsT Repeat="3" OnDuration="300" OffDuration="300" OnPower="0.95" OffPower="0.86" pace="0" />
        <SteadyState Duration="780" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="300" OffDuration="300" OnPower="0.95" OffPower="0.86" pace="0" />
        <SteadyState Duration="780" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="300" OffDuration="300" OnPower="0.95" OffPower="0.86" pace="0" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.55" pace="0" />
    </workout>
</workout_file>