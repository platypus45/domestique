<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 13x2min (62min)</name>
    <description>Warmup: 5min from 40% to 65% FTP | Intervals: 13 x (2min @ 100% / 1min @ 75%) | Cooldown: 5min ramp from 75% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.4" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" Cadence="95" />
        <SteadyState Duration="180" Power="0.8" pace="0" Cadence="100" />
        <SteadyState Duration="120" Power="0.55" pace="0" Cadence="85" />
        <IntervalsT Repeat="7" OnDuration="120" OffDuration="60" OnPower="1.0" OffPower="0.75" pace="0" Cadence="90" CadenceResting="70" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <IntervalsT Repeat="6" OnDuration="120" OffDuration="60" OnPower="1.0" OffPower="0.75" pace="0" Cadence="90" CadenceResting="70" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.4" /></workout>
</workout_file>