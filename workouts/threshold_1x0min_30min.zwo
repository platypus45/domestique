<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo 30s/30s 6x (34min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Microintervals: 6 x (30s @ 110% / 30s @ 50%) | Cooldown: 4min from 70% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.1" OffPower="0.5" pace="0" Cadence="100" CadenceResting="90" />
        <SteadyState Duration="240" Power="0.87" pace="0" Cadence="90" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="2" OnDuration="30" OffDuration="30" OnPower="1.1" OffPower="0.5" pace="0" Cadence="100" CadenceResting="90" />
        <SteadyState Duration="240" Power="0.87" pace="0" Cadence="90" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="30" OnPower="1.1" OffPower="0.5" pace="0" Cadence="100" CadenceResting="90" />
        <SteadyState Duration="240" Power="0.87" pace="0" Cadence="90" />
        <Cooldown Duration="240" PowerLow="0.7" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>