<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (47min)</name>
    <description>Warmup: 3min from 40% to 60% FTP | Steady: 2min @ 68% FTP | Steady: 2min @ 85% FTP | Steady: 30min @ 75% FTP | Cooldown: 10min from 50% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="180" PowerLow="0.4" PowerHigh="0.6" pace="0" />
        <Ramp Duration="120" PowerLow="0.6" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.85" pace="0" />
        <Ramp Duration="900" PowerLow="0.5" PowerHigh="1" pace="0" />
        <Ramp Duration="900" PowerLow="1" PowerHigh="0.5" pace="0" />
        <Cooldown Duration="600" PowerLow="0.50" PowerHigh="0.40" pace="0" />
    </workout>
</workout_file>