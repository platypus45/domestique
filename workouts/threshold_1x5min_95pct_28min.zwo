<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (28min)</name>
    <description>Warmup: 5min from 45% to 55% FTP | Steady: 3min @ 60% FTP | Steady: 5min @ 95% FTP | Steady: 10min @ 60% FTP | Cooldown: 5min from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.45" PowerHigh="0.55" pace="0" />
        <SteadyState Duration="180" Power="0.6" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <SteadyState Duration="300" Power="0.6" pace="0" />
        <SteadyState Duration="300" Power="0.6" pace="0" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>