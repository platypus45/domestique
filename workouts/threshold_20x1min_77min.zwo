<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 20x1min (77min)</name>
    <description>Warmup: 10min from 50% to 65% FTP | Intervals: 20 x (1min @ 95% / 1min 36s @ 72%) | Cooldown: 10min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.65" pace="0" />
        <IntervalsT Repeat="6" OnDuration="60" OffDuration="120" OnPower="0.95" OffPower="0.72" pace="0" Cadence="65" CadenceResting="85" />
        <IntervalsT Repeat="6" OnDuration="60" OffDuration="120" OnPower="0.95" OffPower="0.72" pace="0" Cadence="65" CadenceResting="85" />
        <SteadyState Duration="300" Power="0.72" pace="0" />
        <IntervalsT Repeat="8" OnDuration="60" OffDuration="60" OnPower="0.95" OffPower="0.72" pace="0" Cadence="120" CadenceResting="85" />
        <Cooldown Duration="600" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>