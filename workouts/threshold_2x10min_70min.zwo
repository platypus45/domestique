<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 2x10min (70min)</name>
    <description>Warmup: 10min from 56% to 87% FTP | Intervals: 2 x (10min @ 99% / 5min @ 50%) | Cooldown: 5min from 50% to 41% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.56" PowerHigh="0.87" pace="0" />
        <SteadyState Duration="1200" Power="0.87" pace="0" />
        <FreeRide Duration="300" FlatRoad="0" />
        <IntervalsT Repeat="2" OnDuration="600" OffDuration="300" OnPower="0.99" OffPower="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.50" PowerHigh="0.41" pace="0" />
    </workout>
</workout_file>