<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 2x12min (95min)</name>
    <description>Warmup: 15min from 30% to 90% FTP | Intervals: 2 x (12min @ 102% / 15min @ 30%) | Cooldown: 15min from 40% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.3" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.35" pace="0" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="30" OnPower="1.41" OffPower="0.3" pace="0" Cadence="107" CadenceResting="100" />
        <SteadyState Duration="300" Power="0.3" pace="0" />
        <IntervalsT Repeat="2" OnDuration="720" OffDuration="900" OnPower="1.02" OffPower="0.3" pace="0" />
        <Cooldown Duration="900" PowerLow="0.4" PowerHigh="0.3" pace="0" />
    </workout>
</workout_file>