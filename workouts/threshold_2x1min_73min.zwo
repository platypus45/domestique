<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 2x1min (73min)</name>
    <description>Warmup: 10min from 40% to 73% FTP | Intervals: 2 x (1min @ 88% / 1min @ 88%) | Cooldown: 5min from 53% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.73" pace="0" Cadence="85" />
        <SteadyState Duration="240" Power="0.88" pace="0" Cadence="95" />
        <SteadyState Duration="120" Power="0.53" pace="0" Cadence="85" />
        <Ramp Duration="240" PowerLow="0.84" PowerHigh="0.92" pace="0" Cadence="90" />
        <SteadyState Duration="120" Power="0.53" pace="0" Cadence="85" />
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="60" OnPower="0.88" OffPower="0.88" pace="0" Cadence="95" CadenceResting="105" />
        <SteadyState Duration="120" Power="0.53" pace="0" Cadence="85" />
        <SteadyState Duration="240" Power="0.88" pace="0" Cadence="100" />
        <SteadyState Duration="120" Power="0.53" pace="0" Cadence="85" />
        <Ramp Duration="240" PowerLow="0.84" PowerHigh="0.92" pace="0" Cadence="90" />
        <SteadyState Duration="120" Power="0.53" pace="0" Cadence="85" />
        <SteadyState Duration="240" Power="1.0" pace="0" Cadence="95" />
        <SteadyState Duration="120" Power="0.53" pace="0" Cadence="85" />
        <SteadyState Duration="60" Power="1.0" pace="0" Cadence="90" />
        <SteadyState Duration="60" Power="1.0" pace="0" Cadence="95" />
        <SteadyState Duration="60" Power="1.0" pace="0" Cadence="100" />
        <SteadyState Duration="60" Power="1.0" pace="0" Cadence="105" />
        <SteadyState Duration="120" Power="0.53" pace="0" Cadence="85" />
        <SteadyState Duration="240" Power="1.0" pace="0" Cadence="100" />
        <SteadyState Duration="120" Power="0.53" pace="0" Cadence="85" />
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="60" OnPower="1.0" OffPower="1.0" pace="0" Cadence="95" CadenceResting="105" />
        <SteadyState Duration="120" Power="0.53" pace="0" Cadence="85" />
        <SteadyState Duration="240" Power="1.0" pace="0" Cadence="100" />
        <Cooldown Duration="300" PowerLow="0.53" PowerHigh="0.4" pace="0" Cadence="85" />
    </workout>
</workout_file>