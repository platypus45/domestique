<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 2x1min (85min)</name>
    <description>Warmup: 10min from 40% to 75% FTP | Intervals: 2 x (1min @ 85% / 1min @ 85%) | Cooldown: 5min from 65% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="0.95" OffPower="0.5" pace="0" Cadence="95" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.05" OffPower="0.5" pace="0" Cadence="105" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.15" OffPower="0.5" pace="0" Cadence="115" CadenceResting="85" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="120" Power="0.85" pace="0" Cadence="75" />
        <SteadyState Duration="60" Power="0.85" pace="0" Cadence="60" />
        <SteadyState Duration="120" Power="0.85" pace="0" Cadence="75" />
        <SteadyState Duration="60" Power="0.85" pace="0" Cadence="60" />
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="60" OnPower="0.85" OffPower="0.85" pace="0" Cadence="75" CadenceResting="55" />
        <SteadyState Duration="300" Power="0.65" pace="0" Cadence="85" />
        <SteadyState Duration="600" Power="1.0" pace="0" Cadence="90" />
        <SteadyState Duration="150" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="180" Power="0.65" pace="0" Cadence="85" />
        <IntervalsT Repeat="6" OnDuration="15" OffDuration="45" OnPower="1.1" OffPower="0.45" pace="0" Cadence="110" CadenceResting="85" />
        <SteadyState Duration="300" Power="0.65" pace="0" Cadence="85" />
        <Ramp Duration="60" PowerLow="1.05" PowerHigh="1.15" pace="0" />
        <Ramp Duration="60" PowerLow="1.15" PowerHigh="1.05" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" Cadence="85" />
        <Ramp Duration="60" PowerLow="1.05" PowerHigh="1.15" pace="0" />
        <Ramp Duration="60" PowerLow="1.15" PowerHigh="1.05" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" Cadence="85" />
        <Ramp Duration="60" PowerLow="1.05" PowerHigh="1.15" pace="0" />
        <Ramp Duration="60" PowerLow="1.15" PowerHigh="1.05" pace="0" />
        <SteadyState Duration="150" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="180" Power="0.65" pace="0" Cadence="85" />
        <SteadyState Duration="600" Power="1.0" pace="0" Cadence="90" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>