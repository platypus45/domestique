<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 2x20min (175min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Intervals: 2 x (20min @ 100% / 10min @ 61%) | Cooldown: 15min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="2700" Power="0.75" pace="0" />
        <IntervalsT Repeat="2" OnDuration="1200" OffDuration="600" OnPower="1.0" OffPower="0.61" pace="0" />
        <SteadyState Duration="2700" Power="0.75" pace="0" />
        <Cooldown Duration="900" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>