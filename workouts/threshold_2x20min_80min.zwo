<?xml version='1.0' encoding='utf-8'?>
<workout_file>
  <author>Domestique Library</author>
  <name>Threshold 2x20min (80min)</name>
  <description>Warmup: 10min from 45% to 56% FTP | Intervals: 2 x (20min @ 97% / 5min @ 50%) | Cooldown: 15min from 56% to 40% FTP</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.56" />
    <SteadyState Duration="300" Power="0.68" />
    <IntervalsT Repeat="2" OnDuration="1200" OffDuration="300" OnPower="0.97" OffPower="0.5" />
    <Cooldown Duration="900" PowerLow="0.56" PowerHigh="0.40" />
  </workout>
</workout_file>