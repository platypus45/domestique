<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed Ramp (18min)</name>
    <description>Warmup: 5min from 40% to 70% FTP | Ramp: 10min from 82% to 95% FTP | Cooldown: 3min from 40% to 65% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.4" PowerHigh="0.7" pace="0" />
        <Ramp Duration="120" PowerLow="0.6" PowerHigh="1.05" pace="0" />
        <Ramp Duration="120" PowerLow="1.05" PowerHigh="0.6" pace="0" />
        <Ramp Duration="120" PowerLow="0.6" PowerHigh="1.05" pace="0" />
        <Ramp Duration="120" PowerLow="1.05" PowerHigh="0.6" pace="0" />
        <SteadyState Duration="120" Power="0.95" pace="0" />
        <Cooldown Duration="180" PowerLow="0.4" PowerHigh="0.65" pace="0" />
    </workout>
</workout_file>