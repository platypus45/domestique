<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 2x3min (64min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 2 x (3min @ 100% / 1min 30s @ 55%) | Cooldown: 5min ramp from 55% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="2" OnDuration="300" OffDuration="120" OnPower="0.8" OffPower="0.55" pace="0" Cadence="60" CadenceResting="90" />
        <IntervalsT Repeat="1" OnDuration="120" OffDuration="60" OnPower="1.0" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="180" OffDuration="90" OnPower="1.0" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="240" OffDuration="120" OnPower="1.0" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="180" OffDuration="90" OnPower="1.0" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="120" OffDuration="60" OnPower="1.0" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="2" OnDuration="300" OffDuration="120" OnPower="0.8" OffPower="0.55" pace="0" Cadence="60" CadenceResting="90" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.40" /></workout>
</workout_file>