<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (40min)</name>
    <description>Warmup: 5min from 40% to 75% FTP | Steady: 30s @ 80% FTP | Steady: 1min @ 85% FTP | Steady: 30s @ 90% FTP | Steady: 30s @ 95% FTP | Steady: 30s @ 100% FTP | Steady: 2min @ 50% FTP | Steady: 10min @ 92% FTP | Steady: 5min @ 65% FTP | Steady: 10min @ 92% FTP | Cooldown: 5min from 40% to 65% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.4" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="30" Power="0.8" pace="0" />
        <SteadyState Duration="30" Power="0.85" pace="0" />
        <SteadyState Duration="30" Power="0.85" pace="0" />
        <SteadyState Duration="30" Power="0.9" pace="0" />
        <SteadyState Duration="30" Power="0.95" pace="0" />
        <SteadyState Duration="30" Power="1" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Ramp Duration="600" PowerLow="0.88" PowerHigh="0.95" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <Ramp Duration="600" PowerLow="0.88" PowerHigh="0.95" pace="0" />
        <Cooldown Duration="300" PowerLow="0.4" PowerHigh="0.65" pace="0" />
    </workout>
</workout_file>