<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (20min)</name>
    <description>Warmup: 4min ramp from 50% to 70% FTP | Steady: 30s @ 95% FTP | Steady: 3min @ 57% FTP | Steady: 30s @ 95% FTP | Steady: 3min @ 70% FTP | Steady: 5min @ 65% FTP | Cooldown: 4min from 60% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="240" PowerLow="0.5" PowerHigh="0.7" /><SteadyState Duration="30" Power="0.95" pace="0" />
        <Ramp Duration="180" PowerLow="0.5" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="30" Power="0.95" pace="0" />
        <Ramp Duration="180" PowerLow="0.65" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <Cooldown Duration="240" PowerLow="0.6" PowerHigh="0.3" pace="0" />
    </workout>
</workout_file>