<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (21min)</name>
    <description>Warmup: 3min from 30% to 50% FTP | Steady: 30s @ 95% FTP | Steady: 3min @ 57% FTP | Steady: 30s @ 95% FTP | Steady: 3min @ 70% FTP | Steady: 6min @ 65% FTP | Cooldown: 5min from 25% to 65% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="180" PowerLow="0.3" PowerHigh="0.5" pace="0" />
        <SteadyState Duration="30" Power="0.95" pace="0" />
        <Ramp Duration="180" PowerLow="0.5" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="30" Power="0.95" pace="0" />
        <Ramp Duration="180" PowerLow="0.65" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <Cooldown Duration="300" PowerLow="0.25" PowerHigh="0.65" pace="0" />
    </workout>
</workout_file>