<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 2x3min (60min)</name>
    <description>Warmup: 5min from 35% to 55% FTP | Intervals: 2 x (3min @ 100% / 1min 30s @ 55%) | Cooldown: 3min from 55% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.35" PowerHigh="0.55" pace="0" />
        <Ramp Duration="120" PowerLow="0.85" PowerHigh="1.05" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <IntervalsT Repeat="2" OnDuration="300" OffDuration="120" OnPower="0.8" OffPower="0.55" pace="0" Cadence="60" CadenceResting="90" />
        <IntervalsT Repeat="1" OnDuration="120" OffDuration="60" OnPower="1.0" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="180" OffDuration="90" OnPower="1.0" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="240" OffDuration="120" OnPower="1.0" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="180" OffDuration="90" OnPower="1.0" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="120" OffDuration="60" OnPower="1.0" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="2" OnDuration="300" OffDuration="120" OnPower="0.8" OffPower="0.55" pace="0" Cadence="60" CadenceResting="90" />
        <Cooldown Duration="180" PowerLow="0.55" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>