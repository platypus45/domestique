<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (30min)</name>
    <description>Warmup: 4min from 40% to 60% FTP | Steady: 30s @ 95% FTP | Steady: 4min @ 68% FTP | Steady: 30s @ 95% FTP | Steady: 5min @ 75% FTP | Steady: 6min @ 85% FTP | Cooldown: 10min from 40% to 75% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="240" PowerLow="0.4" PowerHigh="0.6" pace="0" />
        <SteadyState Duration="30" Power="0.95" pace="0" />
        <Ramp Duration="240" PowerLow="0.6" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="30" Power="0.95" pace="0" />
        <SteadyState Duration="300" Power="0.75" pace="0" />
        <SteadyState Duration="180" Power="0.85" pace="0" />
        <SteadyState Duration="180" Power="0.85" pace="0" />
        <Cooldown Duration="600" PowerLow="0.4" PowerHigh="0.75" pace="0" />
    </workout>
</workout_file>