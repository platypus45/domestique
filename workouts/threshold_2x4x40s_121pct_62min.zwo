<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 40s/25s 8x (62min)</name>
    <description>Warmup: 10min ramp from 50% to 65% FTP | Microintervals: 8 x (40s @ 121% / 25s @ 50%) | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="620" PowerLow="0.5" PowerHigh="0.65" /><IntervalsT Repeat="5" OnDuration="30" OffDuration="30" OnPower="0.65" OffPower="0.8" pace="0" Cadence="90" CadenceResting="95" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="40" OffDuration="30" OnPower="1.21" OffPower="0.5" pace="0" Cadence="95" CadenceResting="80" />
        <SteadyState Duration="600" Power="0.95" pace="0" Cadence="90" />
        <SteadyState Duration="600" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="40" OffDuration="20" OnPower="1.21" OffPower="0.5" pace="0" Cadence="95" CadenceResting="80" />
        <SteadyState Duration="600" Power="0.95" pace="0" Cadence="90" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
    </workout>
</workout_file>