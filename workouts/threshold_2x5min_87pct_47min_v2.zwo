<workout_file>
    <author>Domestique Library</author>
    <name>Mixed (47min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Steady: 5min @ 87% FTP | Steady: 3min @ 95% FTP | Steady: 1min @ 110% FTP | Steady: 5min @ 87% FTP | Steady: 3min @ 95% FTP | Steady: 1min @ 110% FTP | Steady: 2min @ 65% FTP | Steady: 5min @ 95% FTP | Steady: 2min @ 50% FTP | Steady: 5min @ 95% FTP | Cooldown: 5min from 60% to 40% FTP</description>
