<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (30min)</name>
    <description>Warmup: 5min from 50% to 75% FTP | Steady: 8min @ 70% FTP | Steady: 10min @ 100% FTP | Steady: 4min @ 55% FTP | Cooldown: 3min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="480" Power="0.7" pace="0" />
        <SteadyState Duration="600" Power="1" pace="0" />
        <SteadyState Duration="240" Power="0.55" pace="0" />
        <Cooldown Duration="180" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>