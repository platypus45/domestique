<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 30s/2min 10x (65min)</name>
    <description>Warmup: 15min from 45% to 65% FTP | Microintervals: 10 x (30s @ 115% / 2min @ 100%) | Cooldown: 10min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.45" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.52" pace="0" />
        <IntervalsT Repeat="5" OnDuration="30" OffDuration="120" OnPower="1.15" OffPower="1.0" pace="0" />
        <SteadyState Duration="600" Power="0.52" pace="0" />
        <IntervalsT Repeat="5" OnDuration="30" OffDuration="120" OnPower="1.15" OffPower="1.0" pace="0" />
        <Cooldown Duration="600" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>