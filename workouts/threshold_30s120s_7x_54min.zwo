<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 30s/2min 7x (54min)</name>
    <description>Warmup: 3min from 25% to 75% FTP | Microintervals: 7 x (30s @ 140% / 2min @ 55%) | Cooldown: 3min from 25% to 75% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="180" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <Ramp Duration="420" PowerLow="0.75" PowerHigh="1.05" pace="0" />
        <Ramp Duration="420" PowerLow="1" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="30" Power="1.4" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
