<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 30s/3min 7x (66min)</name>
    <description>Warmup: 3min from 25% to 75% FTP | Microintervals: 7 x (30s @ 140% / 2min 34s @ 56%) | Cooldown: 5min ramp from 65% to 40% FTP</description>
