<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 3x30s (38min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Intervals: 3 x (30s @ 105% / 30s @ 65%) | Cooldown: 5min from 65% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="3" OnDuration="30" OffDuration="30" OnPower="1.05" OffPower="0.65" pace="0" Cadence="105" CadenceResting="85" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <Ramp Duration="300" PowerLow="0.88" PowerHigh="0.95" pace="0" Cadence="75" />
        <SteadyState Duration="150" Power="0.65" pace="0" Cadence="90" />
        <Ramp Duration="300" PowerLow="0.88" PowerHigh="0.95" pace="0" Cadence="75" />
        <SteadyState Duration="150" Power="0.65" pace="0" Cadence="90" />
        <Ramp Duration="300" PowerLow="0.88" PowerHigh="0.95" pace="0" Cadence="75" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.4" pace="0" Cadence="0" />
    </workout>
</workout_file>