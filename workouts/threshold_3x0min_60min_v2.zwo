<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 3x30s (60min)</name>
    <description>Warmup: 5min from 25% to 65% FTP | Intervals: 3 x (30s @ 110% / 30s @ 55%) | Cooldown: 7min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
