<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 3x10min (74min)</name>
    <description>Warmup: 20min from 50% to 80% FTP | Intervals: 3 x (10min @ 95% / 3min @ 50%)</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="1200" PowerLow="0.5" PowerHigh="0.8" pace="0" />
        <IntervalsT Repeat="3" OnDuration="600" OffDuration="180" OnPower="0.95" OffPower="0.5" pace="0" />
        <Ramp Duration="600" PowerLow="0.7" PowerHigh="0.5" pace="0" />
        <FreeRide Duration="300" FlatRoad="0" />
    </workout>
</workout_file>