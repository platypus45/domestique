<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 3x10min (98min)</name>
    <description>Warmup: 10min ramp from 50% to 72% FTP | Intervals: 3 x (10min @ 95% / 10min @ 72%) | Cooldown: 10min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.72" /><IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="0.72" OffPower="0.72" pace="0" Cadence="105" CadenceResting="85" />
        <IntervalsT Repeat="3" OnDuration="600" OffDuration="600" OnPower="0.95" OffPower="0.72" pace="0" />
        <IntervalsT Repeat="2" OnDuration="180" OffDuration="180" OnPower="1.14" OffPower="0.72" pace="0" />
        <Cooldown Duration="600" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>