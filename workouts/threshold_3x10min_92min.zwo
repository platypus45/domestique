<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 3x10min (92min)</name>
    <description>Warmup: 4min from 55% to 72% FTP | Intervals: 3 x (10min @ 95% / 10min @ 72%) | Cooldown: 10min from 72% to 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="240" PowerLow="0.55" PowerHigh="0.72" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="0.72" OffPower="0.72" pace="0" Cadence="105" CadenceResting="85" />
        <IntervalsT Repeat="3" OnDuration="600" OffDuration="600" OnPower="0.95" OffPower="0.72" pace="0" />
        <IntervalsT Repeat="2" OnDuration="180" OffDuration="180" OnPower="1.14" OffPower="0.72" pace="0" />
        <Cooldown Duration="600" PowerLow="0.72" PowerHigh="0.55" pace="0" />
    </workout>
</workout_file>