<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 3x15min (107min)</name>
    <description>Warmup: 15min from 25% to 75% FTP | Intervals: 3 x (15min @ 95% / 5min @ 68%) | Cooldown: 10min from 61% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="900" OffDuration="300" OnPower="0.95" OffPower="0.68" pace="0" />
        <FreeRide Duration="600" FlatRoad="0" />
        <IntervalsT Repeat="2" OnDuration="180" OffDuration="180" OnPower="1.15" OffPower="0.61" pace="0" />
        <Cooldown Duration="600" PowerLow="0.61" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>