<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 3x15min (82min)</name>
    <description>Warmup: 6min @ 50% FTP | Intervals: 3 x (15min @ 100% / 5min @ 40%) | Cooldown: 5min ramp @ 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <Ramp Duration="60" PowerLow="0.5" PowerHigh="0.72" pace="0" />
        <SteadyState Duration="300" Power="0.72" pace="0" />
        <Ramp Duration="60" PowerLow="0.72" PowerHigh="0.96" pace="0" />
        <SteadyState Duration="120" Power="0.96" pace="0" />
        <FreeRide Duration="120" FlatRoad="0" />
        <IntervalsT Repeat="3" OnDuration="900" OffDuration="300" OnPower="1.0" OffPower="0.4" pace="0" />
    <Cooldown Duration="300" PowerLow="0.40" PowerHigh="0.40" /></workout>
</workout_file>