<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 3x15min (99min)</name>
    <description>Warmup: 10min from 40% to 85% FTP | Intervals: 3 x (15min @ 100% / 8min @ 50%) | Cooldown: 15min from 75% to 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.85" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <SteadyState Duration="900" Power="1.0" pace="0" />
        <SteadyState Duration="480" Power="0.5" pace="0" />
        <SteadyState Duration="900" Power="1.0" pace="0" />
        <SteadyState Duration="480" Power="0.5" pace="0" />
        <SteadyState Duration="900" Power="1.0" pace="0" />
        <SteadyState Duration="480" Power="0.5" pace="0" />
        <Cooldown Duration="900" PowerLow="0.75" PowerHigh="0.55" pace="0" />
    </workout>
</workout_file>