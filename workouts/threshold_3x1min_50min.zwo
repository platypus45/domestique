<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo 3x1min (54min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Intervals: 3 x (1min @ 110% / 1min 30s @ 90%) | Cooldown: 3min ramp from 65% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="120" Power="0.81" pace="0" />
        <SteadyState Duration="60" Power="0.95" pace="0" />
        <SteadyState Duration="120" Power="0.65" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="90" OnPower="1.1" OffPower="0.9" pace="0" />
        <FreeRide Duration="1180" FlatRoad="0" />
        <SteadyState Duration="120" Power="0.65" pace="0" />
        <SteadyState Duration="60" Power="0.81" pace="0" />
        <IntervalsT Repeat="3" OnDuration="20" OffDuration="120" OnPower="1.35" OffPower="0.85" pace="0" />
        <Cooldown Duration="230" PowerLow="0.65" PowerHigh="0.40" /></workout>
</workout_file>