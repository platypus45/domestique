<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (51min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Steady: 10min @ 97% FTP | Steady: 3min @ 65% FTP | Steady: 5min @ 99% FTP | Steady: 1min @ 80% FTP | Steady: 5min @ 95% FTP | Steady: 1min @ 80% FTP | Steady: 5min @ 99% FTP | Steady: 1min @ 80% FTP | Steady: 5min @ 95% FTP | Cooldown: 5min ramp from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="600" Power="0.97" pace="0" />
        <FreeRide Duration="180" FlatRoad="0" />
        <SteadyState Duration="300" Power="0.99" pace="0" Cadence="105" />
        <SteadyState Duration="60" Power="0.8" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <SteadyState Duration="60" Power="0.8" pace="0" />
        <SteadyState Duration="300" Power="0.99" pace="0" Cadence="105" />
        <SteadyState Duration="60" Power="0.8" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.40" /></workout>
</workout_file>