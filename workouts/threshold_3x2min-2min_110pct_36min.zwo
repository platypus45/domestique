<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 3x2min (36min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 3 x (2min @ 110% / 2min @ 40%) | Cooldown: 5min @ 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="300" Power="0.88" pace="0" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="120" OnPower="1.1" OffPower="0.4" pace="0" />
        <Cooldown Duration="300" PowerLow="0.40" PowerHigh="0.40" pace="0" />
    </workout>
</workout_file>