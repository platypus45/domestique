<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery (32min)</name>
    <description>Warmup: 10min from 50% to 81% FTP | Steady: 2min @ 105% FTP | Steady: 8min @ 50% FTP | Steady: 2min @ 51% FTP | Steady: 2min @ 50% FTP | Cooldown: 8min from 50% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.81" pace="0" />
        <SteadyState Duration="120" Power="1.05" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.51" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Cooldown Duration="480" PowerLow="0.50" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>