<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 3x30s (61min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 3 x (30s @ 120% / 1min @ 55%) | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="630" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="30" Power="1.2" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <SteadyState Duration="30" Power="1.2" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <SteadyState Duration="30" Power="1.2" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <SteadyState Duration="600" Power="1.02" pace="0" />
        <SteadyState Duration="600" Power="0.97" pace="0" />
        <SteadyState Duration="600" Power="0.93" pace="0" />
        <SteadyState Duration="660" Power="0.8" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
    </workout>
</workout_file>