<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 3x30s (56min)</name>
    <description>Warmup: 10min from 40% to 70% FTP | Intervals: 3 x (30s @ 120% / 0s @ 55%) | Cooldown: 5min from 35% to 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <Ramp Duration="180" PowerLow="0.9" PowerHigh="1.1" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="360" Power="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="30" Power="1.2" pace="0" />
        <SteadyState Duration="300" Power="1" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="30" Power="1.2" pace="0" />
        <SteadyState Duration="300" Power="1" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="30" Power="1.2" pace="0" />
        <SteadyState Duration="300" Power="1" pace="0" />
        <Cooldown Duration="300" PowerLow="0.35" PowerHigh="0.55" pace="0" />
    </workout>
</workout_file>