<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 3x3min (90min)</name>
    <description>Warmup: 15min from 30% to 90% FTP | Intervals: 3 x (3min @ 105% / 3min @ 30%) | Cooldown: 10min from 46% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.3" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="300" Power="0.3" pace="0" />
        <IntervalsT Repeat="2" OnDuration="240" OffDuration="240" OnPower="1.05" OffPower="0.3" pace="0" />
        <IntervalsT Repeat="3" OnDuration="180" OffDuration="180" OnPower="1.05" OffPower="0.3" pace="0" />
        <IntervalsT Repeat="4" OnDuration="120" OffDuration="120" OnPower="1.05" OffPower="0.3" pace="0" />
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="1.05" OffPower="0.3" pace="0" />
        <Cooldown Duration="600" PowerLow="0.46" PowerHigh="0.3" pace="0" />
    </workout>
</workout_file>