<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 9x3min (93min)</name>
    <description>Warmup: 10min from 50% to 65% FTP | Intervals: 9 x (3min @ 95% / 3min 20s @ 71%) | Cooldown: 5min from 50% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.65" pace="0" />
        <Ramp Duration="300" PowerLow="0.5" PowerHigh="1.0" pace="0" />
        <SteadyState Duration="120" Power="0.65" pace="0" />
        <SteadyState Duration="120" Power="0.81" pace="0" />
        <SteadyState Duration="60" Power="0.95" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="180" OnPower="0.81" OffPower="0.95" pace="0" />
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="180" OnPower="0.81" OffPower="0.95" pace="0" />
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="180" OnPower="0.81" OffPower="0.95" pace="0" />
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.50" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>