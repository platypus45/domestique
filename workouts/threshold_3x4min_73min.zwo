<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 3x4min (73min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Intervals: 3 x (4min @ 100% / 3min 20s @ 65%) | Cooldown: 10min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="0.75" OffPower="0.5" pace="0" Cadence="110" CadenceResting="80" />
        <SteadyState Duration="300" Power="0.85" pace="0" />
        <Ramp Duration="240" PowerLow="1.0" PowerHigh="0.98" pace="0" Cadence="90" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <Ramp Duration="240" PowerLow="1.0" PowerHigh="0.98" pace="0" Cadence="90" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <Ramp Duration="240" PowerLow="1.05" PowerHigh="1.0" pace="0" Cadence="83" />
        <SteadyState Duration="240" Power="0.65" pace="0" />
        <Ramp Duration="240" PowerLow="1.07" PowerHigh="1.0" pace="0" Cadence="93" />
        <SteadyState Duration="240" Power="0.65" pace="0" />
        <Ramp Duration="240" PowerLow="1.1" PowerHigh="0.97" pace="0" Cadence="93" />
        <SteadyState Duration="240" Power="0.65" pace="0" />
        <Ramp Duration="240" PowerLow="1.13" PowerHigh="0.95" pace="0" Cadence="88" />
        <Cooldown Duration="600" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>