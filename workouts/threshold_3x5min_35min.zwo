<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo Ramp (35min)</name>
    <description>Warmup: 5min from 50% to 70% FTP | Ramp: 25min from 72% to 90% FTP | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.5" PowerHigh="0.7" pace="0" />
        <Ramp Duration="300" PowerLow="0.7" PowerHigh="0.75" pace="0" />
        <Ramp Duration="300" PowerLow="0.75" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="300" Power="0.8" pace="0" />
        <Ramp Duration="300" PowerLow="0.83" PowerHigh="0.9" pace="0" />
        <Ramp Duration="300" PowerLow="0.86" PowerHigh="0.95" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>