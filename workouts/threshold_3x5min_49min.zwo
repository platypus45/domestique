<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 3x5min (49min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Intervals: 3 x (5min @ 95% / 0s @ 55%) | Cooldown: 7min from 25% to 50% FTP</description>
