<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (50min)</name>
    <description>Warmup: 10min from 55% to 70% FTP | Steady: 5min @ 70% FTP | Steady: 5min @ 68% FTP | Steady: 5min @ 82% FTP | Steady: 5min @ 100% FTP | Steady: 5min @ 82% FTP | Steady: 5min @ 73% FTP | Steady: 5min @ 80% FTP | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.55" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="300" Power="0.7" pace="0" />
        <Ramp Duration="300" PowerLow="0.7" PowerHigh="0.65" pace="0" />
        <Ramp Duration="300" PowerLow="0.65" PowerHigh="1" pace="0" />
        <SteadyState Duration="300" Power="1" pace="0" />
        <Ramp Duration="300" PowerLow="1" PowerHigh="0.65" pace="0" />
        <Ramp Duration="300" PowerLow="0.65" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="300" Power="0.8" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
