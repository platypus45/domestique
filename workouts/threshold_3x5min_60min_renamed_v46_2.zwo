<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 3x5min (60min)</name>
    <description>Warmup: 5min from 44% to 75% FTP | Intervals: 3 x (5min @ 95% / 5min @ 75%) | Cooldown: 10min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.44" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="300" Power="0.75" pace="0" Cadence="95" />
        <SteadyState Duration="300" Power="0.82" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <SteadyState Duration="300" Power="0.75" pace="0" Cadence="95" />
        <SteadyState Duration="300" Power="0.82" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <SteadyState Duration="300" Power="0.75" pace="0" Cadence="95" />
        <SteadyState Duration="300" Power="0.82" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <SteadyState Duration="600" Power="0.5" pace="0" />
    </workout>
</workout_file>