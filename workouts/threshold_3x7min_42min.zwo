<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 3x7min (44min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 3 x (7min @ 102% / 2min 30s @ 55%) | Cooldown: 5min from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="630" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="420" Power="1.02" pace="0" />
        <SteadyState Duration="150" Power="0.55" pace="0" />
        <SteadyState Duration="420" Power="1.02" pace="0" />
        <SteadyState Duration="150" Power="0.55" pace="0" />
        <SteadyState Duration="420" Power="1.02" pace="0" />
        <SteadyState Duration="150" Power="0.55" pace="0" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>