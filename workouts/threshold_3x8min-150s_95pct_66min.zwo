<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 3x8min (66min)</name>
    <description>Warmup: 20min from 55% to 80% FTP | Intervals: 3 x (8min @ 95% / 2min 30s @ 55%)</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="1200" PowerLow="0.55" PowerHigh="0.8" pace="0" />
        <IntervalsT Repeat="3" OnDuration="480" OffDuration="150" OnPower="0.95" OffPower="0.55" pace="0" />
        <Ramp Duration="600" PowerLow="0.75" PowerHigh="0.55" pace="0" />
        <FreeRide Duration="300" FlatRoad="0" />
    </workout>
</workout_file>