<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 4x10min (83min)</name>
    <description>Warmup: 10min from 50% to 65% FTP | Intervals: 4 x (10min @ 95% / 5min @ 72%) | Cooldown: 5min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.65" pace="0" />
        <IntervalsT Repeat="4" OnDuration="600" OffDuration="300" OnPower="0.95" OffPower="0.72" pace="0" />
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="1.41" OffPower="0.72" pace="0" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>