<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 4x2min (38min)</name>
    <description>Warmup: 8min from 40% to 80% FTP | Intervals: 4 x (2min @ 102% / 30s @ 55%) | Cooldown: 5min ramp from 55% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.4" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <IntervalsT Repeat="4" OnDuration="90" OffDuration="30" OnPower="1.05" OffPower="0.55" pace="0" />
        <SteadyState Duration="240" Power="0.55" pace="0" />
        <IntervalsT Repeat="4" OnDuration="120" OffDuration="30" OnPower="1.02" OffPower="0.55" pace="0" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.40" /></workout>
</workout_file>