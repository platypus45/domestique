<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 4x30s (41min)</name>
    <description>Warmup: 10min from 25% to 85% FTP | Intervals: 4 x (30s @ 150% / 3min @ 55%) | Cooldown: 5min from 60% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.85" pace="0" />
        <IntervalsT Repeat="4" OnDuration="30" OffDuration="180" OnPower="1.5" OffPower="0.55" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="600" Power="0.95" pace="0" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>