<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 4x30s (78min)</name>
    <description>Warmup: 15min from 45% to 85% FTP | Intervals: 4 x (30s @ 100% / 1min @ 50%) | Cooldown: 15min from 85% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.45" PowerHigh="0.85" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <IntervalsT Repeat="4" OnDuration="30" OffDuration="60" OnPower="1.0" OffPower="0.5" pace="0" />
        <SteadyState Duration="240" Power="1.0" pace="0" Cadence="90" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="1.0" pace="0" Cadence="85" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="1.0" pace="0" Cadence="80" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="1.0" pace="0" Cadence="75" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="1.0" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="1.0" pace="0" Cadence="80" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="1.0" pace="0" Cadence="85" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="240" Power="1.0" pace="0" Cadence="90" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <Cooldown Duration="900" PowerLow="0.85" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>