<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 4x4min (46min)</name>
    <description>Warmup: 10min from 75% to 85% FTP | Intervals: 4 x (4min @ 100% / 2min 30s @ 75%) | Cooldown: 10min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.75" PowerHigh="0.85" pace="0" />
        <IntervalsT Repeat="4" OnDuration="240" OffDuration="150" OnPower="1.0" OffPower="0.75" pace="0" />
        <Cooldown Duration="600" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>