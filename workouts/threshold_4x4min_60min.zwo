<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 4x4min (60min)</name>
    <description>Warmup: 15min from 55% to 80% FTP | Intervals: 4 x (4min @ 104% / 5min @ 55%) | Cooldown: 8min from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.55" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <IntervalsT Repeat="4" OnDuration="240" OffDuration="300" OnPower="1.04" OffPower="0.55" pace="0" />
        <Cooldown Duration="480" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>