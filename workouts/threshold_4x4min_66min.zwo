<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 4x4min (70min)</name>
    <description>Intervals: 4 x (3min 30s @ 95% / 1min 30s @ 80%) | Cooldown: 4min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="60" Power="0.9" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <IntervalsT Repeat="4" OnDuration="210" OffDuration="90" OnPower="0.95" OffPower="0.8" pace="0" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <SteadyState Duration="120" Power="0.95" pace="0" />
        <SteadyState Duration="180" Power="1.03" pace="0" />
        <SteadyState Duration="120" Power="1.11" pace="0" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <FreeRide Duration="600" FlatRoad="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <FreeRide Duration="120" FlatRoad="0" />
        <Cooldown Duration="240" PowerLow="0.60" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>