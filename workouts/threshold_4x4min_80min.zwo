<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 4x4min (80min)</name>
    <description>Warmup: 5min from 53% to 68% FTP | Intervals: 4 x (4min @ 101% / 2min @ 55%) | Cooldown: 5min from 63% to 49% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.53" PowerHigh="0.68" pace="0" />
        <SteadyState Duration="960" Power="0.93" pace="0" Cadence="70" />
        <SteadyState Duration="360" Power="0.53" pace="0" Cadence="85" />
        <IntervalsT Repeat="2" OnDuration="480" OffDuration="240" OnPower="0.97" OffPower="0.55" pace="0" Cadence="60" CadenceResting="85" />
        <IntervalsT Repeat="4" OnDuration="240" OffDuration="120" OnPower="1.01" OffPower="0.55" pace="0" Cadence="60" CadenceResting="85" />
        <Cooldown Duration="300" PowerLow="0.63" PowerHigh="0.49" pace="0" />
    </workout>
</workout_file>