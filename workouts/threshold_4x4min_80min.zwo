<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 4x4min (85min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 4 x (4min @ 101% / 2min @ 55%) | Cooldown: 5min from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="960" Power="0.93" pace="0" Cadence="70" />
        <SteadyState Duration="360" Power="0.53" pace="0" Cadence="85" />
        <IntervalsT Repeat="2" OnDuration="480" OffDuration="240" OnPower="0.97" OffPower="0.55" pace="0" Cadence="60" CadenceResting="85" />
        <IntervalsT Repeat="4" OnDuration="240" OffDuration="120" OnPower="1.01" OffPower="0.55" pace="0" Cadence="60" CadenceResting="85" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>