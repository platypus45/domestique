<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 4x5min (53min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 4 x (5min @ 95% / 1min @ 61%) | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="2" OnDuration="10" OffDuration="50" OnPower="1.75" OffPower="0.5" pace="0" Cadence="110" CadenceResting="85" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="1.09" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="240" Power="0.85" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="300" OffDuration="60" OnPower="0.95" OffPower="0.61" pace="0" Cadence="95" CadenceResting="65" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
    </workout>
</workout_file>