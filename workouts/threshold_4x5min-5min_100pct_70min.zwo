<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 4x5min (70min)</name>
    <description>Warmup: 20min from 35% to 82% FTP | Intervals: 4 x (5min @ 100% / 5min @ 40%) | Cooldown: 5min ramp @ 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="1200" PowerLow="0.35" PowerHigh="0.82" pace="0" />
        <SteadyState Duration="300" Power="0.4" pace="0" />
        <IntervalsT Repeat="4" OnDuration="300" OffDuration="300" OnPower="1.0" OffPower="0.4" pace="0" />
    <Cooldown Duration="300" PowerLow="0.40" PowerHigh="0.40" /></workout>
</workout_file>