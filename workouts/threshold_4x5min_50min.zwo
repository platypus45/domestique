<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 4x5min (55min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 4 x (5min @ 96% / 5min @ 89%) | Cooldown: 5min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="4" OnDuration="300" OffDuration="300" OnPower="0.96" OffPower="0.89" pace="0" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>