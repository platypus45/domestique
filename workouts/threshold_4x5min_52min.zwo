<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 4x5min (52min)</name>
    <description>Warmup: 5min from 40% to 85% FTP | Intervals: 4 x (5min @ 96% / 5min @ 89%) | Cooldown: 5min from 75% to 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.4" PowerHigh="0.85" pace="0" />
        <IntervalsT Repeat="2" OnDuration="300" OffDuration="300" OnPower="0.96" OffPower="0.89" pace="0" />
        <SteadyState Duration="10" Power="1.7" pace="0" />
        <SteadyState Duration="60" Power="1.05" pace="0" />
        <SteadyState Duration="60" Power="0.98" pace="0" />
        <IntervalsT Repeat="2" OnDuration="300" OffDuration="300" OnPower="0.96" OffPower="0.89" pace="0" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.55" pace="0" />
    </workout>
</workout_file>