<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 5x5min (60min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Intervals: 5 x (5min @ 95% / 5min @ 51%) | Cooldown: 5min from 65% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>