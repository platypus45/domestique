<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (60min)</name>
    <description>Warmup: 10min from 25% to 85% FTP | Steady: 5min @ 90% FTP | Steady: 5min @ 95% FTP | Steady: 5min @ 90% FTP | Steady: 5min @ 50% FTP | Steady: 5min @ 90% FTP | Steady: 5min @ 100% FTP | Steady: 5min @ 90% FTP | Steady: 5min @ 50% FTP | Steady: 5min @ 100% FTP | Cooldown: 5min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.85" pace="0" />
        <SteadyState Duration="300" Power="0.9" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <SteadyState Duration="300" Power="0.9" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.9" pace="0" />
        <SteadyState Duration="300" Power="1" pace="0" />
        <SteadyState Duration="300" Power="0.9" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="1" pace="0" />
