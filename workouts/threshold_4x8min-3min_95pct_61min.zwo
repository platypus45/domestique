<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 4x8min (61min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 4 x (8min @ 95% / 3min @ 55%) | Cooldown: 6min 30s from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="630" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="4" OnDuration="480" OffDuration="180" OnPower="0.95" OffPower="0.55" pace="0" />
        <Cooldown Duration="390" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>