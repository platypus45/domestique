<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 20s/40s 15x (39min)</name>
    <description>Warmup: 5min from 50% to 60% FTP | Microintervals: 15 x (20s @ 110% / 40s @ 90%) | Cooldown: 5min from 65% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.5" PowerHigh="0.6" pace="0" />
        <Ramp Duration="300" PowerLow="0.65" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <IntervalsT Repeat="5" OnDuration="20" OffDuration="40" OnPower="1.1" OffPower="0.9" pace="0" Cadence="95" CadenceResting="95" />
        <SteadyState Duration="240" Power="0.55" pace="0" Cadence="80" />
        <IntervalsT Repeat="5" OnDuration="20" OffDuration="40" OnPower="1.1" OffPower="0.9" pace="0" Cadence="95" CadenceResting="95" />
        <SteadyState Duration="240" Power="0.55" pace="0" Cadence="80" />
        <IntervalsT Repeat="5" OnDuration="20" OffDuration="40" OnPower="1.1" OffPower="0.9" pace="0" Cadence="95" CadenceResting="95" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>