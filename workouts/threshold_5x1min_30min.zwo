<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 5x2min (43min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 5 x (1min 30s @ 100% / 30s @ 60%) | Cooldown: 5min ramp from 75% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="20" Power="1.05" pace="0" />
        <Ramp Duration="80" PowerLow="0.6" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="20" Power="1.05" pace="0" />
        <Ramp Duration="120" PowerLow="0.7" PowerHigh="0.85" pace="0" />
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="30" OnPower="1.05" OffPower="0.6" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="90" OffDuration="30" OnPower="1.0" OffPower="0.6" pace="0" />
        <SteadyState Duration="50" Power="0.95" pace="0" />
        <SteadyState Duration="90" Power="1.05" pace="0" />
        <SteadyState Duration="45" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.05" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <SteadyState Duration="20" Power="1.05" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <SteadyState Duration="20" Power="1.05" pace="0" />
        <Cooldown Duration="315" PowerLow="0.75" PowerHigh="0.4" /></workout>
</workout_file>