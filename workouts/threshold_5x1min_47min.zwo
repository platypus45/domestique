<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 5x2min (48min)</name>
    <description>Warmup: 15min from 25% to 75% FTP | Intervals: 5 x (1min 30s @ 105% / 3min @ 50%) | Cooldown: 10min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="5" OnDuration="90" OffDuration="180" OnPower="1.05" OffPower="0.5" pace="0" />
        <Cooldown Duration="600" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>