<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 5x1min (51min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 5 x (1min @ 105% / 1min @ 50%) | Cooldown: 5min from 50% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="300" Power="1.0" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="1.05" OffPower="0.5" pace="0" />
        <SteadyState Duration="600" Power="0.95" pace="0" />
        <SteadyState Duration="600" Power="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.5" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>