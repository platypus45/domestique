<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 5x1min (62min)</name>
    <description>Warmup: 8min from 50% to 85% FTP | Intervals: 5 x (1min @ 140% / 2min @ 50%) | Cooldown: 4min from 50% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.85" pace="0" />
