<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 5x1min (65min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 5 x (1min @ 140% / 2min @ 50%) | Cooldown: 5min ramp from 75% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="180" Power="0.9" pace="0" Cadence="75" />
        <SteadyState Duration="60" Power="0.6" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" Cadence="70" />
        <SteadyState Duration="60" Power="0.6" pace="0" />
        <SteadyState Duration="180" Power="1.0" pace="0" Cadence="65" />
        <SteadyState Duration="60" Power="0.6" pace="0" />
        <SteadyState Duration="180" Power="1.05" pace="0" Cadence="60" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.7" pace="0" />
        <SteadyState Duration="60" Power="0.9" pace="0" Cadence="70" />
        <SteadyState Duration="60" Power="0.9" pace="0" Cadence="100" />
        <SteadyState Duration="60" Power="0.9" pace="0" Cadence="60" />
        <SteadyState Duration="60" Power="0.9" pace="0" Cadence="110" />
        <SteadyState Duration="60" Power="0.9" pace="0" Cadence="50" />
        <SteadyState Duration="60" Power="0.9" pace="0" Cadence="120" />
        <SteadyState Duration="60" Power="0.9" pace="0" Cadence="50" />
        <SteadyState Duration="60" Power="0.9" pace="0" Cadence="130" />
        <SteadyState Duration="60" Power="0.95" pace="0" Cadence="50" />
        <SteadyState Duration="60" Power="0.95" pace="0" Cadence="120" />
        <SteadyState Duration="60" Power="0.95" pace="0" Cadence="50" />
        <SteadyState Duration="60" Power="1.0" pace="0" Cadence="120" />
        <SteadyState Duration="60" Power="1.0" pace="0" Cadence="125" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="120" OnPower="1.4" OffPower="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.4" /></workout>
</workout_file>