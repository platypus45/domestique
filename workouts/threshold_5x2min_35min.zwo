<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (38min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Steady: 30s @ 80% FTP | Steady: 1min @ 85% FTP | Steady: 30s @ 90% FTP | Steady: 30s @ 95% FTP | Steady: 30s @ 100% FTP | Steady: 2min @ 50% FTP | Steady: 2min @ 88% FTP | Steady: 2min @ 95% FTP | Steady: 2min @ 88% FTP | Steady: 2min @ 95% FTP | Steady: 2min @ 88% FTP | Steady: 2min @ 95% FTP | Steady: 2min @ 88% FTP | Steady: 2min @ 95% FTP | Steady: 2min @ 88% FTP | Steady: 2min @ 95% FTP | Cooldown: 5min from 60% to 40% FTP</description>
