<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 5x3min (60min)</name>
    <description>Warmup: 10min from 40% to 75% FTP | Intervals: 5 x (3min @ 100% / 2min @ 65%) | Cooldown: 10min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="5" OnDuration="180" OffDuration="120" OnPower="1.0" OffPower="0.65" pace="0" />
        <SteadyState Duration="60" Power="0.81" pace="0" />
        <SteadyState Duration="90" Power="0.95" pace="0" />
        <SteadyState Duration="120" Power="1.05" pace="0" />
        <SteadyState Duration="90" Power="0.95" pace="0" />
        <SteadyState Duration="60" Power="0.81" pace="0" />
        <SteadyState Duration="480" Power="0.9" pace="0" Cadence="85" />
        <Cooldown Duration="600" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>