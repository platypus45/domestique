<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 5x3min (86min)</name>
    <description>Warmup: 8min from 35% to 95% FTP | Intervals: 5 x (3min @ 100% / 3min @ 75%) | Cooldown: 5min from 60% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.35" PowerHigh="0.95" pace="0" />
        <SteadyState Duration="120" Power="0.45" pace="0" />
        <FreeRide Duration="1800" FlatRoad="0" />
        <IntervalsT Repeat="5" OnDuration="180" OffDuration="180" OnPower="1.0" OffPower="0.75" pace="0" />
        <SteadyState Duration="240" Power="0.4" pace="0" />
        <Ramp Duration="360" PowerLow="0.5" PowerHigh="1.3" pace="0" />
        <SteadyState Duration="60" Power="0.25" pace="0" />
        <Cooldown Duration="300" PowerLow="0.6" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>