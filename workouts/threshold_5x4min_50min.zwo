<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 5x4min (50min)</name>
    <description>Warmup: 10min from 50% to 75% FTP | Intervals: 5 x (4min @ 98% / 3min @ 55%) | Cooldown: 5min from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="240" Power="0.98" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="240" Power="0.98" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="240" Power="0.98" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="240" Power="0.98" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="240" Power="0.98" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>