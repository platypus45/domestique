        <SteadyState Duration="120" Power="1.05" pace="0" />
        <SteadyState Duration="60" Power="0.65" pace="0" />
        <SteadyState Duration="120" Power="1.05" pace="0" />
        <SteadyState Duration="60" Power="0.65" pace="0" />
        <SteadyState Duration="120" Power="1.05" pace="0" />
        <SteadyState Duration="60" Power="0.65" pace="0" />
        <SteadyState Duration="120" Power="1.05" pace="0" />
        <SteadyState Duration="120" Power="1.05" pace="0" />
    <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.4" /></workout>
</workout_file>