<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 6x2min (27min)</name>
    <description>Warmup: 3min from 35% to 55% FTP | Intervals: 6 x (2min @ 96% / 0s @ 55%) | Cooldown: 3min from 35% to 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="180" PowerLow="0.35" PowerHigh="0.55" pace="0" />
        <SteadyState Duration="120" Power="0.96" pace="0" />
        <SteadyState Duration="60" Power="1.04" pace="0" />
        <SteadyState Duration="120" Power="0.96" pace="0" />
        <SteadyState Duration="60" Power="1.04" pace="0" />
        <SteadyState Duration="120" Power="0.96" pace="0" />
        <SteadyState Duration="60" Power="1.04" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="120" Power="0.96" pace="0" />
        <SteadyState Duration="60" Power="1.04" pace="0" />
        <SteadyState Duration="120" Power="0.96" pace="0" />
        <SteadyState Duration="60" Power="1.04" pace="0" />
        <SteadyState Duration="120" Power="0.96" pace="0" />
        <SteadyState Duration="60" Power="1.04" pace="0" />
        <Cooldown Duration="180" PowerLow="0.35" PowerHigh="0.55" pace="0" />
    </workout>
</workout_file>