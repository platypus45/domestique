<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 6x2min (36min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 6 x (2min @ 96% / 0s @ 55%) | Cooldown: 5min ramp from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="120" Power="0.96" pace="0" />
        <SteadyState Duration="60" Power="1.04" pace="0" />
        <SteadyState Duration="120" Power="0.96" pace="0" />
        <SteadyState Duration="60" Power="1.04" pace="0" />
        <SteadyState Duration="120" Power="0.96" pace="0" />
        <SteadyState Duration="60" Power="1.04" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="120" Power="0.96" pace="0" />
        <SteadyState Duration="60" Power="1.04" pace="0" />
        <SteadyState Duration="120" Power="0.96" pace="0" />
        <SteadyState Duration="60" Power="1.04" pace="0" />
        <SteadyState Duration="120" Power="0.96" pace="0" />
        <SteadyState Duration="60" Power="1.04" pace="0" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.40" /></workout>
</workout_file>