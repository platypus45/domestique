<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 6x2min (33min)</name>
    <description>Warmup: 5min from 40% to 105% FTP | Intervals: 6 x (2min @ 105% / 1min @ 90%) | Cooldown: 5min from 70% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.4" PowerHigh="1.05" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="60" OnPower="1.05" OffPower="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.51" pace="0" />
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="60" OnPower="1.05" OffPower="0.91" pace="0" />
        <Cooldown Duration="300" PowerLow="0.7" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>