<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 6x2min (36min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 6 x (2min @ 105% / 1min @ 90%) | Cooldown: 5min from 65% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="3" OnDuration="120" OffDuration="60" OnPower="1.05" OffPower="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.51" pace="0" />
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="60" OnPower="1.05" OffPower="0.91" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.40" pace="0" />
    </workout>
</workout_file>