<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 6x2min (90min)</name>
    <description>Warmup: 10min from 40% to 75% FTP | Intervals: 6 x (1min 30s @ 95% / 30s @ 70%) | Cooldown: 8min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="90" OnPower="1.0" OffPower="0.7" pace="0" Cadence="105" CadenceResting="95" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <IntervalsT Repeat="6" OnDuration="90" OffDuration="30" OnPower="0.95" OffPower="0.7" pace="0" Cadence="100" CadenceResting="90" />
        <SteadyState Duration="180" Power="0.5" pace="0" Cadence="90" />
        <SteadyState Duration="480" Power="0.85" pace="0" Cadence="100" />
        <SteadyState Duration="180" Power="0.5" pace="0" Cadence="90" />
        <IntervalsT Repeat="11" OnDuration="45" OffDuration="15" OnPower="0.95" OffPower="0.75" pace="0" Cadence="100" CadenceResting="90" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="480" Power="0.95" pace="0" Cadence="100" />
        <SteadyState Duration="180" Power="0.5" pace="0" Cadence="90" />
        <IntervalsT Repeat="8" OnDuration="60" OffDuration="30" OnPower="1.0" OffPower="0.8" pace="0" Cadence="105" CadenceResting="90" />
        <Cooldown Duration="480" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>