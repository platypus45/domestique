<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 6x3min (54min)</name>
    <description>Warmup: 7min from 25% to 75% FTP | Intervals: 6 x (3min @ 105% / 1min @ 28%) | Cooldown: 7min from 60% to 36% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="420" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="6" OnDuration="180" OffDuration="60" OnPower="1.05" OffPower="0.28" pace="0" />
        <SteadyState Duration="600" Power="0.65" pace="0" />
        <IntervalsT Repeat="2" OnDuration="15" OffDuration="180" OnPower="1.95" OffPower="0.5" pace="0" />
        <Cooldown Duration="420" PowerLow="0.6" PowerHigh="0.36" pace="0" />
    </workout>
</workout_file>