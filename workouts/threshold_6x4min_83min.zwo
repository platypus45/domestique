<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 6x4min (83min)</name>
    <description>Warmup: 15min from 25% to 85% FTP | Intervals: 6 x (4min @ 105% / 4min @ 50%) | Cooldown: 15min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.25" PowerHigh="0.85" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <IntervalsT Repeat="6" OnDuration="240" OffDuration="240" OnPower="1.05" OffPower="0.5" pace="0" />
        <Cooldown Duration="900" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>