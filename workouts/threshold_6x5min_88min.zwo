<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 6x5min (88min)</name>
    <description>Warmup: 10min from 50% to 65% FTP | Intervals: 6 x (5min @ 95% / 3min @ 50%) | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.65" pace="0" />
        <Ramp Duration="300" PowerLow="0.5" PowerHigh="1.0" pace="0" />
        <SteadyState Duration="120" Power="0.65" pace="0" />
        <SteadyState Duration="120" Power="0.81" pace="0" />
        <SteadyState Duration="60" Power="0.95" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="6" OnDuration="300" OffDuration="180" OnPower="0.95" OffPower="0.5" pace="0" />
        <SteadyState Duration="600" Power="0.65" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>