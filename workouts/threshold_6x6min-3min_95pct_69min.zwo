<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 6x6min (69min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 6 x (6min @ 95% / 3min @ 55%) | Cooldown: 5min from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="6" OnDuration="360" OffDuration="180" OnPower="0.95" OffPower="0.55" pace="0" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>