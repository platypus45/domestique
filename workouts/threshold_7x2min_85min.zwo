<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 7x2min (85min)</name>
    <description>Warmup: 10min from 50% to 75% FTP | Intervals: 7 x (2min @ 95% / 1min @ 55%) | Cooldown: 9min from 75% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="300" Power="0.75" pace="0" />
        <IntervalsT Repeat="7" OnDuration="120" OffDuration="60" OnPower="0.95" OffPower="0.55" pace="0" />
        <SteadyState Duration="360" Power="0.75" pace="0" />
        <SteadyState Duration="240" Power="0.9" pace="0" />
        <SteadyState Duration="360" Power="0.75" pace="0" />
        <SteadyState Duration="240" Power="0.95" pace="0" />
        <SteadyState Duration="360" Power="0.75" pace="0" />
        <SteadyState Duration="240" Power="1.0" pace="0" />
        <SteadyState Duration="360" Power="0.75" pace="0" />
        <SteadyState Duration="240" Power="1.05" pace="0" />
        <Cooldown Duration="540" PowerLow="0.75" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>