<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 7x6min (70min)</name>
    <description>Warmup: 3min from 45% to 75% FTP | Intervals: 7 x (6min @ 100% / 1min @ 50%) | Cooldown: 1min from 50% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="180" PowerLow="0.45" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="4" OnDuration="360" OffDuration="60" OnPower="1.0" OffPower="0.5" pace="0" Cadence="90" CadenceResting="90" />
        <IntervalsT Repeat="5" OnDuration="70" OffDuration="20" OnPower="1.21" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="360" OffDuration="60" OnPower="1.0" OffPower="0.5" pace="0" Cadence="110" CadenceResting="90" />
        <FreeRide Duration="60" FlatRoad="0" />
        <IntervalsT Repeat="3" OnDuration="12" OffDuration="168" OnPower="2.2" OffPower="0.5" pace="0" />
        <Cooldown Duration="60" PowerLow="0.5" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>