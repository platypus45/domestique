<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 8x2min (52min)</name>
    <description>Warmup: 10min from 37% to 73% FTP | Intervals: 8 x (2min @ 100% / 2min @ 52%) | Cooldown: 10min from 50% to 39% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.37" PowerHigh="0.73" pace="0" />
        <IntervalsT Repeat="8" OnDuration="120" OffDuration="120" OnPower="1.0" OffPower="0.52" pace="0" Cadence="65" CadenceResting="95" />
        <Cooldown Duration="600" PowerLow="0.5" PowerHigh="0.39" pace="0" />
    </workout>
</workout_file>