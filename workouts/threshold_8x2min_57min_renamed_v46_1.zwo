<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 8x2min (62min)</name>
    <description>Intervals: 8 x (2min @ 103% / 1min 30s @ 65%) | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="60" Power="0.81" pace="0" />
        <SteadyState Duration="60" Power="1.03" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="1.1" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="240" Power="0.85" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="1.1" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <IntervalsT Repeat="8" OnDuration="120" OffDuration="90" OnPower="1.03" OffPower="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
    </workout>
</workout_file>