<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 8x3min (56min)</name>
    <description>Intervals: 8 x (3min @ 98% / 1min @ 62%) | Cooldown: 5min from 75% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="60" OnPower="0.75" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="60" OnPower="0.9" OffPower="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="180" OffDuration="60" OnPower="0.98" OffPower="0.62" pace="0" />
        <SteadyState Duration="300" Power="0.56" pace="0" />
        <IntervalsT Repeat="4" OnDuration="180" OffDuration="60" OnPower="0.98" OffPower="0.62" pace="0" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>