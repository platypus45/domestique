<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 8x3min (67min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 8 x (3min @ 95% / 2min @ 80%) | Cooldown: 5min from 60% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="20" Power="0.95" pace="0" />
        <Ramp Duration="180" PowerLow="0.45" PowerHigh="0.6" pace="0" />
        <SteadyState Duration="20" Power="1.0" pace="0" />
        <Ramp Duration="180" PowerLow="0.6" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="20" Power="1.1" pace="0" />
        <IntervalsT Repeat="4" OnDuration="180" OffDuration="120" OnPower="0.95" OffPower="0.8" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="180" OffDuration="120" OnPower="0.95" OffPower="0.8" pace="0" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>