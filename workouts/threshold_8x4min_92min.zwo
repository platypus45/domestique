<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 8x4min (95min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 8 x (4min @ 102% / 4min @ 74%) | Cooldown: 10min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="30" Power="1.09" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.09" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="180" OffDuration="240" OnPower="0.8" OffPower="1.02" pace="0" Cadence="70" CadenceResting="70" />
        <SteadyState Duration="600" Power="0.4" pace="0" />
        <IntervalsT Repeat="4" OnDuration="180" OffDuration="240" OnPower="0.8" OffPower="1.02" pace="0" Cadence="70" CadenceResting="70" />
        <SteadyState Duration="600" Power="0.5" pace="0" />
    </workout>
</workout_file>