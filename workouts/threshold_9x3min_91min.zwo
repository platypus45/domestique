<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 9x3min (91min)</name>
    <description>Warmup: 10min from 50% to 65% FTP | Intervals: 9 x (3min @ 95% / 2min @ 81%) | Cooldown: 3min from 65% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.65" pace="0" />
        <Ramp Duration="300" PowerLow="0.5" PowerHigh="1.0" pace="0" />
        <SteadyState Duration="120" Power="0.65" pace="0" />
        <SteadyState Duration="120" Power="0.81" pace="0" />
        <SteadyState Duration="60" Power="0.95" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="180" OffDuration="120" OnPower="0.95" OffPower="0.81" pace="0" />
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="180" OffDuration="120" OnPower="0.95" OffPower="0.81" pace="0" />
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="180" OffDuration="120" OnPower="0.95" OffPower="0.81" pace="0" />
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <Cooldown Duration="180" PowerLow="0.65" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>