<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 3x6min (46min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 3 x (6min @ 100% / 4min @ 55%) | Cooldown: 6min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="3" OnDuration="360" OffDuration="240" OnPower="1" OffPower="0.55" pace="0" />
        <Cooldown Duration="360" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>