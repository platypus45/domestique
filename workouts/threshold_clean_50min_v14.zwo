<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 3x8min (54min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 3 x (8min @ 95% / 5min @ 55%) | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="3" OnDuration="480" OffDuration="300" OnPower="0.95" OffPower="0.55" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>