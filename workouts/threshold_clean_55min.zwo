<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 4x8min (55min)</name>
    <description>Warmup: 6min from 50% to 75% FTP | Intervals: 4 x (8min @ 95% / 3min @ 55%) | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="360" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="4" OnDuration="480" OffDuration="180" OnPower="0.95" OffPower="0.55" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>