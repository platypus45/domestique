<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 2x12min (55min)</name>
    <description>Warmup: 14min from 50% to 75% FTP | Intervals: 2 x (12min @ 100% / 4min @ 55%) | Cooldown: 9min from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="840" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="2" OnDuration="720" OffDuration="240" OnPower="1" OffPower="0.55" pace="0" />
        <Cooldown Duration="540" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>