<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 3x8min (55min)</name>
    <description>Warmup: 13min from 50% to 75% FTP | Intervals: 3 x (8min @ 95% / 3min @ 55%) | Cooldown: 9min from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="780" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="480" OffDuration="180" OnPower="0.95" OffPower="0.55" pace="0" />
        <Cooldown Duration="540" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>