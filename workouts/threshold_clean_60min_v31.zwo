<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 3x8min (60min)</name>
    <description>Warmup: 12min from 50% to 75% FTP | Intervals: 3 x (8min @ 95% / 5min @ 55%) | Cooldown: 8min 30s from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="750" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="480" OffDuration="300" OnPower="0.95" OffPower="0.55" pace="0" />
        <Cooldown Duration="510" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>