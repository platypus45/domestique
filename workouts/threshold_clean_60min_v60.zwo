<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 2x18min (61min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 2 x (18min @ 100% / 4min @ 55%) | Cooldown: 6min 30s from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="630" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="2" OnDuration="1080" OffDuration="240" OnPower="1" OffPower="0.55" pace="0" />
        <Cooldown Duration="390" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>