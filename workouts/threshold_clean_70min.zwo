<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 2x20min (70min)</name>
    <description>Warmup: 14min from 50% to 75% FTP | Intervals: 2 x (20min @ 95% / 3min @ 55%) | Cooldown: 9min 30s from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="870" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="2" OnDuration="1200" OffDuration="180" OnPower="0.95" OffPower="0.55" pace="0" />
        <Cooldown Duration="570" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>