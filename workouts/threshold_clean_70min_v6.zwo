<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 3x15min (70min)</name>
    <description>Warmup: 5min from 50% to 75% FTP | Intervals: 3 x (15min @ 95% / 5min @ 55%) | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="900" OffDuration="300" OnPower="0.95" OffPower="0.55" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>