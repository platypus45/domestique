<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 2x25min (76min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 2 x (25min @ 100% / 5min @ 55%) | Cooldown: 6min from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="2" OnDuration="1500" OffDuration="300" OnPower="1" OffPower="0.55" pace="0" />
        <Cooldown Duration="360" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>