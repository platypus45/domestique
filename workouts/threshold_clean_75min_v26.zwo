<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 6x6min (75min)</name>
    <description>Warmup: 12min from 50% to 75% FTP | Intervals: 6 x (6min @ 100% / 3min @ 55%) | Cooldown: 8min 30s from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="750" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="6" OnDuration="360" OffDuration="180" OnPower="1" OffPower="0.55" pace="0" />
        <Cooldown Duration="510" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>