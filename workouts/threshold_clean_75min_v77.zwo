<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 2x25min (75min)</name>
    <description>Warmup: 11min from 50% to 75% FTP | Intervals: 2 x (25min @ 100% / 3min @ 55%) | Cooldown: 7min 30s from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="690" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="2" OnDuration="1500" OffDuration="180" OnPower="1" OffPower="0.55" pace="0" />
        <Cooldown Duration="450" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>