<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 6x6min (82min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 6 x (6min @ 95% / 5min @ 55%) | Cooldown: 5min 30s from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="630" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="6" OnDuration="360" OffDuration="300" OnPower="0.95" OffPower="0.55" pace="0" />
        <Cooldown Duration="330" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>