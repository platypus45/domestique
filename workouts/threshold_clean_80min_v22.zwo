<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 6x6min (80min)</name>
    <description>Warmup: 8min 30s from 50% to 75% FTP | Intervals: 6 x (6min @ 100% / 5min @ 55%) | Cooldown: 5min 30s from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="510" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="6" OnDuration="360" OffDuration="300" OnPower="1" OffPower="0.55" pace="0" />
        <Cooldown Duration="330" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>