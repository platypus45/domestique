<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 3x18min (85min)</name>
    <description>Warmup: 11min from 50% to 75% FTP | Intervals: 3 x (18min @ 97% / 4min @ 55%) | Cooldown: 7min 30s from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="690" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="1080" OffDuration="240" OnPower="0.97" OffPower="0.55" pace="0" />
        <Cooldown Duration="450" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>