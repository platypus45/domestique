<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 3x20min (90min)</name>
    <description>Warmup: 9min from 50% to 75% FTP | Intervals: 3 x (20min @ 95% / 5min @ 55%) | Cooldown: 6min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="540" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="1200" OffDuration="300" OnPower="0.95" OffPower="0.55" pace="0" />
        <Cooldown Duration="360" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>