    <workout>
        <Warmup Duration="870" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="6" OnDuration="360" OffDuration="300" OnPower="0.95" OffPower="0.55" pace="0" />
        <Cooldown Duration="570" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>