<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 6x6min (90min)</name>
    <description>Warmup: 14min from 50% to 75% FTP | Intervals: 6 x (6min @ 95% / 5min @ 55%) | Cooldown: 9min 30s from 65% to 45% FTP</description>
