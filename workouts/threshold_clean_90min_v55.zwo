<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 6x8min (90min)</name>
    <description>Warmup: 11min from 50% to 75% FTP | Intervals: 6 x (8min @ 97% / 4min @ 55%) | Cooldown: 7min from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="660" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="6" OnDuration="480" OffDuration="240" OnPower="0.97" OffPower="0.55" pace="0" />
        <Cooldown Duration="420" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>