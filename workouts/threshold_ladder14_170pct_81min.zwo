<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 6 cycles (81min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Over-Under: 6 cycles (alternating above/below threshold) | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
