<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (74min)</name>
    <description>Warmup: 20min from 55% to 80% FTP | Steady: 12min @ 95% FTP | Steady: 3min 15s @ 55% FTP | Steady: 10min @ 95% FTP | Steady: 3min @ 55% FTP | Steady: 8min @ 95% FTP | Steady: 2min 30s @ 55% FTP | Steady: 15min @ 65% FTP</description>
