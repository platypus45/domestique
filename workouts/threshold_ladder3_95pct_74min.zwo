        <SteadyState Duration="600" Power="0.95" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="480" Power="0.95" pace="0" />
        <SteadyState Duration="150" Power="0.55" pace="0" />
        <Ramp Duration="600" PowerLow="0.75" PowerHigh="0.55" pace="0" />
