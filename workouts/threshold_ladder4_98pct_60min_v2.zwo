<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (60min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Steady: 10min @ 90% FTP | Steady: 10min @ 92% FTP | Steady: 10min @ 95% FTP | Steady: 10min @ 98% FTP | Cooldown: 10min from 60% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="600" Power="0.9" pace="0" />
        <SteadyState Duration="600" Power="0.92" pace="0" />
        <SteadyState Duration="600" Power="0.95" pace="0" />
        <SteadyState Duration="600" Power="0.98" pace="0" />
        <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>