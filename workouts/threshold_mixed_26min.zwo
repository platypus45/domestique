<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (28min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Steady: 1min @ 105% FTP | Steady: 1min @ 55% FTP | Steady: 2min @ 105% FTP | Steady: 1min @ 55% FTP | Steady: 3min @ 105% FTP | Steady: 1min @ 55% FTP | Steady: 2min @ 105% FTP | Steady: 1min @ 55% FTP | Steady: 1min @ 105% FTP | Cooldown: 5min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="60" Power="1.05" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <SteadyState Duration="120" Power="1.05" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <SteadyState Duration="180" Power="1.05" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <SteadyState Duration="120" Power="1.05" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <SteadyState Duration="60" Power="1.05" pace="0" />
        <Cooldown Duration="300" PowerLow="0.6" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>