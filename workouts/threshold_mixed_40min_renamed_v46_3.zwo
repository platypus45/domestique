<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (42min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Steady: 3min @ 95% FTP | Steady: 2min @ 60% FTP | Steady: 4min @ 95% FTP | Steady: 2min @ 60% FTP | Steady: 5min @ 95% FTP | Steady: 2min @ 60% FTP | Steady: 4min @ 95% FTP | Steady: 2min @ 60% FTP | Steady: 3min @ 95% FTP | Cooldown: 5min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="180" Power="0.95" pace="0" />
        <SteadyState Duration="120" Power="0.6" pace="0" />
        <SteadyState Duration="240" Power="0.95" pace="0" />
        <SteadyState Duration="120" Power="0.6" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <SteadyState Duration="120" Power="0.6" pace="0" />
        <SteadyState Duration="240" Power="0.95" pace="0" />
        <SteadyState Duration="120" Power="0.6" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <Cooldown Duration="300" PowerLow="0.6" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>