<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (63min)</name>
    <description>Steady: 2min @ 50% FTP | Steady: 2min @ 60% FTP | Steady: 2min @ 70% FTP | Steady: 1min @ 90% FTP | Steady: 4min @ 65% FTP | Steady: 1min @ 60% FTP | Steady: 30s @ 250% FTP | Steady: 5min @ 65% FTP | Steady: 1min @ 200% FTP | Steady: 5min @ 65% FTP | Steady: 10min @ 95% FTP | Steady: 5min @ 65% FTP | Steady: 15min @ 105% FTP | Cooldown: 5min from 45% to 65% FTP</description>
