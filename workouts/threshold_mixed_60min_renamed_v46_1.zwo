<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (65min)</name>
    <description>Warmup: 20min from 25% to 75% FTP | Steady: 20min @ 80% FTP | Steady: 20min @ 95% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="1200" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="1200" Power="0.8" pace="0" />
        <SteadyState Duration="1200" Power="0.95" pace="0" />
    <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.4" /></workout>
</workout_file>