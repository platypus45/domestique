<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (60min)</name>
    <description>Warmup: 10min from 50% to 80% FTP | Steady: 1min @ 88% FTP | Steady: 2min @ 55% FTP | Steady: 5min @ 105% FTP | Steady: 1min 30s @ 55% FTP | Steady: 5min @ 100% FTP | Steady: 1min 30s @ 55% FTP | Steady: 5min @ 95% FTP | Steady: 6min @ 55% FTP | Steady: 5min @ 95% FTP | Steady: 1min 30s @ 55% FTP | Steady: 5min @ 100% FTP | Steady: 1min 30s @ 55% FTP | Steady: 5min @ 105% FTP | Cooldown: 5min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.8" pace="0" />
        <Ramp Duration="60" PowerLow="0.8" PowerHigh="0.95" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="300" Power="1.05" pace="0" />
        <SteadyState Duration="90" Power="0.55" pace="0" />
        <SteadyState Duration="300" Power="1.0" pace="0" />
        <SteadyState Duration="90" Power="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <SteadyState Duration="360" Power="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <SteadyState Duration="90" Power="0.55" pace="0" />
        <SteadyState Duration="300" Power="1.0" pace="0" />
        <SteadyState Duration="90" Power="0.55" pace="0" />
        <SteadyState Duration="300" Power="1.05" pace="0" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45" pace="0" />
