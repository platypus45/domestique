<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (64min)</name>
    <description>Warmup: 3min from 45% to 60% FTP | Steady: 1min @ 60% FTP | Steady: 1min @ 65% FTP | Steady: 1min @ 81% FTP | Steady: 1min @ 109% FTP | Steady: 2min @ 50% FTP | Steady: 4min @ 90% FTP | Steady: 3min @ 50% FTP | Steady: 9min @ 104% FTP | Steady: 2min 15s @ 50% FTP | Steady: 9min @ 99% FTP | Steady: 2min 15s @ 50% FTP | Steady: 9min @ 94% FTP | Steady: 2min 15s @ 50% FTP | Steady: 9min @ 90% FTP | Cooldown: 5min from 70% to 45% FTP</description>
