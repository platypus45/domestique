<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (71min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Steady: 1min @ 75% FTP | Steady: 1min @ 50% FTP | Steady: 1min @ 75% FTP | Steady: 1min @ 50% FTP | Steady: 1min @ 75% FTP | Steady: 1min @ 50% FTP | Steady: 20min @ 100% FTP | Steady: 5min @ 75% FTP | Steady: 20min @ 100% FTP | Cooldown: 10min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="0.75" OffPower="0.5" pace="0" />
        <SteadyState Duration="1200" Power="1.0" pace="0" />
        <SteadyState Duration="300" Power="0.75" pace="0" />
        <SteadyState Duration="1200" Power="1.0" pace="0" />
        <Cooldown Duration="600" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>