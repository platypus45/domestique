<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (82min)</name>
    <description>Warmup: 20min from 35% to 85% FTP | Steady: 5min @ 40% FTP | Steady: 16min @ 100% FTP | Steady: 10min @ 40% FTP | Steady: 16min @ 100% FTP | Cooldown: 15min from 60% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="1200" PowerLow="0.35" PowerHigh="0.85" pace="0" />
        <SteadyState Duration="300" Power="0.4" pace="0" />
        <SteadyState Duration="960" Power="1.0" pace="0" />
        <SteadyState Duration="600" Power="0.4" pace="0" />
        <SteadyState Duration="960" Power="1.0" pace="0" />
        <Cooldown Duration="900" PowerLow="0.60" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>