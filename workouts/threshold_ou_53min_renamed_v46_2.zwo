<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 3 cycles (58min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Over-Under: 3 cycles (alternating above/below threshold) | Cooldown: 5min from 65% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="420" Power="0.95" pace="0" Cadence="55" />
        <SteadyState Duration="60" Power="0.87" pace="0" Cadence="90" />
        <SteadyState Duration="300" Power="1.05" pace="0" Cadence="90" />
        <SteadyState Duration="60" Power="0.87" pace="0" Cadence="90" />
        <SteadyState Duration="180" Power="0.95" pace="0" Cadence="110" />
        <SteadyState Duration="60" Power="0.87" pace="0" Cadence="90" />
        <SteadyState Duration="60" Power="0.4" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" Cadence="110" />
        <SteadyState Duration="60" Power="0.87" pace="0" Cadence="90" />
        <SteadyState Duration="300" Power="1.05" pace="0" Cadence="90" />
        <SteadyState Duration="60" Power="0.87" pace="0" Cadence="90" />
        <SteadyState Duration="420" Power="0.95" pace="0" Cadence="55" />
        <SteadyState Duration="60" Power="0.87" pace="0" Cadence="90" />
        <SteadyState Duration="60" Power="0.4" pace="0" />
        <SteadyState Duration="300" Power="1.05" pace="0" Cadence="110" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>