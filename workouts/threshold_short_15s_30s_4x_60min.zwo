<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 2min/1min 12x (65min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 12 x (1min 30s @ 105% / 1min @ 50%) | Cooldown: 6min from 65% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="4" OnDuration="15" OffDuration="30" OnPower="1.2" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.65" pace="0" />
        <IntervalsT Repeat="12" OnDuration="90" OffDuration="60" OnPower="1.05" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.65" pace="0" />
        <SteadyState Duration="720" Power="0.89" pace="0" />
        <Cooldown Duration="360" PowerLow="0.65" PowerHigh="0.40" pace="0" />
    </workout>
</workout_file>