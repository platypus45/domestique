<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 3x3min (37min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 3 x (3min @ 95% / 3min @ 55%) | Cooldown: 5min ramp from 55% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="4" OnDuration="15" OffDuration="45" OnPower="1.15" OffPower="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="180" OffDuration="180" OnPower="0.95" OffPower="0.55" pace="0" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.40" /></workout>
</workout_file>