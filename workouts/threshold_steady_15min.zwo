<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery (17min)</name>
    <description>Warmup: 6min @ 50% FTP | Steady: 1min @ 61% FTP | Steady: 5min @ 72% FTP | Steady: 1min @ 84% FTP | Steady: 2min @ 96% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <Ramp Duration="60" PowerLow="0.5" PowerHigh="0.72" pace="0" />
        <SteadyState Duration="300" Power="0.72" pace="0" />
        <Ramp Duration="60" PowerLow="0.72" PowerHigh="0.96" pace="0" />
        <SteadyState Duration="120" Power="0.96" pace="0" />
    <Cooldown Duration="120" PowerLow="0.7" PowerHigh="0.4" /></workout>
</workout_file>