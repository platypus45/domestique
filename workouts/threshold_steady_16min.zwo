<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery (16min)</name>
    <description>Warmup: 9min from 50% to 65% FTP | Steady: 3min @ 97% FTP | Steady: 2min @ 55% FTP | Cooldown: 2min from 50% to 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="540" PowerLow="0.5" PowerHigh="0.65" pace="0" />
        <Ramp Duration="180" PowerLow="0.94" PowerHigh="1" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <Cooldown Duration="120" PowerLow="0.5" PowerHigh="0.55" pace="0" />
    </workout>
</workout_file>