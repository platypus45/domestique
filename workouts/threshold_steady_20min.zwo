<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 5 cycles (20min)</name>
    <description>Warmup: 5min from 50% to 75% FTP | Over-Under: 5 cycles (alternating above/below threshold) | Cooldown: 2min 30s from 50% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.5" PowerHigh="0.75" pace="0" Cadence="85" />
        <SteadyState Duration="60" Power="0.9" pace="0" Cadence="90" />
        <SteadyState Duration="30" Power="1.1" pace="0" Cadence="100" />
        <SteadyState Duration="120" Power="0.9" pace="0" Cadence="90" />
        <SteadyState Duration="30" Power="1.2" pace="0" Cadence="100" />
        <SteadyState Duration="120" Power="0.9" pace="0" Cadence="90" />
        <SteadyState Duration="30" Power="1.3" pace="0" Cadence="100" />
        <SteadyState Duration="120" Power="0.9" pace="0" Cadence="90" />
        <SteadyState Duration="30" Power="1.2" pace="0" Cadence="100" />
        <SteadyState Duration="120" Power="0.9" pace="0" Cadence="90" />
        <SteadyState Duration="30" Power="1.1" pace="0" Cadence="100" />
        <SteadyState Duration="60" Power="0.9" pace="0" Cadence="90" />
        <Cooldown Duration="150" PowerLow="0.5" PowerHigh="0.3" pace="0" Cadence="85" />
    </workout>
</workout_file>