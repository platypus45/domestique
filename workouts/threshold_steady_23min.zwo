<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance Steady (23min)</name>
    <description>Warmup: 8min from 39% to 75% FTP | Steady: 10min @ 80% FTP | Cooldown: 5min from 65% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.39" PowerHigh="0.75" pace="0" />
        <Ramp Duration="600" PowerLow="0.66" PowerHigh="0.95" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>