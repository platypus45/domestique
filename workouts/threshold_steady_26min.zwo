<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery Steady (26min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Steady: 10min @ 78% FTP | Cooldown: 6min from 70% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <Ramp Duration="300" PowerLow="0.5" PowerHigh="1.05" pace="0" />
        <Ramp Duration="300" PowerLow="1.05" PowerHigh="0.5" pace="0" />
        <Cooldown Duration="360" PowerLow="0.7" PowerHigh="0.3" pace="0" />
    </workout>
</workout_file>