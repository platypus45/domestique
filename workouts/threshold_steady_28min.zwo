<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (43min)</name>
    <description>Steady: 8min @ 100% FTP | Steady: 4min @ 65% FTP | Steady: 16min @ 100% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="480" Power="1" pace="0" />
        <SteadyState Duration="240" Power="0.65" pace="0" />
        <SteadyState Duration="480" Power="1" pace="0" />
        <SteadyState Duration="480" Power="1" pace="0" />
    <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.40" /></workout>
</workout_file>