<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo (33min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Steady: 6min @ 87% FTP | Steady: 3min @ 94% FTP | Steady: 3min @ 50% FTP | Steady: 6min @ 87% FTP | Steady: 3min @ 94% FTP | Cooldown: 4min from 70% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="360" Power="0.87" pace="0" />
        <Ramp Duration="180" PowerLow="0.87" PowerHigh="1" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="360" Power="0.87" pace="0" />
        <Ramp Duration="180" PowerLow="0.87" PowerHigh="1" pace="0" />
        <Cooldown Duration="240" PowerLow="0.7" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>