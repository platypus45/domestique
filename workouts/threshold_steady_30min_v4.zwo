<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot Steady (30min)</name>
    <description>Warmup: 15min from 58% to 75% FTP | Steady: 10min @ 91% FTP | Cooldown: 5min from 65% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.58" PowerHigh="0.75" pace="0" />
        <Ramp Duration="600" PowerLow="0.87" PowerHigh="0.95" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>