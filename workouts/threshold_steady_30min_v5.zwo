<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (34min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Steady: 20s @ 81% FTP | Steady: 20s @ 95% FTP | Steady: 20s @ 81% FTP | Steady: 4min @ 62% FTP | Steady: 2min @ 65% FTP | Steady: 10min @ 90% FTP | Cooldown: 9min from 60% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="20" Power="0.81" pace="0" />
        <SteadyState Duration="20" Power="0.95" pace="0" />
        <SteadyState Duration="20" Power="0.81" pace="0" />
        <Ramp Duration="240" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.65" pace="0" />
        <SteadyState Duration="600" Power="0.9" pace="0" />
        <Cooldown Duration="540" PowerLow="0.60" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>