<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance 3x30s (32min)</name>
    <description>Warmup: 5min from 55% to 75% FTP | Intervals: 3 x (30s @ 126% / 0s @ 55%) | Cooldown: 5min from 35% to 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.55" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <Ramp Duration="30" PowerLow="1.5" PowerHigh="1.02" pace="0" />
        <SteadyState Duration="180" Power="1.02" pace="0" />
        <SteadyState Duration="240" Power="0.55" pace="0" />
        <Ramp Duration="30" PowerLow="1.5" PowerHigh="1.02" pace="0" />
        <SteadyState Duration="180" Power="1.02" pace="0" />
        <SteadyState Duration="240" Power="0.55" pace="0" />
        <Ramp Duration="30" PowerLow="1.5" PowerHigh="1.02" pace="0" />
        <SteadyState Duration="180" Power="1.02" pace="0" />
        <Cooldown Duration="300" PowerLow="0.35" PowerHigh="0.55" pace="0" />
    </workout>
</workout_file>