<workout_file>
    <author>Domestique Library</author>
    <name>Mixed (32min)</name>
    <description>Steady: 3min @ 50% FTP | Steady: 3min @ 70% FTP | Steady: 2min @ 50% FTP | Steady: 5min @ 85% FTP | Steady: 3min @ 50% FTP | Steady: 4min @ 100% FTP | Steady: 5min @ 50% FTP | Steady: 4min @ 100% FTP | Steady: 3min @ 50% FTP</description>
