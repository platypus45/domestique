<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (36min)</name>
    <description>Steady: 3min @ 50% FTP | Steady: 3min @ 70% FTP | Steady: 2min @ 50% FTP | Steady: 5min @ 85% FTP | Steady: 3min @ 50% FTP | Steady: 4min @ 100% FTP | Steady: 5min @ 50% FTP | Steady: 4min @ 100% FTP | Steady: 3min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="300" Power="0.85" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <Ramp Duration="240" PowerLow="0.95" PowerHigh="1.04" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <Ramp Duration="240" PowerLow="0.95" PowerHigh="1.05" pace="0" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.4" /></workout>
</workout_file>