<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (34min)</name>
    <description>Warmup: 10min from 40% to 75% FTP | Steady: 1min @ 81% FTP | Steady: 1min @ 95% FTP | Steady: 2min @ 105% FTP | Steady: 1min @ 95% FTP | Steady: 1min @ 81% FTP | Steady: 8min @ 90% FTP | Cooldown: 10min from 45% to 65% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="60" Power="0.81" pace="0" />
        <SteadyState Duration="60" Power="0.95" pace="0" />
        <SteadyState Duration="120" Power="1.05" pace="0" />
        <SteadyState Duration="60" Power="0.95" pace="0" />
        <SteadyState Duration="60" Power="0.81" pace="0" />
        <SteadyState Duration="480" Power="0.9" pace="0" />
        <Cooldown Duration="600" PowerLow="0.45" PowerHigh="0.65" pace="0" />
    </workout>
</workout_file>