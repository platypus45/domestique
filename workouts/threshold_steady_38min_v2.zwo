<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery (38min)</name>
    <description>Warmup: 5min from 45% to 75% FTP | Steady: 1min @ 50% FTP | Steady: 3min @ 85% FTP | Steady: 1min @ 50% FTP | Steady: 1min @ 102% FTP | Steady: 15min @ 50% FTP | Steady: 3min @ 63% FTP | Steady: 3min @ 50% FTP | Cooldown: 6min from 63% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.45" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.85" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="1.02" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.63" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <Cooldown Duration="360" PowerLow="0.63" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>