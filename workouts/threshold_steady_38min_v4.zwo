<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (41min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Steady: 5min @ 100% FTP | Steady: 1min @ 50% FTP | Steady: 10min @ 95% FTP | Steady: 10min @ 50% FTP | Cooldown: 5min from 25% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="300" Power="1" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="600" Power="0.95" pace="0" />
        <SteadyState Duration="600" Power="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.25" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>