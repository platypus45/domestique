<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (43min)</name>
    <description>Warmup: 6min @ 50% FTP | Steady: 6min @ 92% FTP | Steady: 5min @ 50% FTP | Steady: 6min @ 92% FTP | Steady: 5min @ 50% FTP | Steady: 5min @ 95% FTP | Cooldown: 10min from 50% to 75% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.92" pace="0" />
        <SteadyState Duration="120" Power="0.92" pace="0" />
        <SteadyState Duration="120" Power="0.92" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.92" pace="0" />
        <SteadyState Duration="120" Power="0.92" pace="0" />
        <SteadyState Duration="120" Power="0.92" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <Cooldown Duration="600" PowerLow="0.5" PowerHigh="0.75" pace="0" />
    </workout>
</workout_file>