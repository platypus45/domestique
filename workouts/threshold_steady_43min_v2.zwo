<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (45min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Steady: 6min @ 92% FTP | Steady: 5min @ 50% FTP | Steady: 6min @ 92% FTP | Steady: 5min @ 50% FTP | Steady: 5min @ 95% FTP | Cooldown: 10min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="120" Power="0.92" pace="0" />
        <SteadyState Duration="120" Power="0.92" pace="0" />
        <SteadyState Duration="120" Power="0.92" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.92" pace="0" />
        <SteadyState Duration="120" Power="0.92" pace="0" />
        <SteadyState Duration="120" Power="0.92" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" />
        <Cooldown Duration="600" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>