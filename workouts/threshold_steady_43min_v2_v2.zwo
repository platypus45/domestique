<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (43min)</name>
    <description>Warmup: 10min from 40% to 96% FTP | Steady: 1min @ 50% FTP | Steady: 10s @ 125% FTP | Steady: 3min @ 40% FTP | Steady: 8min @ 95% FTP | Steady: 2min @ 45% FTP | Steady: 6min @ 100% FTP | Steady: 2min @ 45% FTP | Steady: 4min @ 105% FTP | Steady: 2min @ 45% FTP | Steady: 2min @ 110% FTP | Cooldown: 3min from 30% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.96" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="10" Power="1.25" pace="0" />
        <SteadyState Duration="180" Power="0.4" pace="0" />
        <SteadyState Duration="480" Power="0.95" pace="0" />
        <SteadyState Duration="120" Power="0.45" pace="0" />
        <SteadyState Duration="360" Power="1" pace="0" />
        <SteadyState Duration="120" Power="0.45" pace="0" />
        <SteadyState Duration="240" Power="1.05" pace="0" />
        <SteadyState Duration="120" Power="0.45" pace="0" />
        <SteadyState Duration="120" Power="1.1" pace="0" />
        <Cooldown Duration="180" PowerLow="0.3" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>