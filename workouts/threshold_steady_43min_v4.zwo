<workout_file>
    <author>Domestique Library</author>
    <name>Mixed (47min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Steady: 5min @ 85% FTP | Steady: 3min @ 97% FTP | Steady: 1min @ 105% FTP | Steady: 2min @ 60% FTP | Steady: 5min @ 85% FTP | Steady: 3min @ 95% FTP | Steady: 1min @ 105% FTP | Steady: 2min @ 65% FTP | Steady: 5min @ 90% FTP | Steady: 2min @ 50% FTP | Steady: 3min @ 90% FTP | Cooldown: 5min from 65% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="300" Power="0.85" pace="0" />
