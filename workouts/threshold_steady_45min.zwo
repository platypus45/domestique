<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (45min)</name>
    <description>Warmup: 5min from 30% to 70% FTP | Steady: 20s @ 90% FTP | Steady: 20s @ 110% FTP | Steady: 20s @ 130% FTP | Steady: 3min @ 60% FTP | Steady: 3min @ 110% FTP | Steady: 2min @ 120% FTP | Steady: 6min @ 55% FTP | Steady: 20min @ 65% FTP | Cooldown: 5min from 50% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.3" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="20" Power="0.9" pace="0" />
        <SteadyState Duration="20" Power="1.1" pace="0" />
        <SteadyState Duration="20" Power="1.3" pace="0" />
        <SteadyState Duration="180" Power="0.6" pace="0" />
        <SteadyState Duration="180" Power="1.1" pace="0" />
        <SteadyState Duration="120" Power="1.2" pace="0" />
        <SteadyState Duration="360" Power="0.55" pace="0" />
        <FreeRide Duration="1200" FlatRoad="0" />
        <Cooldown Duration="300" PowerLow="0.5" PowerHigh="0.3" pace="0" />
    </workout>
</workout_file>