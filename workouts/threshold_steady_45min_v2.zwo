<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (45min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Steady: 8min @ 90% FTP | Steady: 9min @ 55% FTP | Steady: 8min @ 90% FTP | Cooldown: 10min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="480" Power="0.9" pace="0" />
        <SteadyState Duration="540" Power="0.55" pace="0" />
        <SteadyState Duration="480" Power="0.9" pace="0" />
        <Cooldown Duration="600" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>