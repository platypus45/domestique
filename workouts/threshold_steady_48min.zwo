<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (48min)</name>
    <description>Warmup: 10min from 50% to 65% FTP | Steady: 5min @ 75% FTP | Steady: 2min @ 65% FTP | Steady: 2min @ 81% FTP | Steady: 1min @ 95% FTP | Steady: 23min @ 50% FTP | Cooldown: 5min from 50% to 65% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.65" pace="0" />
        <Ramp Duration="300" PowerLow="0.5" PowerHigh="1" pace="0" />
        <SteadyState Duration="120" Power="0.65" pace="0" />
        <SteadyState Duration="120" Power="0.81" pace="0" />
        <SteadyState Duration="60" Power="0.95" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.5" PowerHigh="0.65" pace="0" />
    </workout>
</workout_file>