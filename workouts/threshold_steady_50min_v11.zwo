<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance Steady (50min)</name>
    <description>Warmup: 6min from 40% to 75% FTP | Steady: 37min @ 75% FTP | Cooldown: 7min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="360" PowerLow="0.4" PowerHigh="0.75" pace="0" />
        <Ramp Duration="1200" PowerLow="0.5" PowerHigh="1" pace="0" />
        <Ramp Duration="900" PowerLow="1" PowerHigh="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.75" pace="0" />
        <Cooldown Duration="420" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>