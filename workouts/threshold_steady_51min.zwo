<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance 3 cycles (51min)</name>
    <description>Warmup: 10min from 40% to 75% FTP | Over-Under: 3 cycles (alternating above/below threshold) | Cooldown: 5min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="20" Power="0.9" pace="0" />
        <SteadyState Duration="20" Power="1.1" pace="0" />
        <SteadyState Duration="20" Power="1.3" pace="0" />
        <SteadyState Duration="20" Power="0.9" pace="0" />
        <SteadyState Duration="20" Power="1.1" pace="0" />
        <SteadyState Duration="20" Power="1.3" pace="0" />
        <SteadyState Duration="20" Power="0.9" pace="0" />
        <SteadyState Duration="20" Power="1.1" pace="0" />
        <SteadyState Duration="20" Power="1.3" pace="0" />
        <SteadyState Duration="180" Power="0.6" pace="0" />
        <SteadyState Duration="300" Power="1.1" pace="0" />
        <SteadyState Duration="300" Power="0.6" pace="0" />
        <FreeRide Duration="1200" FlatRoad="0" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>