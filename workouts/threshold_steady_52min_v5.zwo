<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (52min)</name>
    <description>Warmup: 15min from 50% to 75% FTP | Steady: 16min @ 50% FTP | Steady: 4min @ 95% FTP | Steady: 4min @ 55% FTP | Steady: 3min @ 95% FTP | Steady: 3min @ 55% FTP | Steady: 2min @ 95% FTP | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="600" Power="0.5" pace="0" />
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <SteadyState Duration="240" Power="0.95" pace="0" />
        <SteadyState Duration="240" Power="0.55" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="120" Power="0.95" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>