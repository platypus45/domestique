<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (53min)</name>
    <description>Steady: 4min @ 50% FTP | Steady: 3min @ 70% FTP | Steady: 2min @ 50% FTP | Steady: 5min @ 90% FTP | Steady: 3min @ 50% FTP | Steady: 6min @ 86% FTP | Steady: 5min @ 92% FTP | Steady: 3min @ 50% FTP | Steady: 12min @ 90% FTP | Steady: 5min @ 92% FTP | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.7" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
