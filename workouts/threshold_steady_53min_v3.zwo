<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (53min)</name>
    <description>Warmup: 20min from 55% to 80% FTP | Steady: 8min @ 95% FTP | Steady: 2min @ 55% FTP | Steady: 6min @ 95% FTP | Steady: 2min @ 50% FTP | Steady: 4min @ 95% FTP | Steady: 1min @ 50% FTP | Cooldown: 10min from 75% to 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="1200" PowerLow="0.55" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="480" Power="0.95" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="360" Power="0.95" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="240" Power="0.95" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <Cooldown Duration="600" PowerLow="0.75" PowerHigh="0.55" pace="0" />
    </workout>
</workout_file>