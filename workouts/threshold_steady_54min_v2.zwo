<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Tempo 6x1min (54min)</name>
    <description>Warmup: 10min from 40% to 75% FTP | Intervals: 6 x (1min @ 95% / 3min @ 80%) | Cooldown: 6min from 25% to 50% FTP</description>
