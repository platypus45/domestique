        <SteadyState Duration="180" Power="0.8" pace="0" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.8" pace="0" />
        <Ramp Duration="60" PowerLow="0.9" PowerHigh="1" pace="0" />
        <Ramp Duration="60" PowerLow="1" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.8" pace="0" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.8" pace="0" />
        <Ramp Duration="60" PowerLow="0.9" PowerHigh="1" pace="0" />
        <Ramp Duration="60" PowerLow="1" PowerHigh="0.9" pace="0" />
