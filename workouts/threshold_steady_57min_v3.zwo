<workout_file>
    <author>Domestique Library</author>
    <name>Threshold 6x1min (62min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 6 x (1min @ 100% / 1min @ 55%) | Cooldown: 5min ramp from 65% to 40% FTP</description>
