<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Threshold (59min)</name>
    <description>Warmup: 20min from 55% to 80% FTP | Steady: 8min @ 95% FTP | Steady: 2min 30s @ 55% FTP | Steady: 6min @ 95% FTP | Steady: 2min @ 50% FTP | Steady: 4min @ 95% FTP | Steady: 1min 30s @ 50% FTP | Steady: 15min @ 65% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="1200" PowerLow="0.55" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="480" Power="0.95" pace="0" />
        <SteadyState Duration="150" Power="0.55" pace="0" />
        <SteadyState Duration="360" Power="0.95" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="240" Power="0.95" pace="0" />
        <SteadyState Duration="90" Power="0.5" pace="0" />
        <Ramp Duration="600" PowerLow="0.55" PowerHigh="0.75" pace="0" />
        <FreeRide Duration="300" FlatRoad="0" />
    </workout>
</workout_file>