<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max (20min)</name>
    <description>Warmup: 5min from 50% to 75% FTP | Steady: 2min @ 82% FTP | Steady: 1min @ 95% FTP | Steady: 2min @ 50% FTP | Steady: 5min @ 110% FTP | Cooldown: 5min from 50% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <Ramp Duration="120" PowerLow="0.75" PowerHigh="0.9" pace="0" />
        <Ramp Duration="60" PowerLow="0.9" PowerHigh="1" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="1.1" pace="0" />
        <Cooldown Duration="300" PowerLow="0.5" PowerHigh="0.3" pace="0" />
    </workout>
</workout_file>