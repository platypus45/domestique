<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (28min)</name>
    <description>Warmup: 4min from 40% to 50% FTP | Steady: 4min @ 55% FTP | Steady: 4min @ 65% FTP | Steady: 4min @ 75% FTP | Steady: 2min @ 55% FTP | Steady: 3min @ 110% FTP | Steady: 2min @ 55% FTP | Steady: 1min @ 115% FTP | Steady: 2min @ 55% FTP | Cooldown: 2min from 25% to 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="240" PowerLow="0.4" PowerHigh="0.5" pace="0" />
        <Ramp Duration="240" PowerLow="0.5" PowerHigh="0.6" pace="0" />
        <Ramp Duration="240" PowerLow="0.6" PowerHigh="0.7" pace="0" />
        <Ramp Duration="240" PowerLow="0.7" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="180" Power="1.1" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="60" Power="1.15" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <Cooldown Duration="120" PowerLow="0.25" PowerHigh="0.55" pace="0" />
    </workout>
</workout_file>