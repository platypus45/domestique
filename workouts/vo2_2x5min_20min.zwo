    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="300" Power="1.1" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <SteadyState Duration="300" Power="1.1" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
    </workout>
</workout_file>