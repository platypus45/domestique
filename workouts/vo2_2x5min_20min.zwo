<workout_file>
    <author>Domestique Library</author>
    <name>VO2max (30min)</name>
    <description>Steady: 5min @ 110% FTP | Steady: 5min @ 55% FTP | Steady: 5min @ 110% FTP | Cooldown: 5min @ 55% FTP</description>
