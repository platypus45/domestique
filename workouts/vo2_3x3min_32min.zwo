<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 4x1min (32min)</name>
    <description>Warmup: 7min from 50% to 75% FTP | Intervals: 4 x (1min @ 110% / 3min @ 50%) | Cooldown: 5min @ 50% FTP</description>
