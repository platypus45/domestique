<workout_file>
    <author>Domestique Library</author>
    <name>VO2max (40min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Steady: 1min @ 50% FTP | Steady: 1min @ 95% FTP | Steady: 30s @ 50% FTP | Steady: 1min @ 100% FTP | Steady: 30s @ 50% FTP | Steady: 1min @ 105% FTP | Steady: 30s @ 50% FTP | Steady: 1min @ 100% FTP | Steady: 30s @ 50% FTP | Steady: 1min @ 95% FTP | Steady: 2min @ 50% FTP | Steady: 5min @ 115% FTP | Steady: 5min @ 50% FTP | Steady: 5min @ 100% FTP | Cooldown: 6min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="60" Power="0.95" pace="0" />
