<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 6x2min (42min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Intervals: 6 x (2min @ 110% / 3min @ 55%) | Cooldown: 5min from 25% to 75% FTP</description>
