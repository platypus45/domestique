        <SteadyState Duration="300" Power="0.68" pace="0" />
        <SteadyState Duration="600" Power="0.9" pace="0" />
        <SteadyState Duration="300" Power="0.68" pace="0" />
        <SteadyState Duration="480" Power="1.05" pace="0" />
        <SteadyState Duration="300" Power="0.6" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
    </workout>
