<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 1min/20s 18x (60min)</name>
    <description>Warmup: 5min from 25% to 75% FTP | Microintervals: 18 x (1min 10s @ 105% / 20s @ 25%) | Cooldown: 3min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="450" Power="0.95" pace="0" />
        <SteadyState Duration="60" Power="0.85" pace="0" />
        <SteadyState Duration="180" Power="1.1" pace="0" />
        <SteadyState Duration="60" Power="0.95" pace="0" />
        <SteadyState Duration="60" Power="1.2" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <IntervalsT Repeat="9" OnDuration="70" OffDuration="20" OnPower="1.05" OffPower="0.25" pace="0" />
        <SteadyState Duration="210" Power="0.55" pace="0" />
        <IntervalsT Repeat="9" OnDuration="70" OffDuration="20" OnPower="1.05" OffPower="0.25" pace="0" />
        <SteadyState Duration="60" Power="0.95" pace="0" />
        <SteadyState Duration="60" Power="0.85" pace="0" />
        <Ramp Duration="300" PowerLow="0.95" PowerHigh="0.85" pace="0" />
        <Cooldown Duration="180" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>