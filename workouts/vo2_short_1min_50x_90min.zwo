<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 1min/30s 50x (96min)</name>
    <description>Warmup: 10min from 50% to 95% FTP | Microintervals: 50 x (1min @ 120% / 30s @ 35%)</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.95" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.1" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.15" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.2" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <IntervalsT Repeat="50" OnDuration="60" OffDuration="30" OnPower="1.2" OffPower="0.35" pace="0" />
    <Cooldown Duration="330" PowerLow="0.75" PowerHigh="0.4" /></workout>
</workout_file>