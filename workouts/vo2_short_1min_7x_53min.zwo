<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 1min/20s 7x (60min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 7 x (1min 10s @ 110% / 20s @ 25%) | Cooldown: 5min ramp from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="450" Power="0.95" pace="0" Cadence="55" />
        <SteadyState Duration="60" Power="0.85" pace="0" />
        <SteadyState Duration="180" Power="1.1" pace="0" />
        <SteadyState Duration="60" Power="0.95" pace="0" />
        <SteadyState Duration="60" Power="1.2" pace="0" />
        <SteadyState Duration="60" Power="0.55" pace="0" />
        <IntervalsT Repeat="7" OnDuration="70" OffDuration="20" OnPower="1.1" OffPower="0.25" pace="0" Cadence="100" CadenceResting="100" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <IntervalsT Repeat="5" OnDuration="40" OffDuration="20" OnPower="1.2" OffPower="0.25" pace="0" Cadence="90" CadenceResting="90" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <IntervalsT Repeat="7" OnDuration="40" OffDuration="20" OnPower="1.2" OffPower="0.25" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.40" /></workout>
</workout_file>