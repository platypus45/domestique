<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 20s/10s 30x (50min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 30 x (20s @ 119% / 10s @ 50%) | Cooldown: 5min from 65% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="3" OnDuration="30" OffDuration="30" OnPower="1.05" OffPower="0.65" pace="0" Cadence="105" CadenceResting="85" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="2" OnDuration="10" OffDuration="50" OnPower="1.5" OffPower="0.65" pace="0" Cadence="110" CadenceResting="85" />
        <SteadyState Duration="180" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="10" OnDuration="20" OffDuration="10" OnPower="1.19" OffPower="0.5" pace="0" Cadence="100" CadenceResting="85" />
        <SteadyState Duration="300" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="10" OnDuration="20" OffDuration="10" OnPower="1.19" OffPower="0.5" pace="0" Cadence="100" CadenceResting="85" />
        <SteadyState Duration="300" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="10" OnDuration="20" OffDuration="10" OnPower="1.19" OffPower="0.5" pace="0" Cadence="100" CadenceResting="85" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>