<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 30s/30s 29x (66min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 29 x (30s @ 120% / 30s @ 70%) | Cooldown: 10min from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="630" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="30" Power="0.95" pace="0" />
        <Ramp Duration="270" PowerLow="0.6" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="30" Power="0.95" pace="0" />
        <SteadyState Duration="300" Power="0.75" pace="0" />
        <IntervalsT Repeat="9" OnDuration="30" OffDuration="30" OnPower="1.2" OffPower="0.7" pace="0" />
        <SteadyState Duration="180" Power="0.85" pace="0" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="30" OnPower="1.2" OffPower="0.7" pace="0" />
        <SteadyState Duration="180" Power="0.85" pace="0" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="30" OnPower="1.2" OffPower="0.7" pace="0" />
        <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.40" pace="0" />
    </workout>
</workout_file>