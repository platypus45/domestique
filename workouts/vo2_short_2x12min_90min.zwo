<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 2x12min (102min)</name>
    <description>Intervals: 2 x (12min @ 90% / 6min @ 55%) | Cooldown: 5min ramp from 75% to 40% FTP</description>
