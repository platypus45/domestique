<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 30s/15s 2x13 (45min)</name>
    <description>Warmup: 12min from 45% to 75% FTP + 2min @ 55% | Rønnestad 30/15: 2 sets of 13 x (30s @ 115% / 15s @ 50%), 3min @ 55% between sets | Ride the bursts at a repeatable rhythm — the goal is accumulated time near 90% VO2max; hotter than ~115% turns the set anaerobic and cuts the stimulus | Cooldown: 8min from 50% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="720" PowerLow="0.45" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <IntervalsT Repeat="13" OnDuration="30" OffDuration="15" OnPower="1.15" OffPower="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <IntervalsT Repeat="13" OnDuration="30" OffDuration="15" OnPower="1.15" OffPower="0.5" pace="0" />
        <Cooldown Duration="480" PowerLow="0.50" PowerHigh="0.40" pace="0" />
    </workout>
</workout_file>
