<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 30s/30s 40x (85min)</name>
    <description>Warmup: 20min from 25% to 90% FTP | Microintervals: 40 x (30s @ 115% / 30s @ 70%) | Cooldown: 10min from 60% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="1200" PowerLow="0.25" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <IntervalsT Repeat="20" OnDuration="30" OffDuration="30" OnPower="1.15" OffPower="0.7" pace="0" />
        <SteadyState Duration="600" Power="0.65" pace="0" />
        <IntervalsT Repeat="20" OnDuration="30" OffDuration="30" OnPower="1.15" OffPower="0.7" pace="0" />
        <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>