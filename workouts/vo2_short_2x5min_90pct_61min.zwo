<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 30s/15s 13x (61min)</name>
    <description>Warmup: 10min from 46% to 78% FTP | Microintervals: 13 x (30s @ 125% / 15s @ 60%) | Cooldown: 5min from 49% to 38% FTP</description>
