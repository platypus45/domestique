<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Anaerobic 30s/15s 13x (59min)</name>
    <description>Warmup: 10min from 46% to 78% FTP | Microintervals: 13 x (30s @ 125% / 15s @ 60%) | Cooldown: 5min from 38% to 49% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.46" PowerHigh="0.78" pace="0" />
        <SteadyState Duration="300" Power="0.85" pace="0" Cadence="70" />
        <SteadyState Duration="60" Power="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.9" pace="0" Cadence="65" />
        <SteadyState Duration="60" Power="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" Cadence="60" />
        <SteadyState Duration="60" Power="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" Cadence="50" />
        <SteadyState Duration="180" Power="1.05" pace="0" Cadence="120" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <Ramp Duration="180" PowerLow="0.6" PowerHigh="1.0" pace="0" />
        <IntervalsT Repeat="13" OnDuration="30" OffDuration="15" OnPower="1.25" OffPower="0.6" pace="0" />
        <SteadyState Duration="120" Power="0.43" pace="0" />
        <SteadyState Duration="30" Power="2.01" pace="0" />
        <Cooldown Duration="300" PowerLow="0.38" PowerHigh="0.49" pace="0" />
    </workout>
