<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 30s/15s 13x (61min)</name>
    <description>Warmup: 10min from 45% to 90% FTP | Microintervals: 13 x (30s @ 120% / 15s @ 60%) | Cooldown: 2min 5s from 65% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="300" Power="0.8" pace="0" Cadence="80" />
        <SteadyState Duration="60" Power="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.86" pace="0" Cadence="70" />
        <SteadyState Duration="60" Power="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.9" pace="0" Cadence="60" />
        <SteadyState Duration="60" Power="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" Cadence="50" />
        <SteadyState Duration="180" Power="1.05" pace="0" Cadence="120" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <Ramp Duration="180" PowerLow="0.6" PowerHigh="1.0" pace="0" />
        <IntervalsT Repeat="13" OnDuration="30" OffDuration="15" OnPower="1.2" OffPower="0.6" pace="0" />
        <Ramp Duration="420" PowerLow="0.41" PowerHigh="0.65" pace="0" />
        <Cooldown Duration="125" PowerLow="0.65" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>