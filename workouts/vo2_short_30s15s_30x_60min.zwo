<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 30s/15s 30x (60min)</name>
    <description>Warmup: 5min from 45% to 75% FTP | Microintervals: 30 x (30s @ 125% / 15s @ 65%) | Cooldown: 6min from 75% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.45" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="5" OnDuration="30" OffDuration="30" OnPower="0.65" OffPower="0.89" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <Ramp Duration="180" PowerLow="0.9" PowerHigh="1.04" pace="0" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="15" OnPower="1.25" OffPower="0.65" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <Ramp Duration="180" PowerLow="0.9" PowerHigh="1.04" pace="0" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="15" OnPower="1.25" OffPower="0.65" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <Ramp Duration="180" PowerLow="0.9" PowerHigh="1.04" pace="0" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="15" OnPower="1.25" OffPower="0.65" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <Cooldown Duration="360" PowerLow="0.75" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>