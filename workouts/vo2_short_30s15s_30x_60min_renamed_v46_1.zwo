<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 30s/15s 30x (64min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 30 x (30s @ 110% / 15s @ 60%) | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="10" Power="1.08" pace="0" />
        <SteadyState Duration="20" Power="0.5" pace="0" />
        <SteadyState Duration="10" Power="1.12" pace="0" />
        <SteadyState Duration="20" Power="0.5" pace="0" />
        <SteadyState Duration="10" Power="1.16" pace="0" />
        <SteadyState Duration="20" Power="0.5" pace="0" />
        <SteadyState Duration="10" Power="1.2" pace="0" />
        <SteadyState Duration="20" Power="0.5" pace="0" />
        <SteadyState Duration="10" Power="1.24" pace="0" />
        <SteadyState Duration="140" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="15" OnPower="1.1" OffPower="0.6" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="15" OnPower="1.1" OffPower="0.6" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="15" OnPower="1.1" OffPower="0.6" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.9" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>