<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 30s/15s 30x (60min)</name>
    <description>Warmup: 6min from 45% to 70% FTP | Microintervals: 30 x (30s @ 125% / 15s @ 60%) | Cooldown: 5min from 70% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="360" PowerLow="0.45" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="10" Power="1.2" pace="0" />
        <SteadyState Duration="20" Power="0.5" pace="0" />
        <SteadyState Duration="10" Power="1.3" pace="0" />
        <SteadyState Duration="20" Power="0.5" pace="0" />
        <SteadyState Duration="10" Power="1.4" pace="0" />
        <SteadyState Duration="20" Power="0.5" pace="0" />
        <SteadyState Duration="10" Power="1.5" pace="0" />
        <SteadyState Duration="20" Power="0.5" pace="0" />
        <SteadyState Duration="10" Power="1.6" pace="0" />
        <SteadyState Duration="140" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="15" OnPower="1.25" OffPower="0.6" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="15" OnPower="1.25" OffPower="0.6" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="15" OnPower="1.25" OffPower="0.6" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.9" pace="0" />
        <Cooldown Duration="300" PowerLow="0.7" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>