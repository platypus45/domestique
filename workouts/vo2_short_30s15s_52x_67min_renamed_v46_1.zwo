<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 30s/15s 52x (67min)</name>
    <description>Warmup: 5min from 35% to 75% FTP | Microintervals: 52 x (30s @ 132% / 15s @ 52%) | Cooldown: 5min from 40% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.35" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="30" OnPower="1.0" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.4" pace="0" />
        <IntervalsT Repeat="13" OnDuration="30" OffDuration="15" OnPower="1.32" OffPower="0.52" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="13" OnDuration="30" OffDuration="15" OnPower="1.32" OffPower="0.52" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="13" OnDuration="30" OffDuration="15" OnPower="1.32" OffPower="0.52" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="13" OnDuration="30" OffDuration="15" OnPower="1.32" OffPower="0.52" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="0.4" pace="0" />
        <Cooldown Duration="300" PowerLow="0.4" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>