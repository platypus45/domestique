<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short Rønnestad-style 2x10x30/30s (40min)</name>
    <description>Warmup: 5min from 50% to 75% FTP | Microintervals: 10 x (30s @ 105% / 30s @ 50%) | Cooldown: 5min from 50% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.5" PowerHigh="0.75" pace="0" Cadence="85" />
        <Ramp Duration="120" PowerLow="0.75" PowerHigh="0.9" pace="0" Cadence="95" />
        <Ramp Duration="60" PowerLow="0.9" PowerHigh="1.0" pace="0" Cadence="100" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="30" OnPower="1.05" OffPower="0.5" pace="0" Cadence="95" CadenceResting="85" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="30" OnPower="1.08" OffPower="0.5" pace="0" Cadence="95" CadenceResting="85" />
        <SteadyState Duration="300" Power="1.1" pace="0" Cadence="90" />
        <Cooldown Duration="300" PowerLow="0.5" PowerHigh="0.3" pace="0" Cadence="85" />
    </workout>
</workout_file>