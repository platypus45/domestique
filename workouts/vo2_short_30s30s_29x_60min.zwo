<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 30s/30s 29x (60min)</name>
    <description>Warmup: 4min 30s from 40% to 60% FTP | Microintervals: 29 x (30s @ 120% / 30s @ 70%) | Cooldown: 10min from 75% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="270" PowerLow="0.4" PowerHigh="0.6" pace="0" />
        <SteadyState Duration="30" Power="0.95" pace="0" />
        <Ramp Duration="270" PowerLow="0.6" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="30" Power="0.95" pace="0" />
        <SteadyState Duration="300" Power="0.75" pace="0" />
        <IntervalsT Repeat="9" OnDuration="30" OffDuration="30" OnPower="1.2" OffPower="0.7" pace="0" />
        <SteadyState Duration="180" Power="0.85" pace="0" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="30" OnPower="1.2" OffPower="0.7" pace="0" />
        <SteadyState Duration="180" Power="0.85" pace="0" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="30" OnPower="1.2" OffPower="0.7" pace="0" />
        <Cooldown Duration="600" PowerLow="0.75" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>