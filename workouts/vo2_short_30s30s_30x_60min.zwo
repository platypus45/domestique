<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 30s/30s 30x (60min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Microintervals: 30 x (30s @ 110% / 30s @ 70%) | Cooldown: 6min from 55% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="0.95" OffPower="0.5" pace="0" Cadence="95" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.01" OffPower="0.5" pace="0" Cadence="105" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.05" OffPower="0.5" pace="0" Cadence="115" CadenceResting="85" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="30" OnPower="1.1" OffPower="0.7" pace="0" Cadence="105" CadenceResting="90" />
        <SteadyState Duration="180" Power="0.55" pace="0" Cadence="85" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="30" OnPower="1.1" OffPower="0.7" pace="0" Cadence="105" CadenceResting="90" />
        <SteadyState Duration="180" Power="0.55" pace="0" Cadence="85" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="30" OnPower="1.1" OffPower="0.7" pace="0" Cadence="105" CadenceResting="90" />
        <SteadyState Duration="180" Power="0.55" pace="0" Cadence="85" />
        <Cooldown Duration="360" PowerLow="0.55" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>