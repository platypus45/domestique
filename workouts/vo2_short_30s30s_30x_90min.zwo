        <SteadyState Duration="180" Power="0.6" pace="0" />
        <SteadyState Duration="30" Power="0.95" pace="0" />
        <SteadyState Duration="55" Power="0.45" pace="0" />
        <SteadyState Duration="180" Power="0.6" pace="0" />
        <SteadyState Duration="30" Power="0.95" pace="0" />
        <SteadyState Duration="55" Power="0.45" pace="0" />
