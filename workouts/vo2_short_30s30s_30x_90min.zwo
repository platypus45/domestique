<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 30s/30s 30x (103min)</name>
    <description>Microintervals: 30 x (30s @ 120% / 30s @ 55%) | Cooldown: 5min ramp from 55% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="30" Power="0.95" pace="0" />
