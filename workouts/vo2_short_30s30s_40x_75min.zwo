<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 30s/30s 40x (76min)</name>
    <description>Warmup: 6min @ 50% FTP | Microintervals: 40 x (30s @ 120% / 30s @ 30%) | Cooldown: 5min ramp @ 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <Ramp Duration="60" PowerLow="0.5" PowerHigh="0.72" pace="0" />
        <SteadyState Duration="300" Power="0.72" pace="0" />
        <IntervalsT Repeat="3" OnDuration="15" OffDuration="45" OnPower="1.2" OffPower="0.72" pace="0" />
        <FreeRide Duration="120" FlatRoad="0" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="30" OnPower="1.2" OffPower="0.3" pace="0" />
        <SteadyState Duration="270" Power="0.3" pace="0" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="30" OnPower="1.2" OffPower="0.3" pace="0" />
        <SteadyState Duration="270" Power="0.3" pace="0" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="30" OnPower="1.2" OffPower="0.3" pace="0" />
        <SteadyState Duration="270" Power="0.3" pace="0" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="30" OnPower="1.2" OffPower="0.3" pace="0" />
        <Cooldown Duration="330" PowerLow="0.30" PowerHigh="0.30" /></workout>
</workout_file>