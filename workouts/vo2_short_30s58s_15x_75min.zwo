<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 30s/58s 15x (75min)</name>
    <description>Warmup: 7min from 25% to 50% FTP | Microintervals: 15 x (30s @ 110% / 58s @ 67%) | Cooldown: 5min 30s @ 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="420" PowerLow="0.25" PowerHigh="0.5" pace="0" Cadence="95" />
        <SteadyState Duration="60" Power="0.5" pace="0" Cadence="100" />
        <SteadyState Duration="60" Power="0.6" pace="0" Cadence="105" />
        <SteadyState Duration="60" Power="0.7" pace="0" Cadence="110" />
        <SteadyState Duration="60" Power="0.8" pace="0" Cadence="115" />
        <SteadyState Duration="60" Power="0.9" pace="0" Cadence="120" />
        <SteadyState Duration="180" Power="0.5" pace="0" Cadence="95" />
        <IntervalsT Repeat="10" OnDuration="45" OffDuration="15" OnPower="0.7" OffPower="1.1" pace="0" Cadence="110" CadenceResting="70" />
        <SteadyState Duration="180" Power="0.5" pace="0" Cadence="95" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="30" OnPower="0.7" OffPower="1.1" pace="0" Cadence="110" CadenceResting="70" />
        <SteadyState Duration="180" Power="0.5" pace="0" Cadence="95" />
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="30" OnPower="0.7" OffPower="1.1" pace="0" Cadence="110" CadenceResting="70" />
        <SteadyState Duration="180" Power="0.5" pace="0" Cadence="95" />
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="0.7" OffPower="1.1" pace="0" Cadence="110" CadenceResting="70" />
        <SteadyState Duration="180" Power="0.5" pace="0" Cadence="95" />
        <SteadyState Duration="60" Power="0.5" pace="0" Cadence="100" />
        <SteadyState Duration="60" Power="0.6" pace="0" Cadence="105" />
        <SteadyState Duration="60" Power="0.7" pace="0" Cadence="110" />
        <SteadyState Duration="60" Power="0.8" pace="0" Cadence="115" />
        <SteadyState Duration="60" Power="0.9" pace="0" Cadence="120" />
        <SteadyState Duration="330" Power="0.4" pace="0" Cadence="105" />
    </workout>
</workout_file>