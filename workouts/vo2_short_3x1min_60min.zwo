<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 3x1min (60min)</name>
    <description>Warmup: 4min from 40% to 70% FTP | Intervals: 3 x (1min @ 90% / 1min @ 50%) | Cooldown: 4min 15s from 65% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="240" PowerLow="0.4" PowerHigh="0.7" pace="0" />
        <IntervalsT Repeat="3" OnDuration="15" OffDuration="30" OnPower="1.1" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="15" OffDuration="30" OnPower="1.2" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="15" OffDuration="30" OnPower="1.3" OffPower="0.5" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="0.9" OffPower="0.5" pace="0" />
        <SteadyState Duration="270" Power="0.85" pace="0" />
        <SteadyState Duration="210" Power="0.95" pace="0" />
        <SteadyState Duration="90" Power="1.1" pace="0" />
        <SteadyState Duration="30" Power="1.2" pace="0" />
        <Ramp Duration="240" PowerLow="0.65" PowerHigh="0.5" pace="0" />
        <SteadyState Duration="270" Power="0.85" pace="0" />
        <SteadyState Duration="210" Power="0.95" pace="0" />
        <SteadyState Duration="90" Power="1.1" pace="0" />
        <SteadyState Duration="30" Power="1.2" pace="0" />
        <Ramp Duration="240" PowerLow="0.65" PowerHigh="0.5" pace="0" />
        <SteadyState Duration="270" Power="0.85" pace="0" />
        <SteadyState Duration="210" Power="0.95" pace="0" />
        <SteadyState Duration="90" Power="1.1" pace="0" />
        <SteadyState Duration="30" Power="1.2" pace="0" />
        <Cooldown Duration="255" PowerLow="0.65" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>