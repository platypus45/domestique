<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 3x5min (120min)</name>
    <description>Warmup: 15min from 30% to 90% FTP | Intervals: 3 x (5min @ 90% / 5min @ 80%) | Cooldown: 9min from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.3" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <SteadyState Duration="120" Power="0.65" pace="0" />
        <IntervalsT Repeat="3" OnDuration="300" OffDuration="300" OnPower="0.9" OffPower="0.8" pace="0" Cadence="90" CadenceResting="60" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.5" pace="0" Cadence="120" />
        <SteadyState Duration="150" Power="0.5" pace="0" />
        <IntervalsT Repeat="2" OnDuration="300" OffDuration="300" OnPower="0.95" OffPower="0.8" pace="0" Cadence="110" CadenceResting="80" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.6" pace="0" />
        <IntervalsT Repeat="6" OnDuration="40" OffDuration="20" OnPower="1.3" OffPower="0.4" pace="0" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <IntervalsT Repeat="6" OnDuration="40" OffDuration="20" OnPower="1.3" OffPower="0.4" pace="0" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <IntervalsT Repeat="6" OnDuration="40" OffDuration="20" OnPower="1.3" OffPower="0.4" pace="0" />
        <Cooldown Duration="540" PowerLow="0.6" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>