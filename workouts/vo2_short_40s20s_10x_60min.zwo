<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 40s/20s 10x (60min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Microintervals: 10 x (40s @ 120% / 20s @ 55%) | Cooldown: 5min from 55% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="30" Power="0.95" pace="0" Cadence="95" />
        <SteadyState Duration="30" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="30" Power="1.05" pace="0" Cadence="105" />
        <SteadyState Duration="30" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="30" Power="1.15" pace="0" Cadence="115" />
        <SteadyState Duration="30" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="10" OnDuration="40" OffDuration="20" OnPower="1.2" OffPower="0.55" pace="0" Cadence="110" CadenceResting="85" />
        <SteadyState Duration="300" Power="0.65" pace="0" Cadence="85" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="30" OnPower="1.3" OffPower="0.55" pace="0" Cadence="110" CadenceResting="85" />
        <SteadyState Duration="300" Power="0.65" pace="0" Cadence="85" />
        <IntervalsT Repeat="10" OnDuration="20" OffDuration="40" OnPower="1.4" OffPower="0.55" pace="0" Cadence="110" CadenceResting="85" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>