<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 40s/20s 30x (60min)</name>
    <description>Warmup: 10min from 25% to 73% FTP | Microintervals: 30 x (40s @ 120% / 20s @ 55%) | Cooldown: 10min from 55% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.73" pace="0" />
        <IntervalsT Repeat="12" OnDuration="40" OffDuration="20" OnPower="1.2" OffPower="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.66" pace="0" />
        <IntervalsT Repeat="12" OnDuration="40" OffDuration="20" OnPower="1.2" OffPower="0.55" pace="0" />
        <SteadyState Duration="300" Power="0.66" pace="0" />
        <IntervalsT Repeat="6" OnDuration="40" OffDuration="20" OnPower="1.2" OffPower="0.55" pace="0" />
        <Cooldown Duration="600" PowerLow="0.55" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>