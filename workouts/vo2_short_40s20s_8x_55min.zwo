<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 40s/20s 8x (62min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 8 x (40s @ 110% / 20s @ 65%) | Cooldown: 6min from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="20" Power="1.05" pace="0" />
        <Ramp Duration="180" PowerLow="0.5" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="20" Power="1.15" pace="0" />
        <Ramp Duration="180" PowerLow="0.7" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="20" Power="1.25" pace="0" />
        <SteadyState Duration="300" Power="0.6" pace="0" Cadence="85" />
        <IntervalsT Repeat="8" OnDuration="20" OffDuration="40" OnPower="1.3" OffPower="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.7" pace="0" Cadence="85" />
        <IntervalsT Repeat="8" OnDuration="30" OffDuration="30" OnPower="1.2" OffPower="0.65" pace="0" Cadence="85" CadenceResting="65" />
        <SteadyState Duration="300" Power="0.6" pace="0" Cadence="85" />
        <IntervalsT Repeat="8" OnDuration="40" OffDuration="20" OnPower="1.1" OffPower="0.65" pace="0" />
        <Cooldown Duration="360" PowerLow="0.60" PowerHigh="0.40" pace="0" />
    </workout>
</workout_file>