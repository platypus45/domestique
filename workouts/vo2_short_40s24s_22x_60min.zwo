<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 40s/24s 22x (67min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 22 x (40s @ 110% / 24s @ 50%) | Cooldown: 5min from 50% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="30" Power="0.95" pace="0" />
        <Ramp Duration="180" PowerLow="0.5" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="30" Power="0.95" pace="0" />
        <Ramp Duration="180" PowerLow="0.65" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="60" OnPower="1.2" OffPower="0.6" pace="0" />
        <SteadyState Duration="200" Power="0.65" pace="0" />
        <IntervalsT Repeat="10" OnDuration="40" OffDuration="30" OnPower="1.1" OffPower="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <IntervalsT Repeat="12" OnDuration="40" OffDuration="20" OnPower="1.1" OffPower="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.50" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>