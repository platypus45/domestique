<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 45s/15s 7x (33min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 7 x (45s @ 120% / 15s @ 55%) | Cooldown: 5min ramp from 75% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="1" OnDuration="45" OffDuration="15" OnPower="1.2" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="45" OffDuration="15" OnPower="1.2" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="45" OffDuration="15" OnPower="1.2" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="45" OffDuration="15" OnPower="1.2" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="45" OffDuration="15" OnPower="1.2" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="45" OffDuration="15" OnPower="1.2" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="45" OffDuration="15" OnPower="1.2" OffPower="0.55" pace="0" />
        <SteadyState Duration="240" Power="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.2" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.2" OffPower="0.55" pace="0" />
