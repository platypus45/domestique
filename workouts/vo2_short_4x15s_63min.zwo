<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 4x15s (70min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 4 x (15s @ 115% / 30s @ 50%) | Cooldown: 5min ramp from 65% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
