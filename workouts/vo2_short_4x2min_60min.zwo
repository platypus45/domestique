<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 4x2min (62min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 4 x (2min @ 100% / 30s @ 50%) | Cooldown: 6min from 66% to 55% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="60" Power="0.95" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="1.0" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="1.05" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="1.0" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="0.95" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="1.15" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="120" OffDuration="30" OnPower="1.0" OffPower="0.5" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="30" OnPower="1.05" OffPower="0.5" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="30" OnPower="1.0" OffPower="0.5" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="1.0" pace="0" />
        <Cooldown Duration="360" PowerLow="0.66" PowerHigh="0.55" pace="0" />
    </workout>
</workout_file>