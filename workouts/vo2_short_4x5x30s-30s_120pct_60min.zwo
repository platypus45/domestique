<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 30s/30s 20x (60min)</name>
    <description>Warmup: 10min from 50% to 72% FTP | Microintervals: 20 x (30s @ 120% / 30s @ 59%) | Cooldown: 10min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.72" pace="0" />
        <IntervalsT Repeat="2" OnDuration="30" OffDuration="30" OnPower="1.2" OffPower="0.5" pace="0" />
        <SteadyState Duration="240" Power="0.55" pace="0" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="30" OnPower="1.3" OffPower="0.6" pace="0" />
        <IntervalsT Repeat="5" OnDuration="30" OffDuration="30" OnPower="1.2" OffPower="0.6" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="2" OnDuration="30" OffDuration="30" OnPower="1.3" OffPower="0.6" pace="0" />
        <IntervalsT Repeat="6" OnDuration="30" OffDuration="30" OnPower="1.2" OffPower="0.6" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.3" OffPower="0.6" pace="0" />
        <IntervalsT Repeat="7" OnDuration="30" OffDuration="30" OnPower="1.2" OffPower="0.6" pace="0" />
        <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>