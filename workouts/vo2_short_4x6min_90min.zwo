<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 4x6min (90min)</name>
    <description>Warmup: 10min from 40% to 75% FTP | Intervals: 4 x (6min @ 95% / 3min @ 85%) | Cooldown: 9min from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="300" Power="0.85" pace="0" />
        <IntervalsT Repeat="10" OnDuration="40" OffDuration="20" OnPower="1.1" OffPower="0.7" pace="0" />
        <SteadyState Duration="300" Power="0.81" pace="0" />
        <IntervalsT Repeat="10" OnDuration="40" OffDuration="20" OnPower="1.1" OffPower="0.7" pace="0" />
        <SteadyState Duration="300" Power="0.7" pace="0" />
        <IntervalsT Repeat="4" OnDuration="360" OffDuration="180" OnPower="0.95" OffPower="0.85" pace="0" />
        <Cooldown Duration="540" PowerLow="0.60" PowerHigh="0.40" pace="0" />
    </workout>
</workout_file>