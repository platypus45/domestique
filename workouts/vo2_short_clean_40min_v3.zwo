<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 30s/15s 30x (44min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 30 x (30s @ 118% / 15s @ 50%) | Cooldown: 5min from 50% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="630" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="10" OnDuration="30" OffDuration="15" OnPower="1.18" OffPower="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="15" OnPower="1.18" OffPower="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="15" OnPower="1.18" OffPower="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.50" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>