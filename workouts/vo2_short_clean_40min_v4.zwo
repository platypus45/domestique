<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 40s/20s 24x (40min)</name>
    <description>Warmup: 5min from 50% to 75% FTP | Microintervals: 24 x (40s @ 115% / 20s @ 50%) | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="8" OnDuration="40" OffDuration="20" OnPower="1.15" OffPower="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="8" OnDuration="40" OffDuration="20" OnPower="1.15" OffPower="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="8" OnDuration="40" OffDuration="20" OnPower="1.15" OffPower="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>