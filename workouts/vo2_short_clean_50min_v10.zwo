<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 30s/30s 24x (50min)</name>
    <description>Warmup: 11min from 50% to 75% FTP | Microintervals: 24 x (30s @ 115% / 30s @ 50%) | Cooldown: 7min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="660" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="8" OnDuration="30" OffDuration="30" OnPower="1.15" OffPower="0.5" pace="0" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <IntervalsT Repeat="8" OnDuration="30" OffDuration="30" OnPower="1.15" OffPower="0.5" pace="0" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <IntervalsT Repeat="8" OnDuration="30" OffDuration="30" OnPower="1.15" OffPower="0.5" pace="0" />
        <Cooldown Duration="420" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>