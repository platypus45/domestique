<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 30s/15s 39x (52min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 39 x (30s @ 116% / 15s @ 50%) | Cooldown: 6min from 50% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="645" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="13" OnDuration="30" OffDuration="15" OnPower="1.16" OffPower="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="13" OnDuration="30" OffDuration="15" OnPower="1.16" OffPower="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="13" OnDuration="30" OffDuration="15" OnPower="1.16" OffPower="0.5" pace="0" />
        <Cooldown Duration="360" PowerLow="0.50" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>