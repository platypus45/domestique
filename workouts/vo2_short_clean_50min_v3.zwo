<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 30s/15s 30x (50min)</name>
    <description>Warmup: 13min from 50% to 75% FTP | Microintervals: 30 x (30s @ 118% / 15s @ 50%) | Cooldown: 8min 30s from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="780" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="15" OnPower="1.18" OffPower="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="15" OnPower="1.18" OffPower="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="15" OnPower="1.18" OffPower="0.5" pace="0" />
        <Cooldown Duration="510" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>