<workout_file>
    <author>Domestique Library</author>
    <name>VO2 Short 30s/15s 39x (60min)</name>
    <description>Warmup: 14min from 50% to 75% FTP | Microintervals: 39 x (30s @ 116% / 15s @ 50%) | Cooldown: 10min from 50% to 45% FTP</description>
