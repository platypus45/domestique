<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max (27min)</name>
    <description>Warmup: 10min from 40% to 75% FTP | Steady: 2min @ 81% FTP | Steady: 2min @ 95% FTP | Steady: 2min @ 109% FTP | Steady: 1min @ 75% FTP | Cooldown: 10min from 65% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.81" pace="0" />
        <SteadyState Duration="120" Power="0.95" pace="0" />
        <SteadyState Duration="120" Power="1.09" pace="0" />
        <SteadyState Duration="60" Power="0.75" pace="0" />
        <Cooldown Duration="600" PowerLow="0.65" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>