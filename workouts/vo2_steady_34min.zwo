<workout_file>
    <author>Domestique Library</author>
    <name>VO2max (40min)</name>
    <description>Steady: 2min @ 60% FTP | Steady: 2min @ 70% FTP | Steady: 2min @ 80% FTP | Steady: 1min @ 90% FTP | Steady: 3min @ 55% FTP | Steady: 2min @ 90% FTP | Steady: 2min @ 95% FTP | Steady: 2min @ 107% FTP | Steady: 5min @ 55% FTP | Steady: 8min @ 110% FTP | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="120" Power="0.8" pace="0" />
        <SteadyState Duration="60" Power="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="120" Power="0.9" pace="0" />
        <SteadyState Duration="120" Power="0.95" pace="0" />
        <SteadyState Duration="120" Power="1.07" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="480" Power="1.1" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>