<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 4x1min (43min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 4 x (1min @ 107% / 1min @ 50%) | Cooldown: 5min @ 50% FTP</description>
