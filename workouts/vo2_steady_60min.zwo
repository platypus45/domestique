<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 3x3min (60min)</name>
    <description>Warmup: 10min from 30% to 70% FTP | Intervals: 3 x (3min @ 100% / 0s @ 55%) | Cooldown: 5min from 30% to 70% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.3" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="180" Power="1" pace="0" />
        <SteadyState Duration="180" Power="1.12" pace="0" />
        <SteadyState Duration="180" Power="1.25" pace="0" />
        <SteadyState Duration="540" Power="0.6" pace="0" />
        <SteadyState Duration="180" Power="1" pace="0" />
        <SteadyState Duration="180" Power="1.12" pace="0" />
        <SteadyState Duration="180" Power="1.25" pace="0" />
        <SteadyState Duration="540" Power="0.6" pace="0" />
        <SteadyState Duration="180" Power="1" pace="0" />
        <SteadyState Duration="180" Power="1.12" pace="0" />
        <SteadyState Duration="180" Power="1.25" pace="0" />
        <Cooldown Duration="300" PowerLow="0.3" PowerHigh="0.7" pace="0" />
    </workout>
</workout_file>