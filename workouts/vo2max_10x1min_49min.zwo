<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 1min/3min 10x (55min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 10 x (1min @ 117% / 3min @ 55%) | Cooldown: 5min ramp from 55% to 40% FTP</description>
