    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="10" OnDuration="60" OffDuration="180" OnPower="1.17" OffPower="0.55" pace="0" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.40" /></workout>
</workout_file>