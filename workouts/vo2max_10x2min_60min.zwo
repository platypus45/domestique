        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="10" OnDuration="120" OffDuration="120" OnPower="1.13" OffPower="0.47" pace="0" />
        <Cooldown Duration="600" PowerLow="0.47" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>