<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 10x2min (60min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Intervals: 10 x (2min @ 113% / 2min @ 47%) | Cooldown: 10min from 47% to 25% FTP</description>
