<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 10x2min (70min)</name>
    <description>Warmup: 5min from 45% to 75% FTP | Intervals: 10 x (2min @ 95% / 1min @ 50%) | Cooldown: 5min from 75% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.45" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="5" OnDuration="120" OffDuration="60" OnPower="0.95" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="120" OffDuration="60" OnPower="1.05" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="120" OffDuration="60" OnPower="0.95" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="120" OffDuration="60" OnPower="1.05" OffPower="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>