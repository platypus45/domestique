<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 1min/1min 10x (77min)</name>
    <description>Warmup: 10min from 55% to 72% FTP | Microintervals: 10 x (1min @ 114% / 1min @ 95%) | Cooldown: 15min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.55" PowerHigh="0.72" pace="0" />
        <SteadyState Duration="300" Power="0.95" pace="0" Cadence="90" />
        <SteadyState Duration="300" Power="0.72" pace="0" />
        <SteadyState Duration="300" Power="0.72" pace="0" />
        <IntervalsT Repeat="10" OnDuration="60" OffDuration="60" OnPower="1.14" OffPower="0.95" pace="0" Cadence="55" CadenceResting="90" />
        <SteadyState Duration="300" Power="0.72" pace="0" />
        <IntervalsT Repeat="6" OnDuration="60" OffDuration="60" OnPower="0.87" OffPower="0.72" pace="0" Cadence="55" CadenceResting="90" />
        <Cooldown Duration="900" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>