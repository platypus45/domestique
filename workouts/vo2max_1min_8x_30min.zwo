<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 1min/1min 8x (30min)</name>
    <description>Warmup: 8min from 50% to 75% FTP | Microintervals: 8 x (1min @ 110% / 1min @ 70%)</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" pace="0" Cadence="85" />
        <SteadyState Duration="180" Power="1.2" pace="0" Cadence="100" />
        <IntervalsT Repeat="8" OnDuration="60" OffDuration="60" OnPower="0.7" OffPower="1.1" pace="0" Cadence="85" CadenceResting="95" />
        <SteadyState Duration="60" Power="1.2" pace="0" Cadence="100" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
    </workout>
</workout_file>