<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 1min/1min 8x (35min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 8 x (1min @ 110% / 1min @ 70%)</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="180" Power="1.2" pace="0" Cadence="100" />
        <IntervalsT Repeat="8" OnDuration="60" OffDuration="60" OnPower="0.7" OffPower="1.1" pace="0" Cadence="85" CadenceResting="95" />
        <SteadyState Duration="60" Power="1.2" pace="0" Cadence="100" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.4" /></workout>
</workout_file>