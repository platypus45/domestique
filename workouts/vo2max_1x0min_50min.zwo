<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 4x4min (50min)</name>
    <description>Warmup: 5min @ 55% FTP | Intervals: 4 x (4min @ 107% / 2min @ 50%) | Cooldown: 6min from 50% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <SteadyState Duration="180" Power="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="180" Power="0.85" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="10" OffDuration="290" OnPower="1.5" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="4" OnDuration="240" OffDuration="120" OnPower="1.07" OffPower="0.5" pace="0" />
        <Cooldown Duration="360" PowerLow="0.5" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>