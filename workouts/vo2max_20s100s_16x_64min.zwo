<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 8min Surge 4x (64min)</name>
    <description>Warmup: 5min ramp from 35% to 75% FTP | Priming: 3 x (30s @ 100% / 30s @ 50%) + 2min @ 40% | Main: 4 x 8min VO2max blocks, each 4 x (20s surge @ 115% / 1min 40s @ 104%), 4min @ 50% between blocks — surges pull VO2 up fast, base holds it | Cooldown: 1min @ 40% + 5min ramp from 40% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.35" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="30" OnPower="1.0" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.4" pace="0" />
        <IntervalsT Repeat="4" OnDuration="20" OffDuration="100" OnPower="1.15" OffPower="1.04" pace="0" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="20" OffDuration="100" OnPower="1.15" OffPower="1.04" pace="0" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="20" OffDuration="100" OnPower="1.15" OffPower="1.04" pace="0" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="20" OffDuration="100" OnPower="1.15" OffPower="1.04" pace="0" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="0.4" pace="0" />
        <Cooldown Duration="300" PowerLow="0.4" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>
