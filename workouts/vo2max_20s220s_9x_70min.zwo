<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 12min Surge 3x (70min)</name>
    <description>Warmup: 5min ramp from 35% to 75% FTP | Priming: 3 x (30s @ 100% / 30s @ 50%) + 2min @ 40% | Main: 3 x 12min supra-threshold blocks, each 3 x (20s surge @ 125% / 3min 40s @ 106%), 6min @ 50% between blocks — long surged blocks for maximal aerobic power | Cooldown: 1min @ 40% + 5min ramp from 40% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.35" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="30" OnPower="1.0" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.4" pace="0" />
        <IntervalsT Repeat="3" OnDuration="20" OffDuration="220" OnPower="1.25" OffPower="1.06" pace="0" />
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="20" OffDuration="220" OnPower="1.25" OffPower="1.06" pace="0" />
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="20" OffDuration="220" OnPower="1.25" OffPower="1.06" pace="0" />
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="0.4" pace="0" />
        <Cooldown Duration="300" PowerLow="0.4" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>
