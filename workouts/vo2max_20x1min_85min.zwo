<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 20x1min (85min)</name>
    <description>Warmup: 20min from 50% to 75% FTP | Intervals: 20 x (1min @ 95% / 1min @ 110%) | Cooldown: 10min from 75% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="1200" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="0.95" OffPower="1.1" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="0.95" OffPower="1.1" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="0.95" OffPower="1.1" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="0.95" OffPower="1.1" pace="0" />
        <Cooldown Duration="600" PowerLow="0.75" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>