<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 20x30s (112min)</name>
    <description>Warmup: 10min from 55% to 72% FTP | Intervals: 20 x (30s @ 95% / 2min @ 87%) | Cooldown: 10min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.55" PowerHigh="0.72" pace="0" />
        <IntervalsT Repeat="6" OnDuration="60" OffDuration="60" OnPower="0.95" OffPower="0.87" pace="0" Cadence="105" CadenceResting="85" />
        <SteadyState Duration="300" Power="0.72" pace="0" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="120" OnPower="0.95" OffPower="0.87" pace="0" />
        <SteadyState Duration="300" Power="0.87" pace="0" />
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="120" OnPower="0.95" OffPower="0.87" pace="0" />
        <SteadyState Duration="300" Power="0.87" pace="0" />
        <SteadyState Duration="300" Power="1.14" pace="0" />
        <SteadyState Duration="300" Power="0.87" pace="0" />
        <SteadyState Duration="300" Power="1.14" pace="0" />
        <Cooldown Duration="600" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>