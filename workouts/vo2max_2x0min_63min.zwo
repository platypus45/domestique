<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Neuromuscular 2x30s (63min)</name>
    <description>Intervals: 2 x (30s @ 150% / 1min 30s @ 45%)</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="180" Power="0.7" pace="0" Cadence="85" />
        <SteadyState Duration="180" Power="0.85" pace="0" Cadence="70" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="180" Power="1.05" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="2" OnDuration="30" OffDuration="90" OnPower="1.5" OffPower="0.45" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <FreeRide Duration="720" FlatRoad="0" />
        <SteadyState Duration="600" Power="0.55" pace="0" />
        <FreeRide Duration="720" FlatRoad="0" />
        <SteadyState Duration="300" Power="0.75" pace="0" />
    </workout>
</workout_file>