<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 2x10min (85min)</name>
    <description>Warmup: 5min from 58% to 75% FTP | Intervals: 2 x (10min @ 99% / 5min @ 50%) | Cooldown: 7min from 75% to 36% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.58" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="0.99" OffPower="0.5" pace="0" Cadence="105" CadenceResting="85" />
        <IntervalsT Repeat="2" OnDuration="120" OffDuration="120" OnPower="1.1" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="2" OnDuration="600" OffDuration="300" OnPower="0.99" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="120" OffDuration="180" OnPower="1.08" OffPower="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.94" pace="0" />
        <Cooldown Duration="420" PowerLow="0.75" PowerHigh="0.36" pace="0" />
    </workout>
</workout_file>