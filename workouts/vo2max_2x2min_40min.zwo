<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 2x2min (40min)</name>
    <description>Warmup: 5min from 50% to 75% FTP | Intervals: 2 x (1min 30s @ 110% / 30s @ 50%) | Cooldown: 5min from 50% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.5" PowerHigh="0.75" pace="0" Cadence="85" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="0.95" OffPower="0.5" pace="0" Cadence="95" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.05" OffPower="0.5" pace="0" Cadence="105" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.15" OffPower="0.5" pace="0" Cadence="115" CadenceResting="85" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="1" OnDuration="90" OffDuration="30" OnPower="1.1" OffPower="0.5" pace="0" Cadence="95" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="90" OffDuration="30" OnPower="1.12" OffPower="0.5" pace="0" Cadence="95" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="90" OffDuration="30" OnPower="1.14" OffPower="0.5" pace="0" Cadence="95" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="90" OffDuration="30" OnPower="1.16" OffPower="0.5" pace="0" Cadence="95" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="90" OffDuration="30" OnPower="1.18" OffPower="0.5" pace="0" Cadence="95" CadenceResting="85" />
        <SteadyState Duration="300" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="1" OnDuration="90" OffDuration="30" OnPower="1.1" OffPower="0.5" pace="0" Cadence="95" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="90" OffDuration="30" OnPower="1.12" OffPower="0.5" pace="0" Cadence="95" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="90" OffDuration="30" OnPower="1.14" OffPower="0.5" pace="0" Cadence="95" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="90" OffDuration="30" OnPower="1.16" OffPower="0.5" pace="0" Cadence="95" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="90" OffDuration="30" OnPower="1.18" OffPower="0.5" pace="0" Cadence="95" CadenceResting="85" />
        <Cooldown Duration="300" PowerLow="0.5" PowerHigh="0.3" pace="0" Cadence="85" />
    </workout>
</workout_file>