<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 2x3min (64min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 2 x (3min @ 108% / 1min 30s @ 60%) | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="630" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="60" Power="1.09" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="240" Power="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="2" OnDuration="120" OffDuration="120" OnPower="1.08" OffPower="0.6" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="2" OnDuration="180" OffDuration="90" OnPower="1.08" OffPower="0.6" pace="0" />
        <SteadyState Duration="210" Power="0.5" pace="0" />
        <SteadyState Duration="240" Power="1.08" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <Ramp Duration="300" PowerLow="1.05" PowerHigh="1.2" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>