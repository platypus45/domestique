<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 10x2min (92min)</name>
    <description>Warmup: 10min from 55% to 87% FTP | Intervals: 10 x (2min @ 95% / 30s @ 115%) | Cooldown: 10min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.55" PowerHigh="0.87" pace="0" Cadence="90" />
        <IntervalsT Repeat="6" OnDuration="60" OffDuration="60" OnPower="1.14" OffPower="0.95" pace="0" Cadence="115" CadenceResting="80" />
        <SteadyState Duration="300" Power="0.72" pace="0" />
        <IntervalsT Repeat="5" OnDuration="120" OffDuration="30" OnPower="0.95" OffPower="1.15" pace="0" />
        <SteadyState Duration="300" Power="0.72" pace="0" />
        <IntervalsT Repeat="5" OnDuration="120" OffDuration="30" OnPower="0.95" OffPower="1.15" pace="0" />
        <SteadyState Duration="300" Power="0.72" pace="0" />
        <IntervalsT Repeat="2" OnDuration="300" OffDuration="300" OnPower="1.14" OffPower="0.72" pace="0" />
        <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>