<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 30s/2min 16x (84min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 16 x (30s @ 106% / 2min @ 95%) | Cooldown: 5min from 75% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
