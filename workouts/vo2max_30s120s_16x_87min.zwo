<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 30s/2min 16x (87min)</name>
    <description>Warmup: 10min from 40% to 75% FTP | Microintervals: 16 x (30s @ 110% / 2min @ 98%) | Cooldown: 10min from 75% to 37% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="0.89" OffPower="0.5" pace="0" Cadence="110" CadenceResting="65" />
        <IntervalsT Repeat="8" OnDuration="30" OffDuration="120" OnPower="1.1" OffPower="0.98" pace="0" />
        <FreeRide Duration="300" FlatRoad="0" />
        <IntervalsT Repeat="8" OnDuration="30" OffDuration="120" OnPower="1.1" OffPower="0.98" pace="0" />
        <FreeRide Duration="300" FlatRoad="0" />
        <SteadyState Duration="180" Power="1.1" pace="0" />
        <FreeRide Duration="300" FlatRoad="0" />
        <SteadyState Duration="180" Power="1.1" pace="0" />
        <Cooldown Duration="600" PowerLow="0.75" PowerHigh="0.37" pace="0" />
    </workout>
</workout_file>