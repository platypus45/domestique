<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 3x40s (46min)</name>
    <description>Warmup: 10min from 50% to 82% FTP | Intervals: 3 x (40s @ 106% / 1min @ 88%) | Cooldown: 5min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.82" pace="0" />
        <Ramp Duration="120" PowerLow="0.9" PowerHigh="1.05" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="3" OnDuration="40" OffDuration="60" OnPower="1.06" OffPower="0.88" pace="0" />
        <SteadyState Duration="150" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="40" OffDuration="60" OnPower="1.08" OffPower="0.9" pace="0" />
        <SteadyState Duration="150" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="40" OffDuration="60" OnPower="1.09" OffPower="0.91" pace="0" />
        <SteadyState Duration="150" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="40" OffDuration="60" OnPower="1.1" OffPower="0.92" pace="0" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>