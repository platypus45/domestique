<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 3x2min (49min)</name>
    <description>Warmup: 10min from 50% to 80% FTP | Intervals: 3 x (2min @ 115% / 0s @ 55%) | Cooldown: 5min from 55% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.8" pace="0" />
        <Ramp Duration="60" PowerLow="0.8" PowerHigh="0.95" pace="0" />
        <SteadyState Duration="180" Power="0.6" pace="0" />
        <SteadyState Duration="120" Power="1.15" pace="0" />
        <SteadyState Duration="60" Power="0.95" pace="0" />
        <SteadyState Duration="60" Power="1.15" pace="0" />
        <SteadyState Duration="120" Power="0.95" pace="0" />
        <SteadyState Duration="360" Power="0.55" pace="0" />
        <SteadyState Duration="120" Power="1.15" pace="0" />
        <SteadyState Duration="60" Power="0.95" pace="0" />
        <SteadyState Duration="60" Power="1.15" pace="0" />
        <SteadyState Duration="120" Power="0.95" pace="0" />
        <SteadyState Duration="360" Power="0.55" pace="0" />
        <SteadyState Duration="120" Power="1.15" pace="0" />
        <SteadyState Duration="60" Power="0.95" pace="0" />
        <SteadyState Duration="60" Power="1.15" pace="0" />
        <SteadyState Duration="120" Power="0.95" pace="0" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>