<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 3x2min (45min)</name>
    <description>Warmup: 10min from 50% to 80% FTP | Intervals: 3 x (2min @ 110% / 3min @ 65%) | Cooldown: 5min from 65% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="180" Power="0.6" pace="0" />
        <Ramp Duration="120" PowerLow="1.0" PowerHigh="1.08" pace="0" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <Ramp Duration="120" PowerLow="1.02" PowerHigh="1.1" pace="0" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <Ramp Duration="120" PowerLow="1.04" PowerHigh="1.12" pace="0" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <Ramp Duration="120" PowerLow="1.06" PowerHigh="1.14" pace="0" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <Ramp Duration="120" PowerLow="1.08" PowerHigh="1.16" pace="0" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <Ramp Duration="120" PowerLow="1.1" PowerHigh="1.18" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>