<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 3x3min (65min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 3 x (3min @ 106% / 3min @ 55%) | Cooldown: 7min from 75% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="300" Power="1.05" pace="0" />
        <SteadyState Duration="300" Power="0.55" pace="0" />
        <SteadyState Duration="180" Power="1.06" pace="0" Cadence="85" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="180" Power="1.06" pace="0" Cadence="85" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="180" Power="1.06" pace="0" Cadence="85" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="120" Power="1.06" pace="0" Cadence="70" />
        <SteadyState Duration="240" Power="0.55" pace="0" Cadence="85" />
        <SteadyState Duration="120" Power="1.06" pace="0" Cadence="70" />
        <SteadyState Duration="240" Power="0.55" pace="0" />
        <SteadyState Duration="120" Power="1.06" pace="0" Cadence="70" />
        <SteadyState Duration="240" Power="0.55" pace="0" />
        <Cooldown Duration="420" PowerLow="0.75" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>