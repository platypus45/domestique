<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 3x4min (103min)</name>
    <description>Warmup: 15min from 49% to 92% FTP | Intervals: 3 x (4min @ 111% / 4min @ 49%) | Cooldown: 15min from 54% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.49" PowerHigh="0.92" pace="0" />
        <SteadyState Duration="180" Power="0.51" pace="0" />
        <IntervalsT Repeat="2" OnDuration="30" OffDuration="150" OnPower="1.23" OffPower="0.49" pace="0" Cadence="100" CadenceResting="100" />
        <IntervalsT Repeat="1" OnDuration="1200" OffDuration="600" OnPower="0.95" OffPower="0.49" pace="0" />
        <IntervalsT Repeat="3" OnDuration="240" OffDuration="240" OnPower="1.11" OffPower="0.49" pace="0" />
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="1.23" OffPower="0.68" pace="0" />
        <Cooldown Duration="900" PowerLow="0.54" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>