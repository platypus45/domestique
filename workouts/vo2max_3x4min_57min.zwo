<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 3x4min (57min)</name>
    <description>Intervals: 3 x (4min @ 105% / 4min @ 65%) | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="30" OffDuration="30" OnPower="0.65" OffPower="0.85" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.85" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="1.02" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Ramp Duration="300" PowerLow="0.75" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="240" OffDuration="240" OnPower="1.05" OffPower="0.65" pace="0" />
        <Ramp Duration="300" PowerLow="0.75" PowerHigh="0.9" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
    </workout>
</workout_file>