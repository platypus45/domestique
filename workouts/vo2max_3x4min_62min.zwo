<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 3x4min (62min)</name>
    <description>Warmup: 14min from 50% to 75% FTP | Intervals: 3 x (4min @ 112% / 4min @ 50%) | Cooldown: 15min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="840" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="60" Power="1.0" pace="0" />
        <SteadyState Duration="60" Power="0.75" pace="0" />
        <SteadyState Duration="60" Power="1.0" pace="0" />
        <SteadyState Duration="120" Power="0.7" pace="0" />
        <IntervalsT Repeat="3" OnDuration="240" OffDuration="240" OnPower="1.12" OffPower="0.5" pace="0" />
        <SteadyState Duration="240" Power="1.12" pace="0" />
        <Cooldown Duration="900" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>