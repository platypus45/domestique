<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 3x5min (70min)</name>
    <description>Warmup: 15min from 50% to 75% FTP | Intervals: 3 x (5min @ 112% / 5min @ 50%) | Cooldown: 15min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="60" Power="1.0" pace="0" />
        <SteadyState Duration="60" Power="0.75" pace="0" />
        <SteadyState Duration="60" Power="1.0" pace="0" />
        <SteadyState Duration="120" Power="0.7" pace="0" />
        <IntervalsT Repeat="3" OnDuration="300" OffDuration="300" OnPower="1.12" OffPower="0.5" pace="0" />
        <SteadyState Duration="300" Power="1.12" pace="0" />
        <Cooldown Duration="900" PowerLow="0.60" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>