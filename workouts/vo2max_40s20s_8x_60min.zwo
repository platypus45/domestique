<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 40s/20s 8x (63min)</name>
    <description>Warmup: 10min from 55% to 80% FTP | Microintervals: 8 x (40s @ 110% / 20s @ 50%)</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.55" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="120" Power="0.6" pace="0" />
        <IntervalsT Repeat="4" OnDuration="40" OffDuration="20" OnPower="1.1" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.6" pace="0" />
        <Ramp Duration="240" PowerLow="0.85" PowerHigh="1.2" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Ramp Duration="240" PowerLow="0.85" PowerHigh="1.2" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Ramp Duration="240" PowerLow="0.85" PowerHigh="1.2" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Ramp Duration="240" PowerLow="0.85" PowerHigh="1.2" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Ramp Duration="240" PowerLow="0.85" PowerHigh="1.2" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <Ramp Duration="240" PowerLow="0.85" PowerHigh="1.2" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="40" OffDuration="20" OnPower="1.1" OffPower="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.50" PowerHigh="0.40" /></workout>
</workout_file>