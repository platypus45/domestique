<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 4min ramp-down 4x (49min)</name>
    <description>Warmup: 7min ramp from 45% to 75% FTP, 3 x 30s fast-pedal drill @ 82%, primer 1min @ 88% + 2min @ 106% | Descending-target reps: 4 x (4min falling steadily from 120% down to 95% FTP), 4min @ 50% between reps — the target drops as fatigue builds, so the rep holds to the last second instead of fading unplanned | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="420" PowerLow="0.45" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="30" Power="0.82" pace="0" Cadence="110" />
        <SteadyState Duration="30" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="30" Power="0.82" pace="0" Cadence="110" />
        <SteadyState Duration="30" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="30" Power="0.82" pace="0" Cadence="110" />
        <SteadyState Duration="30" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="60" Power="0.88" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="120" Power="1.06" pace="0" />
        <SteadyState Duration="120" Power="0.45" pace="0" />
        <Ramp Duration="240" PowerLow="1.2" PowerHigh="0.95" pace="0" Cadence="85" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <Ramp Duration="240" PowerLow="1.2" PowerHigh="0.95" pace="0" Cadence="85" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <Ramp Duration="240" PowerLow="1.2" PowerHigh="0.95" pace="0" Cadence="85" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <Ramp Duration="240" PowerLow="1.2" PowerHigh="0.95" pace="0" Cadence="85" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>