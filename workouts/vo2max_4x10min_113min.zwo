<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 4x10min (113min)</name>
    <description>Warmup: 10min from 55% to 72% FTP | Intervals: 4 x (10min @ 100% / 10min @ 72%) | Cooldown: 5min from 60% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.55" PowerHigh="0.72" pace="0" />
        <IntervalsT Repeat="4" OnDuration="600" OffDuration="600" OnPower="1.0" OffPower="0.72" pace="0" />
        <SteadyState Duration="600" Power="0.72" pace="0" />
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="1.0" OffPower="0.72" pace="0" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>