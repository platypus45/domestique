<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 4x1min (76min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 4 x (1min @ 85% / 1min @ 55%) | Cooldown: 10min from 50% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="0.85" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="0.9" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="0.95" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="1.0" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="1.05" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="1.1" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="20" OffDuration="100" OnPower="1.3" OffPower="0.5" pace="0" />
        <Cooldown Duration="600" PowerLow="0.50" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>