<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 4x1min (63min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 4 x (1min @ 100% / 1min @ 108%) | Cooldown: 6min from 50% to 24% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="120" Power="1.1" pace="0" />
        <SteadyState Duration="90" Power="0.5" pace="0" />
        <SteadyState Duration="60" Power="1.0" pace="0" />
        <Ramp Duration="60" PowerLow="1.01" PowerHigh="1.08" pace="0" />
        <SteadyState Duration="60" Power="1.08" pace="0" />
        <Ramp Duration="60" PowerLow="1.08" PowerHigh="1.0" pace="0" />
        <SteadyState Duration="60" Power="1.0" pace="0" />
        <Ramp Duration="60" PowerLow="1.01" PowerHigh="1.09" pace="0" />
        <SteadyState Duration="60" Power="1.1" pace="0" />
        <Ramp Duration="60" PowerLow="1.09" PowerHigh="1.01" pace="0" />
        <SteadyState Duration="180" Power="0.59" pace="0" />
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="1.0" OffPower="1.08" pace="0" />
        <SteadyState Duration="240" Power="0.6" pace="0" />
        <SteadyState Duration="120" Power="0.9" pace="0" />
        <SteadyState Duration="120" Power="0.95" pace="0" />
        <SteadyState Duration="120" Power="1.0" pace="0" />
        <SteadyState Duration="120" Power="1.05" pace="0" />
        <SteadyState Duration="300" Power="0.59" pace="0" />
        <IntervalsT Repeat="6" OnDuration="30" OffDuration="45" OnPower="1.19" OffPower="0.5" pace="0" />
        <Cooldown Duration="360" PowerLow="0.50" PowerHigh="0.24" pace="0" />
    </workout>
</workout_file>