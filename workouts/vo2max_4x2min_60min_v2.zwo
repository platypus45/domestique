<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 4x2min (60min)</name>
    <description>Warmup: 9min from 50% to 80% FTP | Intervals: 4 x (2min @ 115% / 2min @ 55%) | Cooldown: 5min from 55% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="540" PowerLow="0.5" PowerHigh="0.8" pace="0" Cadence="90" />
        <SteadyState Duration="120" Power="0.55" pace="0" Cadence="90" />
        <SteadyState Duration="180" Power="0.8" pace="0" Cadence="95" />
        <SteadyState Duration="120" Power="0.55" pace="0" Cadence="90" />
        <Ramp Duration="120" PowerLow="0.9" PowerHigh="1.1" pace="0" Cadence="95" />
        <SteadyState Duration="360" Power="0.55" pace="0" Cadence="90" />
        <FreeRide Duration="240" FlatRoad="0" />
        <SteadyState Duration="30" Power="0.3" pace="0" />
        <SteadyState Duration="60" Power="0.45" pace="0" />
        <SteadyState Duration="480" Power="0.55" pace="0" Cadence="90" />
        <SteadyState Duration="90" Power="0.45" pace="0" Cadence="90" />
        <IntervalsT Repeat="4" OnDuration="120" OffDuration="120" OnPower="1.15" OffPower="0.55" pace="0" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.40" pace="0" Cadence="90" />
    </workout>
</workout_file>