<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 4x5min (46min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 4 x (5min @ 106% / 2min 30s @ 50%) | Cooldown: 6min from 50% to 45% FTP</description>
