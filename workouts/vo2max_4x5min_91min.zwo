<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 4x5min (91min)</name>
    <description>Warmup: 10min from 30% to 80% FTP | Intervals: 4 x (5min @ 106% / 5min @ 83%) | Cooldown: 5min from 75% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.3" PowerHigh="0.8" pace="0" />
        <IntervalsT Repeat="3" OnDuration="180" OffDuration="180" OnPower="1.06" OffPower="0.95" pace="0" />
        <SteadyState Duration="900" Power="0.64" pace="0" />
        <IntervalsT Repeat="3" OnDuration="40" OffDuration="20" OnPower="2.05" OffPower="0.71" pace="0" />
        <IntervalsT Repeat="4" OnDuration="300" OffDuration="300" OnPower="1.06" OffPower="0.83" pace="0" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>