<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 4x6min (66min)</name>
    <description>Warmup: 6min @ 50% FTP | Intervals: 4 x (6min @ 110% / 5min @ 50%) | Cooldown: 5min ramp from 50% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <Ramp Duration="60" PowerLow="0.5" PowerHigh="0.72" pace="0" />
        <SteadyState Duration="300" Power="0.72" pace="0" />
        <Ramp Duration="60" PowerLow="0.72" PowerHigh="0.96" pace="0" />
        <SteadyState Duration="120" Power="0.96" pace="0" />
        <FreeRide Duration="120" FlatRoad="0" />
        <IntervalsT Repeat="4" OnDuration="360" OffDuration="300" OnPower="1.1" OffPower="0.5" pace="0" />
    <Cooldown Duration="300" PowerLow="0.50" PowerHigh="0.40" /></workout>
</workout_file>