<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 5x2min (60min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Intervals: 5 x (2min 30s @ 115% / 3min @ 55%) | Cooldown: 7min 30s from 90% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="0.95" OffPower="0.5" pace="0" Cadence="95" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.05" OffPower="0.5" pace="0" Cadence="105" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.15" OffPower="0.5" pace="0" Cadence="115" CadenceResting="85" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <IntervalsT Repeat="5" OnDuration="150" OffDuration="180" OnPower="1.15" OffPower="0.55" pace="0" Cadence="105" CadenceResting="85" />
        <SteadyState Duration="600" Power="0.9" pace="0" Cadence="90" />
        <Cooldown Duration="450" PowerLow="0.9" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>