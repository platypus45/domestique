<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 5x3min (56min)</name>
    <description>Warmup: 5min from 50% to 55% FTP | Intervals: 5 x (3min @ 110% / 4min @ 50%) | Cooldown: 5min from 55% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="150" Power="0.5" pace="0" />
        <SteadyState Duration="150" Power="0.55" pace="0" />
        <SteadyState Duration="150" Power="0.6" pace="0" />
        <SteadyState Duration="150" Power="0.65" pace="0" />
        <IntervalsT Repeat="4" OnDuration="30" OffDuration="30" OnPower="1.05" OffPower="0.55" pace="0" />
        <SteadyState Duration="120" Power="0.75" pace="0" />
        <IntervalsT Repeat="5" OnDuration="180" OffDuration="240" OnPower="1.1" OffPower="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>