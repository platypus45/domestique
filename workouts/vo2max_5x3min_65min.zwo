<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 5x3min (65min)</name>
    <description>Warmup: 6min from 50% to 75% FTP | Intervals: 5 x (3min @ 115% / 1min 30s @ 50%) | Cooldown: 8min from 60% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="360" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="600" Power="1.0" pace="0" />
        <SteadyState Duration="240" Power="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="180" OffDuration="90" OnPower="1.15" OffPower="0.5" pace="0" />
        <SteadyState Duration="150" Power="0.5" pace="0" />
        <SteadyState Duration="600" Power="1.0" pace="0" />
        <Cooldown Duration="480" PowerLow="0.6" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>