<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 5x5min (60min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Intervals: 5 x (5min @ 106% / 3min @ 47%) | Cooldown: 10min from 47% to 25% FTP</description>
