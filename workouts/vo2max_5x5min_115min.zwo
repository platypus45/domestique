<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 5x5min (116min)</name>
    <description>Warmup: 10min from 40% to 80% FTP | Intervals: 5 x (5min @ 85% / 1min @ 100%) | Cooldown: 5min ramp from 75% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.4" PowerHigh="0.8" pace="0" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="0.9" OffPower="0.55" pace="0" Cadence="95" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.0" OffPower="0.55" pace="0" Cadence="105" CadenceResting="85" />
        <IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.1" OffPower="0.55" pace="0" Cadence="115" CadenceResting="85" />
        <SteadyState Duration="120" Power="0.55" pace="0" Cadence="85" />
        <IntervalsT Repeat="5" OnDuration="180" OffDuration="180" OnPower="1.15" OffPower="0.65" pace="0" Cadence="100" CadenceResting="85" />
        <SteadyState Duration="300" Power="0.55" pace="0" Cadence="85" />
        <IntervalsT Repeat="10" OnDuration="60" OffDuration="60" OnPower="1.0" OffPower="0.75" pace="0" Cadence="95" CadenceResting="65" />
        <SteadyState Duration="300" Power="0.55" pace="0" Cadence="85" />
        <IntervalsT Repeat="1" OnDuration="300" OffDuration="60" OnPower="0.85" OffPower="1.0" pace="0" Cadence="90" CadenceResting="105" />
        <IntervalsT Repeat="1" OnDuration="300" OffDuration="60" OnPower="0.85" OffPower="1.0" pace="0" Cadence="80" CadenceResting="95" />
        <IntervalsT Repeat="1" OnDuration="300" OffDuration="60" OnPower="0.85" OffPower="1.0" pace="0" Cadence="70" CadenceResting="85" />
        <SteadyState Duration="60" Power="0.85" pace="0" Cadence="85" />
        <SteadyState Duration="60" Power="0.85" pace="0" Cadence="60" />
        <SteadyState Duration="60" Power="0.85" pace="0" Cadence="85" />
        <SteadyState Duration="60" Power="0.85" pace="0" Cadence="60" />
        <SteadyState Duration="60" Power="0.85" pace="0" Cadence="85" />
        <SteadyState Duration="60" Power="1.0" pace="0" Cadence="100" />
        <IntervalsT Repeat="1" OnDuration="300" OffDuration="60" OnPower="0.85" OffPower="1.0" pace="0" Cadence="80" CadenceResting="95" />
        <IntervalsT Repeat="1" OnDuration="300" OffDuration="60" OnPower="0.85" OffPower="1.0" pace="0" Cadence="90" CadenceResting="105" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.4" /></workout>
</workout_file>