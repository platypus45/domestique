<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 2x5min (105min)</name>
    <description>Warmup: 15min from 25% to 75% FTP | Intervals: 2 x (5min @ 105% / 3min @ 65%) | Cooldown: 14min from 65% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="6" OnDuration="30" OffDuration="120" OnPower="1.2" OffPower="0.9" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <IntervalsT Repeat="6" OnDuration="30" OffDuration="120" OnPower="1.2" OffPower="0.9" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <IntervalsT Repeat="6" OnDuration="30" OffDuration="120" OnPower="1.2" OffPower="0.9" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <IntervalsT Repeat="2" OnDuration="300" OffDuration="180" OnPower="1.05" OffPower="0.65" pace="0" />
        <Cooldown Duration="840" PowerLow="0.65" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>