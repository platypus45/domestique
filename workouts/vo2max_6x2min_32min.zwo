<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 6x2min (32min)</name>
    <description>Warmup: 7min from 25% to 75% FTP | Intervals: 6 x (2min @ 114% / 30s @ 25%) | Cooldown: 3min from 57% to 36% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="420" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="6" OnDuration="120" OffDuration="30" OnPower="1.14" OffPower="0.25" pace="0" />
        <SteadyState Duration="420" Power="0.57" pace="0" />
        <Cooldown Duration="180" PowerLow="0.57" PowerHigh="0.36" pace="0" />
    </workout>
</workout_file>