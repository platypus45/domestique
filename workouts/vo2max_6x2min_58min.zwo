<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 6x2min (58min)</name>
    <description>Warmup: 7min from 44% to 75% FTP | Intervals: 6 x (2min 30s @ 110% / 2min 30s @ 30%) | Cooldown: 8min 30s from 30% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="420" PowerLow="0.44" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="30" Power="1.09" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.09" pace="0" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <IntervalsT Repeat="3" OnDuration="150" OffDuration="150" OnPower="1.1" OffPower="0.3" pace="0" Cadence="65" CadenceResting="90" />
        <SteadyState Duration="480" Power="0.8" pace="0" />
        <IntervalsT Repeat="3" OnDuration="150" OffDuration="150" OnPower="1.1" OffPower="0.3" pace="0" />
        <SteadyState Duration="360" Power="0.4" pace="0" />
    </workout>
</workout_file>