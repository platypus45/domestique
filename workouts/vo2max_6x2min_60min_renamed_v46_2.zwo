<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 6x2min (68min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 6 x (2min @ 107% / 2min @ 55%) | Cooldown: 5min ramp from 75% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="1" OnDuration="30" OffDuration="30" OnPower="1.02" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="20" OffDuration="40" OnPower="1.05" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="10" OffDuration="50" OnPower="1.07" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="120" OnPower="1.07" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="2" OnDuration="180" OffDuration="120" OnPower="1.05" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="240" OffDuration="120" OnPower="1.02" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="2" OnDuration="180" OffDuration="120" OnPower="1.05" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="120" OnPower="1.07" OffPower="0.55" pace="0" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.4" /></workout>
</workout_file>