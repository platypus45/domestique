<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Race Intervals 5x (56min)</name>
    <description>Warmup: 5min ramp from 35% to 75% FTP | Priming: 3 x (30s @ 100% / 30s @ 50%) + 2min @ 40% | Main: 5 x (30s attack @ 145%, settle 3min @ 110% over threshold, 10s finishing kick @ 180% - capped at library max from CP-calibrated source, 275s @ 50% rest) - race attack simulation | Cooldown: 1min @ 40% + 5min ramp from 40% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.35" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="30" OnPower="1.0" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.4" pace="0" />
        <SteadyState Duration="30" Power="1.45" pace="0" />
