<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 6x3min (62min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Intervals: 6 x (3min @ 110% / 5min @ 50%) | Cooldown: 5min from 50% to 25% FTP</description>
