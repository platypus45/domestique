<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 6x3min (81min)</name>
    <description>Warmup: 10min from 30% to 80% FTP | Intervals: 6 x (3min @ 106% / 3min @ 95%) | Cooldown: 5min from 75% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.3" PowerHigh="0.8" pace="0" />
        <IntervalsT Repeat="3" OnDuration="180" OffDuration="180" OnPower="1.06" OffPower="0.95" pace="0" />
        <SteadyState Duration="900" Power="0.6" pace="0" />
        <IntervalsT Repeat="3" OnDuration="180" OffDuration="180" OnPower="1.06" OffPower="0.95" pace="0" />
        <SteadyState Duration="900" Power="0.6" pace="0" />
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>