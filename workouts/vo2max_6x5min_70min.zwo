<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 6x5min (70min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Intervals: 6 x (5min @ 110% / 3min @ 65%) | Cooldown: 9min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="0.75" OffPower="0.5" pace="0" Cadence="110" CadenceResting="80" />
        <Ramp Duration="300" PowerLow="1.2" PowerHigh="1.0" pace="0" Cadence="85" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <Ramp Duration="300" PowerLow="1.2" PowerHigh="1.0" pace="0" Cadence="85" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <Ramp Duration="300" PowerLow="1.2" PowerHigh="1.0" pace="0" Cadence="85" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <Ramp Duration="300" PowerLow="1.2" PowerHigh="1.0" pace="0" Cadence="85" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <Ramp Duration="300" PowerLow="1.2" PowerHigh="1.0" pace="0" Cadence="85" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <Ramp Duration="300" PowerLow="1.2" PowerHigh="1.0" pace="0" Cadence="85" />
        <Cooldown Duration="540" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>