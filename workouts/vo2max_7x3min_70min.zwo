<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 7x3min (70min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Intervals: 7 x (3min @ 113% / 4min @ 65%) | Cooldown: 9min from 65% to 25% FTP</description>
