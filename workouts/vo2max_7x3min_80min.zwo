<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 7x3min (80min)</name>
    <description>Warmup: 7min from 44% to 75% FTP | Intervals: 7 x (3min @ 115% / 5min @ 50%) | Cooldown: 10min @ 50% FTP</description>
