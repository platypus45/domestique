<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 2x5min (106min)</name>
    <description>Warmup: 15min from 25% to 75% FTP | Intervals: 2 x (5min @ 110% / 3min @ 50%) | Cooldown: 15min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="8" OnDuration="30" OffDuration="120" OnPower="1.2" OffPower="0.9" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <IntervalsT Repeat="8" OnDuration="30" OffDuration="120" OnPower="1.2" OffPower="0.9" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <IntervalsT Repeat="2" OnDuration="300" OffDuration="180" OnPower="1.1" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="60" OnPower="0.75" OffPower="0.5" pace="0" />
        <Cooldown Duration="900" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>