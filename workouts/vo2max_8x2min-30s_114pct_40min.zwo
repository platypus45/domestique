<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 8x2min (40min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 8 x (2min @ 114% / 30s @ 26%) | Cooldown: 3min from 57% to 36% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="8" OnDuration="120" OffDuration="30" OnPower="1.14" OffPower="0.26" pace="0" />
        <SteadyState Duration="420" Power="0.57" pace="0" />
        <Cooldown Duration="180" PowerLow="0.57" PowerHigh="0.36" pace="0" />
    </workout>
</workout_file>