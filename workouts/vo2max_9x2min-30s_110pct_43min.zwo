<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 9x2min (43min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 9 x (2min @ 110% / 30s @ 25%) | Cooldown: 3min from 57% to 36% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="630" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="9" OnDuration="120" OffDuration="30" OnPower="1.1" OffPower="0.25" pace="0" />
        <SteadyState Duration="420" Power="0.57" pace="0" />
        <Cooldown Duration="180" PowerLow="0.57" PowerHigh="0.36" pace="0" />
    </workout>
</workout_file>