<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance 2x30s (30min)</name>
    <description>Warmup: 8min from 40% to 53% FTP | Intervals: 2 x (30s @ 120% / 30s @ 55%) | Cooldown: 2min from 55% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="240" Power="0.4" pace="0" Cadence="80" />
        <SteadyState Duration="240" Power="0.53" pace="0" Cadence="90" />
        <SteadyState Duration="240" Power="0.67" pace="0" Cadence="100" />
        <SteadyState Duration="240" Power="0.8" pace="0" Cadence="110" />
        <SteadyState Duration="120" Power="0.55" pace="0" Cadence="85" />
        <SteadyState Duration="180" Power="1.05" pace="0" Cadence="100" />
        <SteadyState Duration="120" Power="0.55" pace="0" Cadence="85" />
        <SteadyState Duration="60" Power="1.15" pace="0" Cadence="110" />
        <SteadyState Duration="120" Power="0.55" pace="0" Cadence="85" />
        <IntervalsT Repeat="2" OnDuration="30" OffDuration="30" OnPower="1.2" OffPower="0.55" pace="0" Cadence="110" CadenceResting="85" />
        <Cooldown Duration="120" PowerLow="0.55" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>