<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 2x30s (33min)</name>
    <description>Warmup: 4min from 40% to 50% FTP | Intervals: 2 x (30s @ 122% / 30s @ 55%) | Cooldown: 5min ramp from 55% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="240" PowerLow="0.4" PowerHigh="0.5" pace="0" Cadence="80" />
        <Ramp Duration="240" PowerLow="0.5" PowerHigh="0.6" pace="0" Cadence="90" />
        <Ramp Duration="240" PowerLow="0.6" PowerHigh="0.7" pace="0" Cadence="95" />
        <Ramp Duration="240" PowerLow="0.7" PowerHigh="0.8" pace="0" Cadence="100" />
        <SteadyState Duration="120" Power="0.55" pace="0" Cadence="85" />
        <SteadyState Duration="180" Power="1.1" pace="0" Cadence="100" />
        <SteadyState Duration="120" Power="0.55" pace="0" Cadence="85" />
        <SteadyState Duration="60" Power="1.15" pace="0" Cadence="110" />
        <SteadyState Duration="120" Power="0.55" pace="0" Cadence="85" />
        <IntervalsT Repeat="2" OnDuration="30" OffDuration="30" OnPower="1.22" OffPower="0.55" pace="0" Cadence="110" CadenceResting="85" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.40" /></workout>
</workout_file>