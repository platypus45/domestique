<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 2x3min (52min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 2 x (3min @ 115% / 4min @ 55%) | Cooldown: 5min from 55% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="2" OnDuration="30" OffDuration="30" OnPower="1.15" OffPower="0.55" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="120" OffDuration="180" OnPower="1.2" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="180" OffDuration="240" OnPower="1.15" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="240" OffDuration="300" OnPower="1.1" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="180" OffDuration="240" OnPower="1.15" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="120" OffDuration="180" OnPower="1.2" OffPower="0.55" pace="0" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.35" pace="0" />
    </workout>
</workout_file>