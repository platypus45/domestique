<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 3x30s (66min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Intervals: 3 x (30s @ 115% / 30s @ 50%) | Cooldown: 10min from 65% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="30" OnPower="1.15" OffPower="0.5" pace="0" />
        <FreeRide Duration="120" FlatRoad="0" />
        <SteadyState Duration="900" Power="0.88" pace="0" />
        <SteadyState Duration="60" Power="1.15" pace="0" />
        <SteadyState Duration="600" Power="0.88" pace="0" />
        <SteadyState Duration="60" Power="1.15" pace="0" />
        <SteadyState Duration="300" Power="0.88" pace="0" />
        <SteadyState Duration="60" Power="1.15" pace="0" />
        <SteadyState Duration="150" Power="0.88" pace="0" />
        <SteadyState Duration="60" Power="1.15" pace="0" />
        <SteadyState Duration="60" Power="0.88" pace="0" />
        <SteadyState Duration="60" Power="1.15" pace="0" />
        <SteadyState Duration="30" Power="0.88" pace="0" />
        <SteadyState Duration="60" Power="1.15" pace="0" />
        <SteadyState Duration="15" Power="0.88" pace="0" />
        <SteadyState Duration="60" Power="1.15" pace="0" />
        <Cooldown Duration="600" PowerLow="0.65" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>