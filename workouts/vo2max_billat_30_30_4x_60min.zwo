<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 3x3min (60min)</name>
    <description>Warmup: 8min from 50% to 80% FTP | Intervals: 3 x (3min @ 110% / 3min @ 60%) | Cooldown: 8min from 80% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.8" pace="0" />
        <SteadyState Duration="60" Power="0.6" pace="0" />
        <IntervalsT Repeat="4" OnDuration="30" OffDuration="30" OnPower="1.2" OffPower="0.5" pace="0" />
        <SteadyState Duration="60" Power="0.6" pace="0" />
        <IntervalsT Repeat="3" OnDuration="180" OffDuration="180" OnPower="1.1" OffPower="0.6" pace="0" />
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="120" OnPower="1.15" OffPower="0.6" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="1.2" OffPower="0.6" pace="0" />
        <SteadyState Duration="120" Power="0.65" pace="0" />
        <Cooldown Duration="480" PowerLow="0.8" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>