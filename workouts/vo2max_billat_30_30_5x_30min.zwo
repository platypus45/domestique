<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 5x40s (37min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 5 x (40s @ 110% / 20s @ 50%) | Cooldown: 5min ramp from 60% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="5" OnDuration="30" OffDuration="30" OnPower="1.2" OffPower="0.5" pace="0" />
        <Ramp Duration="150" PowerLow="0.6" PowerHigh="1.05" pace="0" />
        <Ramp Duration="150" PowerLow="1.05" PowerHigh="0.6" pace="0" />
        <Ramp Duration="150" PowerLow="0.6" PowerHigh="1.05" pace="0" />
        <Ramp Duration="150" PowerLow="1.05" PowerHigh="0.6" pace="0" />
        <IntervalsT Repeat="5" OnDuration="40" OffDuration="20" OnPower="1.1" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.95" pace="0" />
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.40" /></workout>
</workout_file>