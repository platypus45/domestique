<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 12x3min (105min)</name>
    <description>Warmup: 14min from 50% to 75% FTP | Intervals: 12 x (3min @ 110% / 3min @ 50%) | Cooldown: 9min from 50% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="840" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="4" OnDuration="180" OffDuration="180" OnPower="1.1" OffPower="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="180" OffDuration="180" OnPower="1.1" OffPower="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="180" OffDuration="180" OnPower="1.1" OffPower="0.5" pace="0" />
        <Cooldown Duration="540" PowerLow="0.50" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>