<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 20s/40s 10x (30min)</name>
    <description>Warmup: 12min from 50% to 75% FTP | Microintervals: 10 x (20s @ 120% / 40s @ 50%) | Cooldown: 8min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="720" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="10" OnDuration="20" OffDuration="40" OnPower="1.2" OffPower="0.5" pace="0" />
        <Cooldown Duration="480" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>