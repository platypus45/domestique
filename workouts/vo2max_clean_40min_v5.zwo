<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 4x5min (40min)</name>
    <description>Warmup: 5min from 50% to 75% FTP | Intervals: 4 x (5min @ 108% / 2min 30s @ 50%) | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="4" OnDuration="300" OffDuration="150" OnPower="1.08" OffPower="0.5" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>