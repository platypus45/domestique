<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 8x2min (45min)</name>
    <description>Warmup: 8min from 50% to 75% FTP | Intervals: 8 x (2min @ 110% / 2min @ 55%) | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.50" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="8" OnDuration="120" OffDuration="120" OnPower="1.1" OffPower="0.55" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>