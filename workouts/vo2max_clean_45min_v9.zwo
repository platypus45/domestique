<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 5x3min (46min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 5 x (3min @ 115% / 3min @ 55%) | Cooldown: 6min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="5" OnDuration="180" OffDuration="180" OnPower="1.15" OffPower="0.55" pace="0" />
        <Cooldown Duration="360" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>