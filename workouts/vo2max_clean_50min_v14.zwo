<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 6x3min (52min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 6 x (3min @ 115% / 3min @ 55%) | Cooldown: 5min 30s from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="630" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="6" OnDuration="180" OffDuration="180" OnPower="1.15" OffPower="0.55" pace="0" />
        <Cooldown Duration="330" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>