<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 1min/1min 12x (51min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Microintervals: 12 x (1min @ 112% / 1min @ 50%) | Cooldown: 6min 30s from 50% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="630" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="1.12" OffPower="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="1.12" OffPower="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="1.12" OffPower="0.5" pace="0" />
        <Cooldown Duration="390" PowerLow="0.50" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>