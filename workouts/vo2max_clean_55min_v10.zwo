<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 7x3min (57min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 7 x (3min @ 112% / 3min @ 55%) | Cooldown: 5min from 65% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="7" OnDuration="180" OffDuration="180" OnPower="1.12" OffPower="0.55" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>