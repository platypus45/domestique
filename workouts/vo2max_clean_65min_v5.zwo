<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 7x3min (65min)</name>
    <description>Warmup: 14min from 50% to 75% FTP | Intervals: 7 x (3min @ 112% / 3min @ 55%) | Cooldown: 9min from 65% to 45% FTP</description>
