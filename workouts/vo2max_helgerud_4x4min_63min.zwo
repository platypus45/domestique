<?xml version='1.0' encoding='utf-8'?>
<workout_file>
  <author>Domestique Library</author>
  <name>VO2max 4x4min (63min)</name>
  <description>Warmup: 10min from 45% to 56% FTP | Intervals: 4 x (4min @ 115% / 3min @ 55%) | Cooldown: 15min from 55% to 40% FTP</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.56" />
    <SteadyState Duration="600" Power="0.68" />
    <IntervalsT Repeat="4" OnDuration="240" OffDuration="180" OnPower="1.15" OffPower="0.55" />
    <Cooldown Duration="900" PowerLow="0.55" PowerHigh="0.40" />
  </workout>
</workout_file>