<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max (34min)</name>
    <description>Warmup: 10min from 28% to 88% FTP | Steady: 2min @ 130% FTP | Steady: 4min @ 120% FTP | Steady: 12min @ 110% FTP | Steady: 30s @ 250% FTP | Cooldown: 5min from 12% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="120" Power="1.2" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <SteadyState Duration="240" Power="1.2" pace="0" />
        <SteadyState Duration="120" Power="0.5" pace="0" />
        <SteadyState Duration="720" Power="1.1" pace="0" />
        <SteadyState Duration="360" Power="0.5" pace="0" />
        <SteadyState Duration="15" Power="1.2" pace="0" />
        <SteadyState Duration="30" Power="0.5" pace="0" />
        <SteadyState Duration="15" Power="1.2" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>