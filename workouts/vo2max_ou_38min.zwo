<workout_file>
    <author>Domestique Library</author>
    <name>Mixed 4 cycles (46min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Over-Under: 4 cycles (alternating above/below threshold) | Cooldown: 5min ramp from 65% to 40% FTP</description>
