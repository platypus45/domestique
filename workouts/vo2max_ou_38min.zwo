        <SteadyState Duration="180" Power="0.95" pace="0" />
        <SteadyState Duration="240" Power="1.09" pace="0" />
        <SteadyState Duration="30" Power="0.65" pace="0" />
        <SteadyState Duration="30" Power="0.81" pace="0" />
        <SteadyState Duration="30" Power="0.95" pace="0" />
        <SteadyState Duration="33" Power="1.09" pace="0" />
        <SteadyState Duration="35" Power="1.25" pace="0" />
        <SteadyState Duration="240" Power="0.95" pace="0" />
        <SteadyState Duration="180" Power="1.09" pace="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <SteadyState Duration="180" Power="0.81" pace="0" />
        <SteadyState Duration="120" Power="1.09" pace="0" />
        <Cooldown Duration="322" PowerLow="0.65" PowerHigh="0.40" /></workout>
