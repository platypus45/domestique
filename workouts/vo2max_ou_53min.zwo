<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 3 cycles (53min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Over-Under: 3 cycles (alternating above/below threshold) | Cooldown: 8min from 65% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="60" Power="1.25" pace="0" />
        <SteadyState Duration="120" Power="0.81" pace="0" />
        <SteadyState Duration="120" Power="1.09" pace="0" />
        <SteadyState Duration="60" Power="0.93" pace="0" />
        <SteadyState Duration="47" Power="1.5" pace="0" />
        <Ramp Duration="180" PowerLow="1" PowerHigh="1.2" pace="0" />
        <SteadyState Duration="60" Power="0.87" pace="0" />
        <SteadyState Duration="60" Power="1.35" pace="0" />
        <SteadyState Duration="300" Power="0.76" pace="0" />
        <Ramp Duration="120" PowerLow="1.2" PowerHigh="1" pace="0" />
        <Ramp Duration="240" PowerLow="0.65" PowerHigh="1.1" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <SteadyState Duration="120" Power="1.35" pace="0" />
        <Ramp Duration="300" PowerLow="0.89" PowerHigh="1.3" pace="0" />
        <Cooldown Duration="480" PowerLow="0.65" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>