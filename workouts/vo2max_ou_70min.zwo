<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 3 cycles (70min)</name>
    <description>Warmup: 10min from 25% to 75% FTP | Over-Under: 3 cycles (alternating above/below threshold) | Cooldown: 8min from 75% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="0.75" OffPower="0.5" pace="0" Cadence="110" CadenceResting="80" />
        <SteadyState Duration="60" Power="1.25" pace="0" />
        <SteadyState Duration="120" Power="0.81" pace="0" />
        <SteadyState Duration="138" Power="1.09" pace="0" />
        <SteadyState Duration="72" Power="0.93" pace="0" />
        <SteadyState Duration="47" Power="1.5" pace="0" />
        <Ramp Duration="213" PowerLow="0.79" PowerHigh="1.2" pace="0" />
        <SteadyState Duration="300" Power="0.87" pace="0" />
        <SteadyState Duration="300" Power="1.09" pace="0" />
        <SteadyState Duration="300" Power="0.76" pace="0" />
        <Ramp Duration="154" PowerLow="1.0" PowerHigh="1.5" pace="0" />
        <Ramp Duration="300" PowerLow="0.65" PowerHigh="1.1" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <SteadyState Duration="133" Power="1.35" pace="0" />
        <Ramp Duration="323" PowerLow="0.89" PowerHigh="1.3" pace="0" />
        <Cooldown Duration="480" PowerLow="0.75" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>