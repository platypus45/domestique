<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max Ramp (75min)</name>
    <description>Warmup: 8min from 40% to 70% FTP | Ramp: 62min from 65% to 140% FTP | Cooldown: 5min from 140% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.4" PowerHigh="0.7" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.7" pace="0" />
        <SteadyState Duration="300" Power="0.75" pace="0" />
        <SteadyState Duration="240" Power="0.8" pace="0" />
        <SteadyState Duration="240" Power="0.85" pace="0" />
        <SteadyState Duration="240" Power="0.9" pace="0" />
        <SteadyState Duration="240" Power="0.95" pace="0" />
        <SteadyState Duration="240" Power="1.0" pace="0" />
        <SteadyState Duration="240" Power="1.05" pace="0" />
        <SteadyState Duration="240" Power="1.1" pace="0" />
        <SteadyState Duration="240" Power="1.15" pace="0" />
        <SteadyState Duration="180" Power="1.2" pace="0" />
        <SteadyState Duration="180" Power="1.25" pace="0" />
        <SteadyState Duration="180" Power="1.3" pace="0" />
        <SteadyState Duration="180" Power="1.35" pace="0" />
        <SteadyState Duration="180" Power="1.4" pace="0" />
        <Cooldown Duration="300" PowerLow="1.4" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>