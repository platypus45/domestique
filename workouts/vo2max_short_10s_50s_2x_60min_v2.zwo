<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 4x2min (65min)</name>
    <description>Warmup: 10min ramp from 50% to 75% FTP | Intervals: 4 x (2min @ 109% / 3min @ 75%) | Cooldown: 5min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" /><IntervalsT Repeat="2" OnDuration="10" OffDuration="50" OnPower="1.75" OffPower="0.5" pace="0" Cadence="110" CadenceResting="80" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="60" Power="1.09" pace="0" Cadence="95" />
        <SteadyState Duration="120" Power="0.5" pace="0" Cadence="85" />
        <SteadyState Duration="300" Power="0.9" pace="0" Cadence="95" />
        <SteadyState Duration="180" Power="0.5" pace="0" />
        <SteadyState Duration="900" Power="0.81" pace="0" Cadence="90" />
        <IntervalsT Repeat="4" OnDuration="120" OffDuration="180" OnPower="1.09" OffPower="0.75" pace="0" Cadence="95" CadenceResting="80" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
    </workout>
</workout_file>