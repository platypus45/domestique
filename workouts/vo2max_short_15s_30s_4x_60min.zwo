<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 2min/1min 12x (60min)</name>
    <description>Warmup: 5min from 45% to 75% FTP | Microintervals: 12 x (1min 30s @ 105% / 1min @ 50%) | Cooldown: 6min from 75% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.45" PowerHigh="0.75" pace="0" />
        <IntervalsT Repeat="4" OnDuration="15" OffDuration="30" OnPower="1.2" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.65" pace="0" />
        <IntervalsT Repeat="12" OnDuration="90" OffDuration="60" OnPower="1.05" OffPower="0.5" pace="0" />
        <SteadyState Duration="120" Power="0.65" pace="0" />
        <SteadyState Duration="720" Power="0.89" pace="0" />
        <Cooldown Duration="360" PowerLow="0.75" PowerHigh="0.4" pace="0" />
    </workout>
</workout_file>