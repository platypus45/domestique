<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 1min/1min 8x (80min)</name>
    <description>Warmup: 15min from 25% to 100% FTP | Microintervals: 8 x (1min @ 125% / 1min @ 50%) | Cooldown: 10min from 50% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.25" PowerHigh="1.0" pace="0" />
        <SteadyState Duration="60" Power="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="1.25" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="90" OffDuration="60" OnPower="1.25" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="120" OffDuration="300" OnPower="1.09" OffPower="0.5" pace="0" />
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="1.25" OffPower="0.5" pace="0" />
        <Cooldown Duration="600" PowerLow="0.50" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>