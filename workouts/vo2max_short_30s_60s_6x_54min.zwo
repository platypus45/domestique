<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 30s/1min 6x (54min)</name>
    <description>Warmup: 15min from 50% to 55% FTP | Microintervals: 6 x (30s @ 115% / 1min @ 88%) | Cooldown: 15min from 75% to 70% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.5" PowerHigh="0.55" pace="0" />
        <FreeRide Duration="900" FlatRoad="0" />
        <IntervalsT Repeat="6" OnDuration="30" OffDuration="60" OnPower="1.15" OffPower="0.88" pace="0" />
        <Cooldown Duration="900" PowerLow="0.75" PowerHigh="0.7" pace="0" />
    </workout>
</workout_file>