<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Over-Under 2x1min (30min)</name>
    <description>Warmup: 5min from 30% to 70% FTP | Intervals: 2 x (1min @ 150% / 30s @ 64%) | Cooldown: 3min from 70% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.3" PowerHigh="0.7" pace="0" />
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="30" OnPower="1.5" OffPower="0.64" pace="0" />
        <SteadyState Duration="120" Power="0.75" pace="0" />
        <SteadyState Duration="10" Power="1.5" pace="0" />
        <SteadyState Duration="60" Power="0.75" pace="0" />
        <SteadyState Duration="10" Power="2.0" pace="0" />
        <SteadyState Duration="60" Power="0.75" pace="0" />
        <SteadyState Duration="10" Power="2.5" pace="0" />
        <SteadyState Duration="240" Power="0.6" pace="0" />
        <Ramp Duration="600" PowerLow="0.65" PowerHigh="0.89" pace="0" />
        <Cooldown Duration="180" PowerLow="0.7" PowerHigh="0.3" pace="0" />
    </workout>
</workout_file>