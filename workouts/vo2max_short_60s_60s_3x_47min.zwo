<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>VO2max 1min/1min 6x (48min)</name>
    <description>Warmup: 5min from 30% to 50% FTP | Microintervals: 6 x (1min @ 115% / 1min @ 40%) | Cooldown: 5min from 50% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.3" PowerHigh="0.5" pace="0" />
        <SteadyState Duration="180" Power="0.65" pace="0" Cadence="60" />
        <SteadyState Duration="120" Power="0.4" pace="0" />
        <SteadyState Duration="30" Power="0.85" pace="0" Cadence="95" />
        <SteadyState Duration="30" Power="0.4" pace="0" />
        <SteadyState Duration="30" Power="0.95" pace="0" Cadence="100" />
        <SteadyState Duration="30" Power="0.4" pace="0" />
        <SteadyState Duration="30" Power="1.08" pace="0" Cadence="110" />
        <SteadyState Duration="30" Power="0.4" pace="0" />
        <SteadyState Duration="30" Power="0.85" pace="0" Cadence="95" />
        <SteadyState Duration="30" Power="0.4" pace="0" />
        <SteadyState Duration="30" Power="0.95" pace="0" Cadence="100" />
        <SteadyState Duration="30" Power="0.4" pace="0" />
        <SteadyState Duration="30" Power="1.08" pace="0" Cadence="110" />
        <SteadyState Duration="180" Power="0.65" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="1.15" OffPower="0.4" pace="0" />
        <SteadyState Duration="180" Power="0.4" pace="0" />
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="1.15" OffPower="0.4" pace="0" />
        <SteadyState Duration="180" Power="0.4" pace="0" />
        <IntervalsT Repeat="6" OnDuration="15" OffDuration="45" OnPower="1.3" OffPower="0.4" pace="0" />
        <Cooldown Duration="300" PowerLow="0.5" PowerHigh="0.3" pace="0" />
    </workout>
</workout_file>