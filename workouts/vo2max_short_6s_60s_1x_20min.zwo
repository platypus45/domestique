<workout_file>
    <author>Domestique Library</author>
    <name>Mixed (24min)</name>
    <description>Warmup: 9min ramp from 50% to 75% FTP | Steady: 2min @ 60% FTP | Steady: 2min @ 70% FTP | Steady: 2min @ 85% FTP | Steady: 1min 30s @ 100% FTP | Steady: 30s @ 110% FTP | Steady: 2min @ 55% FTP | Steady: 6s @ 150% FTP | Steady: 1min @ 55% FTP | Steady: 6s @ 175% FTP | Steady: 1min @ 55% FTP | Steady: 6s @ 200% FTP | Steady: 1min @ 55% FTP | Cooldown: 5min ramp from 75% to 40% FTP</description>
    <sportType>bike</sportType>
    <workout>
