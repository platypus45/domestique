<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (20min)</name>
    <description>Warmup: 5min from 35% to 55% FTP | Steady: 2min @ 60% FTP | Steady: 2min @ 70% FTP | Steady: 2min @ 85% FTP | Steady: 1min 30s @ 100% FTP | Steady: 30s @ 110% FTP | Steady: 2min @ 55% FTP | Steady: 6s @ 150% FTP | Steady: 1min @ 55% FTP | Steady: 6s @ 175% FTP | Steady: 1min @ 55% FTP | Steady: 6s @ 200% FTP | Steady: 1min @ 55% FTP | Cooldown: 1min 42s from 55% to 35% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.35" PowerHigh="0.55" pace="0" Cadence="90" />
        <SteadyState Duration="120" Power="0.6" pace="0" Cadence="85" />
        <SteadyState Duration="120" Power="0.7" pace="0" Cadence="95" />
        <SteadyState Duration="120" Power="0.85" pace="0" Cadence="100" />
        <SteadyState Duration="90" Power="1.0" pace="0" Cadence="105" />
        <SteadyState Duration="30" Power="1.1" pace="0" Cadence="110" />
        <SteadyState Duration="120" Power="0.55" pace="0" Cadence="90" />
        <IntervalsT Repeat="1" OnDuration="6" OffDuration="60" OnPower="1.5" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="6" OffDuration="60" OnPower="1.75" OffPower="0.55" pace="0" />
        <IntervalsT Repeat="1" OnDuration="6" OffDuration="60" OnPower="2.0" OffPower="0.55" pace="0" />
