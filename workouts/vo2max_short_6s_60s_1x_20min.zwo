        <SteadyState Duration="30" Power="1.1" pace="0" Cadence="110" />
        <SteadyState Duration="120" Power="0.55" pace="0" Cadence="90" />
        <IntervalsT Repeat="1" OnDuration="6" OffDuration="60" OnPower="1.5" OffPower="0.55" pace="0" />
