<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery Steady (30min)</name>
    <description>Warmup: 15min from 50% to 55% FTP | Cooldown: 15min from 55% to 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.5" PowerHigh="0.55" pace="0" />
        <Cooldown Duration="900" PowerLow="0.55" PowerHigh="0.5" pace="0" />
    </workout>
</workout_file>