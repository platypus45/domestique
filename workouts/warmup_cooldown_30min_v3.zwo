<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery Steady (30min)</name>
    <description>Warmup: 20min from 30% to 50% FTP | Cooldown: 10min from 50% to 30% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="1200" PowerLow="0.3" PowerHigh="0.5" pace="0" />
        <Cooldown Duration="600" PowerLow="0.5" PowerHigh="0.3" pace="0" />
    </workout>
</workout_file>