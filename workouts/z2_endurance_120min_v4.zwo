<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (120min)</name>
    <description>Warmup: 10min from 25% to 65% FTP | Steady: 30min @ 70% FTP | Steady: 10min @ 90% FTP | Steady: 10min @ 55% FTP | Steady: 30min @ 70% FTP | Steady: 10min @ 90% FTP | Steady: 10min @ 55% FTP | Cooldown: 10min from 50% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="1800" Power="0.7" pace="0" />
        <SteadyState Duration="600" Power="0.9" pace="0" />
        <SteadyState Duration="600" Power="0.55" pace="0" />
        <SteadyState Duration="1800" Power="0.7" pace="0" />
        <SteadyState Duration="600" Power="0.9" pace="0" />
        <SteadyState Duration="600" Power="0.55" pace="0" />
        <Cooldown Duration="600" PowerLow="0.5" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>