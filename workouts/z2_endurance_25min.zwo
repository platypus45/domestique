<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Recovery 3x30s (25min)</name>
    <description>Warmup: 5min from 40% to 65% FTP | Intervals: 3 x (30s @ 150% / 1min 30s @ 50%) | Cooldown: 6min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.4" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="90" Power="0.65" pace="0" />
        <SteadyState Duration="90" Power="0.8" pace="0" />
        <SteadyState Duration="90" Power="0.95" pace="0" />
        <SteadyState Duration="90" Power="1.1" pace="0" />
        <SteadyState Duration="60" Power="1.25" pace="0" />
        <SteadyState Duration="150" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.5" pace="0" />
        <SteadyState Duration="90" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.5" pace="0" />
        <SteadyState Duration="90" Power="0.5" pace="0" />
        <SteadyState Duration="30" Power="1.5" pace="0" />
        <SteadyState Duration="360" Power="0.5" pace="0" />
    </workout>
</workout_file>