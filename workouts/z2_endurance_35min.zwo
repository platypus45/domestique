<workout_file>
    <author>Domestique Library</author>
    <name>VO2max (38min)</name>
    <description>Warmup: 10min from 25% to 65% FTP | Steady: 7min @ 65% FTP | Steady: 4min @ 80% FTP | Steady: 2min @ 65% FTP | Steady: 3min @ 95% FTP | Steady: 2min @ 65% FTP | Steady: 2min @ 109% FTP | Steady: 2min @ 65% FTP | Steady: 1min @ 125% FTP | Steady: 2min @ 65% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <FreeRide Duration="120" FlatRoad="0" />
        <SteadyState Duration="240" Power="0.8" pace="0" />
        <FreeRide Duration="120" FlatRoad="0" />
        <SteadyState Duration="180" Power="0.95" pace="0" />
        <FreeRide Duration="120" FlatRoad="0" />
        <SteadyState Duration="120" Power="1.09" pace="0" />
        <FreeRide Duration="120" FlatRoad="0" />
        <SteadyState Duration="60" Power="1.25" pace="0" />
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.40" /></workout>
