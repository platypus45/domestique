<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot (50min)</name>
    <description>Warmup: 8min ramp from 50% to 75% FTP | Steady: 1min @ 70% FTP | Steady: 1min @ 80% FTP | Steady: 30s @ 90% FTP | Steady: 30s @ 100% FTP | Steady: 2min @ 55% FTP | Steady: 10min @ 90% FTP | Steady: 3min @ 55% FTP | Steady: 20min @ 65% FTP | Cooldown: 5min from 55% to 45% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.5" PowerHigh="0.75" /><SteadyState Duration="60" Power="0.8" pace="0" />
        <SteadyState Duration="30" Power="0.9" pace="0" />
        <SteadyState Duration="30" Power="1.0" pace="0" />
        <SteadyState Duration="120" Power="0.55" pace="0" />
        <SteadyState Duration="600" Power="0.9" pace="0" />
        <SteadyState Duration="180" Power="0.55" pace="0" />
        <FreeRide Duration="1200" FlatRoad="0" />
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.45" pace="0" />
    </workout>
</workout_file>