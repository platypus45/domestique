<workout_file>
    <author>Domestique Library</author>
    <name>Endurance (50min)</name>
    <description>Warmup: 10min from 25% to 70% FTP | Steady: 10min @ 70% FTP | Steady: 10min @ 75% FTP | Steady: 10min @ 70% FTP | Cooldown: 10min from 70% to 25% FTP</description>
