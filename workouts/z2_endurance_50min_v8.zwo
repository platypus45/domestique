        <SteadyState Duration="600" Power="0.7" pace="0" />
        <SteadyState Duration="600" Power="0.75" pace="0" />
        <SteadyState Duration="480" Power="0.7" pace="0" />
        <SteadyState Duration="120" Power="0.7" pace="0" />
        <Cooldown Duration="600" PowerLow="0.7" PowerHigh="0.25" pace="0" />
    </workout>
