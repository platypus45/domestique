<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Sweet Spot 3 cycles (64min)</name>
    <description>Warmup: 5min from 44% to 65% FTP | Over-Under: 3 cycles (alternating above/below threshold) | Cooldown: 10min @ 50% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.44" PowerHigh="0.65" pace="0" />
        <SteadyState Duration="300" Power="0.65" pace="0" />
        <SteadyState Duration="600" Power="0.85" pace="0" />
        <SteadyState Duration="300" Power="0.51" pace="0" />
        <SteadyState Duration="300" Power="0.9" pace="0" />
        <SteadyState Duration="10" Power="1.15" pace="0" />
        <SteadyState Duration="300" Power="1.0" pace="0" />
        <SteadyState Duration="120" Power="1.15" pace="0" />
        <SteadyState Duration="300" Power="0.5" pace="0" />
        <SteadyState Duration="300" Power="0.9" pace="0" />
        <SteadyState Duration="10" Power="1.15" pace="0" />
        <SteadyState Duration="300" Power="1.0" pace="0" />
        <SteadyState Duration="120" Power="1.15" pace="0" />
        <SteadyState Duration="600" Power="0.5" pace="0" />
    </workout>
</workout_file>