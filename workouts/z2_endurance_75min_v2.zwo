<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Domestique Library</author>
    <name>Endurance Steady (75min)</name>
    <description>Warmup: 15min from 25% to 75% FTP | Steady: 45min @ 74% FTP | Cooldown: 15min from 65% to 25% FTP</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.25" PowerHigh="0.75" pace="0" />
        <SteadyState Duration="2700" Power="0.74" pace="0" />
        <Cooldown Duration="900" PowerLow="0.65" PowerHigh="0.25" pace="0" />
    </workout>
</workout_file>